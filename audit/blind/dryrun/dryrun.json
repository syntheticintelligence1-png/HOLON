  "commands": [
    "S=<scratch>; mkdir -p S/laws; cp -r laws/M0 laws/M1 laws/M3 S/laws/",
    "HOLON_BUILD_DIR=S/build python -m holon run --milestone M0 --out S/results/M0 --gen-dir S/gen/M0",
