    "python -m holon compare --snapshot . --into audit/blind/dryrun/lead --milestone M0,M1,M3",
    "python -m holon compare --blind audit/blind/dryrun/tree --lead audit/blind/dryrun/lead --milestone M0,M1,M3 --out audit/blind/dryrun/compare.json"
