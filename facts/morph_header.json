  "assumptions": [
    {
      "id": "A-width",
      "text": "batchIndex, l1MessagePopped, totalL1MessagePopped and lastBlockNumber are < 2^64; Solidity stores shl(192, x) of a uint256, so larger values would be truncated. Modelled as 8-byte fields (SORT width obligation, later milestone)."
    },
    {
      "id": "A-version",
      "text": "version fits in one byte; Solidity guard requires version <= 2."
    },
    {
      "id": "A-cache",
      "text": "Go encoders are modelled with an empty EncodedBytes cache."
    },
    {
      "id": "A-dirty",
      "text": "Solidity encodes into memory at the free pointer whose prior contents are unknown; the model marks unwritten bytes UNKNOWN (outside the byte range) so any unwritten byte in the output is detectable."
    },
    {
      "id": "A-hash",
      "text": "M0 compares header bytes, not hashes; no hash premises are needed in M0."
    }
