    case OPanic{} OPanic{}:
      True{}
    case OErr{} OErr{}:
      True{}
    case ORet{} ORet{}:
      True{}
    case _ _:
      False{}

def eq_bool(a: Bool, b: Bool) -> Bool:
  match a b:
    case True{} True{}:
      True{}
    case False{} False{}:
      True{}
    case True{} False{}:
      False{}
    case False{} True{}:
      False{}

def is_true(b: Bool) -> Type:
