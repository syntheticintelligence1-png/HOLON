def x0_WriteMsg(+st: HSt, +ar: AR_WriteMsg, +en: HEnv, +kh: List<&2, HKB>) -> X_WriteMsg:
  X_WriteMsg{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_WriteMsg(+st: HSt, +ar: AR_WriteMsg, +en: HEnv, +kh: List<&2, HKB>) -> X_WriteMsg:
  s_WriteMsg_28(x0_WriteMsg(st, ar, en, kh))

def xo_WriteMsg(x: X_WriteMsg) -> HOut:
  match x:
    case X_WriteMsg{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_WriteMsg(+st: HSt, +ar: AR_WriteMsg, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_WriteMsg(xr_WriteMsg(st, ar, en, kh))

# 0 when every check of WriteMsg holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_WriteMsg(+st: HSt, +ar: AR_WriteMsg, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_WriteMsg(st, ar, en, kh))

def post_WriteMsg(+st: HSt, +ar: AR_WriteMsg, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_WriteMsg(st, ar, en, kh))

def logs_WriteMsg(+st: HSt, +ar: AR_WriteMsg, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_WriteMsg(st, ar, en, kh))

def step_WriteMsg(+st: HSt, +ar: AR_WriteMsg, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_WriteMsg(st, ar, en, kh), st)

# an action with its arguments and its environment (A-env: free per step)
type HAct is Data:
  A_Close{ar: AR_Close, en: HEnv}
  A_ReadMsg{ar: AR_ReadMsg, en: HEnv}
  A_WriteMsg{ar: AR_WriteMsg, en: HEnv}

def step(a: HAct, +s: HSt, +kh: List<&2, HKB>) -> HSt:
  match a:
    case A_Close{ar, en}:
      step_Close(s, ar, en, kh)
    case A_ReadMsg{ar, en}:
      step_ReadMsg(s, ar, en, kh)
    case A_WriteMsg{ar, en}:
      step_WriteMsg(s, ar, en, kh)

# the initial state: the target's storage after the deployment of the binding (zero without one)
def s0() -> HSt:
  HSt{Nil{}}

# ---- ghost: SORT coercions (holon.rules.sort)

type Tag is Data:
  TG_bot{}

def tg_eq(a: Tag, b: Tag) -> Bool:
  match a b:
    case TG_bot{} TG_bot{}:
      True{}

type GKT is Data:
  GKT{k: W, t: Tag}

def gk_get(xs: List<&2, GKT>, +k: W) -> Tag:
  match xs:
    case Nil{}:
      TG_bot{}
    case Con{h, t}:
      match h:
        case GKT{hk, ht}:
          ite(Tag, w_eq(hk, k), ht, gk_get(t, k))

def gk_put(xs: List<&2, GKT>, +k: W, +v: Tag, +done: Bool) -> List<&2, GKT>:
  match xs:
    case Nil{}:
      ite(List<&2, GKT>, done, Nil{}, [GKT{k, v}])
    case Con{h, t}:
      match h:
        case GKT{+hk, ht}:
          +eq = w_eq(hk, k)
          Con{GKT{hk, ite(Tag, Bool.and(eq, Bool.not(done)), v, ht)}, gk_put(t, k, v, Bool.or(done, eq))}

def gk_set(xs: List<&2, GKT>, +k: W, +v: Tag) -> List<&2, GKT>:
  gk_put(xs, k, v, False{})

# the augmented state: the real store and the generated companion of every union register (G1)
type GSt is Data:
  GSt{st: HSt}

def gh_get_st(e: GSt) -> HSt:
  match e:
    case GSt{st}:
      st

def gh_set_st(e: GSt, +v: HSt) -> GSt:
  match e:
    case GSt{_}:
      GSt{v}

def gh_s0() -> GSt:
  GSt{s0()}

def gh_eff_Close(x: X_Close, +g: GSt) -> GSt:
  g

def gh_ok_Close(c: Bool, x: X_Close, +g: GSt) -> GSt:
  match c:
    case True{}:
      g
    case False{}:
      match x:
        case X_Close{x_st, +x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
          gh_eff_Close(X_Close{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, gh_set_st(g, x_ov))

def gh_go_Close(x: X_Close, +g: GSt) -> GSt:
  match x:
    case X_Close{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_Close(u_nz(x_cd), X_Close{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

def gh_eff_ReadMsg(x: X_ReadMsg, +g: GSt) -> GSt:
  g

def gh_ok_ReadMsg(c: Bool, x: X_ReadMsg, +g: GSt) -> GSt:
  match c:
    case True{}:
      g
    case False{}:
      match x:
        case X_ReadMsg{x_st, +x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
          gh_eff_ReadMsg(X_ReadMsg{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, gh_set_st(g, x_ov))

def gh_go_ReadMsg(x: X_ReadMsg, +g: GSt) -> GSt:
  match x:
    case X_ReadMsg{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_ReadMsg(u_nz(x_cd), X_ReadMsg{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

def gh_eff_WriteMsg(x: X_WriteMsg, +g: GSt) -> GSt:
  g

def gh_ok_WriteMsg(c: Bool, x: X_WriteMsg, +g: GSt) -> GSt:
  match c:
    case True{}:
      g
    case False{}:
      match x:
        case X_WriteMsg{x_st, +x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
          gh_eff_WriteMsg(X_WriteMsg{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, gh_set_st(g, x_ov))

def gh_go_WriteMsg(x: X_WriteMsg, +g: GSt) -> GSt:
  match x:
    case X_WriteMsg{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_WriteMsg(u_nz(x_cd), X_WriteMsg{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

# one step of any action from an augmented state: the real step and its ghost effects
def gh_step(a: HAct, +g: GSt, +kh: List<&2, HKB>) -> GSt:
  match a:
    case A_Close{ar, en}:
      gh_go_Close(xr_Close(gh_get_st(g), ar, en, kh), g)
    case A_ReadMsg{ar, en}:
      gh_go_ReadMsg(xr_ReadMsg(gh_get_st(g), ar, en, kh), g)
    case A_WriteMsg{ar, en}:
      gh_go_WriteMsg(xr_WriteMsg(gh_get_st(g), ar, en, kh), g)

# the reachable augmented states: the deployment (R0) and one step of any action (RStep)
type Reach<-kh: List<&2, HKB>, -s: GSt> is Type:
  R0{e: {s == gh_s0() : GSt}}
  RStep{a: HAct, p: GSt, r: Reach<kh, p>, e: {s == gh_step(a, p, kh) : GSt}}

def run(tr: List<&2, HAct>, g: GSt, +kh: List<&2, HKB>) -> GSt:
  match tr:
    case Nil{}:
      g
    case Con{a, rest}:
      run(rest, gh_step(a, g, kh), kh)

def rz_reached(+c: U32, +k: U32) -> Bool:
  Bool.or(U32.is_eq(c, 0), Bool.and(U32.is_ge(c, k), U32.is_lt(c, 4026531840)))
