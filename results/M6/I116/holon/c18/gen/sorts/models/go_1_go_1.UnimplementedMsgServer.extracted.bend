# an action with its arguments and its environment (A-env: free per step)
type HAct is Data:
  A_CreateGroup{ar: AR_CreateGroup, en: HEnv}
  A_CreateGroupPolicy{ar: AR_CreateGroupPolicy, en: HEnv}
  A_CreateGroupWithPolicy{ar: AR_CreateGroupWithPolicy, en: HEnv}
  A_Exec{ar: AR_Exec, en: HEnv}
  A_LeaveGroup{ar: AR_LeaveGroup, en: HEnv}
  A_SubmitProposal{ar: AR_SubmitProposal, en: HEnv}
  A_UpdateGroupAdmin{ar: AR_UpdateGroupAdmin, en: HEnv}
  A_UpdateGroupMembers{ar: AR_UpdateGroupMembers, en: HEnv}
  A_UpdateGroupMetadata{ar: AR_UpdateGroupMetadata, en: HEnv}
  A_UpdateGroupPolicyAdmin{ar: AR_UpdateGroupPolicyAdmin, en: HEnv}
  A_UpdateGroupPolicyDecisionPolicy{ar: AR_UpdateGroupPolicyDecisionPolicy, en: HEnv}
  A_UpdateGroupPolicyMetadata{ar: AR_UpdateGroupPolicyMetadata, en: HEnv}
  A_Vote{ar: AR_Vote, en: HEnv}
  A_WithdrawProposal{ar: AR_WithdrawProposal, en: HEnv}

def step(a: HAct, +s: HSt, +kh: List<&2, HKB>) -> HSt:
  match a:
    case A_CreateGroup{ar, en}:
      step_CreateGroup(s, ar, en, kh)
    case A_CreateGroupPolicy{ar, en}:
      step_CreateGroupPolicy(s, ar, en, kh)
    case A_CreateGroupWithPolicy{ar, en}:
      step_CreateGroupWithPolicy(s, ar, en, kh)
    case A_Exec{ar, en}:
      step_Exec(s, ar, en, kh)
    case A_LeaveGroup{ar, en}:
      step_LeaveGroup(s, ar, en, kh)
    case A_SubmitProposal{ar, en}:
      step_SubmitProposal(s, ar, en, kh)
    case A_UpdateGroupAdmin{ar, en}:
      step_UpdateGroupAdmin(s, ar, en, kh)
    case A_UpdateGroupMembers{ar, en}:
      step_UpdateGroupMembers(s, ar, en, kh)
    case A_UpdateGroupMetadata{ar, en}:
      step_UpdateGroupMetadata(s, ar, en, kh)
    case A_UpdateGroupPolicyAdmin{ar, en}:
      step_UpdateGroupPolicyAdmin(s, ar, en, kh)
    case A_UpdateGroupPolicyDecisionPolicy{ar, en}:
      step_UpdateGroupPolicyDecisionPolicy(s, ar, en, kh)
    case A_UpdateGroupPolicyMetadata{ar, en}:
      step_UpdateGroupPolicyMetadata(s, ar, en, kh)
    case A_Vote{ar, en}:
      step_Vote(s, ar, en, kh)
    case A_WithdrawProposal{ar, en}:
      step_WithdrawProposal(s, ar, en, kh)

# the initial state: the target's storage after the deployment of the binding (zero without one)
def s0() -> HSt:
  HSt{Nil{}}

# ---- ghost: SORT coercions (holon.rules.sort)

type Tag is Data:
  TG_bot{}

def tg_eq(a: Tag, b: Tag) -> Bool:
  match a b:
    case TG_bot{} TG_bot{}:
      True{}

type GKT is Data:
  GKT{k: W, t: Tag}

def gk_get(xs: List<&2, GKT>, +k: W) -> Tag:
  match xs:
    case Nil{}:
      TG_bot{}
    case Con{h, t}:
      match h:
        case GKT{hk, ht}:
          ite(Tag, w_eq(hk, k), ht, gk_get(t, k))

def gk_put(xs: List<&2, GKT>, +k: W, +v: Tag, +done: Bool) -> List<&2, GKT>:
  match xs:
    case Nil{}:
      ite(List<&2, GKT>, done, Nil{}, [GKT{k, v}])
    case Con{h, t}:
      match h:
        case GKT{+hk, ht}:
          +eq = w_eq(hk, k)
          Con{GKT{hk, ite(Tag, Bool.and(eq, Bool.not(done)), v, ht)}, gk_put(t, k, v, Bool.or(done, eq))}

def gk_set(xs: List<&2, GKT>, +k: W, +v: Tag) -> List<&2, GKT>:
  gk_put(xs, k, v, False{})

# the augmented state: the real store and the generated companion of every union register (G1)
type GSt is Data:
  GSt{st: HSt}

def gh_get_st(e: GSt) -> HSt:
  match e:
    case GSt{st}:
      st

def gh_set_st(e: GSt, +v: HSt) -> GSt:
  match e:
    case GSt{_}:
      GSt{v}

def gh_s0() -> GSt:
  GSt{s0()}

def gh_eff_CreateGroup(x: X_CreateGroup, +g: GSt) -> GSt:
  g

def gh_ok_CreateGroup(c: Bool, x: X_CreateGroup, +g: GSt) -> GSt:
  match c:
    case True{}:
      g
    case False{}:
      match x:
        case X_CreateGroup{x_st, +x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
          gh_eff_CreateGroup(X_CreateGroup{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, gh_set_st(g, x_ov))

def gh_go_CreateGroup(x: X_CreateGroup, +g: GSt) -> GSt:
  match x:
    case X_CreateGroup{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_CreateGroup(u_nz(x_cd), X_CreateGroup{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

