# one step of any action from an augmented state: the real step and its ghost effects
def gh_step(a: HAct, +g: GSt, +kh: List<&2, HKB>) -> GSt:
  match a:
    case A_CreateGroup{ar, en}:
      gh_go_CreateGroup(xr_CreateGroup(gh_get_st(g), ar, en, kh), g)
    case A_CreateGroupPolicy{ar, en}:
      gh_go_CreateGroupPolicy(xr_CreateGroupPolicy(gh_get_st(g), ar, en, kh), g)
    case A_CreateGroupWithPolicy{ar, en}:
      gh_go_CreateGroupWithPolicy(xr_CreateGroupWithPolicy(gh_get_st(g), ar, en, kh), g)
    case A_Exec{ar, en}:
      gh_go_Exec(xr_Exec(gh_get_st(g), ar, en, kh), g)
    case A_LeaveGroup{ar, en}:
      gh_go_LeaveGroup(xr_LeaveGroup(gh_get_st(g), ar, en, kh), g)
    case A_SubmitProposal{ar, en}:
      gh_go_SubmitProposal(xr_SubmitProposal(gh_get_st(g), ar, en, kh), g)
    case A_UpdateGroupAdmin{ar, en}:
      gh_go_UpdateGroupAdmin(xr_UpdateGroupAdmin(gh_get_st(g), ar, en, kh), g)
    case A_UpdateGroupMembers{ar, en}:
      gh_go_UpdateGroupMembers(xr_UpdateGroupMembers(gh_get_st(g), ar, en, kh), g)
    case A_UpdateGroupMetadata{ar, en}:
      gh_go_UpdateGroupMetadata(xr_UpdateGroupMetadata(gh_get_st(g), ar, en, kh), g)
    case A_UpdateGroupPolicyAdmin{ar, en}:
      gh_go_UpdateGroupPolicyAdmin(xr_UpdateGroupPolicyAdmin(gh_get_st(g), ar, en, kh), g)
    case A_UpdateGroupPolicyDecisionPolicy{ar, en}:
      gh_go_UpdateGroupPolicyDecisionPolicy(xr_UpdateGroupPolicyDecisionPolicy(gh_get_st(g), ar, en, kh), g)
    case A_UpdateGroupPolicyMetadata{ar, en}:
      gh_go_UpdateGroupPolicyMetadata(xr_UpdateGroupPolicyMetadata(gh_get_st(g), ar, en, kh), g)
    case A_Vote{ar, en}:
      gh_go_Vote(xr_Vote(gh_get_st(g), ar, en, kh), g)
    case A_WithdrawProposal{ar, en}:
      gh_go_WithdrawProposal(xr_WithdrawProposal(gh_get_st(g), ar, en, kh), g)

# the reachable augmented states: the deployment (R0) and one step of any action (RStep)
type Reach<-kh: List<&2, HKB>, -s: GSt> is Type:
  R0{e: {s == gh_s0() : GSt}}
  RStep{a: HAct, p: GSt, r: Reach<kh, p>, e: {s == gh_step(a, p, kh) : GSt}}

def run(tr: List<&2, HAct>, g: GSt, +kh: List<&2, HKB>) -> GSt:
  match tr:
    case Nil{}:
      g
    case Con{a, rest}:
      run(rest, gh_step(a, g, kh), kh)

def rz_reached(+c: U32, +k: U32) -> Bool:
  Bool.or(U32.is_eq(c, 0), Bool.and(U32.is_ge(c, k), U32.is_lt(c, 4026531840)))
