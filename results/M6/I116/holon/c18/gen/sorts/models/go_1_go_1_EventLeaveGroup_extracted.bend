def xo_Unmarshal(x: X_Unmarshal) -> HOut:
  match x:
    case X_Unmarshal{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_Unmarshal(+st: HSt, +ar: AR_Unmarshal, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_Unmarshal(xr_Unmarshal(st, ar, en, kh))

# 0 when every check of Unmarshal holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_Unmarshal(+st: HSt, +ar: AR_Unmarshal, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_Unmarshal(st, ar, en, kh))

def post_Unmarshal(+st: HSt, +ar: AR_Unmarshal, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_Unmarshal(st, ar, en, kh))

def logs_Unmarshal(+st: HSt, +ar: AR_Unmarshal, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_Unmarshal(st, ar, en, kh))

def step_Unmarshal(+st: HSt, +ar: AR_Unmarshal, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_Unmarshal(st, ar, en, kh), st)

