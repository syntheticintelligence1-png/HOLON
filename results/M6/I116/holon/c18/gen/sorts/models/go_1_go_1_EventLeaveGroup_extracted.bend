def x0_XXX_Unmarshal(+st: HSt, +ar: AR_XXX_Unmarshal, +en: HEnv, +kh: List<&2, HKB>) -> X_XXX_Unmarshal:
  X_XXX_Unmarshal{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_XXX_Unmarshal(+st: HSt, +ar: AR_XXX_Unmarshal, +en: HEnv, +kh: List<&2, HKB>) -> X_XXX_Unmarshal:
  s_XXX_Unmarshal_38(x0_XXX_Unmarshal(st, ar, en, kh))

def xo_XXX_Unmarshal(x: X_XXX_Unmarshal) -> HOut:
  match x:
    case X_XXX_Unmarshal{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_XXX_Unmarshal(+st: HSt, +ar: AR_XXX_Unmarshal, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_XXX_Unmarshal(xr_XXX_Unmarshal(st, ar, en, kh))

# 0 when every check of XXX_Unmarshal holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_XXX_Unmarshal(+st: HSt, +ar: AR_XXX_Unmarshal, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_XXX_Unmarshal(st, ar, en, kh))

def post_XXX_Unmarshal(+st: HSt, +ar: AR_XXX_Unmarshal, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_XXX_Unmarshal(st, ar, en, kh))

def logs_XXX_Unmarshal(+st: HSt, +ar: AR_XXX_Unmarshal, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_XXX_Unmarshal(st, ar, en, kh))

def step_XXX_Unmarshal(+st: HSt, +ar: AR_XXX_Unmarshal, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_XXX_Unmarshal(st, ar, en, kh), st)

# an action with its arguments and its environment (A-env: free per step)
type HAct is Data:
  A_Descriptor{ar: AR_Descriptor, en: HEnv}
  A_GetAddress{ar: AR_GetAddress, en: HEnv}
  A_GetGroupId{ar: AR_GetGroupId, en: HEnv}
  A_Marshal{ar: AR_Marshal, en: HEnv}
  A_MarshalTo{ar: AR_MarshalTo, en: HEnv}
  A_MarshalToSizedBuffer{ar: AR_MarshalToSizedBuffer, en: HEnv}
  A_ProtoMessage{ar: AR_ProtoMessage, en: HEnv}
  A_Reset{ar: AR_Reset, en: HEnv}
  A_Size{ar: AR_Size, en: HEnv}
  A_String{ar: AR_String, en: HEnv}
  A_Unmarshal{ar: AR_Unmarshal, en: HEnv}
  A_XXX_DiscardUnknown{ar: AR_XXX_DiscardUnknown, en: HEnv}
  A_XXX_Marshal{ar: AR_XXX_Marshal, en: HEnv}
  A_XXX_Merge{ar: AR_XXX_Merge, en: HEnv}
  A_XXX_Size{ar: AR_XXX_Size, en: HEnv}
  A_XXX_Unmarshal{ar: AR_XXX_Unmarshal, en: HEnv}

def step(a: HAct, +s: HSt, +kh: List<&2, HKB>) -> HSt:
  match a:
    case A_Descriptor{ar, en}:
      step_Descriptor(s, ar, en, kh)
    case A_GetAddress{ar, en}:
      step_GetAddress(s, ar, en, kh)
    case A_GetGroupId{ar, en}:
      step_GetGroupId(s, ar, en, kh)
    case A_Marshal{ar, en}:
      step_Marshal(s, ar, en, kh)
    case A_MarshalTo{ar, en}:
      step_MarshalTo(s, ar, en, kh)
    case A_MarshalToSizedBuffer{ar, en}:
      step_MarshalToSizedBuffer(s, ar, en, kh)
    case A_ProtoMessage{ar, en}:
      step_ProtoMessage(s, ar, en, kh)
    case A_Reset{ar, en}:
      step_Reset(s, ar, en, kh)
    case A_Size{ar, en}:
      step_Size(s, ar, en, kh)
    case A_String{ar, en}:
      step_String(s, ar, en, kh)
    case A_Unmarshal{ar, en}:
      step_Unmarshal(s, ar, en, kh)
    case A_XXX_DiscardUnknown{ar, en}:
      step_XXX_DiscardUnknown(s, ar, en, kh)
    case A_XXX_Marshal{ar, en}:
      step_XXX_Marshal(s, ar, en, kh)
    case A_XXX_Merge{ar, en}:
      step_XXX_Merge(s, ar, en, kh)
    case A_XXX_Size{ar, en}:
      step_XXX_Size(s, ar, en, kh)
    case A_XXX_Unmarshal{ar, en}:
      step_XXX_Unmarshal(s, ar, en, kh)

# the initial state: the target's storage after the deployment of the binding (zero without one)
def s0() -> HSt:
  HSt{Nil{}}

# ---- ghost: SORT coercions (holon.rules.sort)

type Tag is Data:
  TG_bot{}

def tg_eq(a: Tag, b: Tag) -> Bool:
  match a b:
    case TG_bot{} TG_bot{}:
      True{}

type GKT is Data:
  GKT{k: W, t: Tag}

def gk_get(xs: List<&2, GKT>, +k: W) -> Tag:
  match xs:
    case Nil{}:
      TG_bot{}
    case Con{h, t}:
      match h:
        case GKT{hk, ht}:
          ite(Tag, w_eq(hk, k), ht, gk_get(t, k))

def gk_put(xs: List<&2, GKT>, +k: W, +v: Tag, +done: Bool) -> List<&2, GKT>:
  match xs:
    case Nil{}:
      ite(List<&2, GKT>, done, Nil{}, [GKT{k, v}])
    case Con{h, t}:
      match h:
        case GKT{+hk, ht}:
          +eq = w_eq(hk, k)
          Con{GKT{hk, ite(Tag, Bool.and(eq, Bool.not(done)), v, ht)}, gk_put(t, k, v, Bool.or(done, eq))}

def gk_set(xs: List<&2, GKT>, +k: W, +v: Tag) -> List<&2, GKT>:
  gk_put(xs, k, v, False{})

# the augmented state: the real store and the generated companion of every union register (G1)
type GSt is Data:
  GSt{st: HSt}

def gh_get_st(e: GSt) -> HSt:
  match e:
    case GSt{st}:
      st

def gh_set_st(e: GSt, +v: HSt) -> GSt:
  match e:
    case GSt{_}:
      GSt{v}

def gh_s0() -> GSt:
  GSt{s0()}

def gh_eff_Descriptor(x: X_Descriptor, +g: GSt) -> GSt:
  g

def gh_ok_Descriptor(c: Bool, x: X_Descriptor, +g: GSt) -> GSt:
  match c:
    case True{}:
      g
    case False{}:
      match x:
        case X_Descriptor{x_st, +x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
          gh_eff_Descriptor(X_Descriptor{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, gh_set_st(g, x_ov))

def gh_go_Descriptor(x: X_Descriptor, +g: GSt) -> GSt:
  match x:
    case X_Descriptor{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_Descriptor(u_nz(x_cd), X_Descriptor{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

