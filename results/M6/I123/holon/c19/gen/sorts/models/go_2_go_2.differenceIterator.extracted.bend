# one step of any action from an augmented state: the real step and its ghost effects
def gh_step(a: HAct, +g: GSt, +kh: List<&2, HKB>) -> GSt:
  match a:
    case A_AddResolver{ar, en}:
      gh_go_AddResolver(xr_AddResolver(gh_get_st(g), ar, en, kh), g)
    case A_Error{ar, en}:
      gh_go_Error(xr_Error(gh_get_st(g), ar, en, kh), g)
    case A_Hash{ar, en}:
      gh_go_Hash(xr_Hash(gh_get_st(g), ar, en, kh), g)
    case A_Leaf{ar, en}:
      gh_go_Leaf(xr_Leaf(gh_get_st(g), ar, en, kh), g)
    case A_LeafBlob{ar, en}:
      gh_go_LeafBlob(xr_LeafBlob(gh_get_st(g), ar, en, kh), g)
    case A_LeafKey{ar, en}:
      gh_go_LeafKey(xr_LeafKey(gh_get_st(g), ar, en, kh), g)
    case A_LeafProof{ar, en}:
      gh_go_LeafProof(xr_LeafProof(gh_get_st(g), ar, en, kh), g)
    case A_Next{ar, en}:
      gh_go_Next(xr_Next(gh_get_st(g), ar, en, kh), g)
    case A_Parent{ar, en}:
      gh_go_Parent(xr_Parent(gh_get_st(g), ar, en, kh), g)
    case A_Path{ar, en}:
      gh_go_Path(xr_Path(gh_get_st(g), ar, en, kh), g)

# the reachable augmented states: the deployment (R0) and one step of any action (RStep)
type Reach<-kh: List<&2, HKB>, -s: GSt> is Type:
  R0{e: {s == gh_s0() : GSt}}
  RStep{a: HAct, p: GSt, r: Reach<kh, p>, e: {s == gh_step(a, p, kh) : GSt}}

def run(tr: List<&2, HAct>, g: GSt, +kh: List<&2, HKB>) -> GSt:
  match tr:
    case Nil{}:
      g
    case Con{a, rest}:
      run(rest, gh_step(a, g, kh), kh)

def rz_reached(+c: U32, +k: U32) -> Bool:
  Bool.or(U32.is_eq(c, 0), Bool.and(U32.is_ge(c, k), U32.is_lt(c, 4026531840)))
