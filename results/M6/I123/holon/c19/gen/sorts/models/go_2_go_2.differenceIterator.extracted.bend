def x0_Next(+st: HSt, +ar: AR_Next, +en: HEnv, +kh: List<&2, HKB>) -> X_Next:
  X_Next{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_Next(+st: HSt, +ar: AR_Next, +en: HEnv, +kh: List<&2, HKB>) -> X_Next:
  s_Next_23(x0_Next(st, ar, en, kh))

def xo_Next(x: X_Next) -> HOut:
  match x:
    case X_Next{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_Next(+st: HSt, +ar: AR_Next, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_Next(xr_Next(st, ar, en, kh))

# 0 when every check of Next holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_Next(+st: HSt, +ar: AR_Next, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_Next(st, ar, en, kh))

def post_Next(+st: HSt, +ar: AR_Next, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_Next(st, ar, en, kh))

def logs_Next(+st: HSt, +ar: AR_Next, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_Next(st, ar, en, kh))

def step_Next(+st: HSt, +ar: AR_Next, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_Next(st, ar, en, kh), st)

