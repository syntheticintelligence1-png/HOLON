def sz_Parent(x: X_Parent) -> X_Parent:
  x

def x0_Parent(+st: HSt, +ar: AR_Parent, +en: HEnv, +kh: List<&2, HKB>) -> X_Parent:
  X_Parent{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_Parent(+st: HSt, +ar: AR_Parent, +en: HEnv, +kh: List<&2, HKB>) -> X_Parent:
  sz_Parent(x0_Parent(st, ar, en, kh))

def xo_Parent(x: X_Parent) -> HOut:
  match x:
    case X_Parent{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_Parent(+st: HSt, +ar: AR_Parent, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_Parent(xr_Parent(st, ar, en, kh))

# 0 when every check of Parent holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_Parent(+st: HSt, +ar: AR_Parent, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_Parent(st, ar, en, kh))

def post_Parent(+st: HSt, +ar: AR_Parent, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
