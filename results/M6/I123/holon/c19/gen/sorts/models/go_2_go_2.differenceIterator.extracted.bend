# an action with its arguments and its environment (A-env: free per step)
type HAct is Data:
  A_AddResolver{ar: AR_AddResolver, en: HEnv}
  A_Error{ar: AR_Error, en: HEnv}
  A_Hash{ar: AR_Hash, en: HEnv}
  A_Leaf{ar: AR_Leaf, en: HEnv}
  A_LeafBlob{ar: AR_LeafBlob, en: HEnv}
  A_LeafKey{ar: AR_LeafKey, en: HEnv}
  A_LeafProof{ar: AR_LeafProof, en: HEnv}
  A_Next{ar: AR_Next, en: HEnv}
  A_Parent{ar: AR_Parent, en: HEnv}
  A_Path{ar: AR_Path, en: HEnv}

def step(a: HAct, +s: HSt, +kh: List<&2, HKB>) -> HSt:
  match a:
    case A_AddResolver{ar, en}:
      step_AddResolver(s, ar, en, kh)
    case A_Error{ar, en}:
      step_Error(s, ar, en, kh)
    case A_Hash{ar, en}:
      step_Hash(s, ar, en, kh)
    case A_Leaf{ar, en}:
      step_Leaf(s, ar, en, kh)
    case A_LeafBlob{ar, en}:
      step_LeafBlob(s, ar, en, kh)
    case A_LeafKey{ar, en}:
      step_LeafKey(s, ar, en, kh)
    case A_LeafProof{ar, en}:
      step_LeafProof(s, ar, en, kh)
    case A_Next{ar, en}:
      step_Next(s, ar, en, kh)
    case A_Parent{ar, en}:
      step_Parent(s, ar, en, kh)
    case A_Path{ar, en}:
      step_Path(s, ar, en, kh)

# the initial state: the target's storage after the deployment of the binding (zero without one)
def s0() -> HSt:
  HSt{Nil{}}

# ---- ghost: SORT coercions (holon.rules.sort)

type Tag is Data:
  TG_bot{}

def tg_eq(a: Tag, b: Tag) -> Bool:
  match a b:
    case TG_bot{} TG_bot{}:
      True{}

type GKT is Data:
  GKT{k: W, t: Tag}

def gk_get(xs: List<&2, GKT>, +k: W) -> Tag:
  match xs:
    case Nil{}:
      TG_bot{}
    case Con{h, t}:
      match h:
        case GKT{hk, ht}:
          ite(Tag, w_eq(hk, k), ht, gk_get(t, k))

def gk_put(xs: List<&2, GKT>, +k: W, +v: Tag, +done: Bool) -> List<&2, GKT>:
  match xs:
    case Nil{}:
      ite(List<&2, GKT>, done, Nil{}, [GKT{k, v}])
    case Con{h, t}:
      match h:
        case GKT{+hk, ht}:
          +eq = w_eq(hk, k)
          Con{GKT{hk, ite(Tag, Bool.and(eq, Bool.not(done)), v, ht)}, gk_put(t, k, v, Bool.or(done, eq))}

def gk_set(xs: List<&2, GKT>, +k: W, +v: Tag) -> List<&2, GKT>:
  gk_put(xs, k, v, False{})

# the augmented state: the real store and the generated companion of every union register (G1)
type GSt is Data:
  GSt{st: HSt}

def gh_get_st(e: GSt) -> HSt:
  match e:
    case GSt{st}:
      st

def gh_set_st(e: GSt, +v: HSt) -> GSt:
  match e:
    case GSt{_}:
      GSt{v}

def gh_s0() -> GSt:
  GSt{s0()}

def gh_eff_AddResolver(x: X_AddResolver, +g: GSt) -> GSt:
  g

def gh_ok_AddResolver(c: Bool, x: X_AddResolver, +g: GSt) -> GSt:
  match c:
    case True{}:
      g
    case False{}:
      match x:
        case X_AddResolver{x_st, +x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
          gh_eff_AddResolver(X_AddResolver{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, gh_set_st(g, x_ov))

def gh_go_AddResolver(x: X_AddResolver, +g: GSt) -> GSt:
  match x:
    case X_AddResolver{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_AddResolver(u_nz(x_cd), X_AddResolver{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

