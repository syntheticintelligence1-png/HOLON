# ---- Go integer ops (holon.gen.goint): a Go integer as the 64-bit two's complement of its value, Word(64n), LSB first
def gw_cat(n: Nat, a: Word(n), b: Word(32n)) -> Word(Nat.add(n, 32n)):
  match n:
    case 0n:
      b
    case 1n+p:
