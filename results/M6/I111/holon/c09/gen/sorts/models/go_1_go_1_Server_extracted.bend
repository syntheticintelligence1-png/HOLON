def x0_Self(+st: HSt, +ar: AR_Self, +en: HEnv, +kh: List<&2, HKB>) -> X_Self:
  X_Self{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_Self(+st: HSt, +ar: AR_Self, +en: HEnv, +kh: List<&2, HKB>) -> X_Self:
  s_Self_54(x0_Self(st, ar, en, kh))

def xo_Self(x: X_Self) -> HOut:
  match x:
    case X_Self{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_Self(+st: HSt, +ar: AR_Self, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_Self(xr_Self(st, ar, en, kh))

# 0 when every check of Self holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_Self(+st: HSt, +ar: AR_Self, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_Self(st, ar, en, kh))

def post_Self(+st: HSt, +ar: AR_Self, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_Self(st, ar, en, kh))

def logs_Self(+st: HSt, +ar: AR_Self, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_Self(st, ar, en, kh))

def step_Self(+st: HSt, +ar: AR_Self, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_Self(st, ar, en, kh), st)

