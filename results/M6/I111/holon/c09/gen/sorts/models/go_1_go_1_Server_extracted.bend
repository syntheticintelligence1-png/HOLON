      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_Start(+st: HSt, +ar: AR_Start, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_Start(xr_Start(st, ar, en, kh))

# 0 when every check of Start holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_Start(+st: HSt, +ar: AR_Start, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_Start(st, ar, en, kh))

def post_Start(+st: HSt, +ar: AR_Start, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_Start(st, ar, en, kh))

def logs_Start(+st: HSt, +ar: AR_Start, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_Start(st, ar, en, kh))

def step_Start(+st: HSt, +ar: AR_Start, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_Start(st, ar, en, kh), st)

