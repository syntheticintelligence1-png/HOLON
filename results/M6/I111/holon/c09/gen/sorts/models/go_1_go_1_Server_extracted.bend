def x0_NodeInfo(+st: HSt, +ar: AR_NodeInfo, +en: HEnv, +kh: List<&2, HKB>) -> X_NodeInfo:
  X_NodeInfo{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_NodeInfo(+st: HSt, +ar: AR_NodeInfo, +en: HEnv, +kh: List<&2, HKB>) -> X_NodeInfo:
  s_NodeInfo_54(x0_NodeInfo(st, ar, en, kh))

def xo_NodeInfo(x: X_NodeInfo) -> HOut:
  match x:
    case X_NodeInfo{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_NodeInfo(+st: HSt, +ar: AR_NodeInfo, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_NodeInfo(xr_NodeInfo(st, ar, en, kh))

# 0 when every check of NodeInfo holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_NodeInfo(+st: HSt, +ar: AR_NodeInfo, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_NodeInfo(st, ar, en, kh))

def post_NodeInfo(+st: HSt, +ar: AR_NodeInfo, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_NodeInfo(st, ar, en, kh))

def logs_NodeInfo(+st: HSt, +ar: AR_NodeInfo, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_NodeInfo(st, ar, en, kh))

def step_NodeInfo(+st: HSt, +ar: AR_NodeInfo, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_NodeInfo(st, ar, en, kh), st)

type X_PeerCount is Data:
  X_PeerCount{st: HSt, ov: HSt, ar: AR_PeerCount, en: HEnv, kh: List<&2, HKB>, cd: U32, rv: List<&2, U32>, lg: List<&2, HLog>, tw: List<&2, SK>}

def gx_PeerCount_st(e: X_PeerCount) -> HSt:
  match e:
    case X_PeerCount{st, ov, ar, en, kh, cd, rv, lg, tw}:
      st

def gx_PeerCount_ov(e: X_PeerCount) -> HSt:
  match e:
    case X_PeerCount{st, ov, ar, en, kh, cd, rv, lg, tw}:
      ov

