# an action with its arguments and its environment (A-env: free per step)
type HAct is Data:
  A_AddPeer{ar: AR_AddPeer, en: HEnv}
  A_AddTrustedPeer{ar: AR_AddTrustedPeer, en: HEnv}
  A_LocalNode{ar: AR_LocalNode, en: HEnv}
  A_NodeInfo{ar: AR_NodeInfo, en: HEnv}
  A_PeerCount{ar: AR_PeerCount, en: HEnv}
  A_Peers{ar: AR_Peers, en: HEnv}
  A_PeersInfo{ar: AR_PeersInfo, en: HEnv}
  A_RemovePeer{ar: AR_RemovePeer, en: HEnv}
  A_RemoveTrustedPeer{ar: AR_RemoveTrustedPeer, en: HEnv}
  A_Self{ar: AR_Self, en: HEnv}
  A_SetupConn{ar: AR_SetupConn, en: HEnv}
  A_Start{ar: AR_Start, en: HEnv}
  A_Stop{ar: AR_Stop, en: HEnv}
  A_SubscribeEvents{ar: AR_SubscribeEvents, en: HEnv}

def step(a: HAct, +s: HSt, +kh: List<&2, HKB>) -> HSt:
  match a:
    case A_AddPeer{ar, en}:
      step_AddPeer(s, ar, en, kh)
    case A_AddTrustedPeer{ar, en}:
      step_AddTrustedPeer(s, ar, en, kh)
    case A_LocalNode{ar, en}:
      step_LocalNode(s, ar, en, kh)
    case A_NodeInfo{ar, en}:
      step_NodeInfo(s, ar, en, kh)
    case A_PeerCount{ar, en}:
      step_PeerCount(s, ar, en, kh)
    case A_Peers{ar, en}:
      step_Peers(s, ar, en, kh)
    case A_PeersInfo{ar, en}:
      step_PeersInfo(s, ar, en, kh)
    case A_RemovePeer{ar, en}:
      step_RemovePeer(s, ar, en, kh)
    case A_RemoveTrustedPeer{ar, en}:
      step_RemoveTrustedPeer(s, ar, en, kh)
    case A_Self{ar, en}:
      step_Self(s, ar, en, kh)
    case A_SetupConn{ar, en}:
      step_SetupConn(s, ar, en, kh)
    case A_Start{ar, en}:
      step_Start(s, ar, en, kh)
    case A_Stop{ar, en}:
      step_Stop(s, ar, en, kh)
    case A_SubscribeEvents{ar, en}:
      step_SubscribeEvents(s, ar, en, kh)

# the initial state: the target's storage after the deployment of the binding (zero without one)
def s0() -> HSt:
  HSt{Nil{}}

# ---- ghost: SORT coercions (holon.rules.sort)

type Tag is Data:
  TG_bot{}

def tg_eq(a: Tag, b: Tag) -> Bool:
  match a b:
    case TG_bot{} TG_bot{}:
      True{}

type GKT is Data:
  GKT{k: W, t: Tag}

def gk_get(xs: List<&2, GKT>, +k: W) -> Tag:
  match xs:
    case Nil{}:
      TG_bot{}
    case Con{h, t}:
      match h:
        case GKT{hk, ht}:
          ite(Tag, w_eq(hk, k), ht, gk_get(t, k))

def gk_put(xs: List<&2, GKT>, +k: W, +v: Tag, +done: Bool) -> List<&2, GKT>:
  match xs:
    case Nil{}:
      ite(List<&2, GKT>, done, Nil{}, [GKT{k, v}])
    case Con{h, t}:
      match h:
        case GKT{+hk, ht}:
          +eq = w_eq(hk, k)
          Con{GKT{hk, ite(Tag, Bool.and(eq, Bool.not(done)), v, ht)}, gk_put(t, k, v, Bool.or(done, eq))}

def gk_set(xs: List<&2, GKT>, +k: W, +v: Tag) -> List<&2, GKT>:
  gk_put(xs, k, v, False{})

# the augmented state: the real store and the generated companion of every union register (G1)
type GSt is Data:
  GSt{st: HSt}

def gh_get_st(e: GSt) -> HSt:
  match e:
    case GSt{st}:
      st

def gh_set_st(e: GSt, +v: HSt) -> GSt:
  match e:
    case GSt{_}:
      GSt{v}

def gh_s0() -> GSt:
  GSt{s0()}

def gh_eff_AddPeer(x: X_AddPeer, +g: GSt) -> GSt:
  g

def gh_ok_AddPeer(c: Bool, x: X_AddPeer, +g: GSt) -> GSt:
  match c:
    case True{}:
      g
    case False{}:
      match x:
        case X_AddPeer{x_st, +x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
          gh_eff_AddPeer(X_AddPeer{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, gh_set_st(g, x_ov))

def gh_go_AddPeer(x: X_AddPeer, +g: GSt) -> GSt:
