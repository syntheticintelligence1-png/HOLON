# one step of any action from an augmented state: the real step and its ghost effects
def gh_step(a: HAct, +g: GSt, +kh: List<&2, HKB>) -> GSt:
  match a:
    case A_AddPeer{ar, en}:
      gh_go_AddPeer(xr_AddPeer(gh_get_st(g), ar, en, kh), g)
    case A_AddTrustedPeer{ar, en}:
      gh_go_AddTrustedPeer(xr_AddTrustedPeer(gh_get_st(g), ar, en, kh), g)
    case A_LocalNode{ar, en}:
      gh_go_LocalNode(xr_LocalNode(gh_get_st(g), ar, en, kh), g)
    case A_NodeInfo{ar, en}:
      gh_go_NodeInfo(xr_NodeInfo(gh_get_st(g), ar, en, kh), g)
    case A_PeerCount{ar, en}:
      gh_go_PeerCount(xr_PeerCount(gh_get_st(g), ar, en, kh), g)
    case A_Peers{ar, en}:
      gh_go_Peers(xr_Peers(gh_get_st(g), ar, en, kh), g)
    case A_PeersInfo{ar, en}:
      gh_go_PeersInfo(xr_PeersInfo(gh_get_st(g), ar, en, kh), g)
    case A_RemovePeer{ar, en}:
      gh_go_RemovePeer(xr_RemovePeer(gh_get_st(g), ar, en, kh), g)
    case A_RemoveTrustedPeer{ar, en}:
      gh_go_RemoveTrustedPeer(xr_RemoveTrustedPeer(gh_get_st(g), ar, en, kh), g)
    case A_Self{ar, en}:
      gh_go_Self(xr_Self(gh_get_st(g), ar, en, kh), g)
    case A_SetupConn{ar, en}:
      gh_go_SetupConn(xr_SetupConn(gh_get_st(g), ar, en, kh), g)
    case A_Start{ar, en}:
      gh_go_Start(xr_Start(gh_get_st(g), ar, en, kh), g)
    case A_Stop{ar, en}:
      gh_go_Stop(xr_Stop(gh_get_st(g), ar, en, kh), g)
    case A_SubscribeEvents{ar, en}:
      gh_go_SubscribeEvents(xr_SubscribeEvents(gh_get_st(g), ar, en, kh), g)

# the reachable augmented states: the deployment (R0) and one step of any action (RStep)
type Reach<-kh: List<&2, HKB>, -s: GSt> is Type:
  R0{e: {s == gh_s0() : GSt}}
  RStep{a: HAct, p: GSt, r: Reach<kh, p>, e: {s == gh_step(a, p, kh) : GSt}}

def run(tr: List<&2, HAct>, g: GSt, +kh: List<&2, HKB>) -> GSt:
  match tr:
    case Nil{}:
      g
    case Con{a, rest}:
      run(rest, gh_step(a, g, kh), kh)

def rz_reached(+c: U32, +k: U32) -> Bool:
  Bool.or(U32.is_eq(c, 0), Bool.and(U32.is_ge(c, k), U32.is_lt(c, 4026531840)))
