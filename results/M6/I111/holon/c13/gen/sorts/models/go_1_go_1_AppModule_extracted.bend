# an action with its arguments and its environment (A-env: free per step)
type HAct is Data:
  A_BeginBlock{ar: AR_BeginBlock, en: HEnv}
  A_ConsensusVersion{ar: AR_ConsensusVersion, en: HEnv}
  A_EndBlock{ar: AR_EndBlock, en: HEnv}
  A_ExportGenesis{ar: AR_ExportGenesis, en: HEnv}
  A_GenerateGenesisState{ar: AR_GenerateGenesisState, en: HEnv}
  A_InitGenesis{ar: AR_InitGenesis, en: HEnv}
  A_RegisterInvariants{ar: AR_RegisterInvariants, en: HEnv}
  A_RegisterServices{ar: AR_RegisterServices, en: HEnv}
  A_RegisterStoreDecoder{ar: AR_RegisterStoreDecoder, en: HEnv}
  A_WeightedOperations{ar: AR_WeightedOperations, en: HEnv}

def step(a: HAct, +s: HSt, +kh: List<&2, HKB>) -> HSt:
  match a:
    case A_BeginBlock{ar, en}:
      step_BeginBlock(s, ar, en, kh)
    case A_ConsensusVersion{ar, en}:
      step_ConsensusVersion(s, ar, en, kh)
    case A_EndBlock{ar, en}:
      step_EndBlock(s, ar, en, kh)
    case A_ExportGenesis{ar, en}:
      step_ExportGenesis(s, ar, en, kh)
    case A_GenerateGenesisState{ar, en}:
      step_GenerateGenesisState(s, ar, en, kh)
    case A_InitGenesis{ar, en}:
      step_InitGenesis(s, ar, en, kh)
    case A_RegisterInvariants{ar, en}:
      step_RegisterInvariants(s, ar, en, kh)
    case A_RegisterServices{ar, en}:
      step_RegisterServices(s, ar, en, kh)
    case A_RegisterStoreDecoder{ar, en}:
      step_RegisterStoreDecoder(s, ar, en, kh)
    case A_WeightedOperations{ar, en}:
      step_WeightedOperations(s, ar, en, kh)

# the initial state: the target's storage after the deployment of the binding (zero without one)
def s0() -> HSt:
  HSt{Nil{}}

# ---- ghost: SORT coercions (holon.rules.sort)

type Tag is Data:
  TG_bot{}

def tg_eq(a: Tag, b: Tag) -> Bool:
  match a b:
    case TG_bot{} TG_bot{}:
      True{}

type GKT is Data:
  GKT{k: W, t: Tag}

def gk_get(xs: List<&2, GKT>, +k: W) -> Tag:
  match xs:
    case Nil{}:
      TG_bot{}
    case Con{h, t}:
      match h:
        case GKT{hk, ht}:
          ite(Tag, w_eq(hk, k), ht, gk_get(t, k))

def gk_put(xs: List<&2, GKT>, +k: W, +v: Tag, +done: Bool) -> List<&2, GKT>:
  match xs:
    case Nil{}:
      ite(List<&2, GKT>, done, Nil{}, [GKT{k, v}])
    case Con{h, t}:
      match h:
        case GKT{+hk, ht}:
          +eq = w_eq(hk, k)
          Con{GKT{hk, ite(Tag, Bool.and(eq, Bool.not(done)), v, ht)}, gk_put(t, k, v, Bool.or(done, eq))}

def gk_set(xs: List<&2, GKT>, +k: W, +v: Tag) -> List<&2, GKT>:
  gk_put(xs, k, v, False{})

# the augmented state: the real store and the generated companion of every union register (G1)
type GSt is Data:
  GSt{st: HSt}

def gh_get_st(e: GSt) -> HSt:
  match e:
    case GSt{st}:
      st

def gh_set_st(e: GSt, +v: HSt) -> GSt:
  match e:
    case GSt{_}:
      GSt{v}

def gh_s0() -> GSt:
  GSt{s0()}

def gh_eff_BeginBlock(x: X_BeginBlock, +g: GSt) -> GSt:
  g

def gh_ok_BeginBlock(c: Bool, x: X_BeginBlock, +g: GSt) -> GSt:
  match c:
    case True{}:
      g
    case False{}:
      match x:
        case X_BeginBlock{x_st, +x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
          gh_eff_BeginBlock(X_BeginBlock{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, gh_set_st(g, x_ov))

def gh_go_BeginBlock(x: X_BeginBlock, +g: GSt) -> GSt:
  match x:
    case X_BeginBlock{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_BeginBlock(u_nz(x_cd), X_BeginBlock{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

