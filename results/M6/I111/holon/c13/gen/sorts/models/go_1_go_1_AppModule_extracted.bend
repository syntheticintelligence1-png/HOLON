  HLog{t: List<&2, W>, d: List<&2, U32>}

type HOut is Data:
  HOut{c: U32, rv: List<&2, U32>, po: HSt, lg: List<&2, HLog>, tw: List<&2, SK>}

def o_code(o: HOut) -> U32:
  match o:
    case HOut{c, rv, po, lg, tw}:
      c

def o_post(o: HOut) -> HSt:
  match o:
    case HOut{c, rv, po, lg, tw}:
      po

def o_logs(o: HOut) -> List<&2, HLog>:
  match o:
    case HOut{c, rv, po, lg, tw}:
      lg

def w_nth(xs: List<&2, W>, n: Nat) -> W:
  match xs n:
    case Nil{} _:
      w0()
    case Con{h, t} 0n:
      h
    case Con{h, t} 1n+p:
      w_nth(t, p)

def w_len(xs: List<&2, W>) -> U32:
  match xs:
    case Nil{}:
      0
    case Con{h, t}:
      U32.inc(w_len(t))

type KB is Data:
  KB{k: W, b: List<&2, U32>}

def kb_get(xs: List<&2, KB>, +k: W) -> List<&2, U32>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      match h:
        case KB{hk, hb}:
          ite(List<&2, U32>, w_eq(hk, k), hb, kb_get(t, k))

def lg_rev(xs: List<&2, HLog>, +acc: List<&2, HLog>) -> List<&2, HLog>:
  match xs:
    case Nil{}:
      acc
    case Con{h, t}:
      lg_rev(t, Con{h, acc})

def hs_get(xs: List<&2, HKB>, +k: List<&2, U32>) -> W:
  h_get(xs, k)

def kt_id(+xs: List<&2, HKB>) -> List<&2, HKB>:
  xs

def st_after(+o: HOut, +st: HSt) -> HSt:
  ite(HSt, u_nz(o_code(o)), st, o_post(o))

def b_zeros(n: Nat) -> List<&2, U32>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      Con{0, b_zeros(p)}

def abi_dyn(+bs: List<&2, U32>) -> List<&2, U32>:
  List.append(&2, U32, b_of_u(b_len(bs)), List.append(&2, U32, bs, b_zeros(U32.to_nat(U32.and(U32.sub(32, U32.and(b_len(bs), 31)), 31)))))

def abi_words(xs: List<&2, W>) -> List<&2, U32>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      List.append(&2, U32, b_of_w(h), abi_words(t))

def abi_wlist(+xs: List<&2, W>) -> List<&2, U32>:
  List.append(&2, U32, b_of_u(w_len(xs)), abi_words(xs))

def eq_bool(a: Bool, b: Bool) -> Bool:
  match a b:
    case True{} True{}:
      True{}
    case False{} False{}:
      True{}
    case True{} False{}:
      False{}
    case False{} True{}:
      False{}

def is_true(b: Bool) -> Type:
  match b:
    case True{}:
      Unit
    case False{}:
      Empty

