def x0_BeginBlock(+st: HSt, +ar: AR_BeginBlock, +en: HEnv, +kh: List<&2, HKB>) -> X_BeginBlock:
  X_BeginBlock{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_BeginBlock(+st: HSt, +ar: AR_BeginBlock, +en: HEnv, +kh: List<&2, HKB>) -> X_BeginBlock:
  sz_BeginBlock(x0_BeginBlock(st, ar, en, kh))

def xo_BeginBlock(x: X_BeginBlock) -> HOut:
  match x:
    case X_BeginBlock{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_BeginBlock(+st: HSt, +ar: AR_BeginBlock, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_BeginBlock(xr_BeginBlock(st, ar, en, kh))

# 0 when every check of BeginBlock holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_BeginBlock(+st: HSt, +ar: AR_BeginBlock, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_BeginBlock(st, ar, en, kh))

def post_BeginBlock(+st: HSt, +ar: AR_BeginBlock, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_BeginBlock(st, ar, en, kh))

def logs_BeginBlock(+st: HSt, +ar: AR_BeginBlock, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_BeginBlock(st, ar, en, kh))

def step_BeginBlock(+st: HSt, +ar: AR_BeginBlock, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_BeginBlock(st, ar, en, kh), st)

