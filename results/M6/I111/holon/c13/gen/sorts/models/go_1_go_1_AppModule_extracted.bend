# one step of any action from an augmented state: the real step and its ghost effects
def gh_step(a: HAct, +g: GSt, +kh: List<&2, HKB>) -> GSt:
  match a:
    case A_BeginBlock{ar, en}:
      gh_go_BeginBlock(xr_BeginBlock(gh_get_st(g), ar, en, kh), g)
    case A_ConsensusVersion{ar, en}:
      gh_go_ConsensusVersion(xr_ConsensusVersion(gh_get_st(g), ar, en, kh), g)
    case A_EndBlock{ar, en}:
      gh_go_EndBlock(xr_EndBlock(gh_get_st(g), ar, en, kh), g)
    case A_ExportGenesis{ar, en}:
      gh_go_ExportGenesis(xr_ExportGenesis(gh_get_st(g), ar, en, kh), g)
    case A_GenerateGenesisState{ar, en}:
      gh_go_GenerateGenesisState(xr_GenerateGenesisState(gh_get_st(g), ar, en, kh), g)
    case A_InitGenesis{ar, en}:
      gh_go_InitGenesis(xr_InitGenesis(gh_get_st(g), ar, en, kh), g)
    case A_RegisterInvariants{ar, en}:
      gh_go_RegisterInvariants(xr_RegisterInvariants(gh_get_st(g), ar, en, kh), g)
    case A_RegisterServices{ar, en}:
      gh_go_RegisterServices(xr_RegisterServices(gh_get_st(g), ar, en, kh), g)
    case A_RegisterStoreDecoder{ar, en}:
      gh_go_RegisterStoreDecoder(xr_RegisterStoreDecoder(gh_get_st(g), ar, en, kh), g)
    case A_WeightedOperations{ar, en}:
      gh_go_WeightedOperations(xr_WeightedOperations(gh_get_st(g), ar, en, kh), g)

# the reachable augmented states: the deployment (R0) and one step of any action (RStep)
type Reach<-kh: List<&2, HKB>, -s: GSt> is Type:
  R0{e: {s == gh_s0() : GSt}}
  RStep{a: HAct, p: GSt, r: Reach<kh, p>, e: {s == gh_step(a, p, kh) : GSt}}

def run(tr: List<&2, HAct>, g: GSt, +kh: List<&2, HKB>) -> GSt:
  match tr:
    case Nil{}:
      g
    case Con{a, rest}:
      run(rest, gh_step(a, g, kh), kh)

def rz_reached(+c: U32, +k: U32) -> Bool:
  Bool.or(U32.is_eq(c, 0), Bool.and(U32.is_ge(c, k), U32.is_lt(c, 4026531840)))
