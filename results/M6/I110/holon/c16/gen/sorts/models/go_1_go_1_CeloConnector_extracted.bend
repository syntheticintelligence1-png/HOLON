# one step of any action from an augmented state: the real step and its ghost effects
def gh_step(a: HAct, +g: GSt, +kh: List<&2, HKB>) -> GSt:
  match a:
    case A_ContractAddress{ar, en}:
      gh_go_ContractAddress(xr_ContractAddress(gh_get_st(g), ar, en, kh), g)
    case A_GetCurrentGuardianSetIndex{ar, en}:
      gh_go_GetCurrentGuardianSetIndex(xr_GetCurrentGuardianSetIndex(gh_get_st(g), ar, en, kh), g)
    case A_GetGuardianSet{ar, en}:
      gh_go_GetGuardianSet(xr_GetGuardianSet(gh_get_st(g), ar, en, kh), g)
    case A_NetworkName{ar, en}:
      gh_go_NetworkName(xr_NetworkName(gh_get_st(g), ar, en, kh), g)
    case A_ParseLogMessagePublished{ar, en}:
      gh_go_ParseLogMessagePublished(xr_ParseLogMessagePublished(gh_get_st(g), ar, en, kh), g)
    case A_RawCallContext{ar, en}:
      gh_go_RawCallContext(xr_RawCallContext(gh_get_st(g), ar, en, kh), g)
    case A_SubscribeForBlocks{ar, en}:
      gh_go_SubscribeForBlocks(xr_SubscribeForBlocks(gh_get_st(g), ar, en, kh), g)
    case A_TimeOfBlockByHash{ar, en}:
      gh_go_TimeOfBlockByHash(xr_TimeOfBlockByHash(gh_get_st(g), ar, en, kh), g)
    case A_TransactionReceipt{ar, en}:
      gh_go_TransactionReceipt(xr_TransactionReceipt(gh_get_st(g), ar, en, kh), g)
    case A_WatchLogMessagePublished{ar, en}:
      gh_go_WatchLogMessagePublished(xr_WatchLogMessagePublished(gh_get_st(g), ar, en, kh), g)

# the reachable augmented states: the deployment (R0) and one step of any action (RStep)
type Reach<-kh: List<&2, HKB>, -s: GSt> is Type:
  R0{e: {s == gh_s0() : GSt}}
  RStep{a: HAct, p: GSt, r: Reach<kh, p>, e: {s == gh_step(a, p, kh) : GSt}}

def run(tr: List<&2, HAct>, g: GSt, +kh: List<&2, HKB>) -> GSt:
  match tr:
    case Nil{}:
      g
    case Con{a, rest}:
      run(rest, gh_step(a, g, kh), kh)

def rz_reached(+c: U32, +k: U32) -> Bool:
  Bool.or(U32.is_eq(c, 0), Bool.and(U32.is_ge(c, k), U32.is_lt(c, 4026531840)))
