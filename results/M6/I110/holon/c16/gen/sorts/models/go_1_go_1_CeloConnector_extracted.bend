  match x:
    case X_ParseLogMessagePublished{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_ParseLogMessagePublished(u_nz(x_cd), X_ParseLogMessagePublished{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

