def step(a: HAct, +s: HSt, +kh: List<&2, HKB>) -> HSt:
  match a:
    case A_ContractAddress{ar, en}:
      step_ContractAddress(s, ar, en, kh)
    case A_GetCurrentGuardianSetIndex{ar, en}:
      step_GetCurrentGuardianSetIndex(s, ar, en, kh)
    case A_GetGuardianSet{ar, en}:
      step_GetGuardianSet(s, ar, en, kh)
    case A_NetworkName{ar, en}:
      step_NetworkName(s, ar, en, kh)
    case A_ParseLogMessagePublished{ar, en}:
      step_ParseLogMessagePublished(s, ar, en, kh)
    case A_RawCallContext{ar, en}:
      step_RawCallContext(s, ar, en, kh)
    case A_SubscribeForBlocks{ar, en}:
      step_SubscribeForBlocks(s, ar, en, kh)
    case A_TimeOfBlockByHash{ar, en}:
      step_TimeOfBlockByHash(s, ar, en, kh)
    case A_TransactionReceipt{ar, en}:
      step_TransactionReceipt(s, ar, en, kh)
    case A_WatchLogMessagePublished{ar, en}:
      step_WatchLogMessagePublished(s, ar, en, kh)

# the initial state: the target's storage after the deployment of the binding (zero without one)
def s0() -> HSt:
  HSt{Nil{}}

# ---- ghost: SORT coercions (holon.rules.sort)

type Tag is Data:
  TG_bot{}

def tg_eq(a: Tag, b: Tag) -> Bool:
  match a b:
    case TG_bot{} TG_bot{}:
      True{}

type GKT is Data:
  GKT{k: W, t: Tag}

def gk_get(xs: List<&2, GKT>, +k: W) -> Tag:
  match xs:
    case Nil{}:
      TG_bot{}
    case Con{h, t}:
      match h:
        case GKT{hk, ht}:
          ite(Tag, w_eq(hk, k), ht, gk_get(t, k))

def gk_put(xs: List<&2, GKT>, +k: W, +v: Tag, +done: Bool) -> List<&2, GKT>:
  match xs:
    case Nil{}:
      ite(List<&2, GKT>, done, Nil{}, [GKT{k, v}])
    case Con{h, t}:
      match h:
        case GKT{+hk, ht}:
          +eq = w_eq(hk, k)
          Con{GKT{hk, ite(Tag, Bool.and(eq, Bool.not(done)), v, ht)}, gk_put(t, k, v, Bool.or(done, eq))}

def gk_set(xs: List<&2, GKT>, +k: W, +v: Tag) -> List<&2, GKT>:
  gk_put(xs, k, v, False{})

