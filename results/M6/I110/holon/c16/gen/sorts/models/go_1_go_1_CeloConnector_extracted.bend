# an action with its arguments and its environment (A-env: free per step)
type HAct is Data:
  A_ContractAddress{ar: AR_ContractAddress, en: HEnv}
  A_GetCurrentGuardianSetIndex{ar: AR_GetCurrentGuardianSetIndex, en: HEnv}
  A_GetGuardianSet{ar: AR_GetGuardianSet, en: HEnv}
