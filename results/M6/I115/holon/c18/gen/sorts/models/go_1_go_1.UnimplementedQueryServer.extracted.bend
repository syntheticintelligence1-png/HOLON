# one step of any action from an augmented state: the real step and its ghost effects
def gh_step(a: HAct, +g: GSt, +kh: List<&2, HKB>) -> GSt:
  match a:
    case A_GroupInfo{ar, en}:
      gh_go_GroupInfo(xr_GroupInfo(gh_get_st(g), ar, en, kh), g)
    case A_GroupMembers{ar, en}:
      gh_go_GroupMembers(xr_GroupMembers(gh_get_st(g), ar, en, kh), g)
    case A_GroupPoliciesByAdmin{ar, en}:
      gh_go_GroupPoliciesByAdmin(xr_GroupPoliciesByAdmin(gh_get_st(g), ar, en, kh), g)
    case A_GroupPoliciesByGroup{ar, en}:
      gh_go_GroupPoliciesByGroup(xr_GroupPoliciesByGroup(gh_get_st(g), ar, en, kh), g)
    case A_GroupPolicyInfo{ar, en}:
      gh_go_GroupPolicyInfo(xr_GroupPolicyInfo(gh_get_st(g), ar, en, kh), g)
    case A_Groups{ar, en}:
      gh_go_Groups(xr_Groups(gh_get_st(g), ar, en, kh), g)
    case A_GroupsByAdmin{ar, en}:
      gh_go_GroupsByAdmin(xr_GroupsByAdmin(gh_get_st(g), ar, en, kh), g)
    case A_GroupsByMember{ar, en}:
      gh_go_GroupsByMember(xr_GroupsByMember(gh_get_st(g), ar, en, kh), g)
    case A_Proposal{ar, en}:
      gh_go_Proposal(xr_Proposal(gh_get_st(g), ar, en, kh), g)
    case A_ProposalsByGroupPolicy{ar, en}:
      gh_go_ProposalsByGroupPolicy(xr_ProposalsByGroupPolicy(gh_get_st(g), ar, en, kh), g)
    case A_TallyResult{ar, en}:
      gh_go_TallyResult(xr_TallyResult(gh_get_st(g), ar, en, kh), g)
    case A_VoteByProposalVoter{ar, en}:
      gh_go_VoteByProposalVoter(xr_VoteByProposalVoter(gh_get_st(g), ar, en, kh), g)
    case A_VotesByProposal{ar, en}:
      gh_go_VotesByProposal(xr_VotesByProposal(gh_get_st(g), ar, en, kh), g)
    case A_VotesByVoter{ar, en}:
      gh_go_VotesByVoter(xr_VotesByVoter(gh_get_st(g), ar, en, kh), g)

# the reachable augmented states: the deployment (R0) and one step of any action (RStep)
type Reach<-kh: List<&2, HKB>, -s: GSt> is Type:
  R0{e: {s == gh_s0() : GSt}}
  RStep{a: HAct, p: GSt, r: Reach<kh, p>, e: {s == gh_step(a, p, kh) : GSt}}

def run(tr: List<&2, HAct>, g: GSt, +kh: List<&2, HKB>) -> GSt:
  match tr:
    case Nil{}:
      g
    case Con{a, rest}:
      run(rest, gh_step(a, g, kh), kh)

def rz_reached(+c: U32, +k: U32) -> Bool:
  Bool.or(U32.is_eq(c, 0), Bool.and(U32.is_ge(c, k), U32.is_lt(c, 4026531840)))
