      X_TruncateTail{st, ov, ar, en, kh, cd, rv, lg, v}

def xf_TruncateTail(x: X_TruncateTail, +c: U32, +r: List<&2, U32>) -> X_TruncateTail:
  sx_TruncateTail_cd(sx_TruncateTail_rv(x, r), c)

def sz_TruncateTail(x: X_TruncateTail) -> X_TruncateTail:
  x

# TruncateTail#core/rawdb/database.go:126#0
def k_TruncateTail_1(c: Bool, x: X_TruncateTail) -> X_TruncateTail:
  match c:
    case True{}:
      sz_TruncateTail(x)
    case False{}:
      xf_TruncateTail(x, 1, Nil{})

# check core/rawdb/database.go:126
def s_TruncateTail_1(x: X_TruncateTail) -> X_TruncateTail:
  k_TruncateTail_1(False{}, x)

def x0_TruncateTail(+st: HSt, +ar: AR_TruncateTail, +en: HEnv, +kh: List<&2, HKB>) -> X_TruncateTail:
  X_TruncateTail{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_TruncateTail(+st: HSt, +ar: AR_TruncateTail, +en: HEnv, +kh: List<&2, HKB>) -> X_TruncateTail:
  s_TruncateTail_1(x0_TruncateTail(st, ar, en, kh))

def xo_TruncateTail(x: X_TruncateTail) -> HOut:
  match x:
    case X_TruncateTail{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_TruncateTail(+st: HSt, +ar: AR_TruncateTail, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_TruncateTail(xr_TruncateTail(st, ar, en, kh))

# 0 when every check of TruncateTail holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_TruncateTail(+st: HSt, +ar: AR_TruncateTail, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_TruncateTail(st, ar, en, kh))

def post_TruncateTail(+st: HSt, +ar: AR_TruncateTail, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_TruncateTail(st, ar, en, kh))

def logs_TruncateTail(+st: HSt, +ar: AR_TruncateTail, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_TruncateTail(st, ar, en, kh))

def step_TruncateTail(+st: HSt, +ar: AR_TruncateTail, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_TruncateTail(st, ar, en, kh), st)

# an action with its arguments and its environment (A-env: free per step)
type HAct is Data:
  A_Ancient{ar: AR_Ancient, en: HEnv}
  A_AncientDatadir{ar: AR_AncientDatadir, en: HEnv}
  A_AncientRange{ar: AR_AncientRange, en: HEnv}
  A_AncientSize{ar: AR_AncientSize, en: HEnv}
  A_Ancients{ar: AR_Ancients, en: HEnv}
  A_HasAncient{ar: AR_HasAncient, en: HEnv}
  A_MigrateTable{ar: AR_MigrateTable, en: HEnv}
  A_ModifyAncients{ar: AR_ModifyAncients, en: HEnv}
  A_ReadAncients{ar: AR_ReadAncients, en: HEnv}
  A_Sync{ar: AR_Sync, en: HEnv}
  A_Tail{ar: AR_Tail, en: HEnv}
  A_TruncateHead{ar: AR_TruncateHead, en: HEnv}
  A_TruncateTail{ar: AR_TruncateTail, en: HEnv}

def step(a: HAct, +s: HSt, +kh: List<&2, HKB>) -> HSt:
  match a:
    case A_Ancient{ar, en}:
      step_Ancient(s, ar, en, kh)
    case A_AncientDatadir{ar, en}:
      step_AncientDatadir(s, ar, en, kh)
    case A_AncientRange{ar, en}:
      step_AncientRange(s, ar, en, kh)
    case A_AncientSize{ar, en}:
      step_AncientSize(s, ar, en, kh)
    case A_Ancients{ar, en}:
      step_Ancients(s, ar, en, kh)
    case A_HasAncient{ar, en}:
      step_HasAncient(s, ar, en, kh)
    case A_MigrateTable{ar, en}:
      step_MigrateTable(s, ar, en, kh)
    case A_ModifyAncients{ar, en}:
      step_ModifyAncients(s, ar, en, kh)
    case A_ReadAncients{ar, en}:
      step_ReadAncients(s, ar, en, kh)
    case A_Sync{ar, en}:
      step_Sync(s, ar, en, kh)
    case A_Tail{ar, en}:
      step_Tail(s, ar, en, kh)
    case A_TruncateHead{ar, en}:
      step_TruncateHead(s, ar, en, kh)
    case A_TruncateTail{ar, en}:
      step_TruncateTail(s, ar, en, kh)

# the initial state: the target's storage after the deployment of the binding (zero without one)
def s0() -> HSt:
  HSt{Nil{}}

# ---- ghost: SORT coercions (holon.rules.sort)

type Tag is Data:
  TG_bot{}

def tg_eq(a: Tag, b: Tag) -> Bool:
  match a b:
    case TG_bot{} TG_bot{}:
      True{}

type GKT is Data:
  GKT{k: W, t: Tag}

def gk_get(xs: List<&2, GKT>, +k: W) -> Tag:
  match xs:
    case Nil{}:
      TG_bot{}
    case Con{h, t}:
      match h:
        case GKT{hk, ht}:
          ite(Tag, w_eq(hk, k), ht, gk_get(t, k))

def gk_put(xs: List<&2, GKT>, +k: W, +v: Tag, +done: Bool) -> List<&2, GKT>:
  match xs:
    case Nil{}:
      ite(List<&2, GKT>, done, Nil{}, [GKT{k, v}])
    case Con{h, t}:
      match h:
        case GKT{+hk, ht}:
          +eq = w_eq(hk, k)
          Con{GKT{hk, ite(Tag, Bool.and(eq, Bool.not(done)), v, ht)}, gk_put(t, k, v, Bool.or(done, eq))}

def gk_set(xs: List<&2, GKT>, +k: W, +v: Tag) -> List<&2, GKT>:
  gk_put(xs, k, v, False{})

# the augmented state: the real store and the generated companion of every union register (G1)
type GSt is Data:
  GSt{st: HSt}

def gh_get_st(e: GSt) -> HSt:
  match e:
    case GSt{st}:
      st

def gh_set_st(e: GSt, +v: HSt) -> GSt:
  match e:
    case GSt{_}:
      GSt{v}

def gh_s0() -> GSt:
  GSt{s0()}

def gh_eff_Ancient(x: X_Ancient, +g: GSt) -> GSt:
  g

def gh_ok_Ancient(c: Bool, x: X_Ancient, +g: GSt) -> GSt:
  match c:
    case True{}:
      g
    case False{}:
      match x:
        case X_Ancient{x_st, +x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
          gh_eff_Ancient(X_Ancient{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, gh_set_st(g, x_ov))

def gh_go_Ancient(x: X_Ancient, +g: GSt) -> GSt:
  match x:
    case X_Ancient{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_Ancient(u_nz(x_cd), X_Ancient{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

