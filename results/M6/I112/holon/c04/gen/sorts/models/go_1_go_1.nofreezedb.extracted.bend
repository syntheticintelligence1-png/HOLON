  match x:
    case X_TruncateHead{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_TruncateHead(u_nz(x_cd), X_TruncateHead{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

def gh_eff_TruncateTail(x: X_TruncateTail, +g: GSt) -> GSt:
  g

def gh_ok_TruncateTail(c: Bool, x: X_TruncateTail, +g: GSt) -> GSt:
  match c:
    case True{}:
      g
    case False{}:
      match x:
        case X_TruncateTail{x_st, +x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
          gh_eff_TruncateTail(X_TruncateTail{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, gh_set_st(g, x_ov))

def gh_go_TruncateTail(x: X_TruncateTail, +g: GSt) -> GSt:
  match x:
    case X_TruncateTail{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_TruncateTail(u_nz(x_cd), X_TruncateTail{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

# one step of any action from an augmented state: the real step and its ghost effects
def gh_step(a: HAct, +g: GSt, +kh: List<&2, HKB>) -> GSt:
  match a:
    case A_Ancient{ar, en}:
      gh_go_Ancient(xr_Ancient(gh_get_st(g), ar, en, kh), g)
    case A_AncientDatadir{ar, en}:
      gh_go_AncientDatadir(xr_AncientDatadir(gh_get_st(g), ar, en, kh), g)
    case A_AncientRange{ar, en}:
      gh_go_AncientRange(xr_AncientRange(gh_get_st(g), ar, en, kh), g)
    case A_AncientSize{ar, en}:
      gh_go_AncientSize(xr_AncientSize(gh_get_st(g), ar, en, kh), g)
    case A_Ancients{ar, en}:
      gh_go_Ancients(xr_Ancients(gh_get_st(g), ar, en, kh), g)
    case A_HasAncient{ar, en}:
      gh_go_HasAncient(xr_HasAncient(gh_get_st(g), ar, en, kh), g)
    case A_MigrateTable{ar, en}:
      gh_go_MigrateTable(xr_MigrateTable(gh_get_st(g), ar, en, kh), g)
    case A_ModifyAncients{ar, en}:
      gh_go_ModifyAncients(xr_ModifyAncients(gh_get_st(g), ar, en, kh), g)
    case A_ReadAncients{ar, en}:
      gh_go_ReadAncients(xr_ReadAncients(gh_get_st(g), ar, en, kh), g)
    case A_Sync{ar, en}:
      gh_go_Sync(xr_Sync(gh_get_st(g), ar, en, kh), g)
    case A_Tail{ar, en}:
      gh_go_Tail(xr_Tail(gh_get_st(g), ar, en, kh), g)
    case A_TruncateHead{ar, en}:
      gh_go_TruncateHead(xr_TruncateHead(gh_get_st(g), ar, en, kh), g)
    case A_TruncateTail{ar, en}:
      gh_go_TruncateTail(xr_TruncateTail(gh_get_st(g), ar, en, kh), g)

# the reachable augmented states: the deployment (R0) and one step of any action (RStep)
type Reach<-kh: List<&2, HKB>, -s: GSt> is Type:
  R0{e: {s == gh_s0() : GSt}}
  RStep{a: HAct, p: GSt, r: Reach<kh, p>, e: {s == gh_step(a, p, kh) : GSt}}

def run(tr: List<&2, HAct>, g: GSt, +kh: List<&2, HKB>) -> GSt:
  match tr:
    case Nil{}:
      g
    case Con{a, rest}:
      run(rest, gh_step(a, g, kh), kh)

def rz_reached(+c: U32, +k: U32) -> Bool:
  Bool.or(U32.is_eq(c, 0), Bool.and(U32.is_ge(c, k), U32.is_lt(c, 4026531840)))
