  xo_MarshalToSizedBuffer(xr_MarshalToSizedBuffer(st, ar, en, kh))

# 0 when every check of MarshalToSizedBuffer holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_MarshalToSizedBuffer(+st: HSt, +ar: AR_MarshalToSizedBuffer, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_MarshalToSizedBuffer(st, ar, en, kh))

def post_MarshalToSizedBuffer(+st: HSt, +ar: AR_MarshalToSizedBuffer, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
