  match x:
    case X_XXX_Size{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_XXX_Size(u_nz(x_cd), X_XXX_Size{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

def gh_eff_XXX_Unmarshal(x: X_XXX_Unmarshal, +g: GSt) -> GSt:
  g

def gh_ok_XXX_Unmarshal(c: Bool, x: X_XXX_Unmarshal, +g: GSt) -> GSt:
  match c:
    case True{}:
      g
    case False{}:
      match x:
        case X_XXX_Unmarshal{x_st, +x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
          gh_eff_XXX_Unmarshal(X_XXX_Unmarshal{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, gh_set_st(g, x_ov))

def gh_go_XXX_Unmarshal(x: X_XXX_Unmarshal, +g: GSt) -> GSt:
  match x:
    case X_XXX_Unmarshal{x_st, x_ov, x_ar, x_en, x_kh, +x_cd, x_rv, x_lg, x_tw}:
      gh_ok_XXX_Unmarshal(u_nz(x_cd), X_XXX_Unmarshal{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}, g)

# one step of any action from an augmented state: the real step and its ghost effects
def gh_step(a: HAct, +g: GSt, +kh: List<&2, HKB>) -> GSt:
  match a:
    case A_Descriptor{ar, en}:
      gh_go_Descriptor(xr_Descriptor(gh_get_st(g), ar, en, kh), g)
    case A_GetAddress{ar, en}:
      gh_go_GetAddress(xr_GetAddress(gh_get_st(g), ar, en, kh), g)
    case A_GetMetadata{ar, en}:
      gh_go_GetMetadata(xr_GetMetadata(gh_get_st(g), ar, en, kh), g)
    case A_GetWeight{ar, en}:
      gh_go_GetWeight(xr_GetWeight(gh_get_st(g), ar, en, kh), g)
    case A_Marshal{ar, en}:
      gh_go_Marshal(xr_Marshal(gh_get_st(g), ar, en, kh), g)
    case A_MarshalTo{ar, en}:
      gh_go_MarshalTo(xr_MarshalTo(gh_get_st(g), ar, en, kh), g)
    case A_MarshalToSizedBuffer{ar, en}:
      gh_go_MarshalToSizedBuffer(xr_MarshalToSizedBuffer(gh_get_st(g), ar, en, kh), g)
    case A_ProtoMessage{ar, en}:
      gh_go_ProtoMessage(xr_ProtoMessage(gh_get_st(g), ar, en, kh), g)
    case A_Reset{ar, en}:
      gh_go_Reset(xr_Reset(gh_get_st(g), ar, en, kh), g)
    case A_Size{ar, en}:
      gh_go_Size(xr_Size(gh_get_st(g), ar, en, kh), g)
    case A_String{ar, en}:
      gh_go_String(xr_String(gh_get_st(g), ar, en, kh), g)
    case A_Unmarshal{ar, en}:
      gh_go_Unmarshal(xr_Unmarshal(gh_get_st(g), ar, en, kh), g)
    case A_XXX_DiscardUnknown{ar, en}:
      gh_go_XXX_DiscardUnknown(xr_XXX_DiscardUnknown(gh_get_st(g), ar, en, kh), g)
    case A_XXX_Marshal{ar, en}:
      gh_go_XXX_Marshal(xr_XXX_Marshal(gh_get_st(g), ar, en, kh), g)
    case A_XXX_Merge{ar, en}:
      gh_go_XXX_Merge(xr_XXX_Merge(gh_get_st(g), ar, en, kh), g)
    case A_XXX_Size{ar, en}:
      gh_go_XXX_Size(xr_XXX_Size(gh_get_st(g), ar, en, kh), g)
    case A_XXX_Unmarshal{ar, en}:
      gh_go_XXX_Unmarshal(xr_XXX_Unmarshal(gh_get_st(g), ar, en, kh), g)

# the reachable augmented states: the deployment (R0) and one step of any action (RStep)
type Reach<-kh: List<&2, HKB>, -s: GSt> is Type:
  R0{e: {s == gh_s0() : GSt}}
  RStep{a: HAct, p: GSt, r: Reach<kh, p>, e: {s == gh_step(a, p, kh) : GSt}}

def run(tr: List<&2, HAct>, g: GSt, +kh: List<&2, HKB>) -> GSt:
  match tr:
    case Nil{}:
      g
    case Con{a, rest}:
      run(rest, gh_step(a, g, kh), kh)

def rz_reached(+c: U32, +k: U32) -> Bool:
  Bool.or(U32.is_eq(c, 0), Bool.and(U32.is_ge(c, k), U32.is_lt(c, 4026531840)))
