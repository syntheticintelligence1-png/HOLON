      "findings": [
        {
          "id": "f0001",
          "kind": "arithmetic underflow / halt",
          "locations": [
            {
              "file": "contracts/contracts/l1/rollup/Rollup.sol",
              "function": null,
              "lines": [
                360,
                364
              ]
            }
          ],
          "message": "While a challenge is open, proveRemainingTime = proofWindow + startTime - block.timestamp underflows and reverts once the proof window has passed without resolution. From then on every commitBatch, commitState and commitBatchWithProof reverts, stalling the rollup until someone resolves the challenge (which, given the gating above, only an active submitter can do).",
          "severity": null
        },
        {
          "id": "f0002",
          "kind": "access-control / liveness",
          "locations": [
            {
              "file": "contracts/contracts/l1/rollup/Rollup.sol",
              "function": null,
              "lines": [
                595,
                622
              ]
            }
          ],
          "message": "proveState is gated by onlyActiveSubmitter, so a challenger can never trigger the timeout branch that awards the win. Only an active submitter can resolve a challenge, and that may be the very submitter who would be slashed. If none calls it, the challenge stays open: the challenged batch can never be finalized, and the slash and challenger reward never happen.",
          "severity": null
        },
        {
          "id": "f0003",
          "kind": "legacy storage reinterpretation",
          "locations": [
            {
              "file": "contracts/contracts/l1/rollup/Rollup.sol",
              "function": null,
              "lines": [
                803,
                809
              ]
            }
          ],
          "message": "_challengerWin slashes batchDataStore[batchIndex].submitter, but batches committed before the cutover stored a different value in that slot (the legacy sequencer data). For a challenged pre-cutover batch, slash is called on a garbage address and returns 0, so the challenger gets no slash reward and the responsible party is never penalized.",
          "severity": null
        },
        {
          "id": "f0004",
          "kind": "unhandled commit path",
          "locations": [
            {
              "file": "node/derivation/derivation.go",
              "function": null,
              "lines": [
                680,
                711
              ]
            }
          ],
          "message": "unpackModernRollupCall only recognizes commitBatch and commitBatchWithProof, but Rollup.commitState also commits a batch and emits CommitBatch. Such batches fall through as ErrNotCommitBatchTx and are silently skipped (continue). They are never verified and safe is never advanced for them. In layer1 mode the next batch then derives across a block-number gap and derivation stalls.",
          "severity": null
        }
      ],
