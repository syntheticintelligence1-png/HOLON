def dmg_4(b: Bool, +m: M.HAct, +s: M.HSt, +c1: Nat, +d1: Nat) -> Bool:
  match b:
    case True{}:
      True{}
    case False{}:
      dms_4(M.last_ok(M.step(m, s)), m, M.step(m, s), c1, d1)

# with 4 moves left: no sequence over axd() from s reaches a target below the staircase
def dl_4(ms: List<&2, M.HAct>, +s: M.HSt, +c0: Nat, +d0: Nat) -> Bool:
  match ms:
    case Nil{}:
      True{}
    case Con{+m, rest}:
      Bool.and(dmg_4(met(Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m))), m, s, Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m))), dl_4(rest, s, c0, d0))

# the bounded dominance law: no sequence of at most K moves over axd() reaches a target below the staircase
def dominance() -> Bool:
  dl_4(axd(), sstar(), 0n, 0n)

# the persistent variant: xs from s* succeeds, ends with the target, within (c, d), and kappa is false after
def persistent_ok(+xs: List<&2, M.HAct>, +c: Nat, +d: Nat) -> Bool:
  Bool.and(Bool.and(M.runs_ok(xs, sstar()), last_target(xs)), Bool.and(Bool.and(Nat.is_le(M.cost(xs), c), Nat.is_le(M.elapsed(xs), d)), Bool.not(ob_kappa(M.run(xs, sstar())))))

def ab_moves(ms: List<&2, M.HAct>, +a: M.HSt, +b: M.HSt) -> Bool:
  match ms:
    case Nil{}:
      True{}
    case Con{+m, rest}:
      Bool.and(Nat.is_eq(code_at(m, a), code_at(m, b)), ab_moves(rest, a, b))

def ab_pairs(ps: List<&2, DtR>, +ms: List<&2, M.HAct>) -> Bool:
  match ps:
    case Nil{}:
      True{}
    case Con{q, rest}:
      match q:
        case DtR{dt, rep}:
          Bool.and(ab_moves(ms, M.step(M.A_wait{dt}, sstar()), M.step(M.A_wait{rep}, sstar())), ab_pairs(rest, ms))

