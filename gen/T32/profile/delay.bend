2n, 0n, 2n, 0n, 3n, 125n, 130n, [1n]}, M.A_commitBatch{2n, 0n, 2n, 1n, 3n, 125n, 130n, [37n]}, M.A_commitBatch{2n, 0n, 2n, 1n, 3n, 125n, 130n, Nil{}}, M.A_commitBatch{2n, 0n, 2n, 1n, 3n, 125n, 130n, [1n]}, M.A_commitState{2n, 1n, 2n, 0n, 3n, 125n, 130n, Nil{}}, M.A_commitState{2n, 2n, 2n, 0n, 3n, 125n, 130n, Nil{}}, M.A_commitBatchWithProof{2n, 1n, 2n, 0n, 3n, 125n, 130n, [37n], 1n}, M.A_commitBatchWithProof{2n, 1n, 2n, 1n, 3n, 125n, 130n, [37n], 1n}]

# a schedule event: the move ae()[mv], played before the strategy's turn `turn`
type Ev is Data:
  Ev{turn: Nat, mv: Nat}

# the adversary's answer: the events (indices into ae()) it plays after the strategy's moves xh (indices into the
# point's game alphabet)
type Ans is Data:
  Ans{xh: List<&2, Nat>, ev: List<&2, Nat>}

# a wait and its representative (the time abstraction)
type DtR is Data:
  DtR{dt: Nat, rep: Nat}

# the greedy pick: the first move of a priority list within the budget that succeeds
type Pick is Data:
  Picked{m: M.HAct, s: M.HSt}
  NoPick{}

def sel_nats(b: Bool, x: List<&2, Nat>, y: List<&2, Nat>) -> List<&2, Nat>:
  match b:
    case True{}:
      x
    case False{}:
      y

def eq_nats(xs: List<&2, Nat>, ys: List<&2, Nat>) -> Bool:
  match xs ys:
    case Nil{} Nil{}:
      True{}
    case Con{x, xt} Con{y, yt}:
      Bool.and(Nat.is_eq(x, y), eq_nats(xt, yt))
    case _ _:
      False{}

def nth_mv(xs: List<&2, M.HAct>, i: Nat) -> M.HAct:
  match xs i:
    case Nil{} _:
      M.A_wait{0n}
    case Con{h, t} 0n:
      h
    case Con{h, t} 1n+p:
      nth_mv(t, p)

def n_moves(xs: List<&2, Nat>) -> Nat:
  match xs:
    case Nil{}:
      0n
    case Con{h, t}:
      1n+n_moves(t)

def head_code(l: List<&2, M.HObs>) -> Nat:
  match l:
    case Nil{}:
      0n
    case Con{o, t}:
      match o:
        case M.O_Ok{}:
          0n
        case M.O_Rev{c}:
          c

# the outcome of the last step: 0 for success, else the revert reason
def code_of(s: M.HSt) -> Nat:
  head_code(M.log_of(s))

def cost1(m: M.HAct) -> Nat:
  M.cost(Con{m, Nil{}})

def delay1(m: M.HAct) -> Nat:
  M.elapsed(Con{m, Nil{}})

# m from s stays within (c, d) after (c0, d0) and succeeds
def fits(+m: M.HAct, +s: M.HSt, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  Bool.and(Bool.and(Nat.is_le(Nat.add(c0, cost1(m)), c), Nat.is_le(Nat.add(d0, delay1(m)), d)), M.last_ok(M.step(m, s)))

def choose(b: Bool, +m: M.HAct, +s: M.HSt, other: Pick) -> Pick:
  match b:
    case True{}:
      Picked{m, M.step(m, s)}
    case False{}:
      other

def pick(p: List<&2, M.HAct>, +s: M.HSt, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Pick:
  match p:
    case Nil{}:
      NoPick{}
    case Con{+m, rest}:
      choose(fits(m, s, c0, d0, c, d), m, s, pick(rest, s, c0, d0, c, d))

def keep_b(b: Bool, x: Nat, r: List<&2, Nat>) -> List<&2, Nat>:
  match b:
    case True{}:
      Con{x, r}
    case False{}:
      r

def keep_ev(e: Ev, +i: Nat, r: List<&2, Nat>) -> List<&2, Nat>:
  match e:
    case Ev{t, mv}:
      keep_b(Nat.is_eq(t, i), mv, r)

# the events of turn i, in order
def at_turn(sc: List<&2, Ev>, +i: Nat) -> List<&2, Nat>:
  match sc:
    case Nil{}:
      Nil{}
    case Con{e, rest}:
      keep_ev(e, i, at_turn(rest, i))

def apply_all(ix: List<&2, Nat>, s: M.HSt) -> M.HSt:
  match ix:
    case Nil{}:
      s
    case Con{i, rest}:
      apply_all(rest, M.step(nth_mv(ae(), i), s))

def ev_turn(e: Ev) -> Nat:
  match e:
    case Ev{t, mv}:
      t

def last_turn(sc: List<&2, Ev>) -> Nat:
  match sc:
    case Nil{}:
      0n
    case Con{e, rest}:
      Nat.max(ev_turn(e), last_turn(rest))

# every schedule sc ++ [Ev{t, m}] for m < nm, onto acc
def with_moves(+sc: List<&2, Ev>, +t: Nat, +m: Nat, acc: List<&2, List<&2, Ev>>) -> List<&2, List<&2, Ev>>:
  match m:
    case 0n:
      acc
    case 1n+p:
      with_moves(sc, t, p, Con{List.append(&2, Ev, sc, Con{Ev{t, p}, Nil{}}), acc})

# for the n turns from t on
def with_turns(n: Nat, +sc: List<&2, Ev>, +t: Nat, +nm: Nat, acc: List<&2, List<&2, Ev>>) -> List<&2, List<&2, Ev>>:
  match n:
    case 0n:
      acc
    case 1n+p:
      with_turns(p, sc, Nat.add(t, 1n), nm, with_moves(sc, t, nm, acc))

# every schedule of the list, extended by one event at its last turn or later
def extend(ss: List<&2, List<&2, Ev>>, +k: Nat, +nm: Nat, acc: List<&2, List<&2, Ev>>) -> List<&2, List<&2, Ev>>:
  match ss:
    case Nil{}:
      acc
    case Con{+sc, rest}:
      extend(rest, k, nm, with_turns(Nat.sub(k, last_turn(sc)), sc, last_turn(sc), nm, acc))

def levels(h: Nat, +cur: List<&2, List<&2, Ev>>, +k: Nat, +nm: Nat, acc: List<&2, List<&2, Ev>>) -> List<&2, List<&2, Ev>>:
  match h:
    case 0n:
      List.append(&2, List<&2, Ev>, acc, cur)
    case 1n+p:
      levels(p, extend(cur, k, nm, Nil{}), k, nm, List.append(&2, List<&2, Ev>, acc, cur))

def answer(e: List<&2, Ans>, +xh: List<&2, Nat>) -> List<&2, Nat>:
  match e:
    case Nil{}:
      Nil{}
    case Con{a, rest}:
      match a:
        case Ans{axh, aev}:
          sel_nats(eq_nats(axh, xh), aev, answer(rest, xh))

def last_target_go(xs: List<&2, M.HAct>, h: M.HAct) -> Bool:
  match xs:
    case Nil{}:
      is_target(h)
    case Con{h2, t}:
      last_target_go(t, h2)

# the last move of xs is the target
def last_target(xs: List<&2, M.HAct>) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case Con{h, t}:
      last_target_go(t, h)

def code_at(m: M.HAct, s: M.HSt) -> Nat:
  code_of(M.step(m, s))

def n_moves_ae() -> Nat:
  14n

# every schedule of at most H events over ae(), at turns 0 .. K - 1, in turn order
def scheds() -> List<&2, List<&2, Ev>>:
  levels(2n, Con{Nil{}, Nil{}}, 4n, n_moves_ae(), Nil{})

def gpt_1(b: Bool, +m: M.HAct, s2: M.HSt, +p: List<&2, M.HAct>, +sc: List<&2, Ev>, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match b:
    case True{}:
      True{}
    case False{}:
      False{}

def gpk_1(k: Pick, +p: List<&2, M.HAct>, +sc: List<&2, Ev>, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match k:
    case NoPick{}:
      False{}
    case Picked{+m, s2}:
      gpt_1(is_target(m), m, s2, p, sc, c0, d0, c, d)

# the greedy play's turn 3
def gp_1(+p: List<&2, M.HAct>, +sc: List<&2, Ev>, s: M.HSt, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  gpk_1(pick(p, apply_all(at_turn(sc, 3n), s), c0, d0, c, d), p, sc, c0, d0, c, d)

def gpt_2(b: Bool, +m: M.HAct, s2: M.HSt, +p: List<&2, M.HAct>, +sc: List<&2, Ev>, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match b:
    case True{}:
      True{}
    case False{}:
      gp_1(p, sc, s2, Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m)), c, d)

def gpk_2(k: Pick, +p: List<&2, M.HAct>, +sc: List<&2, Ev>, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match k:
    case NoPick{}:
      False{}
    case Picked{+m, s2}:
      gpt_2(is_target(m), m, s2, p, sc, c0, d0, c, d)

# the greedy play's turn 2
def gp_2(+p: List<&2, M.HAct>, +sc: List<&2, Ev>, s: M.HSt, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  gpk_2(pick(p, apply_all(at_turn(sc, 2n), s), c0, d0, c, d), p, sc, c0, d0, c, d)

def gpt_3(b: Bool, +m: M.HAct, s2: M.HSt, +p: List<&2, M.HAct>, +sc: List<&2, Ev>, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match b:
    case True{}:
      True{}
    case False{}:
      gp_2(p, sc, s2, Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m)), c, d)

def gpk_3(k: Pick, +p: List<&2, M.HAct>, +sc: List<&2, Ev>, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match k:
    case NoPick{}:
      False{}
    case Picked{+m, s2}:
      gpt_3(is_target(m), m, s2, p, sc, c0, d0, c, d)

# the greedy play's turn 1
def gp_3(+p: List<&2, M.HAct>, +sc: List<&2, Ev>, s: M.HSt, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  gpk_3(pick(p, apply_all(at_turn(sc, 1n), s), c0, d0, c, d), p, sc, c0, d0, c, d)

def gpt_4(b: Bool, +m: M.HAct, s2: M.HSt, +p: List<&2, M.HAct>, +sc: List<&2, Ev>, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match b:
    case True{}:
      True{}
    case False{}:
      gp_3(p, sc, s2, Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m)), c, d)

def gpk_4(k: Pick, +p: List<&2, M.HAct>, +sc: List<&2, Ev>, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match k:
    case NoPick{}:
      False{}
    case Picked{+m, s2}:
      gpt_4(is_target(m), m, s2, p, sc, c0, d0, c, d)

# the greedy play's turn 0
def gp_4(+p: List<&2, M.HAct>, +sc: List<&2, Ev>, s: M.HSt, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  gpk_4(pick(p, apply_all(at_turn(sc, 0n), s), c0, d0, c, d), p, sc, c0, d0, c, d)

def all_gp(ss: List<&2, List<&2, Ev>>, +p: List<&2, M.HAct>, +c: Nat, +d: Nat) -> Bool:
  match ss:
    case Nil{}:
      True{}
    case Con{sc, rest}:
      Bool.and(gp_4(p, sc, sstar(), 0n, 0n, c, d), all_gp(rest, p, c, d))

def ix_moves(ix: List<&2, Nat>, +ax: List<&2, M.HAct>) -> List<&2, M.HAct>:
  match ix:
    case Nil{}:
      Nil{}
    case Con{i, rest}:
      Con{nth_mv(ax, i), ix_moves(rest, ax)}

def ix_in(ix: List<&2, Nat>, +n: Nat) -> Bool:
  match ix:
    case Nil{}:
      True{}
    case Con{i, rest}:
      Bool.and(Nat.is_lt(i, n), ix_in(rest, n))

# §8.4: the priority list ix (indices into the point's game alphabet ax, every one in range) wins every
# schedule within (c, d)
def robust(+ix: List<&2, Nat>, +ax: List<&2, M.HAct>, +c: Nat, +d: Nat) -> Bool:
  Bool.and(ix_in(ix, List.length(&2, M.HAct, ax)), all_gp(scheds(), ix_moves(ix, ax), c, d))

def xlt_1(b: Bool, +m: M.HAct, +i: Nat, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, s2: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match b:
    case True{}:
      False{}
    case False{}:
      True{}

def xlm_1(b: Bool, +m: M.HAct, +i: Nat, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, +s: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match b:
    case False{}:
      True{}
    case True{}:
      xlt_1(is_target(m), m, i, ax, e, M.step(m, s), xh, h, c0, d0, c, d)

# with 1 turns left: every move of ms (ax from index i on) loses
def xl_1(ms: List<&2, M.HAct>, +i: Nat, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, +s: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match ms:
    case Nil{}:
      True{}
    case Con{+m, rest}:
      Bool.and(xlm_1(fits(m, s, c0, d0, c, d), m, i, ax, e, s, xh, h, c0, d0, c, d), xl_1(rest, Nat.add(i, 1n), ax, e, s, xh, h, c0, d0, c, d))

# the answer's events (at most h), then the strategy's turn with 1 turns left
def xla_2(+ev: List<&2, Nat>, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, s2: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  Bool.and(Nat.is_le(n_moves(ev), h), xl_1(ax, 0n, ax, e, apply_all(ev, s2), xh, Nat.sub(h, n_moves(ev)), c0, d0, c, d))

def xlt_2(b: Bool, +m: M.HAct, +i: Nat, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, s2: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match b:
    case True{}:
      False{}
    case False{}:
      xla_2(answer(e, List.append(&2, Nat, xh, Con{i, Nil{}})), ax, e, s2, List.append(&2, Nat, xh, Con{i, Nil{}}), h, Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m)), c, d)

def xlm_2(b: Bool, +m: M.HAct, +i: Nat, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, +s: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match b:
    case False{}:
      True{}
    case True{}:
      xlt_2(is_target(m), m, i, ax, e, M.step(m, s), xh, h, c0, d0, c, d)

# with 2 turns left: every move of ms (ax from index i on) loses
def xl_2(ms: List<&2, M.HAct>, +i: Nat, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, +s: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match ms:
    case Nil{}:
      True{}
    case Con{+m, rest}:
      Bool.and(xlm_2(fits(m, s, c0, d0, c, d), m, i, ax, e, s, xh, h, c0, d0, c, d), xl_2(rest, Nat.add(i, 1n), ax, e, s, xh, h, c0, d0, c, d))

# the answer's events (at most h), then the strategy's turn with 2 turns left
def xla_3(+ev: List<&2, Nat>, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, s2: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  Bool.and(Nat.is_le(n_moves(ev), h), xl_2(ax, 0n, ax, e, apply_all(ev, s2), xh, Nat.sub(h, n_moves(ev)), c0, d0, c, d))

def xlt_3(b: Bool, +m: M.HAct, +i: Nat, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, s2: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match b:
    case True{}:
      False{}
    case False{}:
      xla_3(answer(e, List.append(&2, Nat, xh, Con{i, Nil{}})), ax, e, s2, List.append(&2, Nat, xh, Con{i, Nil{}}), h, Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m)), c, d)

def xlm_3(b: Bool, +m: M.HAct, +i: Nat, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, +s: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match b:
    case False{}:
      True{}
    case True{}:
      xlt_3(is_target(m), m, i, ax, e, M.step(m, s), xh, h, c0, d0, c, d)

# with 3 turns left: every move of ms (ax from index i on) loses
def xl_3(ms: List<&2, M.HAct>, +i: Nat, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, +s: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match ms:
    case Nil{}:
      True{}
    case Con{+m, rest}:
      Bool.and(xlm_3(fits(m, s, c0, d0, c, d), m, i, ax, e, s, xh, h, c0, d0, c, d), xl_3(rest, Nat.add(i, 1n), ax, e, s, xh, h, c0, d0, c, d))

# the answer's events (at most h), then the strategy's turn with 3 turns left
def xla_4(+ev: List<&2, Nat>, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, s2: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  Bool.and(Nat.is_le(n_moves(ev), h), xl_3(ax, 0n, ax, e, apply_all(ev, s2), xh, Nat.sub(h, n_moves(ev)), c0, d0, c, d))

def xlt_4(b: Bool, +m: M.HAct, +i: Nat, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, s2: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match b:
    case True{}:
      False{}
    case False{}:
      xla_4(answer(e, List.append(&2, Nat, xh, Con{i, Nil{}})), ax, e, s2, List.append(&2, Nat, xh, Con{i, Nil{}}), h, Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m)), c, d)

def xlm_4(b: Bool, +m: M.HAct, +i: Nat, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, +s: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match b:
    case False{}:
      True{}
    case True{}:
      xlt_4(is_target(m), m, i, ax, e, M.step(m, s), xh, h, c0, d0, c, d)

# with 4 turns left: every move of ms (ax from index i on) loses
def xl_4(ms: List<&2, M.HAct>, +i: Nat, +ax: List<&2, M.HAct>, +e: List<&2, Ans>, +s: M.HSt, +xh: List<&2, Nat>, +h: Nat, +c0: Nat, +d0: Nat, +c: Nat, +d: Nat) -> Bool:
  match ms:
    case Nil{}:
      True{}
    case Con{+m, rest}:
      Bool.and(xlm_4(fits(m, s, c0, d0, c, d), m, i, ax, e, s, xh, h, c0, d0, c, d), xl_4(rest, Nat.add(i, 1n), ax, e, s, xh, h, c0, d0, c, d))

# the adversary's answers e beat every strategy over ax within (c, d), using at most H events
def beaten(+e: List<&2, Ans>, +ax: List<&2, M.HAct>, +c: Nat, +d: Nat) -> Bool:
  Bool.and(Nat.is_le(n_moves(answer(e, Nil{})), 2n), xl_4(ax, 0n, ax, e, apply_all(answer(e, Nil{}), sstar()), Nil{}, Nat.sub(2n, n_moves(answer(e, Nil{}))), 0n, 0n, c, d))

# an outcome (c, d) meets every gap of the frontier's staircase
def met(+c: Nat, +d: Nat) -> Bool:
  Bool.or(Nat.is_ge(c, 1n), Nat.is_ge(d, 19n))

def dmt_1(b: Bool, s2: M.HSt, +c1: Nat, +d1: Nat) -> Bool:
  match b:
    case True{}:
      False{}
    case False{}:
      True{}

def dms_1(b: Bool, +m: M.HAct, s2: M.HSt, +c1: Nat, +d1: Nat) -> Bool:
  match b:
    case False{}:
      True{}
    case True{}:
      dmt_1(is_target(m), s2, c1, d1)

def dmg_1(b: Bool, +m: M.HAct, +s: M.HSt, +c1: Nat, +d1: Nat) -> Bool:
  match b:
    case True{}:
      True{}
    case False{}:
      dms_1(M.last_ok(M.step(m, s)), m, M.step(m, s), c1, d1)

# with 1 moves left: no sequence over axd() from s reaches a target below the staircase
def dl_1(ms: List<&2, M.HAct>, +s: M.HSt, +c0: Nat, +d0: Nat) -> Bool:
  match ms:
    case Nil{}:
      True{}
    case Con{+m, rest}:
      Bool.and(dmg_1(met(Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m))), m, s, Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m))), dl_1(rest, s, c0, d0))

def dmt_2(b: Bool, s2: M.HSt, +c1: Nat, +d1: Nat) -> Bool:
  match b:
    case True{}:
      False{}
    case False{}:
      dl_1(axd(), s2, c1, d1)

def dms_2(b: Bool, +m: M.HAct, s2: M.HSt, +c1: Nat, +d1: Nat) -> Bool:
  match b:
    case False{}:
      True{}
    case True{}:
      dmt_2(is_target(m), s2, c1, d1)

def dmg_2(b: Bool, +m: M.HAct, +s: M.HSt, +c1: Nat, +d1: Nat) -> Bool:
  match b:
    case True{}:
      True{}
    case False{}:
      dms_2(M.last_ok(M.step(m, s)), m, M.step(m, s), c1, d1)

# with 2 moves left: no sequence over axd() from s reaches a target below the staircase
def dl_2(ms: List<&2, M.HAct>, +s: M.HSt, +c0: Nat, +d0: Nat) -> Bool:
  match ms:
    case Nil{}:
      True{}
    case Con{+m, rest}:
      Bool.and(dmg_2(met(Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m))), m, s, Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m))), dl_2(rest, s, c0, d0))

def dmt_3(b: Bool, s2: M.HSt, +c1: Nat, +d1: Nat) -> Bool:
  match b:
    case True{}:
      False{}
    case False{}:
      dl_2(axd(), s2, c1, d1)

def dms_3(b: Bool, +m: M.HAct, s2: M.HSt, +c1: Nat, +d1: Nat) -> Bool:
  match b:
    case False{}:
      True{}
    case True{}:
      dmt_3(is_target(m), s2, c1, d1)

def dmg_3(b: Bool, +m: M.HAct, +s: M.HSt, +c1: Nat, +d1: Nat) -> Bool:
  match b:
    case True{}:
      True{}
    case False{}:
      dms_3(M.last_ok(M.step(m, s)), m, M.step(m, s), c1, d1)

# with 3 moves left: no sequence over axd() from s reaches a target below the staircase
def dl_3(ms: List<&2, M.HAct>, +s: M.HSt, +c0: Nat, +d0: Nat) -> Bool:
  match ms:
    case Nil{}:
      True{}
    case Con{+m, rest}:
      Bool.and(dmg_3(met(Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m))), m, s, Nat.add(c0, cost1(m)), Nat.add(d0, delay1(m))), dl_3(rest, s, c0, d0))

def dmt_4(b: Bool, s2: M.HSt, +c1: Nat, +d1: Nat) -> Bool:
  match b:
    case True{}:
      False{}
    case False{}:
      dl_3(axd(), s2, c1, d1)

def dms_4(b: Bool, +m: M.HAct, s2: M.HSt, +c1: Nat, +d1: Nat) -> Bool:
  match b:
    case False{}:
      True{}
    case True{}:
