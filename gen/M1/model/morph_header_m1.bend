def ok_go_v(v: Nat, n: Nat) -> Bool:
  match v:
    case 0n:
      Nat.is_eq(n, 249n)
    case 1n:
      Nat.is_eq(n, 257n)
    case 2n:
      Nat.is_eq(n, 257n)
    case 3n+p:
      False{}

def ok_go(+b: List<&2, U32>) -> Bool:
  match b:
    case Nil{}:
      False{}
    case Con{+h0, +t}:
      ok_go_v(U32.to_nat(h0), 1n+List.length(&2, U32, t))


def ok_sol_v(v: Nat, n: Nat) -> Bool:
  match v:
    case 0n:
      Nat.is_ge(n, 249n)
    case 1n:
      Nat.is_eq(n, 257n)
    case 2n:
      Nat.is_eq(n, 257n)
    case 3n+p:
      False{}

def ok_sol(+b: List<&2, U32>) -> Bool:
  match b:
    case Nil{}:
      False{}
    case Con{+h0, +t}:
      ok_sol_v(U32.to_nat(h0), 1n+List.length(&2, U32, t))


