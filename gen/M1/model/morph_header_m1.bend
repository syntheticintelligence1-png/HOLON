def dec_go_fields(v: Nat, +b: List<&2, U32>) -> List<&2, List<&2, U32>>:
  match v:
    case 0n:
      [List.take(&2, U32, List.drop(&2, U32, b, 0n), 1n), List.take(&2, U32, List.drop(&2, U32, b, 1n), 8n), List.take(&2, U32, List.drop(&2, U32, b, 9n), 8n), List.take(&2, U32, List.drop(&2, U32, b, 17n), 8n), List.take(&2, U32, List.drop(&2, U32, b, 25n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 57n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 89n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 121n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 153n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 185n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 217n), 32n)]
    case 1n:
      [List.take(&2, U32, List.drop(&2, U32, b, 0n), 1n), List.take(&2, U32, List.drop(&2, U32, b, 1n), 8n), List.take(&2, U32, List.drop(&2, U32, b, 9n), 8n), List.take(&2, U32, List.drop(&2, U32, b, 17n), 8n), List.take(&2, U32, List.drop(&2, U32, b, 25n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 57n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 89n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 121n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 153n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 185n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 217n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 249n), 8n)]
    case 2n+p:
      [List.take(&2, U32, List.drop(&2, U32, b, 0n), 1n), List.take(&2, U32, List.drop(&2, U32, b, 1n), 8n), List.take(&2, U32, List.drop(&2, U32, b, 9n), 8n), List.take(&2, U32, List.drop(&2, U32, b, 17n), 8n), List.take(&2, U32, List.drop(&2, U32, b, 25n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 57n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 89n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 121n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 153n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 185n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 217n), 32n), List.take(&2, U32, List.drop(&2, U32, b, 249n), 8n)]

def dec_go_h(vh: List<&2, U32>, +b: List<&2, U32>) -> Maybe<&2, List<&2, List<&2, U32>>>:
  match vh:
    case Nil{}:
      None{}
    case Con{+v0, +t}:
      Some{dec_go_fields(U32.to_nat(v0), b)}

def dec_go_g(g: Bool, +b: List<&2, U32>) -> Maybe<&2, List<&2, List<&2, U32>>>:
  match g:
    case True{}:
      dec_go_h(List.take(&2, U32, b, 1n), b)
    case False{}:
      None{}

def dec_go(+b: List<&2, U32>) -> Maybe<&2, List<&2, List<&2, U32>>>:
  dec_go_g(ok_go(b), b)
