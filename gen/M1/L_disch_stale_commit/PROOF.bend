        case M.A_commitBatch{+who, +ver, +parent, +n, +lbn, +prev, +post, +blobs}:
          efq({M.last_ok(M.step(M.A_commitBatch{who, ver, parent, n, lbn, prev, post, blobs}, M.HSt{t, lfi, inch, bc, rri, paused, W, F, D, qlen, qpend, enq, active, chals, fsr, chs, win, s_csr, s_bd, s_bvh, s_tag, log})) == False{} : Bool}, core_false_ne_true(h1))
        case M.A_commitState{+who, +ver, +parent, +n, +lbn, +prev, +post, +blobs}:
