def Laws.l_disch_stale_commit(s, a, h0, h1):
  match s:
    case M.HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
