# class deadline: kappa = b && w + start(chs[i]) < t is preserved by every permissionless action

def dl_nth_set_le(cs: List<&2, M.HCh>, i: Nat, j: Nat) -> {Nat.is_le(M.g_Ch_s(M.nth_d(M.HCh, M.set_d(M.HCh, cs, i, M.empty_ch(), M.empty_ch()), j, M.empty_ch())), M.g_Ch_s(M.nth_d(M.HCh, cs, j, M.empty_ch()))) == True{} : Bool}:
  match cs i j:
    case Nil{} 0n 0n:
      {==}
    case Nil{} 0n 1n+jq:
      {==}
    case Nil{} 1n+ip 0n:
      {==}
    case Nil{} 1n+ip 1n+jq:
      dl_nth_set_le(Nil{}, ip, jq)
    case Con{+h, t} 0n 0n:
      core_le_zero(M.g_Ch_s(h))
    case Con{h, +t} 0n 1n+jq:
      core_le_refl(M.g_Ch_s(M.nth_d(M.HCh, t, jq, M.empty_ch())))
    case Con{+h, t} 1n+ip 0n:
      core_le_refl(M.g_Ch_s(h))
    case Con{h, t} 1n+ip 1n+jq:
      dl_nth_set_le(t, ip, jq)

