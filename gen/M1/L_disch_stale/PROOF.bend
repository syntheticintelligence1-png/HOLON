      efq({Nat.is_lt(1n+ap, c) == True{} : Bool}, core_false_ne_true(e1))
    case 1n+ap 1n+bp 0n:
      efq({Nat.is_lt(1n+ap, 0n) == True{} : Bool}, core_false_ne_true(e2))
    case 1n+ap 1n+bp 1n+cp:
      core_lt_of_le_lt(ap, bp, cp, e1, e2)

