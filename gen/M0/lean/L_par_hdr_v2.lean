  [h.get_version, h.get_batchIndex, h.get_l1MessagePopped, h.get_totalL1MessagePopped, h.get_dataHash, h.get_blobVersionedHash, h.get_prevStateHash, h.get_postStateHash, h.get_withdrawRootHash, h.get_sequencerSetVerifyHash, h.get_parentBatchHash] ++ (if decide (h.version_0.toNat ≥ 1) then [h.get_lastBlockNumber] else [])

/-- `dec_go` getters: None if validate() fails, else Some(list of getter results in this order); lastBlockNumber only when version >= 1. -/
def dec_go_fields (b : Bytes) : Fields :=
  [slice b 0 1, slice b 1 8, slice b 9 8, slice b 17 8, slice b 25 32, slice b 57 32, slice b 89 32, slice b 121 32, slice b 153 32, slice b 185 32, slice b 217 32] ++ (if verIs b (fun v => decide (v ≥ 1)) then [slice b 249 8] else [])

/-- `dec_go`: `none` unless the guard `ok_go` accepts b. -/
def dec_go (b : Bytes) : Option Fields :=
  if ok_go b then some (dec_go_fields b) else none

