def ok_go (b : Bytes) : Bool :=
  -- Version(): ErrEmptyBatchHeaderBytes
  if b.isEmpty then false
  -- len(b) != expectedLengthV0 -> error
  else if verIs b (fun v => v == 0) then decide (b.length = 249)
  -- len(b) != expectedLengthV1 -> error
  else if verIs b (fun v => v == 1) then decide (b.length = 257)
  -- len(b) != expectedLengthV2 -> error
  else if verIs b (fun v => v == 2) then decide (b.length = 257)
  -- ErrInvalidBatchHeaderVersion
  else false

/-- `ok_sol`: true iff _loadBatchHeader(b) does not revert. Rules in order, first match wins. -/
def ok_sol (b : Bytes) : Bool :=
  -- require(batchHeader.length > 0, "Empty batch header")
  if b.isEmpty then false
  -- V0.loadAndValidate: require(length >= 249)
  else if verIs b (fun v => v == 0) then decide (b.length ≥ 249)
  -- V1.loadAndValidate: require(length == 257)
  else if verIs b (fun v => v == 1 || v == 2) then decide (b.length = 257)
  -- revert("Unsupported batch version")
  else false

/-- `view`: the fields a correct decoder should recover from a header: header fields in dec_go getter order; lastBlockNumber included iff version >= 1. -/
