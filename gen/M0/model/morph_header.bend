def enc_sol(+h: Hdr) -> List<&2, U32>:
  enc_sol_at(hdr_version(h), h)

# ok_sol: true iff _loadBatchHeader(b) does not revert
def ok_sol_at(n: Nat, t: List<&2, U32>) -> Bool:
  match n:
    case 0n:
      # V0.loadAndValidate: require(length >= 249)
      tail_len_ge(t, 248n)
    case 1n:
      # V1.loadAndValidate: require(length == 257)
      tail_len_eq(t, 256n)
    case 2n:
      # V1.loadAndValidate: require(length == 257)
      tail_len_eq(t, 256n)
    case 3n+p:
      # revert("Unsupported batch version")
      False{}

def ok_sol(b: List<&2, U32>) -> Bool:
  match b:
    case Nil{}:
      False{}
    case Con{h, t}:
      ok_sol_at(U32.to_nat(h), t)

