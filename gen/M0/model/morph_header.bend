# ok_go: true iff validate() returns nil
def ok_go_at(n: Nat, t: List<&2, U32>) -> Bool:
  match n:
    case 0n:
      # len(b) != expectedLengthV0 -> error
      tail_len_eq(t, 248n)
    case 1n:
      # len(b) != expectedLengthV1 -> error
      tail_len_eq(t, 256n)
    case 2n:
      # len(b) != expectedLengthV2 -> error
      tail_len_eq(t, 256n)
    case 3n+p:
      # ErrInvalidBatchHeaderVersion
      False{}

def ok_go(b: List<&2, U32>) -> Bool:
  match b:
    case Nil{}:
      False{}
    case Con{h, t}:
      ok_go_at(U32.to_nat(h), t)

# dec_go: None if validate() fails, else Some(list of getter results in this order); lastBlockNumber only when version >= 1
def dec_go_fields_at(n: Nat, +b: List<&2, U32>) -> List<&2, List<&2, U32>>:
  match n:
    case 0n:
      [slice(b, 0n, 1n), slice(b, 1n, 8n), slice(b, 9n, 8n), slice(b, 17n, 8n), slice(b, 25n, 32n), slice(b, 57n, 32n), slice(b, 89n, 32n), slice(b, 121n, 32n), slice(b, 153n, 32n), slice(b, 185n, 32n), slice(b, 217n, 32n)]
    case 1n:
      [slice(b, 0n, 1n), slice(b, 1n, 8n), slice(b, 9n, 8n), slice(b, 17n, 8n), slice(b, 25n, 32n), slice(b, 57n, 32n), slice(b, 89n, 32n), slice(b, 121n, 32n), slice(b, 153n, 32n), slice(b, 185n, 32n), slice(b, 217n, 32n), slice(b, 249n, 8n)]
    case 2n+p:
      [slice(b, 0n, 1n), slice(b, 1n, 8n), slice(b, 9n, 8n), slice(b, 17n, 8n), slice(b, 25n, 32n), slice(b, 57n, 32n), slice(b, 89n, 32n), slice(b, 121n, 32n), slice(b, 153n, 32n), slice(b, 185n, 32n), slice(b, 217n, 32n), slice(b, 249n, 8n)]

def dec_go_fields(b: List<&2, U32>) -> List<&2, List<&2, U32>>:
  match b:
    case Nil{}:
      Nil{}
    case Con{+h, +t}:
      dec_go_fields_at(U32.to_nat(h), Con{h, t})

def dec_go_sel(c: Bool, b: List<&2, U32>) -> Maybe<&2, List<&2, List<&2, U32>>>:
  match c:
    case True{}:
      Some{dec_go_fields(b)}
    case False{}:
      None{}

# None unless the guard ok_go accepts b
def dec_go(+b: List<&2, U32>) -> Maybe<&2, List<&2, List<&2, U32>>>:
  dec_go_sel(ok_go(b), b)

