def cost(tr: List<&2, HAct>) -> Nat:
  match tr:
    case Nil{}:
      0n
    case Con{a, rest}:
      match a:
        case A_commitBatch{_, _, _, _, _, _, _, _}:
          Nat.add(0n, cost(rest))
        case A_commitState{_, _, _, _, _, _, _, _}:
          Nat.add(0n, cost(rest))
        case A_commitBatchWithProof{_, _, _, _, _, _, _, _, _}:
          Nat.add(1000n, cost(rest))
        case A_revertBatch{_, _, _}:
          Nat.add(0n, cost(rest))
        case A_challengeState{_, _, _}:
          Nat.add(0n, cost(rest))
        case A_proveState{_, _, _}:
          Nat.add(0n, cost(rest))
        case A_finalizeBatch{_, _}:
          Nat.add(0n, cost(rest))
        case A_setPause{_, _}:
          Nat.add(0n, cost(rest))
        case A_sendMessage{_}:
          Nat.add(1n, cost(rest))
        case A_wait{_}:
          Nat.add(0n, cost(rest))
        case A_addChallenger{_, _}:
          Nat.add(0n, cost(rest))

def elapsed(tr: List<&2, HAct>) -> Nat:
  match tr:
    case Nil{}:
      0n
    case Con{a, rest}:
      match a:
        case A_commitBatch{_, _, _, _, _, _, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_commitState{_, _, _, _, _, _, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_commitBatchWithProof{_, _, _, _, _, _, _, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_revertBatch{_, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_challengeState{_, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_proveState{_, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_finalizeBatch{_, _}:
          Nat.add(0n, elapsed(rest))
        case A_setPause{_, _}:
          Nat.add(0n, elapsed(rest))
        case A_sendMessage{_}:
          Nat.add(0n, elapsed(rest))
        case A_wait{dt}:
          Nat.add(dt, elapsed(rest))
        case A_addChallenger{_, _}:
          Nat.add(0n, elapsed(rest))

# the blob sidecar a commit transaction delivers to L2 derivation (the consumer of FACT)
def blobs_of(a: HAct) -> List<&2, Nat>:
  match a:
    case A_commitBatch{_, _, _, _, _, _, _, blobs}:
      blobs
    case A_commitState{_, _, _, _, _, _, _, blobs}:
      blobs
    case A_commitBatchWithProof{_, _, _, _, _, _, _, blobs, _}:
      blobs
    case A_revertBatch{_, _, _}:
      Nil{}
    case A_challengeState{_, _, _}:
      Nil{}
    case A_proveState{_, _, _}:
      Nil{}
    case A_finalizeBatch{_, _}:
      Nil{}
    case A_setPause{_, _}:
      Nil{}
    case A_sendMessage{_}:
      Nil{}
    case A_wait{_}:
      Nil{}
    case A_addChallenger{_, _}:
      Nil{}

# actions any principal may take (no role modifier): the permissionless class X of DISCH
def perm(a: HAct) -> Bool:
  match a:
    case A_commitBatch{_, _, _, _, _, _, _, _}:
      False{}
    case A_commitState{_, _, _, _, _, _, _, _}:
      False{}
    case A_commitBatchWithProof{_, _, _, _, _, _, _, _, _}:
      True{}
    case A_revertBatch{_, _, _}:
      False{}
    case A_challengeState{_, _, _}:
      False{}
    case A_proveState{_, _, _}:
      False{}
    case A_finalizeBatch{_, _}:
      True{}
    case A_setPause{_, _}:
      False{}
    case A_sendMessage{_}:
      True{}
    case A_wait{_}:
      True{}
    case A_addChallenger{_, _}:
      False{}

# LCI of a state
def lci_of(s: HSt) -> Nat:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      d_lci(lfi, win)

# 
def csr_last(s: HSt) -> Nat:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      g_Entry_csr(last_d(HEntry, win, empty_entry()))

# DISCH guard kappa: an open challenge whose proof window has passed (the realize site at :363 underflows)
def kappa(s: HSt) -> Bool:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      Bool.and(inch, Nat.is_lt(Nat.add(W, g_Ch_s(nth_d(HCh, chs, bc, empty_ch()))), t))

# Prop 6.19 ghost-tag exactness: every committed header's blob field has the sort its version implies (v2 <=> aggregate)
def tags_ok(s: HSt) -> Bool:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      b_tags_exact(win)

# header of the newest batch (committedBatches[LCI] = keccak256 of it, under CF)
def new_hdr(s: HSt) -> List<&2, Nat>:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      b_hdr_of(last_d(HEntry, win, empty_entry()))

# SYM-pi (O20): tag_test Ch.c == 0 at challengeState/guard[8] and def open_ch is sound: no started challenge has challenger == Null
def prin_ch_ok(s: HSt) -> Bool:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      b_pred_ch_prin(chs, 0n)

# SYM-pi (O20): union_read Entry.bds at proveState/effect:active is Prin[submitter], never Null
def prin_bds_ok(s: HSt) -> Bool:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      b_pred_bds_prin(win, 0n)

# SYM-tau (O21): the sentinel test enq[qpend] != 0 in def enq_first reads a Time+Null union; sound iff with a pending message enq_first returns that message's time
def enq_first_sound(s: HSt) -> Bool:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      Bool.or(Bool.not(Nat.is_lt(qpend, qlen)), Nat.is_eq(d_enq_first(qpend, qlen, enq, t), b_nth(enq, qpend)))

# migration: state as written by Rollup before reinitializer(2): committedStateRoots did not exist (all zero)
def mig_legacy(s: HSt) -> HSt:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
