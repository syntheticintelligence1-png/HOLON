def step(a: HAct, s: HSt) -> HSt:
  match a:
    case A_advance_stage{}:
      step_advance_stage(s)
    case A_bump_both{}:
      step_bump_both(s)
    case A_flip_twice{}:
      step_flip_twice(s)
    case A_lock_restore{}:
      step_lock_restore(s)
    case A_add_sub_cancel{+x}:
      step_add_sub_cancel(s, x)
    case A_step_mirror{+x}:
      step_step_mirror(s, x)
    case A_add_acc{+x}:
      step_add_acc(s, x)
    case A_check_cap{+x}:
      step_check_cap(s, x)
    case A_check_window{+x, +y}:
      step_check_window(s, x, y)
    case A_promote_tier{+x}:
      step_promote_tier(s, x)

def run(tr: List<&2, HAct>, s: HSt) -> HSt:
  match tr:
    case Nil{}:
      s
    case Con{a, rest}:
      run(rest, step(a, s))

def clear_log(s: HSt) -> HSt:
  match s:
    case HSt{stage, seq, mirror, acc, tier, locked, halted, alert, overflow, breach, diff_zero, parity, log}:
      HSt{stage, seq, mirror, acc, tier, locked, halted, alert, overflow, breach, diff_zero, parity, Nil{}}

def log_of(s: HSt) -> List<&2, HObs>:
  match s:
    case HSt{stage, seq, mirror, acc, tier, locked, halted, alert, overflow, breach, diff_zero, parity, log}:
      log

# observations of tr from s: the log tr produces (newest first)
def obs(tr: List<&2, HAct>, s: HSt) -> List<&2, HObs>:
  log_of(run(tr, clear_log(s)))

def ok_head(l: List<&2, HObs>) -> Bool:
  match l:
    case Nil{}:
      False{}
    case Con{o, t}:
      match o:
        case O_Ok{}:
          True{}
        case O_Rev{c}:
          False{}

# the last action applied to s succeeded
def last_ok(s: HSt) -> Bool:
  ok_head(log_of(s))

def all_ok(l: List<&2, HObs>) -> Bool:
  match l:
    case Nil{}:
      True{}
    case Con{o, t}:
      match o:
        case O_Ok{}:
          all_ok(t)
        case O_Rev{c}:
          False{}

# every action of tr succeeds from s
def runs_ok(tr: List<&2, HAct>, s: HSt) -> Bool:
  all_ok(obs(tr, s))

def no_code(l: List<&2, HObs>, +k: Nat) -> Bool:
  match l:
    case Nil{}:
      True{}
    case Con{o, t}:
      match o:
        case O_Ok{}:
          no_code(t, k)
        case O_Rev{c}:
          Bool.and(Bool.not(Nat.is_eq(c, k)), no_code(t, k))

def eq_obs(a: HObs, b: HObs) -> Bool:
  match a b:
    case O_Ok{} O_Ok{}:
      True{}
    case O_Rev{x} O_Rev{y}:
      Nat.is_eq(x, y)
    case O_Ok{} O_Rev{y}:
      False{}
    case O_Rev{x} O_Ok{}:
      False{}

def eq_obs_list(xs: List<&2, HObs>, ys: List<&2, HObs>) -> Bool:
  match xs ys:
    case Nil{} Nil{}:
      True{}
    case Nil{} Con{h, t}:
      False{}
    case Con{h, t} Nil{}:
      False{}
    case Con{x, xt} Con{y, yt}:
      Bool.and(eq_obs(x, y), eq_obs_list(xt, yt))

