# 
def obsv_diff_zero(s: HSt) -> Bool:
  match s:
    case HSt{+stage, +seq, +mirror, +acc, +tier, +locked, +halted, +alert, +overflow, +breach, +diff_zero, +parity, +log}:
      diff_zero

# 
def obsv_parity(s: HSt) -> Bool:
  match s:
    case HSt{+stage, +seq, +mirror, +acc, +tier, +locked, +halted, +alert, +overflow, +breach, +diff_zero, +parity, +log}:
      parity

# 
def obsv_seq_eq_mirror(s: HSt) -> Bool:
  match s:
    case HSt{+stage, +seq, +mirror, +acc, +tier, +locked, +halted, +alert, +overflow, +breach, +diff_zero, +parity, +log}:
      Nat.is_eq(seq, mirror)

# initial state: 
def s0() -> HSt:
  HSt{0n, 0n, 0n, 0n, 1n, False{}, False{}, False{}, False{}, False{}, True{}, False{}, Nil{}}


# the reachable states: s0, and one step from a reachable state (I8)
type Reach<-s: HSt> is Type:
  R0{e: {s == s0() : HSt}}
  RStep{a: HAct, p: HSt, r: Reach<p>, e: {s == step(a, p) : HSt}}
