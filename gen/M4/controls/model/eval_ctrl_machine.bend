      False{}
    case A_lock_restore{}:
      False{}
    case A_add_sub_cancel{_}:
      False{}
    case A_step_mirror{_}:
      False{}
    case A_add_acc{_}:
      True{}
    case A_check_cap{_}:
      False{}
    case A_check_window{_, _}:
      False{}
    case A_promote_tier{_}:
      False{}

