def cost(tr: List<&2, HAct>) -> Nat:
  match tr:
    case Nil{}:
      0n
    case Con{a, rest}:
      match a:
        case A_advance_stage{}:
          Nat.add(0n, cost(rest))
        case A_bump_both{}:
          Nat.add(0n, cost(rest))
        case A_flip_twice{}:
          Nat.add(0n, cost(rest))
        case A_lock_restore{}:
          Nat.add(0n, cost(rest))
        case A_add_sub_cancel{_}:
          Nat.add(0n, cost(rest))
        case A_step_mirror{_}:
          Nat.add(0n, cost(rest))
        case A_add_acc{_}:
          Nat.add(0n, cost(rest))
        case A_check_cap{_}:
          Nat.add(0n, cost(rest))
        case A_check_window{_, _}:
          Nat.add(0n, cost(rest))
        case A_promote_tier{_}:
          Nat.add(0n, cost(rest))

def elapsed(tr: List<&2, HAct>) -> Nat:
  match tr:
    case Nil{}:
      0n
    case Con{a, rest}:
      match a:
        case A_advance_stage{}:
          Nat.add(0n, elapsed(rest))
        case A_bump_both{}:
          Nat.add(0n, elapsed(rest))
        case A_flip_twice{}:
          Nat.add(0n, elapsed(rest))
        case A_lock_restore{}:
          Nat.add(0n, elapsed(rest))
        case A_add_sub_cancel{_}:
          Nat.add(0n, elapsed(rest))
        case A_step_mirror{_}:
          Nat.add(0n, elapsed(rest))
        case A_add_acc{_}:
          Nat.add(0n, elapsed(rest))
        case A_check_cap{_}:
          Nat.add(0n, elapsed(rest))
        case A_check_window{_, _}:
          Nat.add(0n, elapsed(rest))
        case A_promote_tier{_}:
          Nat.add(0n, elapsed(rest))

# actions of a permissionless principal class (no permission guard on the caller; holon.diagram.principals): the class X of DISCH
def perm(a: HAct) -> Bool:
  match a:
    case A_advance_stage{}:
      True{}
    case A_bump_both{}:
      True{}
    case A_flip_twice{}:
      True{}
    case A_lock_restore{}:
      True{}
    case A_add_sub_cancel{_}:
      True{}
    case A_step_mirror{_}:
      True{}
    case A_add_acc{_}:
      True{}
    case A_check_cap{_}:
      True{}
    case A_check_window{_, _}:
      True{}
    case A_promote_tier{_}:
      True{}

# principal class any (any): permission predicate none
def perm_any(a: HAct, who: Nat) -> Bool:
  match a:
    case A_advance_stage{}:
      True{}
    case A_bump_both{}:
      True{}
    case A_flip_twice{}:
      True{}
    case A_lock_restore{}:
      True{}
    case A_add_sub_cancel{_}:
      True{}
    case A_step_mirror{_}:
      True{}
    case A_add_acc{_}:
      True{}
    case A_check_cap{_}:
      True{}
    case A_check_window{_, _}:
      True{}
    case A_promote_tier{_}:
      True{}

# 
def obsv_stage(s: HSt) -> Nat:
  match s:
    case HSt{+stage, +seq, +mirror, +acc, +tier, +locked, +halted, +alert, +overflow, +breach, +diff_zero, +parity, +log}:
      stage

# 
def obsv_seq(s: HSt) -> Nat:
  match s:
    case HSt{+stage, +seq, +mirror, +acc, +tier, +locked, +halted, +alert, +overflow, +breach, +diff_zero, +parity, +log}:
      seq

# 
def obsv_mirror(s: HSt) -> Nat:
  match s:
    case HSt{+stage, +seq, +mirror, +acc, +tier, +locked, +halted, +alert, +overflow, +breach, +diff_zero, +parity, +log}:
      mirror

# 
def obsv_acc(s: HSt) -> Nat:
  match s:
    case HSt{+stage, +seq, +mirror, +acc, +tier, +locked, +halted, +alert, +overflow, +breach, +diff_zero, +parity, +log}:
      acc

# 
def obsv_tier(s: HSt) -> Nat:
  match s:
    case HSt{+stage, +seq, +mirror, +acc, +tier, +locked, +halted, +alert, +overflow, +breach, +diff_zero, +parity, +log}:
      tier

# 
def obsv_locked(s: HSt) -> Bool:
  match s:
    case HSt{+stage, +seq, +mirror, +acc, +tier, +locked, +halted, +alert, +overflow, +breach, +diff_zero, +parity, +log}:
      locked

# 
def obsv_halted(s: HSt) -> Bool:
  match s:
    case HSt{+stage, +seq, +mirror, +acc, +tier, +locked, +halted, +alert, +overflow, +breach, +diff_zero, +parity, +log}:
      halted

# 
def obsv_alert(s: HSt) -> Bool:
  match s:
    case HSt{+stage, +seq, +mirror, +acc, +tier, +locked, +halted, +alert, +overflow, +breach, +diff_zero, +parity, +log}:
      alert

# 
def obsv_overflow(s: HSt) -> Bool:
  match s:
