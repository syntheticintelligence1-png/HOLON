# the per-step bundle of a walk of the graph (C.Cons), from its WalkOk evidence
def cons_of(+h: M.R_BatchHeaderV1, w: List<&2, C.Step>, +u: Nat, ok: C.WalkOk(w, Laws.graph(), u)) -> C.Cons(Laws.Car, Laws.act, v => phi(h, v), w, Laws.graph(), u):
  match w:
    case Nil{}:
      Unit{}
    case Con{+s, t}:
      match ok:
        case (o, rest):
          (step_fact(h, s, u, o), cons_of(h, t, C.next_v(s, Laws.graph(), u), rest))

# ---------------------------------------------------------------- the instance law (Thm 6.4 (ii))
def Laws.basis_sufficient_header_length_v1(h, p, q, vp, vq, e):
  C.core_parallel_agree(Laws.Car, Laws.act, v => phi(h, v), p, q, Laws.graph(), 0n, e, cons_of(h, p, 0n, vp), cons_of(h, q, 0n, vq), Laws.run(p, Laws.start(h)), Laws.run(q, Laws.start(h)), runto_run(p, Laws.start(h)), runto_run(q, Laws.start(h)))

# ---------------------------------------------------------------- the certificates (rule T6)

def Laws.const_read_p_batchheaderbytes_version_v1(h):
  %bridge_const_read_p_batchheaderbytes_version_v1(h) : {M.BatchHeaderBytes_Version(M.BatchHeaderV1_Bytes(A0.pin_h(h))) == {Some{_} : Maybe<&2, List<&2, U32>>} : Maybe<&2, List<&2, U32>>}
  Equal.cong(Laws.Car, Maybe<&2, List<&2, U32>>, un3, Laws.run([C.Fwd{1n}, C.Fwd{14n}], Laws.start(h)), Laws.run([C.Fwd{0n}, C.Fwd{38n}, C.Fwd{39n}], Laws.start(h)), Laws.basis_sufficient_header_length_v1(h, [C.Fwd{1n}, C.Fwd{14n}], [C.Fwd{0n}, C.Fwd{38n}, C.Fwd{39n}], ({==}, ({==}, Unit{})), ({==}, ({==}, ({==}, Unit{}))), {==}))

def Laws.const_read_q_batchheaderbytes_sequencersetverifyhash_v1(h):
  %bridge_const_read_q_batchheaderbytes_sequencersetverifyhash_v1(h) : {M.BatchHeaderBytes_SequencerSetVerifyHash(M.enc_sol(Laws.sigma(A0.pin_h(h)))) == {Some{_} : Maybe<&2, List<&2, U32>>} : Maybe<&2, List<&2, U32>>}
  Equal.cong(Laws.Car, Maybe<&2, List<&2, U32>>, un3, Laws.run([C.Fwd{0n}, C.Fwd{2n}, C.Fwd{12n}], Laws.start(h)), Laws.run([C.Fwd{32n}, C.Fwd{33n}], Laws.start(h)), Laws.basis_sufficient_header_length_v1(h, [C.Fwd{0n}, C.Fwd{2n}, C.Fwd{12n}], [C.Fwd{32n}, C.Fwd{33n}], ({==}, ({==}, ({==}, Unit{}))), ({==}, ({==}, Unit{})), {==}))

def Laws.weak_image_p_batchheaderbytes_blobcommithash_batchheaderbytes_blobversionedhash_v1(h):
  Equal.cong(Laws.Car, Maybe<&2, List<&2, U32>>, un3, Laws.run([C.Fwd{1n}, C.Fwd{4n}], Laws.start(h)), Laws.run([C.Fwd{1n}, C.Fwd{5n}], Laws.start(h)), Laws.basis_sufficient_header_length_v1(h, [C.Fwd{1n}, C.Fwd{4n}], [C.Fwd{1n}, C.Fwd{5n}], ({==}, ({==}, Unit{})), ({==}, ({==}, Unit{})), {==}))

