# the tree walk of every vertex (rule T4)
def tree(v: Nat) -> List<&2, C.Step>:
  match v:
    case 0n:
      Nil{}
    case 1n:
      [C.Fwd{0n}]
    case 2n:
      [C.Fwd{1n}]
    case 3n:
      [C.Fwd{1n}, C.Fwd{14n}]
    case 4n:
      [C.Fwd{1n}, C.Fwd{3n}]
    case 5n:
      [C.Fwd{1n}, C.Fwd{10n}]
    case 6n:
      [C.Fwd{1n}, C.Fwd{15n}]
    case 7n:
