/-
  HOLON theory core I (whitepaper §3.1-3.3, §6: Lemma 6.2, Thm 6.3, Thm 6.4, Cor 6.5), stated over a directed
  multigraph whose edges are labelled by maps of one carrier type α. Hand-proved once (human answer Q14b).
  GENERATED by holon.gen.theory (I42); the definitions and theorem statements are frozen in
  spec/M3/lib/theory_core.json. No namespace: holon.lean's axiom audit prints each theorem by its bare name.
-/
set_option autoImplicit false

/-- A step traverses an edge forwards or backwards (§3.1: walks may traverse edges backwards). -/
inductive Step where
  | fwd (e : Nat)
  | bwd (e : Nat)

/-- An edge: source, target, and whether it carries an inverse (it is in the invertible fragment, Def 4.4). -/
structure Edge where
  src : Nat
  tgt : Nat
  inv : Bool

def Step.inv : Step → Step
  | .fwd e => .bwd e
  | .bwd e => .fwd e

def stepOk (G : List Edge) (u : Nat) : Step → Bool
  | .fwd e => match G[e]? with
    | some d => d.src == u
    | none => false
  | .bwd e => match G[e]? with
    | some d => d.inv && d.tgt == u
    | none => false

def nextV (G : List Edge) (u : Nat) : Step → Nat
  | .fwd e => match G[e]? with
    | some d => d.tgt
    | none => u
  | .bwd e => match G[e]? with
    | some d => d.src
    | none => u

def walkOk (G : List Edge) : Nat → List Step → Bool
  | _, [] => true
  | u, s :: t => stepOk G u s && walkOk G (nextV G u s) t

def walkLast (G : List Edge) : Nat → List Step → Nat
  | u, [] => u
  | u, s :: t => walkLast G (nextV G u s) t

/-- The inverse walk: reversed, each step inverted. -/
def walkRev (w : List Step) : List Step := (w.map Step.inv).reverse

/-- The holonomy (transport) of a walk: its steps' maps composed in diagrammatic order (§3.1, §3.3). -/
def run {α : Type} (act : Step → α → α) : List Step → α → α
  | [], x => x
  | s :: t, x => run act t (act s x)

/-- The fragment's maps are bijections between reachable sets: every edge's forward map sends R_src into R_tgt and
its backward map R_tgt into R_src, each undoing the other there (Def 4.4, §3.3). -/
def Bijective {α : Type} (G : List Edge) (act : Step → α → α) (R : Nat → α → Prop) : Prop :=
  (∀ (e : Nat) (d : Edge), G[e]? = some d → d.inv = true) ∧
  (∀ (e : Nat) (d : Edge) x, G[e]? = some d → R d.src x → R d.tgt (act (.fwd e) x) ∧ act (.bwd e) (act (.fwd e) x) = x) ∧
  (∀ (e : Nat) (d : Edge) y, G[e]? = some d → R d.tgt y → R d.src (act (.bwd e) y) ∧ act (.fwd e) (act (.bwd e) y) = y)

/-- A spanning tree rooted at r over the vertices v < n, given by its tree walks t v (§3.2): each t v is a walk of G
from r to v; t r is empty; every edge's endpoints are vertices; and every tree edge extends the tree walk of one
endpoint to the other. -/
def SpanningTree (G : List Edge) (n r : Nat) (t : Nat → List Step) (tree : Nat → Bool) : Prop :=
  r < n ∧ t r = [] ∧
  (∀ v, v < n → walkOk G r (t v) = true ∧ walkLast G r (t v) = v) ∧
  (∀ (e : Nat) (d : Edge), G[e]? = some d → d.src < n ∧ d.tgt < n) ∧
  (∀ (e : Nat) (d : Edge), G[e]? = some d → tree e = true → t d.tgt = t d.src ++ [.fwd e] ∨ t d.src = t d.tgt ++ [.bwd e])

/-- The fundamental cycle of edge e: t_src · e · t_tgt⁻¹ (§3.2). -/
def fundCycle (t : Nat → List Step) (e : Nat) (d : Edge) : List Step := t d.src ++ .fwd e :: walkRev (t d.tgt)

/-- (i) every closed walk has identity holonomy on R. -/
def ClosedIdentity {α : Type} (G : List Edge) (n : Nat) (act : Step → α → α) (R : Nat → α → Prop) : Prop :=
  ∀ u γ y, u < n → walkOk G u γ = true → walkLast G u γ = u → R u y → run act γ y = y

/-- (ii) all parallel walks agree on R. -/
def ParallelAgree {α : Type} (G : List Edge) (n : Nat) (act : Step → α → α) (R : Nat → α → Prop) : Prop :=
  ∀ u p q y, u < n → walkOk G u p = true → walkOk G u q = true → walkLast G u p = walkLast G u q → R u y →
    run act p y = run act q y

/-- (iii) every fundamental cycle has identity holonomy on R_root (non-tree edges; a tree edge's cycle is trivial). -/
def FundamentalIdentity {α : Type} (G : List Edge) (r : Nat) (t : Nat → List Step) (tree : Nat → Bool)
    (act : Step → α → α) (R : Nat → α → Prop) : Prop :=
  ∀ (e : Nat) (d : Edge) x, G[e]? = some d → tree e = false → R r x → run act (fundCycle t e d) x = x

/-- Valid equations on R (Def 6.1, pointwise). -/
def ValidOn {α : Type} (R : α → Prop) (f g : α → α) : Prop := ∀ x, R x → f x = g x

/-- The congruence generated by a list of equations: closed under symmetry, transitivity and whiskering on both
sides (pre-composition by a map that keeps R). -/
inductive Derivable {α : Type} (R : α → Prop) (gens : List ((α → α) × (α → α))) : (α → α) → (α → α) → Prop where
  | gen {f g : α → α} : (f, g) ∈ gens → Derivable R gens f g
  | refl (f : α → α) : Derivable R gens f f
  | symm {f g : α → α} : Derivable R gens f g → Derivable R gens g f
  | trans {f g h : α → α} : Derivable R gens f g → Derivable R gens g h → Derivable R gens f h
  | post {f g : α → α} (k : α → α) : Derivable R gens f g → Derivable R gens (k ∘ f) (k ∘ g)
  | pre {f g : α → α} (m : α → α) : (∀ x, R x → R (m x)) → Derivable R gens f g → Derivable R gens (f ∘ m) (g ∘ m)

-- holon:theorems

/- Hand proofs (Q14b), written once. Helpers first: the walk algebra (run, walkLast, walkOk over append; walkRev of a
cons), one step seen through its edge, bijectivity along a step and along a walk, and transport of potentials. -/

/-- The holonomy of a concatenation is the composite, in diagrammatic order. -/
theorem run_append {α : Type} (act : Step → α → α) :
    ∀ (p q : List Step) (x : α), run act (p ++ q) x = run act q (run act p x) := by
  intro p q
  induction p with
  | nil => intro x; rfl
  | cons s p ih => intro x; exact ih (act s x)

/-- A concatenation ends where its second part, started at the first part's end, ends. -/
theorem walkLast_append (G : List Edge) :
    ∀ (p q : List Step) (u : Nat), walkLast G u (p ++ q) = walkLast G (walkLast G u p) q := by
  intro p q
  induction p with
  | nil => intro u; rfl
  | cons s p ih => intro u; exact ih (nextV G u s)

/-- Concatenating a walk with a walk from its end gives a walk. -/
theorem walkOk_append (G : List Edge) :
    ∀ (p q : List Step) (u : Nat), walkOk G u p = true → walkOk G (walkLast G u p) q = true →
      walkOk G u (p ++ q) = true := by
  intro p q
  induction p with
  | nil => intro u _ hq; exact hq
  | cons s p ih =>
    intro u hp hq
    simp only [walkOk, Bool.and_eq_true] at hp
    show (stepOk G u s && walkOk G (nextV G u s) (p ++ q)) = true
    simp only [Bool.and_eq_true]
    exact ⟨hp.1, ih (nextV G u s) hp.2 hq⟩

/-- The inverse of a cons walk. -/
theorem walkRev_cons (s : Step) (w : List Step) : walkRev (s :: w) = walkRev w ++ [s.inv] := by
  simp only [walkRev, List.map_cons, List.reverse_cons]

/-- A step that is allowed traverses an existing edge, forwards from its source or backwards from its target. -/
theorem step_view (G : List Edge) (u : Nat) (s : Step) (h : stepOk G u s = true) :
    ∃ (e : Nat) (d : Edge), G[e]? = some d ∧ ((s = .fwd e ∧ d.src = u ∧ nextV G u s = d.tgt) ∨
      (s = .bwd e ∧ d.inv = true ∧ d.tgt = u ∧ nextV G u s = d.src)) := by
  cases s with
  | fwd e =>
    cases hd : G[e]? with
    | none => simp only [stepOk, hd, Bool.false_eq_true] at h
    | some d =>
      simp only [stepOk, hd, beq_iff_eq] at h
      refine ⟨e, d, hd, Or.inl ⟨rfl, h, ?_⟩⟩
      simp only [nextV, hd]
  | bwd e =>
    cases hd : G[e]? with
    | none => simp only [stepOk, hd, Bool.false_eq_true] at h
    | some d =>
      simp only [stepOk, hd, Bool.and_eq_true, beq_iff_eq] at h
      refine ⟨e, d, hd, Or.inr ⟨rfl, h.1, h.2, ?_⟩⟩
      simp only [nextV, hd]

/-- In an invertible fragment, the inverse step leads back. -/
theorem step_inv_ok (G : List Edge) (hinv : ∀ (e : Nat) (d : Edge), G[e]? = some d → d.inv = true)
    (u : Nat) (s : Step) (h : stepOk G u s = true) :
    stepOk G (nextV G u s) s.inv = true ∧ nextV G (nextV G u s) s.inv = u := by
  obtain ⟨e, d, hd, ⟨rfl, rfl, hn⟩ | ⟨rfl, _, rfl, hn⟩⟩ := step_view G u s h
  · rw [hn]
    have hi := hinv e d hd
    refine ⟨?_, ?_⟩
    · simp only [Step.inv, stepOk, hd, hi, Bool.true_and, beq_iff_eq]
    · simp only [Step.inv, nextV, hd]
  · rw [hn]
    refine ⟨?_, ?_⟩
    · simp only [Step.inv, stepOk, hd, beq_iff_eq]
    · simp only [Step.inv, nextV, hd]

/-- Bijectivity along one step, forwards. -/
theorem step_bij {α : Type} (G : List Edge) (act : Step → α → α) (R : Nat → α → Prop)
    (hbij : Bijective G act R) (u : Nat) (s : Step) (x : α) (h : stepOk G u s = true) (hx : R u x) :
    R (nextV G u s) (act s x) ∧ act s.inv (act s x) = x := by
  obtain ⟨e, d, hd, ⟨rfl, rfl, hn⟩ | ⟨rfl, _, rfl, hn⟩⟩ := step_view G u s h
  · rw [hn]; exact hbij.2.1 e d x hd hx
  · rw [hn]; exact hbij.2.2 e d x hd hx

/-- Bijectivity along one step, backwards. -/
theorem step_bij_back {α : Type} (G : List Edge) (act : Step → α → α) (R : Nat → α → Prop)
    (hbij : Bijective G act R) (u : Nat) (s : Step) (z : α) (h : stepOk G u s = true)
    (hz : R (nextV G u s) z) :
    R u (act s.inv z) ∧ act s (act s.inv z) = z := by
  obtain ⟨e, d, hd, ⟨rfl, rfl, hn⟩ | ⟨rfl, _, rfl, hn⟩⟩ := step_view G u s h
  · rw [hn] at hz; exact hbij.2.2 e d z hd hz
  · rw [hn] at hz; exact hbij.2.1 e d z hd hz

/-- Bijectivity along a walk, forwards: the walk keeps R and its inverse undoes it. -/
theorem walk_fwd {α : Type} (G : List Edge) (act : Step → α → α) (R : Nat → α → Prop)
    (hbij : Bijective G act R) :
    ∀ w u x, walkOk G u w = true → R u x →
      R (walkLast G u w) (run act w x) ∧ run act (walkRev w) (run act w x) = x := by
  intro w
  induction w with
  | nil => intro u x _ hx; exact ⟨hx, rfl⟩
  | cons s t ih =>
    intro u x hw hx
    simp only [walkOk, Bool.and_eq_true] at hw
    have h2 := step_bij G act R hbij u s x hw.1 hx
    have h1 := ih (nextV G u s) (act s x) hw.2 h2.1
    refine ⟨h1.1, ?_⟩
    rw [walkRev_cons, run_append]
    show act s.inv (run act (walkRev t) (run act t (act s x))) = x
    rw [h1.2]
    exact h2.2

/-- Bijectivity along a walk, backwards: the inverse walk lands in R and the walk undoes it. -/
theorem walk_bwd {α : Type} (G : List Edge) (act : Step → α → α) (R : Nat → α → Prop)
    (hbij : Bijective G act R) :
    ∀ w u y, walkOk G u w = true → R (walkLast G u w) y →
      R u (run act (walkRev w) y) ∧ run act w (run act (walkRev w) y) = y := by
  intro w
  induction w with
  | nil => intro u y _ hy; exact ⟨hy, rfl⟩
  | cons s t ih =>
    intro u y hw hy
    simp only [walkOk, Bool.and_eq_true] at hw
    have h1 := ih (nextV G u s) y hw.2 hy
    have h2 := step_bij_back G act R hbij u s _ hw.1 h1.1
    rw [walkRev_cons, run_append]
    refine ⟨h2.1, ?_⟩
    show run act t (act s (act s.inv (run act (walkRev t) y))) = y
    rw [h2.2]
    exact h1.2

/-- In an invertible fragment the inverse walk is a walk from the end back to the start. -/
theorem walkRev_ok (G : List Edge) (hinv : ∀ (e : Nat) (d : Edge), G[e]? = some d → d.inv = true) :
    ∀ w u, walkOk G u w = true →
      walkOk G (walkLast G u w) (walkRev w) = true ∧ walkLast G (walkLast G u w) (walkRev w) = u := by
  intro w
  induction w with
  | nil => intro u _; exact ⟨rfl, rfl⟩
  | cons s t ih =>
    intro u hw
    simp only [walkOk, Bool.and_eq_true] at hw
    have h1 := ih (nextV G u s) hw.2
    have h2 := step_inv_ok G hinv u s hw.1
    rw [walkRev_cons]
    show walkOk G (walkLast G (nextV G u s) t) (walkRev t ++ [s.inv]) = true ∧
      walkLast G (walkLast G (nextV G u s) t) (walkRev t ++ [s.inv]) = u
    refine ⟨walkOk_append G _ _ _ h1.1 ?_, ?_⟩
    · rw [h1.2]
      show (stepOk G (nextV G u s) s.inv && true) = true
      rw [h2.1]
      rfl
    · rw [walkLast_append, h1.2]
      exact h2.2

/-- Transport: if every step carries the potential of the vertex it leaves to that of the vertex it reaches, so does
every walk. -/
theorem transport {α : Type} (G : List Edge) (act : Step → α → α) (P : α → Prop) (phi : Nat → α → α)
    (hstep : ∀ u s x, stepOk G u s = true → P x → act s (phi u x) = phi (nextV G u s) x) :
    ∀ w u x, walkOk G u w = true → P x → run act w (phi u x) = phi (walkLast G u w) x := by
  intro w
  induction w with
  | nil => intro u x _ _; rfl
  | cons s t ih =>
    intro u x hw hx
    simp only [walkOk, Bool.and_eq_true] at hw
    show run act t (act s (phi u x)) = phi (walkLast G (nextV G u s) t) x
    rw [hstep u s x hw.1 hx]
    exact ih (nextV G u s) x hw.2 hx

/-- Potentials respected by every edge forwards are respected by every step (backwards by bijectivity). -/
theorem step_of_cons {α : Type} (G : List Edge) (act : Step → α → α) (R : Nat → α → Prop) (r : Nat)
    (hbij : Bijective G act R) (phi : Nat → α → α)
    (hcons : ∀ (e : Nat) (d : Edge) x, G[e]? = some d → R r x → act (.fwd e) (phi d.src x) = phi d.tgt x)
    (hsrc : ∀ (e : Nat) (d : Edge) x, G[e]? = some d → R r x → R d.src (phi d.src x)) :
    ∀ u s x, stepOk G u s = true → R r x → act s (phi u x) = phi (nextV G u s) x := by
  intro u s x h hx
  obtain ⟨e, d, hd, ⟨rfl, rfl, hn⟩ | ⟨rfl, _, rfl, hn⟩⟩ := step_view G u s h
  · rw [hn]
    exact hcons e d x hd hx
  · rw [hn, ← hcons e d x hd hx]
    exact (hbij.2.1 e d _ hd (hsrc e d x hd hx)).2

/-- Cor 6.5 (⇐), shared by cor_6_5_flat and thm_6_4_iii_i. -/
theorem flat_core {α : Type} (G : List Edge) (n r : Nat) (act : Step → α → α) (R : Nat → α → Prop)
    (hbij : Bijective G act R) (phi : Nat → α → α)
    (hcons : ∀ (e : Nat) (d : Edge) x, G[e]? = some d → R r x → act (.fwd e) (phi d.src x) = phi d.tgt x)
    (hreach : ∀ v x, v < n → R r x → R v (phi v x))
    (honto : ∀ v y, v < n → R v y → ∃ x, R r x ∧ phi v x = y)
    (hends : ∀ (e : Nat) (d : Edge), G[e]? = some d → d.src < n ∧ d.tgt < n) :
    ClosedIdentity G n act R := by
  intro u γ y hu hγ hl hy
  obtain ⟨x, hx, rfl⟩ := honto u y hu hy
  have hstep := step_of_cons G act R r hbij phi hcons
    (fun e d x hd hx => hreach d.src x (hends e d hd).1 hx)
  have h := transport G act (R r) phi hstep γ u x hγ hx
  rw [hl] at h
  exact h

/-- Parallel agreement makes the tree walks' maps potentials (edge by edge). -/
theorem par_potential {α : Type} (G : List Edge) (n r : Nat) (t : Nat → List Step) (tree : Nat → Bool)
    (act : Step → α → α) (R : Nat → α → Prop) (hT : SpanningTree G n r t tree)
    (h2 : ParallelAgree G n act R) :
    ∀ (e : Nat) (d : Edge) x, G[e]? = some d → R r x →
      act (.fwd e) (run act (t d.src) x) = run act (t d.tgt) x := by
  intro e d x hd hx
  have hsw := hT.2.2.1 d.src (hT.2.2.2.1 e d hd).1
  have htw := hT.2.2.1 d.tgt (hT.2.2.2.1 e d hd).2
  have hstep : walkOk G (walkLast G r (t d.src)) [.fwd e] = true := by
    rw [hsw.2]
    simp only [walkOk, stepOk, hd, beq_iff_eq, Bool.and_true]
  have hok := walkOk_append G (t d.src) [.fwd e] r hsw.1 hstep
  have hlast : walkLast G r (t d.src ++ [.fwd e]) = walkLast G r (t d.tgt) := by
    rw [walkLast_append, hsw.2, htw.2]
    simp only [walkLast, nextV, hd]
  have h := h2 r (t d.src ++ [.fwd e]) (t d.tgt) x hT.1 hok htw.1 hlast hx
  rw [run_append] at h
  exact h

/-- Lemma 6.2 (congruence): checking a generating set establishes the congruence it generates. -/
theorem lemma_6_2 {α : Type} (R : α → Prop) (gens : List ((α → α) × (α → α)))
    (hgens : ∀ fg, fg ∈ gens → ValidOn R fg.1 fg.2) :
    ∀ f g, Derivable R gens f g → ValidOn R f g := by
  intro f g h
  induction h with
  | gen hm => exact hgens _ hm
  | refl f => intro x _; rfl
  | symm _ ih => intro x hx; exact (ih x hx).symm
  | trans _ _ ih1 ih2 => intro x hx; exact (ih1 x hx).trans (ih2 x hx)
  | post k _ ih => intro x hx; exact congrArg k (ih x hx)
  | pre m hm _ ih => intro x hx; exact ih (m x) (hm x hx)

/-- Thm 6.3 (domain coherence is local), into: if every step maps R into R, so does every walk. -/
theorem thm_6_3_into {α : Type} (G : List Edge) (act : Step → α → α) (R : Nat → α → Prop)
    (pres : ∀ u s x, stepOk G u s = true → R u x → R (nextV G u s) (act s x)) :
    ∀ w u x, walkOk G u w = true → R u x → R (walkLast G u w) (run act w x) := by
  intro w
  induction w with
  | nil => intro u x _ hx; exact hx
  | cons s t ih =>
    intro u x hw hx
    simp only [walkOk, Bool.and_eq_true] at hw
    exact ih (nextV G u s) (act s x) hw.2 (pres u s x hw.1 hx)

/-- Thm 6.3, onto: if every step maps R onto R, so does every walk. -/
theorem thm_6_3_onto {α : Type} (G : List Edge) (act : Step → α → α) (R : Nat → α → Prop)
    (onto : ∀ u s y, stepOk G u s = true → R (nextV G u s) y → ∃ x, R u x ∧ act s x = y) :
    ∀ w u y, walkOk G u w = true → R (walkLast G u w) y → ∃ x, R u x ∧ run act w x = y := by
  intro w
  induction w with
  | nil => intro u y _ hy; exact ⟨y, hy, rfl⟩
  | cons s t ih =>
    intro u y hw hy
    simp only [walkOk, Bool.and_eq_true] at hw
    obtain ⟨x', hx', hrun⟩ := ih (nextV G u s) y hw.2 hy
    obtain ⟨x, hx, hact⟩ := onto u s x' hw.1 hx'
    refine ⟨x, hx, ?_⟩
    show run act t (act s x) = y
    rw [hact]
    exact hrun

/-- Thm 6.3, localization: a mismatch on a composite implies a mismatch on some single step. If a walk carries a
value of R_u outside R at its end, then some step of it, taken from a value its prefix keeps in R, leaves R. -/
theorem thm_6_3_local {α : Type} (G : List Edge) (act : Step → α → α) (R : Nat → α → Prop)
    (dec : ∀ v x, Decidable (R v x)) :
    ∀ w u x, walkOk G u w = true → R u x → ¬ R (walkLast G u w) (run act w x) →
      ∃ pre s post, w = pre ++ s :: post ∧ stepOk G (walkLast G u pre) s = true ∧
        R (walkLast G u pre) (run act pre x) ∧ ¬ R (nextV G (walkLast G u pre) s) (act s (run act pre x)) := by
  intro w
  induction w with
  | nil => intro u x _ hx hn; exact absurd hx hn
  | cons s t ih =>
    intro u x hw hx hn
    simp only [walkOk, Bool.and_eq_true] at hw
    cases dec (nextV G u s) (act s x) with
    | isTrue h =>
      obtain ⟨pre, s', post, hw', hs', hr', hn'⟩ := ih (nextV G u s) (act s x) hw.2 h hn
      exact ⟨s :: pre, s', post, by rw [hw', List.cons_append], hs', hr', hn'⟩
    | isFalse h =>
      exact ⟨[], s, t, rfl, hw.1, hx, h⟩

/-- Thm 6.4 (iii) ⇒ (i): for a connected, domain-coherent invertible fragment with spanning tree T, if every
fundamental cycle has identity holonomy then every closed walk does. -/
theorem thm_6_4_iii_i {α : Type} (G : List Edge) (n r : Nat) (t : Nat → List Step) (tree : Nat → Bool)
    (act : Step → α → α) (R : Nat → α → Prop)
    (hbij : Bijective G act R) (hT : SpanningTree G n r t tree)
    (h3 : FundamentalIdentity G r t tree act R) :
    ClosedIdentity G n act R := by
  have hreach : ∀ v x, v < n → R r x → R v (run act (t v) x) := by
    intro v x hv hx
    have h := (walk_fwd G act R hbij (t v) r x (hT.2.2.1 v hv).1 hx).1
    rw [(hT.2.2.1 v hv).2] at h
    exact h
  have honto : ∀ v y, v < n → R v y → ∃ x, R r x ∧ run act (t v) x = y := by
    intro v y hv hy
    have htv := hT.2.2.1 v hv
    have hy' : R (walkLast G r (t v)) y := by
      rw [htv.2]
      exact hy
    have h := walk_bwd G act R hbij (t v) r y htv.1 hy'
    exact ⟨run act (walkRev (t v)) y, h.1, h.2⟩
  have hcons : ∀ (e : Nat) (d : Edge) x, G[e]? = some d → R r x →
      act (.fwd e) (run act (t d.src) x) = run act (t d.tgt) x := by
    intro e d x hd hx
    have hen := hT.2.2.2.1 e d hd
    have hs := hreach d.src x hen.1 hx
    have ht := hreach d.tgt x hen.2 hx
    cases htr : tree e with
    | false =>
      have hz := (hbij.2.1 e d _ hd hs).1
      have hc := h3 e d x hd htr hx
      have hc' : run act (walkRev (t d.tgt)) (act (.fwd e) (run act (t d.src) x)) = x := by
        have hc2 : run act (t d.src ++ .fwd e :: walkRev (t d.tgt)) x = x := hc
        rw [run_append] at hc2
        exact hc2
      have htw := hT.2.2.1 d.tgt hen.2
      have hz' : R (walkLast G r (t d.tgt)) (act (.fwd e) (run act (t d.src) x)) := by
        rw [htw.2]
        exact hz
      have hb := walk_bwd G act R hbij (t d.tgt) r _ htw.1 hz'
      rw [hc'] at hb
      exact hb.2.symm
    | true =>
      cases hT.2.2.2.2 e d hd htr with
      | inl h =>
        rw [h, run_append]
        rfl
      | inr h =>
        rw [h, run_append]
        exact (hbij.2.2 e d _ hd ht).2
  exact flat_core G n r act R hbij (fun v x => run act (t v) x) hcons hreach honto hT.2.2.2.1

/-- Thm 6.4 (i) ⇒ (ii): if every closed walk has identity holonomy then all parallel walks agree. -/
theorem thm_6_4_i_ii {α : Type} (G : List Edge) (n r : Nat) (t : Nat → List Step) (tree : Nat → Bool)
    (act : Step → α → α) (R : Nat → α → Prop)
    (hbij : Bijective G act R) (hT : SpanningTree G n r t tree)
    (h1 : ClosedIdentity G n act R) :
    ParallelAgree G n act R := by
  intro u p q y hu hp hq hpq hy
  have hrq := walkRev_ok G hbij.1 q u hq
  have hc : walkOk G u (p ++ walkRev q) = true := by
    apply walkOk_append G p (walkRev q) u hp
    rw [hpq]
    exact hrq.1
  have hl : walkLast G u (p ++ walkRev q) = u := by
    rw [walkLast_append, hpq]
    exact hrq.2
  have h := h1 u (p ++ walkRev q) y hu hc hl hy
  rw [run_append] at h
  have hz : R (walkLast G u q) (run act p y) := by
    rw [← hpq]
    exact (walk_fwd G act R hbij p u y hp hy).1
  have hb := (walk_bwd G act R hbij q u (run act p y) hq hz).2
  rw [h] at hb
  exact hb.symm

/-- Thm 6.4 (ii) ⇒ (iii): if all parallel walks agree then every fundamental cycle has identity holonomy. -/
theorem thm_6_4_ii_iii {α : Type} (G : List Edge) (n r : Nat) (t : Nat → List Step) (tree : Nat → Bool)
    (act : Step → α → α) (R : Nat → α → Prop)
    (hbij : Bijective G act R) (hT : SpanningTree G n r t tree)
    (h2 : ParallelAgree G n act R) :
    FundamentalIdentity G r t tree act R := by
  intro e d x hd _ hx
  have hp := par_potential G n r t tree act R hT h2 e d x hd hx
  have htw := hT.2.2.1 d.tgt (hT.2.2.2.1 e d hd).2
  show run act (t d.src ++ .fwd e :: walkRev (t d.tgt)) x = x
  rw [run_append]
  show run act (walkRev (t d.tgt)) (act (.fwd e) (run act (t d.src) x)) = x
  rw [hp]
  exact (walk_fwd G act R hbij (t d.tgt) r x htw.1 hx).2

/-- Cor 6.5 (⇒): a flat fragment has potentials: the tree walks' maps φ_v = ⟦t_v⟧ satisfy ⟦e⟧ ∘ φ_src = φ_tgt on
R_root for every edge. -/
theorem cor_6_5_potentials {α : Type} (G : List Edge) (n r : Nat) (t : Nat → List Step) (tree : Nat → Bool)
    (act : Step → α → α) (R : Nat → α → Prop)
    (hbij : Bijective G act R) (hT : SpanningTree G n r t tree)
    (h1 : ClosedIdentity G n act R) :
    ∀ (e : Nat) (d : Edge) x, G[e]? = some d → R r x → act (.fwd e) (run act (t d.src) x) = run act (t d.tgt) x := by
  exact par_potential G n r t tree act R hT (thm_6_4_i_ii G n r t tree act R hbij hT h1)

/-- Cor 6.5 (⇐): potentials that every edge respects, and that reach all of each R_v, make the fragment flat. -/
theorem cor_6_5_flat {α : Type} (G : List Edge) (n r : Nat) (act : Step → α → α) (R : Nat → α → Prop)
    (hbij : Bijective G act R) (phi : Nat → α → α)
    (hcons : ∀ (e : Nat) (d : Edge) x, G[e]? = some d → R r x → act (.fwd e) (phi d.src x) = phi d.tgt x)
    (hreach : ∀ v x, v < n → R r x → R v (phi v x))
    (honto : ∀ v y, v < n → R v y → ∃ x, R r x ∧ phi v x = y)
    (hends : ∀ (e : Nat) (d : Edge), G[e]? = some d → d.src < n ∧ d.tgt < n) :
    ClosedIdentity G n act R := by
  exact flat_core G n r act R hbij phi hcons hreach honto hends

/-- The form every basis-sufficiency instance applies (Thm 6.4 (ii) in potential form over forward walks; Cor 6.5
(<=) with no inverse): a potential that every edge's forward map respects is carried along every valid forward walk to
the potential of its last vertex. Added by the build (not a frozen statement): Bend's core_transport and
core_parallel_agree state it over per-step bundles. -/
theorem forward_transport {α : Type} (G : List Edge) (act : Step → α → α) (phi : Nat → α)
    (hcons : ∀ (e : Nat) (d : Edge), G[e]? = some d → act (.fwd e) (phi d.src) = phi d.tgt) :
    ∀ w u, (∀ s, s ∈ w → ∃ e, s = .fwd e) → walkOk G u w = true → run act w (phi u) = phi (walkLast G u w) := by
  intro w
  induction w with
  | nil => intro u _ _; rfl
  | cons s t ih =>
    intro u hf hok
    obtain ⟨e, rfl⟩ := hf s (List.mem_cons_self ..)
    simp only [walkOk, Bool.and_eq_true] at hok
    obtain ⟨h1, h2⟩ := hok
    cases hd : G[e]? with
    | none => simp [stepOk, hd] at h1
    | some d =>
      simp only [stepOk, hd, beq_iff_eq] at h1
      have hnext : nextV G u (.fwd e) = d.tgt := by simp [nextV, hd]
      have hstep : act (.fwd e) (phi u) = phi d.tgt := by rw [← h1]; exact hcons e d hd
      show run act t (act (.fwd e) (phi u)) = phi (walkLast G (nextV G u (.fwd e)) t)
      rw [hstep, hnext]
      have := ih d.tgt (fun s hs => hf s (List.mem_cons_of_mem _ hs)) (by rw [hnext] at h2; exact h2)
      exact this

/-- Parallel forward walks agree on the potentials (the instance law's form). -/
theorem forward_potential_parallel {α : Type} (G : List Edge) (act : Step → α → α) (phi : Nat → α)
    (hcons : ∀ (e : Nat) (d : Edge), G[e]? = some d → act (.fwd e) (phi d.src) = phi d.tgt) :
    ∀ p q u, (∀ s, s ∈ p → ∃ e, s = .fwd e) → (∀ s, s ∈ q → ∃ e, s = .fwd e) →
      walkOk G u p = true → walkOk G u q = true → walkLast G u p = walkLast G u q →
      run act p (phi u) = run act q (phi u) := by
  intro p q u hp hq okp okq hl
  rw [forward_transport G act phi hcons p u hp okp, forward_transport G act phi hcons q u hq okq, hl]
