# GENERATED by holon.gen.theory (I42): the theory core's proofs, hand-written once (gap T-G7) and emitted as fixed text.
import Base
import ./LAWS.bend as Laws

# ---------------------------------------------------------------- casts along equations (rewrites as top-level lemmas)
# A walk run from x2 is a walk run from x1 when x1 == x2.
def cast_x(-A: Type, -act: Laws.Step -> A -> A, +w: List<&2, Laws.Step>, -x1: A, -x2: A, -z: A, e: {x1 == x2 : A}, r: Laws.RunTo(A, act, w, x2, z)) -> Laws.RunTo(A, act, w, x1, z):
  %Equal.sym(A, x1, x2, e) : Laws.RunTo(A, act, w, _, z)
  r

# A run of w1 is a run of w2 when w1 == w2.
def cast_w(-A: Type, -act: Laws.Step -> A -> A, +w1: List<&2, Laws.Step>, +w2: List<&2, Laws.Step>, -x: A, -y: A, e: {w1 == w2 : List<&2, Laws.Step>}, r: Laws.RunTo(A, act, w1, x, y)) -> Laws.RunTo(A, act, w2, x, y):
  %e : Laws.RunTo(A, act, _, x, y)
  r

# ---------------------------------------------------------------- the inverse walk
# Reversing twice: walk_rev_go(walk_rev_go(w, acc), []) == walk_rev_go(acc, w).
def rev_go_rev(+w: List<&2, Laws.Step>, +acc: List<&2, Laws.Step>) -> {Laws.walk_rev_go(Laws.walk_rev_go(w, acc), Nil{}) == Laws.walk_rev_go(acc, w) : List<&2, Laws.Step>}:
  match w:
    case Nil{}:
      {==}
    case Con{+s, t}:
      match s:
        case Laws.Fwd{+e}:
          rev_go_rev(t, Con{Laws.Bwd{e}, acc})
        case Laws.Bwd{+e}:
          rev_go_rev(t, Con{Laws.Fwd{e}, acc})

def rev_rev(+w: List<&2, Laws.Step>) -> {Laws.walk_rev(Laws.walk_rev(w)) == w : List<&2, Laws.Step>}:
  rev_go_rev(w, Nil{})

# The inverse of a run along w carries its end back to its start, accumulating: rule of walk_rev_go.
def rev_run(-A: Type, -act: Laws.Step -> A -> A, +w: List<&2, Laws.Step>, +acc: List<&2, Laws.Step>, -x: A, -y: A, -z: A, r: Laws.RunTo(A, act, w, x, y), inv: Laws.LInv(A, act, w, x), ra: Laws.RunTo(A, act, acc, x, z)) -> Laws.RunTo(A, act, Laws.walk_rev_go(w, acc), y, z):
  match w:
    case Nil{}:
      %r : Laws.RunTo(A, act, acc, _, z)
      ra
    case Con{+s, t}:
      match inv:
        case (i0, irest):
          rev_run(A, act, t, Con{Laws.step_inv(s), acc}, act(s, x), y, z, r, irest, cast_x(A, act, acc, act(Laws.step_inv(s), act(s, x)), x, z, i0, ra))

# ---------------------------------------------------------------- Lemma 6.2's helper: a motive that is P at True only
def bool_motive(b: Bool, P: Type) -> Type:
  match b:
    case False{}:
      Unit
    case True{}:
      P

# ---------------------------------------------------------------- the walk algebra
def Laws.core_runto_functional(A, act, w, x, y, z, ry, rz):
  match w:
    case Nil{}:
      Equal.trans(A, y, x, z, Equal.sym(A, x, y, ry), rz)
    case Con{+s, t}:
      Laws.core_runto_functional(A, act, t, act(s, x), y, z, ry, rz)

def Laws.core_runto_append(A, act, p, q, x, y, z, rp, rq):
  match p:
    case Nil{}:
      %Equal.sym(A, x, y, rp) : Laws.RunTo(A, act, q, _, z)
      rq
    case Con{+s, t}:
      Laws.core_runto_append(A, act, t, q, act(s, x), y, z, rp, rq)

def Laws.core_runto_split(A, act, p, q, x, y, z, rp, r):
  match p:
    case Nil{}:
      %rp : Laws.RunTo(A, act, q, _, z)
      r
    case Con{+s, t}:
      Laws.core_runto_split(A, act, t, q, act(s, x), y, z, rp, r)

def Laws.core_runto_rev(A, act, w, x, y, r, inv):
  rev_run(A, act, w, Nil{}, x, y, x, r, inv, {==})

# ---------------------------------------------------------------- Thm 6.4 and Cor 6.5
def Laws.core_transport(A, act, phi, w, G, u, H):
  match w:
    case Nil{}:
      {==}
    case Con{+s, t}:
      match H:
        case (h0, hrest):
          cast_x(A, act, t, act(s, phi(u)), phi(Laws.next_v(s, G, u)), phi(Laws.walk_last(t, G, Laws.next_v(s, G, u))), h0, Laws.core_transport(A, act, phi, t, G, Laws.next_v(s, G, u), hrest))

def Laws.core_cycle_identity(A, act, phi, w, G, u, c, H):
  %c : Laws.RunTo(A, act, w, phi(u), phi(_))
  Laws.core_transport(A, act, phi, w, G, u, H)

def Laws.core_parallel_agree(A, act, phi, p, q, G, u, e, Hp, Hq, y, z, rp, rq):
  ey = Laws.core_runto_functional(A, act, p, phi(u), y, phi(Laws.walk_last(p, G, u)), rp, Laws.core_transport(A, act, phi, p, G, u, Hp))
  ez = Laws.core_runto_functional(A, act, q, phi(u), z, phi(Laws.walk_last(q, G, u)), rq, Laws.core_transport(A, act, phi, q, G, u, Hq))
  em = Equal.cong(Nat, A, phi, Laws.walk_last(p, G, u), Laws.walk_last(q, G, u), e)
  Equal.trans(A, y, phi(Laws.walk_last(p, G, u)), z, ey, Equal.trans(A, phi(Laws.walk_last(p, G, u)), phi(Laws.walk_last(q, G, u)), z, em, Equal.sym(A, z, phi(Laws.walk_last(q, G, u)), ez)))

def Laws.core_holonomy_parallel(A, act, p, q, x, y, z, cyc, rp, rq, inv):
  r1 = Laws.core_runto_split(A, act, p, Laws.walk_rev(q), x, y, x, rp, cyc)
  r2 = Laws.core_runto_rev(A, act, Laws.walk_rev(q), y, x, r1, inv)
  r3 = cast_w(A, act, Laws.walk_rev(Laws.walk_rev(q)), q, x, y, rev_rev(q), r2)
  Laws.core_runto_functional(A, act, q, x, y, z, r3, rq)

def Laws.core_bwd_cons(A, act, e, a, b, f, l):
  %f : {act(Laws.Bwd{e}, _) == a : A}
  l

def Laws.core_fundamental_potential(A, act, ta, e, tb, x0, pa, pb, ra, rb, cyc, inv):
  r1 = Laws.core_runto_split(A, act, ta, Con{Laws.Fwd{e}, Laws.walk_rev(tb)}, x0, pa, x0, ra, cyc)
  r2 = Laws.core_runto_rev(A, act, Laws.walk_rev(tb), act(Laws.Fwd{e}, pa), x0, r1, inv)
  r3 = cast_w(A, act, Laws.walk_rev(Laws.walk_rev(tb)), tb, x0, act(Laws.Fwd{e}, pa), rev_rev(tb), r2)
  Laws.core_runto_functional(A, act, tb, x0, act(Laws.Fwd{e}, pa), pb, r3, rb)

def Laws.core_cons_inhabited(A, a, w, G, u):
  match w:
    case Nil{}:
      Unit{}
    case Con{+s, t}:
      ({==}, Laws.core_cons_inhabited(A, a, t, G, Laws.next_v(s, G, u)))

# ---------------------------------------------------------------- Thm 6.3
def Laws.core_domain_into(A, act, R, w, G, u, H, x, y, r, m):
  match w:
    case Nil{}:
      %r : R(u, _)
      m
    case Con{+s, t}:
      match H:
        case (h0, hrest):
          Laws.core_domain_into(A, act, R, t, G, Laws.next_v(s, G, u), hrest, act(s, x), y, r, h0(x, m))

# the last step of core_domain_onto: x0 with R(u, x0) and act(s, x0) == x1 starts the walk Con{s, t}
def onto_fin(-A: Type, -act: Laws.Step -> A -> A, -R: Nat -> A -> Data, +s: Laws.Step, +t: List<&2, Laws.Step>, -u: Nat, -x1: A, -y: A, run1: Laws.RunTo(A, act, t, x1, y), p: &x:A -> (R(u, x) & {act(s, x) == x1 : A})) -> &x:A -> (R(u, x) & Laws.RunTo(A, act, Con{s, t}, x, y)):
  match p:
    case (x0, q):
      match q:
        case (r0, e0):
          (x0, (r0, cast_x(A, act, t, act(s, x0), x1, y, e0, run1)))

def onto_mid(-A: Type, -act: Laws.Step -> A -> A, -R: Nat -> A -> Data, +s: Laws.Step, +t: List<&2, Laws.Step>, +G: List<&2, Laws.Edge>, +u: Nat, -y: A, h0: @-y:A -> R(Laws.next_v(s, G, u), y) -> &x:A -> (R(u, x) & {act(s, x) == y : A}), ih: &x:A -> (R(Laws.next_v(s, G, u), x) & Laws.RunTo(A, act, t, x, y))) -> &x:A -> (R(u, x) & Laws.RunTo(A, act, Con{s, t}, x, y)):
  match ih:
    case (x1, q):
      match q:
        case (r1, run1):
          onto_fin(A, act, R, s, t, u, x1, y, run1, h0(x1, r1))

def Laws.core_domain_onto(A, act, R, w, G, u, H, y, m):
  match w:
    case Nil{}:
      (y, (m, {==}))
    case Con{+s, t}:
      match H:
        case (h0, hrest):
          onto_mid(A, act, R, s, t, G, u, y, h0, Laws.core_domain_onto(A, act, R, t, G, Laws.next_v(s, G, u), hrest, y, m))

# ---------------------------------------------------------------- Lemma 6.2
def Laws.core_cong_sym(A, B, R, f, g, H):
  x => r => Equal.sym(B, f(x), g(x), H(x, r))

def Laws.core_cong_trans(A, B, R, f, g, h, H1, H2):
  x => +r => Equal.trans(B, f(x), g(x), h(x), H1(x, r), H2(x, r))

def Laws.core_whisker_post(A, B, C, R, f, g, k, H):
  x => r => Equal.cong(B, C, k, f(x), g(x), H(x, r))

def Laws.core_whisker_pre(Z, A, B, S, R, m, f, g, H, M):
  z => s => H(m(z), M(z, s))

# ---------------------------------------------------------------- helpers for instance bundles
def Laws.core_efq_bool(P, e):
  %e : bool_motive(_, P)
  Unit{}

def Laws.core_nat_eq_of_is_eq(a, b, e):
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      Laws.core_efq_bool({0n == 1n+q : Nat}, e)
    case 1n+p 0n:
      Laws.core_efq_bool({1n+p == 0n : Nat}, e)
    case 1n+p 1n+q:
      Equal.cong(Nat, Nat, n => 1n+n, p, q, Laws.core_nat_eq_of_is_eq(p, q, e))
