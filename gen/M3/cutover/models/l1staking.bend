def x0_claimWithdrawal(+st: HSt, +ar: AR_claimWithdrawal, +en: HEnv, +kh: List<&2, HKB>) -> X_claimWithdrawal:
  X_claimWithdrawal{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}, w0(), st, st, st, st, st, w0(), w0(), w0(), 0n}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_claimWithdrawal(+st: HSt, +ar: AR_claimWithdrawal, +en: HEnv, +kh: List<&2, HKB>) -> X_claimWithdrawal:
  s_claimWithdrawal_30(x0_claimWithdrawal(st, ar, en, kh))

def xo_claimWithdrawal(x: X_claimWithdrawal) -> HOut:
  match x:
    case X_claimWithdrawal{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw, _, _, _, _, _, _, _, _, _, _}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_claimWithdrawal(+st: HSt, +ar: AR_claimWithdrawal, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_claimWithdrawal(xr_claimWithdrawal(st, ar, en, kh))

# 0 when every check of claimWithdrawal holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_claimWithdrawal(+st: HSt, +ar: AR_claimWithdrawal, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_claimWithdrawal(st, ar, en, kh))

def post_claimWithdrawal(+st: HSt, +ar: AR_claimWithdrawal, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_claimWithdrawal(st, ar, en, kh))

def logs_claimWithdrawal(+st: HSt, +ar: AR_claimWithdrawal, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_claimWithdrawal(st, ar, en, kh))

def step_claimWithdrawal(+st: HSt, +ar: AR_claimWithdrawal, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_claimWithdrawal(st, ar, en, kh), st)

