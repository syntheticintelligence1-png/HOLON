def xo_initialize(x: X_initialize) -> HOut:
  match x:
    case X_initialize{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_initialize(+st: HSt, +ar: AR_initialize, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_initialize(xr_initialize(st, ar, en, kh))

# 0 when every check of initialize holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_initialize(+st: HSt, +ar: AR_initialize, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_initialize(st, ar, en, kh))

def post_initialize(+st: HSt, +ar: AR_initialize, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_initialize(st, ar, en, kh))

def logs_initialize(+st: HSt, +ar: AR_initialize, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_initialize(st, ar, en, kh))

def step_initialize(+st: HSt, +ar: AR_initialize, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_initialize(st, ar, en, kh), st)

