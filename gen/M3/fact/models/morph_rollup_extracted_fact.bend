  M.w_add(M.w_shr_192(M.b_word(M.g_S_IRollup_BatchDataInput_parentBatchHeader(M.ga_commitBatch_batchDataInput(M.gx_commitBatch_ar(x))), 1n)), M.W{1, 0, 0, 0, 0, 0, 0, 0})

