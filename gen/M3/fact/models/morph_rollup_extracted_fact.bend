# one step: its observation and the state after it (gh_step's)
def ux_ostep(a: M.HAct, +g: M.GSt, +kh: List<&2, M.HKB>) -> UOS:
  match a:
    case M.A_addChallenger{ar, en}:
      ux_os_addChallenger(M.xr_addChallenger(M.gh_get_st(g), ar, en, kh), g)
    case M.A_batchChallengedSuccess{ar, en}:
      ux_os_batchChallengedSuccess(M.xr_batchChallengedSuccess(M.gh_get_st(g), ar, en, kh), g)
    case M.A_batchExist{ar, en}:
      ux_os_batchExist(M.xr_batchExist(M.gh_get_st(g), ar, en, kh), g)
    case M.A_batchInChallenge{ar, en}:
      ux_os_batchInChallenge(M.xr_batchInChallenge(M.gh_get_st(g), ar, en, kh), g)
    case M.A_batchInsideChallengeWindow{ar, en}:
      ux_os_batchInsideChallengeWindow(M.xr_batchInsideChallengeWindow(M.gh_get_st(g), ar, en, kh), g)
    case M.A_challengeState{ar, en}:
      ux_os_challengeState(M.xr_challengeState(M.gh_get_st(g), ar, en, kh), g)
    case M.A_claimProveRemaining{ar, en}:
      ux_os_claimProveRemaining(M.xr_claimProveRemaining(M.gh_get_st(g), ar, en, kh), g)
    case M.A_claimReward{ar, en}:
      ux_os_claimReward(M.xr_claimReward(M.gh_get_st(g), ar, en, kh), g)
    case M.A_commitBatch{ar, en}:
      ux_os_commitBatch(M.xr_commitBatch(M.gh_get_st(g), ar, en, kh), g)
    case M.A_commitBatchWithProof{ar, en}:
      ux_os_commitBatchWithProof(M.xr_commitBatchWithProof(M.gh_get_st(g), ar, en, kh), g)
    case M.A_commitState{ar, en}:
      ux_os_commitState(M.xr_commitState(M.gh_get_st(g), ar, en, kh), g)
    case M.A_finalizeBatch{ar, en}:
      ux_os_finalizeBatch(M.xr_finalizeBatch(M.gh_get_st(g), ar, en, kh), g)
    case M.A_importGenesisBatch{ar, en}:
      ux_os_importGenesisBatch(M.xr_importGenesisBatch(M.gh_get_st(g), ar, en, kh), g)
    case M.A_initialize{ar, en}:
      ux_os_initialize(M.xr_initialize(M.gh_get_st(g), ar, en, kh), g)
    case M.A_initialize2{ar, en}:
      ux_os_initialize2(M.xr_initialize2(M.gh_get_st(g), ar, en, kh), g)
    case M.A_initialize3{ar, en}:
      ux_os_initialize3(M.xr_initialize3(M.gh_get_st(g), ar, en, kh), g)
    case M.A_initialize4{ar, en}:
      ux_os_initialize4(M.xr_initialize4(M.gh_get_st(g), ar, en, kh), g)
    case M.A_isBatchFinalized{ar, en}:
      ux_os_isBatchFinalized(M.xr_isBatchFinalized(M.gh_get_st(g), ar, en, kh), g)
    case M.A_owner{ar, en}:
      ux_os_owner(M.xr_owner(M.gh_get_st(g), ar, en, kh), g)
    case M.A_paused{ar, en}:
      ux_os_paused(M.xr_paused(M.gh_get_st(g), ar, en, kh), g)
    case M.A_proveCommittedBatchState{ar, en}:
      ux_os_proveCommittedBatchState(M.xr_proveCommittedBatchState(M.gh_get_st(g), ar, en, kh), g)
    case M.A_proveState{ar, en}:
      ux_os_proveState(M.xr_proveState(M.gh_get_st(g), ar, en, kh), g)
    case M.A_receive{ar, en}:
      ux_os_receive(M.xr_receive(M.gh_get_st(g), ar, en, kh), g)
    case M.A_removeChallenger{ar, en}:
      ux_os_removeChallenger(M.xr_removeChallenger(M.gh_get_st(g), ar, en, kh), g)
    case M.A_renounceOwnership{ar, en}:
      ux_os_renounceOwnership(M.xr_renounceOwnership(M.gh_get_st(g), ar, en, kh), g)
    case M.A_revertBatch{ar, en}:
      ux_os_revertBatch(M.xr_revertBatch(M.gh_get_st(g), ar, en, kh), g)
    case M.A_setPause{ar, en}:
      ux_os_setPause(M.xr_setPause(M.gh_get_st(g), ar, en, kh), g)
    case M.A_transferOwnership{ar, en}:
      ux_os_transferOwnership(M.xr_transferOwnership(M.gh_get_st(g), ar, en, kh), g)
    case M.A_updateFinalizePeriodSeconds{ar, en}:
      ux_os_updateFinalizePeriodSeconds(M.xr_updateFinalizePeriodSeconds(M.gh_get_st(g), ar, en, kh), g)
    case M.A_updateProofWindow{ar, en}:
      ux_os_updateProofWindow(M.xr_updateProofWindow(M.gh_get_st(g), ar, en, kh), g)
    case M.A_updateRewardPercentage{ar, en}:
      ux_os_updateRewardPercentage(M.xr_updateRewardPercentage(M.gh_get_st(g), ar, en, kh), g)
    case M.A_updateRollupDelayPeriod{ar, en}:
      ux_os_updateRollupDelayPeriod(M.xr_updateRollupDelayPeriod(M.gh_get_st(g), ar, en, kh), g)
    case M.A_updateVerifier{ar, en}:
      ux_os_updateVerifier(M.xr_updateVerifier(M.gh_get_st(g), ar, en, kh), g)

def ux_obsr(t: List<&2, M.HAct>, o: UOS, +kh: List<&2, M.HKB>) -> List<&2, UOb>:
  match t o:
    case Nil{} UOS{ob, g, c}:
      Con{ob, Nil{}}
    case Con{a, rest} UOS{ob, g, c}:
      Con{ob, ux_obsr(rest, ux_ostep(a, g, kh), kh)}

# obs(t, s): the observations of running the trace t from the state s, one per step
def obs(t: List<&2, M.HAct>, +g: M.GSt, +kh: List<&2, M.HKB>) -> List<&2, UOb>:
  match t:
    case Nil{}:
      Nil{}
    case Con{a, rest}:
      ux_obsr(rest, ux_ostep(a, g, kh), kh)

# the state after a trace (the typed model's run)
def run(t: List<&2, M.HAct>, g: M.GSt, +kh: List<&2, M.HKB>) -> M.GSt:
  M.run(t, g, kh)

def fx_imp(c: Bool, b: Bool) -> Bool:
  match c:
    case True{}:
      b
    case False{}:
      True{}

def fx_ite(c: Bool, a: Bool, b: Bool) -> Bool:
  match c:
    case True{}:
      a
    case False{}:
      b

# the kernel claim (o1 and o2 and pt and c) implies d: d the consumers' equality, o1 and o2 each run's
# blobs_wf and success, pt the table and closed premises, c equal commitments (matched in that order)
def fx_k3(d: Bool, o1: Bool, o2: Bool, pt: Bool, c: Bool) -> Bool:
  match d:
    case True{}:
      True{}
    case False{}:
      match o1:
        case False{}:
          True{}
        case True{}:
          match o2:
            case False{}:
              True{}
            case True{}:
              match pt:
                case False{}:
                  True{}
                case True{}:
                  Bool.not(c)

def fx_ws_eq(a: List<&2, M.W>, b: List<&2, M.W>) -> Bool:
  match a b:
    case Nil{} Nil{}:
      True{}
    case Nil{} Con{y, ys}:
      False{}
    case Con{x, xs} Nil{}:
      False{}
    case Con{x, xs} Con{y, ys}:
      Bool.and(M.w_eq(x, y), fx_ws_eq(xs, ys))

# the top byte of a word is 0x01
def fx_top(w: M.W) -> Bool:
  match w:
    case M.W{a0, a1, a2, a3, a4, a5, a6, a7}:
      U32.is_eq(U32.and(a7, 4278190080), 16777216)

# blobs_wf on one entry: z is whether the entry is the zero word, rest the rest of the check
def fx_wfw(z: Bool, rest: Bool) -> Bool:
  match z:
    case True{}:
      False{}
    case False{}:
      rest

# blobs_wf: every entry of a blob-hash list is a nonzero word whose top byte is 0x01
def fx_wf(xs: List<&2, M.W>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{+h, t}:
      fx_wfw(M.w_eq(h, M.w0()), Bool.and(fx_top(h), fx_wf(t)))

# NZ over one hash table: no entry is the zero word
def fx_nz(xs: List<&2, M.HKB>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{h, t}:
      match h:
        case M.HKB{b, v}:
          Bool.and(M.w_nz(v), fx_nz(t))

# CF of one entry against the rest of a table: an equal value has an equal key
def fx_cf1(+b: List<&2, U32>, +v: M.W, xs: List<&2, M.HKB>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{h, t}:
      match h:
        case M.HKB{b2, v2}:
          Bool.and(fx_imp(M.w_eq(v, v2), M.b_eq(b, b2)), fx_cf1(b, v, t))

# CF over a hash table: two entries with one value have one key
def fx_cf(xs: List<&2, M.HKB>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{h, +t}:
      match h:
        case M.HKB{b, v}:
          Bool.and(fx_cf1(b, v, t), fx_cf(t))

# the table premises: cf and nz of every hash table
def fx_tabs(+kh: List<&2, M.HKB>) -> Bool:
  Bool.and(fx_cf(kh), fx_nz(kh))

# premise hyp:Hyp-Z0-kzg: the document constant ZERO_VERSIONED_HASH is the recorded value
def fx_hyp_1() -> Bool:
  M.w_eq(M.W{1011105812, 87658170, 1836807945, 3740773270, 2112761717, 1076503185, 1968490369, 17192947}, M.W{1011105812, 87658170, 1836807945, 3740773270, 2112761717, 1076503185, 1968490369, 17192947})

# a step as a call of commitBatchWithProof, or not one
type FxO_commitBatchWithProof is Data:
  FxS_commitBatchWithProof{ar: M.AR_commitBatchWithProof, en: M.HEnv}
  FxN_commitBatchWithProof{}

def fx_sel_commitBatchWithProof(x: M.HAct) -> FxO_commitBatchWithProof:
  match x:
    case M.A_addChallenger{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_batchChallengedSuccess{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_batchExist{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_batchInChallenge{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_batchInsideChallengeWindow{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_challengeState{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_claimProveRemaining{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_claimReward{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_commitBatch{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_commitBatchWithProof{ar, en}:
      FxS_commitBatchWithProof{ar, en}
    case M.A_commitState{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_finalizeBatch{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_importGenesisBatch{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_initialize{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_initialize2{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_initialize3{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_initialize4{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_isBatchFinalized{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_owner{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_paused{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_proveCommittedBatchState{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_proveState{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_receive{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_removeChallenger{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_renounceOwnership{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_revertBatch{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_setPause{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_transferOwnership{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_updateFinalizePeriodSeconds{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_updateProofWindow{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_updateRewardPercentage{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_updateRollupDelayPeriod{ar, en}:
      FxN_commitBatchWithProof{}
    case M.A_updateVerifier{ar, en}:
      FxN_commitBatchWithProof{}

# the key commitBatchWithProof writes committedBatches at (writes[0]), in its context
def fx_key_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(+x: M.X_commitBatchWithProof) -> M.W:
  M.w_add(M.w_shr_192(M.b_word(M.g_S_IRollup_BatchDataInput_parentBatchHeader(M.ga_commitBatchWithProof_batchDataInput(M.gx_commitBatchWithProof_ar(x))), 1n)), M.W{1, 0, 0, 0, 0, 0, 0, 0})

# committedBatches at k1 in st1 equals committedBatches at k2 in st2
def fx_cmeq_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(+st1: M.HSt, +k1: M.W, +st2: M.HSt, +k2: M.W, +kh: List<&2, M.HKB>) -> Bool:
  M.w_eq(M.sload(st1, M.SK{M.W{161, 0, 0, 0, 0, 0, 0, 0}, M.w0(), [M.SP_m{k1, M.w0()}]}), M.sload(st2, M.SK{M.W{161, 0, 0, 0, 0, 0, 0, 0}, M.w0(), [M.SP_m{k2, M.w0()}]}))

# the first word of committedBatches at k in st (the committed value the replay reports)
def fx_cmw_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(+st: M.HSt, +k: M.W, +kh: List<&2, M.HKB>) -> M.W:
  M.sload(st, M.SK{M.W{161, 0, 0, 0, 0, 0, 0, 0}, M.w0(), [M.SP_m{k, M.w0()}]})

# the call (ar, en) of commitBatchWithProof succeeds from s
def fx_s_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(+ar: M.AR_commitBatchWithProof, +en: M.HEnv, +s: M.GSt, +kh: List<&2, M.HKB>) -> Bool:
  U32.is_eq(M.gx_commitBatchWithProof_cd(M.xr_commitBatchWithProof(M.gh_get_st(s), ar, en, kh)), 0)

# one run's part of the premises (blobs_wf of its list) and its success
def fx_ok_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(b: List<&2, M.W>, +ar: M.AR_commitBatchWithProof, +en: M.HEnv, +s: M.GSt, +kh: List<&2, M.HKB>) -> Bool:
  Bool.and(fx_wf(b), fx_s_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(ar, en, s, kh))

# the premises on the tables and the closed hypotheses
def fx_pt_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(+kh: List<&2, M.HKB>) -> Bool:
  Bool.and(fx_tabs(kh), fx_hyp_1())

# the commitments after the two calls, at their write keys, are equal
def fx_c_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(+ar1: M.AR_commitBatchWithProof, +en1: M.HEnv, +s1: M.GSt, +ar2: M.AR_commitBatchWithProof, +en2: M.HEnv, +s2: M.GSt, +kh: List<&2, M.HKB>) -> Bool:
  fx_cmeq_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(M.gh_get_st(M.gh_go_commitBatchWithProof(M.xr_commitBatchWithProof(M.gh_get_st(s1), ar1, en1, kh), s1)), fx_key_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(M.x0_commitBatchWithProof(M.gh_get_st(s1), ar1, en1, kh)), M.gh_get_st(M.gh_go_commitBatchWithProof(M.xr_commitBatchWithProof(M.gh_get_st(s2), ar2, en2, kh), s2)), fx_key_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(M.x0_commitBatchWithProof(M.gh_get_st(s2), ar2, en2, kh)), kh)

def fk3_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(+b1: List<&2, M.W>, +b2: List<&2, M.W>, +ar1: M.AR_commitBatchWithProof, +en1: M.HEnv, +s1: M.GSt, +ar2: M.AR_commitBatchWithProof, +en2: M.HEnv, +s2: M.GSt, +kh: List<&2, M.HKB>) -> Bool:
  fx_k3(fx_ws_eq(b1, b2), fx_ok_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(b1, ar1, en1, s1, kh), fx_ok_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(b2, ar2, en2, s2, kh), fx_pt_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(kh), fx_c_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(ar1, en1, s1, ar2, en2, s2, kh))

def fh3_kernel_Rollup_commitBatchWithProof_committedBatches_blobhash(+b1: List<&2, M.W>, +b2: List<&2, M.W>, +ar1: M.AR_commitBatchWithProof, +en1: M.HEnv, +s1: M.GSt, +ar2: M.AR_commitBatchWithProof, +en2: M.HEnv, +s2: M.GSt, +kh: List<&2, M.HKB>) -> Bool:
