def fx_gs(ok: Bool, s2: M.GSt, s: M.GSt, g2: FxG, g: FxG) -> FxR:
  match ok:
    case True{}:
      FxR{s2, g2}
    case False{}:
      FxR{s, g}

# one step of run_fact: a reverted step changes neither the state nor the companions
def fx_step(r: FxR, a: M.HAct, +kh: List<&2, M.HKB>) -> FxR:
  match r:
    case FxR{+s, +g}:
      match a:
        case M.A_addChallenger{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_addChallenger_cd(M.xr_addChallenger(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_addChallenger{ar, en}, s, kh), s, fx_gu_addChallenger(M.x0_addChallenger(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_batchChallengedSuccess{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_batchChallengedSuccess_cd(M.xr_batchChallengedSuccess(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_batchChallengedSuccess{ar, en}, s, kh), s, fx_gu_batchChallengedSuccess(M.x0_batchChallengedSuccess(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_batchExist{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_batchExist_cd(M.xr_batchExist(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_batchExist{ar, en}, s, kh), s, fx_gu_batchExist(M.x0_batchExist(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_batchInChallenge{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_batchInChallenge_cd(M.xr_batchInChallenge(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_batchInChallenge{ar, en}, s, kh), s, fx_gu_batchInChallenge(M.x0_batchInChallenge(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_batchInsideChallengeWindow{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_batchInsideChallengeWindow_cd(M.xr_batchInsideChallengeWindow(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_batchInsideChallengeWindow{ar, en}, s, kh), s, fx_gu_batchInsideChallengeWindow(M.x0_batchInsideChallengeWindow(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_challengeState{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_challengeState_cd(M.xr_challengeState(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_challengeState{ar, en}, s, kh), s, fx_gu_challengeState(M.x0_challengeState(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_claimProveRemaining{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_claimProveRemaining_cd(M.xr_claimProveRemaining(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_claimProveRemaining{ar, en}, s, kh), s, fx_gu_claimProveRemaining(M.x0_claimProveRemaining(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_claimReward{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_claimReward_cd(M.xr_claimReward(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_claimReward{ar, en}, s, kh), s, fx_gu_claimReward(M.x0_claimReward(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_commitBatch{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_commitBatch_cd(M.xr_commitBatch(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_commitBatch{ar, en}, s, kh), s, fx_gu_commitBatch(M.x0_commitBatch(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_commitBatchWithProof{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_commitBatchWithProof_cd(M.xr_commitBatchWithProof(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_commitBatchWithProof{ar, en}, s, kh), s, fx_gu_commitBatchWithProof(M.x0_commitBatchWithProof(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_commitState{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_commitState_cd(M.xr_commitState(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_commitState{ar, en}, s, kh), s, fx_gu_commitState(M.x0_commitState(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_finalizeBatch{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_finalizeBatch_cd(M.xr_finalizeBatch(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_finalizeBatch{ar, en}, s, kh), s, fx_gu_finalizeBatch(M.x0_finalizeBatch(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_importGenesisBatch{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_importGenesisBatch_cd(M.xr_importGenesisBatch(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_importGenesisBatch{ar, en}, s, kh), s, fx_gu_importGenesisBatch(M.x0_importGenesisBatch(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_initialize{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_initialize_cd(M.xr_initialize(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_initialize{ar, en}, s, kh), s, fx_gu_initialize(M.x0_initialize(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_initialize2{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_initialize2_cd(M.xr_initialize2(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_initialize2{ar, en}, s, kh), s, fx_gu_initialize2(M.x0_initialize2(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_initialize3{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_initialize3_cd(M.xr_initialize3(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_initialize3{ar, en}, s, kh), s, fx_gu_initialize3(M.x0_initialize3(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_initialize4{+ar, +en}:
          fx_gs(U32.is_eq(M.gx_initialize4_cd(M.xr_initialize4(M.gh_get_st(s), ar, en, kh)), 0), M.gh_step(M.A_initialize4{ar, en}, s, kh), s, fx_gu_initialize4(M.x0_initialize4(M.gh_get_st(s), ar, en, kh), g), g)
        case M.A_isBatchFinalized{+ar, +en}:
