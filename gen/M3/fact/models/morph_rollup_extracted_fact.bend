# importGenesisBatch writes[2] of batchBlobVersionedHashes: a copy leaves the chooser, the literal 0 clears it, a fresh value sets the caller
def fx_gu_importGenesisBatch_2_s(cl: Bool, +x: M.X_importGenesisBatch, g: FxG) -> FxG:
