# ---- GHOST: the chooser companions and what reads them (no definition above names them) ----

# one entry of a chooser companion: key, chooser, bottom
type FxC is Data:
  FxC{k: M.W, a: M.W, b: Bool}

# a companion's value at a key: (chooser, bottom), bottom when unset
type FxV is Data:
  FxV{a: M.W, b: Bool}

def fx_vsel(c: Bool, v1: FxV, v2: FxV) -> FxV:
  match c:
    case True{}:
      v1
    case False{}:
      v2

def fx_gsel(c: Bool, g1: FxG, g2: FxG) -> FxG:
  match c:
    case True{}:
      g1
    case False{}:
      g2

def fx_get(xs: List<&2, FxC>, +k: M.W) -> FxV:
  match xs:
    case Nil{}:
      FxV{M.w0(), True{}}
    case Con{h, t}:
      match h:
        case FxC{k2, a, b}:
          fx_vsel(M.w_eq(k, k2), FxV{a, b}, fx_get(t, k))

def fx_put(xs: List<&2, FxC>, +k: M.W, a: M.W, b: Bool) -> List<&2, FxC>:
  Con{FxC{k, a, b}, xs}

# the chooser companions, one per pinned family
type FxG is Data:
  FxG{chooser_batchBlobVersionedHashes: List<&2, FxC>}

def fx_g0() -> FxG:
  FxG{Nil{}}

# the state and the companions
type FxR is Data:
  FxR{s: M.GSt, g: FxG}

def fx_gu_addChallenger(+x: M.X_addChallenger, g: FxG) -> FxG:
  g

def fx_gu_batchChallengedSuccess(+x: M.X_batchChallengedSuccess, g: FxG) -> FxG:
  g

def fx_gu_batchExist(+x: M.X_batchExist, g: FxG) -> FxG:
  g

def fx_gu_batchInChallenge(+x: M.X_batchInChallenge, g: FxG) -> FxG:
  g

def fx_gu_batchInsideChallengeWindow(+x: M.X_batchInsideChallengeWindow, g: FxG) -> FxG:
  g

def fx_gu_challengeState(+x: M.X_challengeState, g: FxG) -> FxG:
  g

def fx_gu_claimProveRemaining(+x: M.X_claimProveRemaining, g: FxG) -> FxG:
  g

def fx_gu_claimReward(+x: M.X_claimReward, g: FxG) -> FxG:
  g

# commitBatch writes[2] of batchBlobVersionedHashes: a copy leaves the chooser, the literal 0 clears it, a fresh value sets the caller
def fx_gu_commitBatch_2_s(cl: Bool, +x: M.X_commitBatch, g: FxG) -> FxG:
  match g:
    case FxG{chooser_batchBlobVersionedHashes}:
      FxG{fx_put(chooser_batchBlobVersionedHashes, M.w_add(M.w_shr_192(M.b_word(M.g_S_IRollup_BatchDataInput_parentBatchHeader(M.ga_commitBatch_batchDataInput(M.gx_commitBatch_ar(x))), 1n)), M.W{1, 0, 0, 0, 0, 0, 0, 0}), M.ge_e_caller(M.gx_commitBatch_en(x)), cl)}

def fx_gu_commitBatch_2(+x: M.X_commitBatch, +g: FxG) -> FxG:
  fx_gsel(False{}, g, fx_gu_commitBatch_2_s(False{}, x, g))

def fx_gu_commitBatch(+x: M.X_commitBatch, g: FxG) -> FxG:
  fx_gu_commitBatch_2(x, g)

# commitBatchWithProof writes[2] of batchBlobVersionedHashes: a copy leaves the chooser, the literal 0 clears it, a fresh value sets the caller
def fx_gu_commitBatchWithProof_2_s(cl: Bool, +x: M.X_commitBatchWithProof, g: FxG) -> FxG:
  match g:
    case FxG{chooser_batchBlobVersionedHashes}:
      FxG{fx_put(chooser_batchBlobVersionedHashes, M.w_add(M.w_shr_192(M.b_word(M.g_S_IRollup_BatchDataInput_parentBatchHeader(M.ga_commitBatchWithProof_batchDataInput(M.gx_commitBatchWithProof_ar(x))), 1n)), M.W{1, 0, 0, 0, 0, 0, 0, 0}), M.ge_e_caller(M.gx_commitBatchWithProof_en(x)), cl)}

def fx_gu_commitBatchWithProof_2(+x: M.X_commitBatchWithProof, +g: FxG) -> FxG:
  fx_gsel(fx_ite(M.w_nz(M.w_b(Bool.not(M.w_eq(M.sload(M.gx_commitBatchWithProof_st(x), M.SK{M.W{173, 0, 0, 0, 0, 0, 0, 0}, M.w0(), [M.SP_m{M.w_add(M.w_shr_192(M.b_word(M.g_S_IRollup_BatchDataInput_parentBatchHeader(M.ga_commitBatchWithProof_batchDataInput(M.gx_commitBatchWithProof_ar(x))), 1n)), M.W{1, 0, 0, 0, 0, 0, 0, 0}), M.w0()}]}), M.W{0, 0, 0, 0, 0, 0, 0, 0})))), True{}, False{}), g, fx_gu_commitBatchWithProof_2_s(False{}, x, g))

def fx_gu_commitBatchWithProof(+x: M.X_commitBatchWithProof, g: FxG) -> FxG:
  fx_gu_commitBatchWithProof_2(x, g)

# commitState writes[2] of batchBlobVersionedHashes: a copy leaves the chooser, the literal 0 clears it, a fresh value sets the caller
def fx_gu_commitState_2_s(cl: Bool, +x: M.X_commitState, g: FxG) -> FxG:
  match g:
    case FxG{chooser_batchBlobVersionedHashes}:
