  for -st: A -> S -> S
  for +w: List<&2, G>
  for -a: A
  for -x: S
  EqvWord(S, A, G, st, g => y => y, g => b => b, w, a, x)

law core_pow_inhabited:
  for -S: Type
  for -A: Data
  for -st: A -> S -> S
  for +n: Nat
  for -a: A
  for -x: S
