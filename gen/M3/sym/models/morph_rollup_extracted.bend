# L_sym_omega_Rollup_addChallenger_challengeState: where both orders of x (addChallenger) and y (challengeState) execute, they agree on every sink-reaching key (J3 omega)
def sy_ok_0(+g: M.GSt, +x: M.HAct, +y: M.HAct, +kh: List<&2, M.HKB>) -> Bool:
  ux_imp(Bool.and(sy_is_addChallenger(x), sy_is_challengeState(y)), sy_om_0_c2(ux_ostep(x, g, kh), ux_ostep(y, g, kh), x, y, kh))

