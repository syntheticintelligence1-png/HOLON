  ux_imp(Bool.and(U32.is_eq(sy_code(ux), 0), U32.is_eq(sy_code(uy), 0)), sy_om_0_c(ux_ostep(y, sy_post(ux), kh), ux_ostep(x, sy_post(uy), kh)))

