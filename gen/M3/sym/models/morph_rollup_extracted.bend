    case M.A_updateVerifier{ar, en}:
      sy_fits_en(en, d)

def sy_tau_uos(u: UOS, +d: M.W) -> UOS:
  match u:
    case UOS{o, g, c}:
      UOS{o, sy_tau_g(g, d), c}

# the address-keyed families' base slots: [159, 165]
def sy_akey(+b: M.W) -> Bool:
  Bool.or(M.w_eq(b, M.W{159, 0, 0, 0, 0, 0, 0, 0}), M.w_eq(b, M.W{165, 0, 0, 0, 0, 0, 0, 0}))

def sy_pi_kw(c: Bool, +k: M.W, +a: M.W, +b: M.W) -> M.W:
  match c:
    case True{}:
      sy_pw(k, a, b)
    case False{}:
      k

def sy_pi_sp(+b0: M.W, h: M.SP, +a: M.W, +b: M.W) -> M.SP:
  match h:
    case M.SP_m{k, o}:
      M.SP_m{sy_pi_kw(sy_akey(b0), k, a, b), o}

def sy_pi_p(+b0: M.W, p: List<&2, M.SP>, +a: M.W, +b: M.W) -> List<&2, M.SP>:
  match p:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{sy_pi_sp(b0, h, a, b), t}

def sy_pi_k(k: M.SK, +a: M.W, +b: M.W) -> M.SK:
  match k:
    case M.SK{+kb, ko, kp}:
      M.SK{kb, ko, sy_pi_p(kb, kp, a, b)}

def sy_shr0(w: M.W) -> M.W:
  match w:
    case M.W{a0, a1, a2, a3, a4, a5, a6, a7}:
      M.W{a0, a1, a2, a3, a4, a5, a6, a7}

def sy_shl0(w: M.W) -> M.W:
  match w:
    case M.W{a0, a1, a2, a3, a4, a5, a6, a7}:
      M.W{a0, a1, a2, a3, a4, a5, a6, a7}

def sy_get_0_160(+w: M.W) -> M.W:
  M.w_and(sy_shr0(w), M.W{4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 0, 0, 0})

def sy_put_0_160(+w: M.W, +f: M.W) -> M.W:
  M.w_or(M.w_and(w, M.W{0, 0, 0, 0, 0, 4294967295, 4294967295, 4294967295}), sy_shl0(M.w_and(f, M.W{4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 0, 0, 0})))

def sy_pi_v_0_m(c: Bool, +v: M.W, +a: M.W, +b: M.W) -> M.W:
  match c:
    case True{}:
      sy_put_0_160(v, sy_pw(sy_get_0_160(v), a, b))
    case False{}:
      v

# _owner
def sy_pi_v_0(+k: M.SK, +v: M.W, +a: M.W, +b: M.W) -> M.W:
  sy_pi_v_0_m(sy_at_0(k, M.W{51, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}), v, a, b)

def sy_pi_v_1_m(c: Bool, +v: M.W, +a: M.W, +b: M.W) -> M.W:
  match c:
    case True{}:
      sy_put_0_160(v, sy_pw(sy_get_0_160(v), a, b))
    case False{}:
      v

# batchDataStore.submitter
def sy_pi_v_1(+k: M.SK, +v: M.W, +a: M.W, +b: M.W) -> M.W:
  sy_pi_v_1_m(sy_at_1(k, M.W{162, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}, M.W{3, 0, 0, 0, 0, 0, 0, 0}), v, a, b)

def sy_shr2(w: M.W) -> M.W:
  match w:
    case M.W{a0, a1, a2, a3, a4, a5, a6, a7}:
      M.W{a2, a3, a4, a5, a6, a7, 0, 0}

def sy_shl2(w: M.W) -> M.W:
  match w:
    case M.W{a0, a1, a2, a3, a4, a5, a6, a7}:
      M.W{0, 0, a0, a1, a2, a3, a4, a5}

def sy_get_64_160(+w: M.W) -> M.W:
  M.w_and(sy_shr2(w), M.W{4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 0, 0, 0})

def sy_put_64_160(+w: M.W, +f: M.W) -> M.W:
  M.w_or(M.w_and(w, M.W{4294967295, 4294967295, 0, 0, 0, 0, 0, 4294967295}), sy_shl2(M.w_and(f, M.W{4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 0, 0, 0})))

def sy_pi_v_2_m(c: Bool, +v: M.W, +a: M.W, +b: M.W) -> M.W:
  match c:
    case True{}:
      sy_put_64_160(v, sy_pw(sy_get_64_160(v), a, b))
    case False{}:
      v

# challenges.challenger
def sy_pi_v_2(+k: M.SK, +v: M.W, +a: M.W, +b: M.W) -> M.W:
  sy_pi_v_2_m(sy_at_1(k, M.W{164, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}), v, a, b)

