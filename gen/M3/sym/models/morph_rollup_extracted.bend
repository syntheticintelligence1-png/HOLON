def sy_sk1(h: M.KV, +xs: List<&2, M.KV>, +ys: List<&2, M.KV>) -> Bool:
  match h:
    case M.KV{+k, v}:
      ux_imp(sy_sink_key(k), sy_sink_cmp(k, M.kv_get(xs, k), M.kv_get(ys, k)))

def sy_sks(zs: List<&2, M.KV>, +xs: List<&2, M.KV>, +ys: List<&2, M.KV>) -> Bool:
  match zs:
    case Nil{}:
      True{}
    case Con{h, t}:
      Bool.and(sy_sk1(h, xs, ys), sy_sks(t, xs, ys))

def sy_snk_c(b: Bool, +h: M.KV, +r: List<&2, M.KV>) -> List<&2, M.KV>:
  match b:
    case True{}:
      Con{h, r}
    case False{}:
      r

def sy_snk_h(h: M.KV, +r: List<&2, M.KV>) -> List<&2, M.KV>:
  match h:
    case M.KV{+k, v}:
      sy_snk_c(sy_sink_key(k), M.KV{k, v}, r)

# the store's sink-reaching entries, in order
def sy_snk(zs: List<&2, M.KV>) -> List<&2, M.KV>:
  match zs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      sy_snk_h(h, sy_snk(t))

# each entry's sink comparison, in order (holon.symd.run locates a counter-law's failing entry with it)
def sy_sk1s(zs: List<&2, M.KV>, +xs: List<&2, M.KV>, +ys: List<&2, M.KV>) -> List<&2, Bool>:
  match zs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{sy_sk1(h, xs, ys), sy_sk1s(t, xs, ys)}

def sy_sink_eq2(+fx: List<&2, M.KV>, +fy: List<&2, M.KV>) -> Bool:
  Bool.and(sy_sks(fx, fx, fy), sy_sks(fy, fx, fy))

def sy_sink_eq(+xs: List<&2, M.KV>, +ys: List<&2, M.KV>) -> Bool:
  sy_sink_eq2(sy_snk(xs), sy_snk(ys))

