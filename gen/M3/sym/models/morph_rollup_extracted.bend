def sy_get_0_8(+w: M.W) -> M.W:
  M.w_and(sy_shr0(w), M.W{255, 0, 0, 0, 0, 0, 0, 0})

def sy_put_0_8(+w: M.W, +f: M.W) -> M.W:
  M.w_or(M.w_and(w, M.W{4294967040, 4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 4294967295}), sy_shl0(M.w_and(f, M.W{255, 0, 0, 0, 0, 0, 0, 0})))

# a register of the role challenger: challenges.challenger
def sy_rh_challenger_0(h: M.KV, +w: M.W) -> Bool:
  match h:
    case M.KV{+k, v}:
      Bool.and(sy_at_1(k, M.W{164, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}), M.w_eq(sy_get_64_160(v), w))

def sy_rm_challenger_0(xs: List<&2, M.KV>, +w: M.W) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case Con{h, t}:
      Bool.or(sy_rh_challenger_0(h, w), sy_rm_challenger_0(t, w))

# the members of the role challenger in g (J1): 3 way(s) to be one
def sy_mem_challenger(+g: M.GSt, +w: M.W) -> Bool:
  Bool.or(M.w_nz(sy_get_0_8(M.sload(sy_st_of(g), M.SK{M.W{159, 0, 0, 0, 0, 0, 0, 0}, M.w0(), [M.SP_m{w, M.w0()}]}))), Bool.or(sy_rm_challenger_0(sy_sl(sy_st_of(g)), w), Bool.not(M.w_nz(w))))

# a register of the role submitter: batchDataStore.submitter
def sy_rh_submitter_0(h: M.KV, +w: M.W) -> Bool:
  match h:
    case M.KV{+k, v}:
      Bool.and(sy_at_1(k, M.W{162, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}, M.W{3, 0, 0, 0, 0, 0, 0, 0}), M.w_eq(sy_get_0_160(v), w))

def sy_rm_submitter_0(xs: List<&2, M.KV>, +w: M.W) -> Bool:
  match xs:
    case Nil{}:
      False{}
    case Con{h, t}:
      Bool.or(sy_rh_submitter_0(h, w), sy_rm_submitter_0(t, w))

# the members of the role submitter in g (J1): 2 way(s) to be one
def sy_mem_submitter(+g: M.GSt, +w: M.W) -> Bool:
  Bool.or(sy_rm_submitter_0(sy_sl(sy_st_of(g)), w), Bool.not(M.w_nz(w)))

def sy_at_b(k: M.SK, +b: M.W) -> Bool:
  match k:
    case M.SK{kb, ko, kp}:
      Bool.and(M.w_eq(kb, b), Bool.not(sy_p0(kp)))

