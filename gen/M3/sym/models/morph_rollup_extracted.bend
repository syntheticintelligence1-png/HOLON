  sy_pi_v_3_m(sy_at_0(k, M.W{155, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}), v, a, b)

def sy_pi_v_4_m(c: Bool, +v: M.W, +a: M.W, +b: M.W) -> M.W:
