# verifier
def sy_pi_v_5(+k: M.SK, +v: M.W, +a: M.W, +b: M.W) -> M.W:
  sy_pi_v_5_m(sy_at_0(k, M.W{156, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}), v, a, b)

# the address-typed registers: _owner, batchDataStore.submitter, challenges.challenger, messageQueue, submitterContract, verifier
def sy_pi_v(+k: M.SK, +v: M.W, +a: M.W, +b: M.W) -> M.W:
  sy_pi_v_5(k, sy_pi_v_4(k, sy_pi_v_3(k, sy_pi_v_2(k, sy_pi_v_1(k, sy_pi_v_0(k, v, a, b), a, b), a, b), a, b), a, b), a, b)

def sy_pi_kv(h: M.KV, +a: M.W, +b: M.W) -> M.KV:
  match h:
    case M.KV{+k, v}:
      M.KV{sy_pi_k(k, a, b), sy_pi_v(k, v, a, b)}

def sy_pi_kvs(xs: List<&2, M.KV>, +a: M.W, +b: M.W) -> List<&2, M.KV>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{sy_pi_kv(h, a, b), sy_pi_kvs(t, a, b)}

def sy_pi_st(s: M.HSt, +a: M.W, +b: M.W) -> M.HSt:
  match s:
    case M.HSt{sl}:
      M.HSt{sy_pi_kvs(sl, a, b)}

# π_(a,b) on a state (J2)
def sy_pi_g(+g: M.GSt, +a: M.W, +b: M.W) -> M.GSt:
  M.gh_set_st(g, sy_pi_st(M.gh_get_st(g), a, b))

def sy_pi_at_go(+bs: List<&2, U32>, hd: List<&2, U32>, +tl: List<&2, U32>, +a: M.W, +b: M.W) -> List<&2, U32>:
  List.append(&2, U32, hd, List.append(&2, U32, M.b_of_w(sy_pw(M.w_of_b32(List.take(&2, U32, tl, 32n)), a, b)), List.drop(&2, U32, tl, 32n)))

def sy_pi_at(+bs: List<&2, U32>, +n: Nat, +a: M.W, +b: M.W) -> List<&2, U32>:
  sy_pi_at_go(bs, List.take(&2, U32, bs, n), List.drop(&2, U32, bs, n), a, b)

# calldata: ISubmitter.isActive, ISubmitter.slash
def sy_pi_cd(+cd: List<&2, U32>, +a: M.W, +b: M.W) -> List<&2, U32>:
  M.ite(List<&2, U32>, M.b_eq(List.take(&2, U32, cd, 4n), [159, 138, 19, 215]), sy_pi_at(cd, 4n, a, b), M.ite(List<&2, U32>, M.b_eq(List.take(&2, U32, cd, 4n), [201, 107, 228, 203]), sy_pi_at(cd, 4n, a, b), cd))

def sy_pi_call(h: M.HCall, +a: M.W, +b: M.W) -> M.HCall:
  match h:
    case M.HCall{to, cd, ok, ret}:
      M.HCall{sy_pw(to, a, b), sy_pi_cd(cd, a, b), ok, ret}

def sy_pi_calls(xs: List<&2, M.HCall>, +a: M.W, +b: M.W) -> List<&2, M.HCall>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{sy_pi_call(h, a, b), sy_pi_calls(t, a, b)}

def sy_pi_kb(h: M.KB, +a: M.W, +b: M.W) -> M.KB:
  match h:
    case M.KB{k, c}:
      M.KB{sy_pw(k, a, b), c}

def sy_pi_kbs(xs: List<&2, M.KB>, +a: M.W, +b: M.W) -> List<&2, M.KB>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{sy_pi_kb(h, a, b), sy_pi_kbs(t, a, b)}

def sy_pi_en(en: M.HEnv, +a: M.W, +b: M.W) -> M.HEnv:
  match en:
    case M.HEnv{e_blobs, e_block_timestamp, e_caller, e_calls, e_code, e_immutable_LAYER_2_CHAIN_ID, e_msg_data_length, e_msg_value, e_this}:
      M.HEnv{e_blobs, e_block_timestamp, sy_pw(e_caller, a, b), sy_pi_calls(e_calls, a, b), sy_pi_kbs(e_code, a, b), e_immutable_LAYER_2_CHAIN_ID, e_msg_data_length, e_msg_value, sy_pw(e_this, a, b)}

def sy_pi_ar_addChallenger(ar: M.AR_addChallenger, +a: M.W, +b: M.W) -> M.AR_addChallenger:
  match ar:
    case M.AR_addChallenger{_account}:
      M.AR_addChallenger{sy_pw(_account, a, b)}

def sy_pi_ar_claimProveRemaining(ar: M.AR_claimProveRemaining, +a: M.W, +b: M.W) -> M.AR_claimProveRemaining:
  match ar:
    case M.AR_claimProveRemaining{receiver}:
      M.AR_claimProveRemaining{sy_pw(receiver, a, b)}

def sy_pi_ar_claimReward(ar: M.AR_claimReward, +a: M.W, +b: M.W) -> M.AR_claimReward:
  match ar:
    case M.AR_claimReward{receiver}:
      M.AR_claimReward{sy_pw(receiver, a, b)}

def sy_pi_ar_initialize(ar: M.AR_initialize, +a: M.W, +b: M.W) -> M.AR_initialize:
  match ar:
    case M.AR_initialize{_submitterContract, _messageQueue, _verifier, _finalizationPeriodSeconds, _proofWindow, _proofRewardPercent}:
      M.AR_initialize{sy_pw(_submitterContract, a, b), sy_pw(_messageQueue, a, b), sy_pw(_verifier, a, b), _finalizationPeriodSeconds, _proofWindow, _proofRewardPercent}

def sy_pi_ar_initialize4(ar: M.AR_initialize4, +a: M.W, +b: M.W) -> M.AR_initialize4:
  match ar:
    case M.AR_initialize4{_newSubmitter, _expectedLegacyCutoverBatchIndex}:
      M.AR_initialize4{sy_pw(_newSubmitter, a, b), _expectedLegacyCutoverBatchIndex}

def sy_pi_ar_removeChallenger(ar: M.AR_removeChallenger, +a: M.W, +b: M.W) -> M.AR_removeChallenger:
  match ar:
    case M.AR_removeChallenger{_account}:
      M.AR_removeChallenger{sy_pw(_account, a, b)}

def sy_pi_ar_transferOwnership(ar: M.AR_transferOwnership, +a: M.W, +b: M.W) -> M.AR_transferOwnership:
  match ar:
    case M.AR_transferOwnership{newOwner}:
      M.AR_transferOwnership{sy_pw(newOwner, a, b)}

def sy_pi_ar_updateVerifier(ar: M.AR_updateVerifier, +a: M.W, +b: M.W) -> M.AR_updateVerifier:
  match ar:
    case M.AR_updateVerifier{_newVerifier}:
      M.AR_updateVerifier{sy_pw(_newVerifier, a, b)}

# π_(a,b) on an act (J2)
def sy_pi_x(x: M.HAct, +a: M.W, +b: M.W) -> M.HAct:
  match x:
    case M.A_addChallenger{ar, en}:
      M.A_addChallenger{sy_pi_ar_addChallenger(ar, a, b), sy_pi_en(en, a, b)}
    case M.A_batchChallengedSuccess{ar, en}:
      M.A_batchChallengedSuccess{ar, sy_pi_en(en, a, b)}
    case M.A_batchExist{ar, en}:
      M.A_batchExist{ar, sy_pi_en(en, a, b)}
    case M.A_batchInChallenge{ar, en}:
      M.A_batchInChallenge{ar, sy_pi_en(en, a, b)}
    case M.A_batchInsideChallengeWindow{ar, en}:
      M.A_batchInsideChallengeWindow{ar, sy_pi_en(en, a, b)}
    case M.A_challengeState{ar, en}:
      M.A_challengeState{ar, sy_pi_en(en, a, b)}
    case M.A_claimProveRemaining{ar, en}:
      M.A_claimProveRemaining{sy_pi_ar_claimProveRemaining(ar, a, b), sy_pi_en(en, a, b)}
    case M.A_claimReward{ar, en}:
      M.A_claimReward{sy_pi_ar_claimReward(ar, a, b), sy_pi_en(en, a, b)}
    case M.A_commitBatch{ar, en}:
      M.A_commitBatch{ar, sy_pi_en(en, a, b)}
    case M.A_commitBatchWithProof{ar, en}:
      M.A_commitBatchWithProof{ar, sy_pi_en(en, a, b)}
    case M.A_commitState{ar, en}:
      M.A_commitState{ar, sy_pi_en(en, a, b)}
    case M.A_finalizeBatch{ar, en}:
      M.A_finalizeBatch{ar, sy_pi_en(en, a, b)}
    case M.A_importGenesisBatch{ar, en}:
      M.A_importGenesisBatch{ar, sy_pi_en(en, a, b)}
    case M.A_initialize{ar, en}:
      M.A_initialize{sy_pi_ar_initialize(ar, a, b), sy_pi_en(en, a, b)}
    case M.A_initialize2{ar, en}:
      M.A_initialize2{ar, sy_pi_en(en, a, b)}
    case M.A_initialize3{ar, en}:
      M.A_initialize3{ar, sy_pi_en(en, a, b)}
    case M.A_initialize4{ar, en}:
      M.A_initialize4{sy_pi_ar_initialize4(ar, a, b), sy_pi_en(en, a, b)}
    case M.A_isBatchFinalized{ar, en}:
      M.A_isBatchFinalized{ar, sy_pi_en(en, a, b)}
    case M.A_owner{ar, en}:
      M.A_owner{ar, sy_pi_en(en, a, b)}
    case M.A_paused{ar, en}:
      M.A_paused{ar, sy_pi_en(en, a, b)}
    case M.A_proveCommittedBatchState{ar, en}:
      M.A_proveCommittedBatchState{ar, sy_pi_en(en, a, b)}
    case M.A_proveState{ar, en}:
      M.A_proveState{ar, sy_pi_en(en, a, b)}
    case M.A_receive{ar, en}:
      M.A_receive{ar, sy_pi_en(en, a, b)}
    case M.A_removeChallenger{ar, en}:
      M.A_removeChallenger{sy_pi_ar_removeChallenger(ar, a, b), sy_pi_en(en, a, b)}
    case M.A_renounceOwnership{ar, en}:
      M.A_renounceOwnership{ar, sy_pi_en(en, a, b)}
    case M.A_revertBatch{ar, en}:
      M.A_revertBatch{ar, sy_pi_en(en, a, b)}
    case M.A_setPause{ar, en}:
      M.A_setPause{ar, sy_pi_en(en, a, b)}
    case M.A_transferOwnership{ar, en}:
      M.A_transferOwnership{sy_pi_ar_transferOwnership(ar, a, b), sy_pi_en(en, a, b)}
    case M.A_updateFinalizePeriodSeconds{ar, en}:
      M.A_updateFinalizePeriodSeconds{ar, sy_pi_en(en, a, b)}
    case M.A_updateProofWindow{ar, en}:
      M.A_updateProofWindow{ar, sy_pi_en(en, a, b)}
    case M.A_updateRewardPercentage{ar, en}:
      M.A_updateRewardPercentage{ar, sy_pi_en(en, a, b)}
    case M.A_updateRollupDelayPeriod{ar, en}:
      M.A_updateRollupDelayPeriod{ar, sy_pi_en(en, a, b)}
    case M.A_updateVerifier{ar, en}:
      M.A_updateVerifier{sy_pi_ar_updateVerifier(ar, a, b), sy_pi_en(en, a, b)}

def sy_pi_ws(xs: List<&2, M.W>, n: Nat, +a: M.W, +b: M.W) -> List<&2, M.W>:
  match xs n:
    case Nil{} _:
      Nil{}
    case Con{h, t} 0n:
      Con{sy_pw(h, a, b), t}
    case Con{h, t} 1n+p:
      Con{h, sy_pi_ws(t, p, a, b)}

