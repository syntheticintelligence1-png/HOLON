  ux_ob_mk(U32.is_eq(M.gx_revertBatch_cd(x), 0), M.gx_revertBatch_rv(x), ret_revertBatch(x), M.lg_rev(M.gx_revertBatch_lg(x), Nil{}))

def ux_os_revertBatch(+x: M.X_revertBatch, +g: M.GSt) -> UOS:
  UOS{ux_ob_revertBatch(x), M.gh_go_revertBatch(x, g), M.gx_revertBatch_cd(x)}

# the return data of a successful call of setPause
def ret_setPause(+x: M.X_setPause) -> List<&2, U32>:
  Nil{}

def ux_ob_setPause(+x: M.X_setPause) -> UOb:
  ux_ob_mk(U32.is_eq(M.gx_setPause_cd(x), 0), M.gx_setPause_rv(x), ret_setPause(x), M.lg_rev(M.gx_setPause_lg(x), Nil{}))

def ux_os_setPause(+x: M.X_setPause, +g: M.GSt) -> UOS:
  UOS{ux_ob_setPause(x), M.gh_go_setPause(x, g), M.gx_setPause_cd(x)}

# the return data of a successful call of transferOwnership
def ret_transferOwnership(+x: M.X_transferOwnership) -> List<&2, U32>:
  Nil{}

def ux_ob_transferOwnership(+x: M.X_transferOwnership) -> UOb:
  ux_ob_mk(U32.is_eq(M.gx_transferOwnership_cd(x), 0), M.gx_transferOwnership_rv(x), ret_transferOwnership(x), M.lg_rev(M.gx_transferOwnership_lg(x), Nil{}))

def ux_os_transferOwnership(+x: M.X_transferOwnership, +g: M.GSt) -> UOS:
  UOS{ux_ob_transferOwnership(x), M.gh_go_transferOwnership(x, g), M.gx_transferOwnership_cd(x)}

# the return data of a successful call of updateFinalizePeriodSeconds
def ret_updateFinalizePeriodSeconds(+x: M.X_updateFinalizePeriodSeconds) -> List<&2, U32>:
  Nil{}

def ux_ob_updateFinalizePeriodSeconds(+x: M.X_updateFinalizePeriodSeconds) -> UOb:
  ux_ob_mk(U32.is_eq(M.gx_updateFinalizePeriodSeconds_cd(x), 0), M.gx_updateFinalizePeriodSeconds_rv(x), ret_updateFinalizePeriodSeconds(x), M.lg_rev(M.gx_updateFinalizePeriodSeconds_lg(x), Nil{}))

def ux_os_updateFinalizePeriodSeconds(+x: M.X_updateFinalizePeriodSeconds, +g: M.GSt) -> UOS:
  UOS{ux_ob_updateFinalizePeriodSeconds(x), M.gh_go_updateFinalizePeriodSeconds(x, g), M.gx_updateFinalizePeriodSeconds_cd(x)}

# the return data of a successful call of updateProofWindow
def ret_updateProofWindow(+x: M.X_updateProofWindow) -> List<&2, U32>:
  Nil{}

def ux_ob_updateProofWindow(+x: M.X_updateProofWindow) -> UOb:
  ux_ob_mk(U32.is_eq(M.gx_updateProofWindow_cd(x), 0), M.gx_updateProofWindow_rv(x), ret_updateProofWindow(x), M.lg_rev(M.gx_updateProofWindow_lg(x), Nil{}))

def ux_os_updateProofWindow(+x: M.X_updateProofWindow, +g: M.GSt) -> UOS:
