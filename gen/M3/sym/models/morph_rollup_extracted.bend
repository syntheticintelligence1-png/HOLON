def ux_ob_updateRollupDelayPeriod(+x: M.X_updateRollupDelayPeriod) -> UOb:
  ux_ob_mk(U32.is_eq(M.gx_updateRollupDelayPeriod_cd(x), 0), M.gx_updateRollupDelayPeriod_rv(x), ret_updateRollupDelayPeriod(x), M.lg_rev(M.gx_updateRollupDelayPeriod_lg(x), Nil{}))

