def sy_is_updateFinalizePeriodSeconds(x: M.HAct) -> Bool:
  match x:
    case M.A_addChallenger{ar, en}:
      False{}
    case M.A_batchChallengedSuccess{ar, en}:
      False{}
    case M.A_batchExist{ar, en}:
      False{}
    case M.A_batchInChallenge{ar, en}:
      False{}
    case M.A_batchInsideChallengeWindow{ar, en}:
      False{}
    case M.A_challengeState{ar, en}:
      False{}
    case M.A_claimProveRemaining{ar, en}:
      False{}
    case M.A_claimReward{ar, en}:
      False{}
    case M.A_commitBatch{ar, en}:
      False{}
    case M.A_commitBatchWithProof{ar, en}:
      False{}
    case M.A_commitState{ar, en}:
      False{}
    case M.A_finalizeBatch{ar, en}:
      False{}
    case M.A_importGenesisBatch{ar, en}:
      False{}
    case M.A_initialize{ar, en}:
      False{}
    case M.A_initialize2{ar, en}:
      False{}
    case M.A_initialize3{ar, en}:
      False{}
    case M.A_initialize4{ar, en}:
      False{}
    case M.A_isBatchFinalized{ar, en}:
      False{}
    case M.A_owner{ar, en}:
      False{}
    case M.A_paused{ar, en}:
      False{}
    case M.A_proveCommittedBatchState{ar, en}:
      False{}
    case M.A_proveState{ar, en}:
      False{}
    case M.A_receive{ar, en}:
      False{}
    case M.A_removeChallenger{ar, en}:
      False{}
    case M.A_renounceOwnership{ar, en}:
      False{}
    case M.A_revertBatch{ar, en}:
      False{}
    case M.A_setPause{ar, en}:
      False{}
    case M.A_transferOwnership{ar, en}:
      False{}
    case M.A_updateFinalizePeriodSeconds{ar, en}:
      True{}
    case M.A_updateProofWindow{ar, en}:
      False{}
    case M.A_updateRewardPercentage{ar, en}:
      False{}
    case M.A_updateRollupDelayPeriod{ar, en}:
      False{}
    case M.A_updateVerifier{ar, en}:
      False{}

