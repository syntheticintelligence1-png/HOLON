def ux_ob_updateRewardPercentage(+x: M.X_updateRewardPercentage) -> UOb:
  ux_ob_mk(U32.is_eq(M.gx_updateRewardPercentage_cd(x), 0), M.gx_updateRewardPercentage_rv(x), ret_updateRewardPercentage(x), M.lg_rev(M.gx_updateRewardPercentage_lg(x), Nil{}))

