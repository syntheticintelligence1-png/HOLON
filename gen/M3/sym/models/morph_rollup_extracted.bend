def sy_om_0_c(+uxy: UOS, +uyx: UOS) -> Bool:
  ux_imp(Bool.and(U32.is_eq(sy_code(uxy), 0), U32.is_eq(sy_code(uyx), 0)), sy_sink_eq(sy_sl(sy_st_of(sy_post(uxy))), sy_sl(sy_st_of(sy_post(uyx)))))

