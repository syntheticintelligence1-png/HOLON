def ux_os_updateVerifier(+x: M.X_updateVerifier, +g: M.GSt) -> UOS:
  UOS{ux_ob_updateVerifier(x), M.gh_go_updateVerifier(x, g), M.gx_updateVerifier_cd(x)}

# one step: its observation and the state after it (gh_step's)
def ux_ostep(a: M.HAct, +g: M.GSt, +kh: List<&2, M.HKB>) -> UOS:
  match a:
    case M.A_addChallenger{ar, en}:
      ux_os_addChallenger(M.xr_addChallenger(M.gh_get_st(g), ar, en, kh), g)
    case M.A_batchChallengedSuccess{ar, en}:
      ux_os_batchChallengedSuccess(M.xr_batchChallengedSuccess(M.gh_get_st(g), ar, en, kh), g)
    case M.A_batchExist{ar, en}:
      ux_os_batchExist(M.xr_batchExist(M.gh_get_st(g), ar, en, kh), g)
    case M.A_batchInChallenge{ar, en}:
      ux_os_batchInChallenge(M.xr_batchInChallenge(M.gh_get_st(g), ar, en, kh), g)
    case M.A_batchInsideChallengeWindow{ar, en}:
      ux_os_batchInsideChallengeWindow(M.xr_batchInsideChallengeWindow(M.gh_get_st(g), ar, en, kh), g)
    case M.A_challengeState{ar, en}:
      ux_os_challengeState(M.xr_challengeState(M.gh_get_st(g), ar, en, kh), g)
    case M.A_claimProveRemaining{ar, en}:
      ux_os_claimProveRemaining(M.xr_claimProveRemaining(M.gh_get_st(g), ar, en, kh), g)
    case M.A_claimReward{ar, en}:
      ux_os_claimReward(M.xr_claimReward(M.gh_get_st(g), ar, en, kh), g)
    case M.A_commitBatch{ar, en}:
      ux_os_commitBatch(M.xr_commitBatch(M.gh_get_st(g), ar, en, kh), g)
    case M.A_commitBatchWithProof{ar, en}:
      ux_os_commitBatchWithProof(M.xr_commitBatchWithProof(M.gh_get_st(g), ar, en, kh), g)
    case M.A_commitState{ar, en}:
      ux_os_commitState(M.xr_commitState(M.gh_get_st(g), ar, en, kh), g)
    case M.A_finalizeBatch{ar, en}:
      ux_os_finalizeBatch(M.xr_finalizeBatch(M.gh_get_st(g), ar, en, kh), g)
    case M.A_importGenesisBatch{ar, en}:
      ux_os_importGenesisBatch(M.xr_importGenesisBatch(M.gh_get_st(g), ar, en, kh), g)
    case M.A_initialize{ar, en}:
      ux_os_initialize(M.xr_initialize(M.gh_get_st(g), ar, en, kh), g)
    case M.A_initialize2{ar, en}:
      ux_os_initialize2(M.xr_initialize2(M.gh_get_st(g), ar, en, kh), g)
    case M.A_initialize3{ar, en}:
      ux_os_initialize3(M.xr_initialize3(M.gh_get_st(g), ar, en, kh), g)
    case M.A_initialize4{ar, en}:
      ux_os_initialize4(M.xr_initialize4(M.gh_get_st(g), ar, en, kh), g)
    case M.A_isBatchFinalized{ar, en}:
      ux_os_isBatchFinalized(M.xr_isBatchFinalized(M.gh_get_st(g), ar, en, kh), g)
    case M.A_owner{ar, en}:
      ux_os_owner(M.xr_owner(M.gh_get_st(g), ar, en, kh), g)
    case M.A_paused{ar, en}:
      ux_os_paused(M.xr_paused(M.gh_get_st(g), ar, en, kh), g)
    case M.A_proveCommittedBatchState{ar, en}:
      ux_os_proveCommittedBatchState(M.xr_proveCommittedBatchState(M.gh_get_st(g), ar, en, kh), g)
    case M.A_proveState{ar, en}:
      ux_os_proveState(M.xr_proveState(M.gh_get_st(g), ar, en, kh), g)
    case M.A_receive{ar, en}:
      ux_os_receive(M.xr_receive(M.gh_get_st(g), ar, en, kh), g)
    case M.A_removeChallenger{ar, en}:
      ux_os_removeChallenger(M.xr_removeChallenger(M.gh_get_st(g), ar, en, kh), g)
    case M.A_renounceOwnership{ar, en}:
      ux_os_renounceOwnership(M.xr_renounceOwnership(M.gh_get_st(g), ar, en, kh), g)
    case M.A_revertBatch{ar, en}:
      ux_os_revertBatch(M.xr_revertBatch(M.gh_get_st(g), ar, en, kh), g)
    case M.A_setPause{ar, en}:
      ux_os_setPause(M.xr_setPause(M.gh_get_st(g), ar, en, kh), g)
    case M.A_transferOwnership{ar, en}:
      ux_os_transferOwnership(M.xr_transferOwnership(M.gh_get_st(g), ar, en, kh), g)
    case M.A_updateFinalizePeriodSeconds{ar, en}:
      ux_os_updateFinalizePeriodSeconds(M.xr_updateFinalizePeriodSeconds(M.gh_get_st(g), ar, en, kh), g)
    case M.A_updateProofWindow{ar, en}:
      ux_os_updateProofWindow(M.xr_updateProofWindow(M.gh_get_st(g), ar, en, kh), g)
    case M.A_updateRewardPercentage{ar, en}:
      ux_os_updateRewardPercentage(M.xr_updateRewardPercentage(M.gh_get_st(g), ar, en, kh), g)
    case M.A_updateRollupDelayPeriod{ar, en}:
      ux_os_updateRollupDelayPeriod(M.xr_updateRollupDelayPeriod(M.gh_get_st(g), ar, en, kh), g)
    case M.A_updateVerifier{ar, en}:
      ux_os_updateVerifier(M.xr_updateVerifier(M.gh_get_st(g), ar, en, kh), g)

def ux_obsr(t: List<&2, M.HAct>, o: UOS, +kh: List<&2, M.HKB>) -> List<&2, UOb>:
  match t o:
    case Nil{} UOS{ob, g, c}:
      Con{ob, Nil{}}
    case Con{a, rest} UOS{ob, g, c}:
      Con{ob, ux_obsr(rest, ux_ostep(a, g, kh), kh)}

# obs(t, s): the observations of running the trace t from the state s, one per step
def obs(t: List<&2, M.HAct>, +g: M.GSt, +kh: List<&2, M.HKB>) -> List<&2, UOb>:
  match t:
    case Nil{}:
      Nil{}
    case Con{a, rest}:
      ux_obsr(rest, ux_ostep(a, g, kh), kh)

# the state after a trace (the typed model's run)
def run(t: List<&2, M.HAct>, g: M.GSt, +kh: List<&2, M.HKB>) -> M.GSt:
  M.run(t, g, kh)

def sy_pw(+w: M.W, +a: M.W, +b: M.W) -> M.W:
  M.ite(M.W, M.w_eq(w, a), b, M.ite(M.W, M.w_eq(w, b), a, w))

def sy_p0(p: List<&2, M.SP>) -> Bool:
  match p:
    case Nil{}:
      True{}
    case Con{h, t}:
      False{}

def sy_p1h(h: M.SP, t: List<&2, M.SP>, +j: M.W) -> Bool:
  match h:
    case M.SP_m{k, o}:
      Bool.and(sy_p0(t), M.w_eq(o, j))

def sy_p1(p: List<&2, M.SP>, +j: M.W) -> Bool:
  match p:
    case Nil{}:
      False{}
    case Con{h, t}:
      sy_p1h(h, t, j)

def sy_at_0(k: M.SK, +b: M.W, +o: M.W, +j: M.W) -> Bool:
  match k:
    case M.SK{kb, ko, kp}:
      Bool.and(M.w_eq(kb, b), Bool.and(M.w_eq(ko, o), sy_p0(kp)))

def sy_at_1(k: M.SK, +b: M.W, +o: M.W, +j: M.W) -> Bool:
  match k:
    case M.SK{kb, ko, kp}:
      Bool.and(M.w_eq(kb, b), Bool.and(M.w_eq(ko, o), sy_p1(kp, j)))

def sy_sub1(h: M.KV, +xs: List<&2, M.KV>, +ys: List<&2, M.KV>) -> Bool:
  match h:
    case M.KV{+k, v}:
      M.w_eq(M.kv_get(xs, k), M.kv_get(ys, k))

def sy_sub(zs: List<&2, M.KV>, +xs: List<&2, M.KV>, +ys: List<&2, M.KV>) -> Bool:
  match zs:
    case Nil{}:
      True{}
    case Con{h, t}:
      Bool.and(sy_sub1(h, xs, ys), sy_sub(t, xs, ys))

def sy_sl_eq(+xs: List<&2, M.KV>, +ys: List<&2, M.KV>) -> Bool:
  Bool.and(sy_sub(xs, xs, ys), sy_sub(ys, xs, ys))

def sy_gkt_eq(a: M.GKT, b: M.GKT) -> Bool:
  match a b:
    case M.GKT{ak, at} M.GKT{bk, bt}:
      Bool.and(M.w_eq(ak, bk), M.tg_eq(at, bt))

def sy_gkts_eq(a: List<&2, M.GKT>, b: List<&2, M.GKT>) -> Bool:
  match a b:
    case Nil{} Nil{}:
      True{}
    case Nil{} Con{y, ys}:
      False{}
    case Con{x, xs} Nil{}:
      False{}
    case Con{x, xs} Con{y, ys}:
      Bool.and(sy_gkt_eq(x, y), sy_gkts_eq(xs, ys))

def sy_sl(s: M.HSt) -> List<&2, M.KV>:
  match s:
    case M.HSt{sl}:
      sl

def sy_g_eq(a: M.GSt, b: M.GSt) -> Bool:
  match a b:
    case M.GSt{st1, gc_batchBlobVersionedHashes1} M.GSt{st2, gc_batchBlobVersionedHashes2}:
      Bool.and(sy_sl_eq(sy_sl(st1), sy_sl(st2)), sy_gkts_eq(gc_batchBlobVersionedHashes1, gc_batchBlobVersionedHashes2))

def sy_uos_eq(u: UOS, v: UOS) -> Bool:
  match u v:
    case UOS{o1, g1, c1} UOS{o2, g2, c2}:
      Bool.and(ux_ob_eq(o1, o2), sy_g_eq(g1, g2))

# a run the model cannot observe: an unanswered external call or the loop fuel
def sy_limit(+c: U32) -> Bool:
  Bool.or(U32.is_eq(c, 4294967294), U32.is_eq(c, 4294967295))

def sy_code(u: UOS) -> U32:
  ux_uos_c(u)

def sy_post(u: UOS) -> M.GSt:
  ux_uos_g(u)

def sy_st_of(+g: M.GSt) -> M.HSt:
  M.gh_get_st(g)

# the Time words of the store: storage:batchDataStore.finalizeTimestamp, storage:batchDataStore.originTimestamp, storage:challenges.startTime
def sy_time_key(+k: M.SK) -> Bool:
  Bool.or(sy_at_1(k, M.W{162, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}, M.W{1, 0, 0, 0, 0, 0, 0, 0}), Bool.or(sy_at_1(k, M.W{162, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}), sy_at_1(k, M.W{164, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}, M.W{2, 0, 0, 0, 0, 0, 0, 0})))

def sy_fit(+v: M.W, +d: M.W) -> Bool:
  Bool.and(M.w_lt(v, M.W{0, 0, 1, 0, 0, 0, 0, 0}), Bool.and(M.w_lt(d, M.W{0, 0, 1, 0, 0, 0, 0, 0}), M.w_lt(M.w_add(v, d), M.W{0, 0, 1, 0, 0, 0, 0, 0})))

def sy_tau_v(c: Bool, +v: M.W, +d: M.W) -> M.W:
  match c:
    case True{}:
      M.w_add(v, d)
    case False{}:
      v

def sy_tau_kv(h: M.KV, +d: M.W) -> M.KV:
  match h:
    case M.KV{+k, v}:
      M.KV{k, sy_tau_v(sy_time_key(k), v, d)}

def sy_tau_kvs(xs: List<&2, M.KV>, +d: M.W) -> List<&2, M.KV>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{sy_tau_kv(h, d), sy_tau_kvs(t, d)}

def sy_tau_st(s: M.HSt, +d: M.W) -> M.HSt:
  match s:
    case M.HSt{sl}:
      M.HSt{sy_tau_kvs(sl, d)}

# τ_d on a state (J2)
def sy_tau_g(+g: M.GSt, +d: M.W) -> M.GSt:
  M.gh_set_st(g, sy_tau_st(M.gh_get_st(g), d))

def sy_fits_kv(h: M.KV, +d: M.W) -> Bool:
  match h:
    case M.KV{+k, +v}:
      ux_imp(sy_time_key(k), sy_fit(v, d))

def sy_fits_kvs(xs: List<&2, M.KV>, +d: M.W) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{h, t}:
      Bool.and(sy_fits_kv(h, d), sy_fits_kvs(t, d))

def sy_fits_g(+g: M.GSt, +d: M.W) -> Bool:
  sy_fits_kvs(sy_sl(M.gh_get_st(g)), d)

def sy_tsel(+cd: List<&2, U32>) -> Bool:
  M.b_eq(List.take(&2, U32, cd, 4n), [181, 155, 26, 120])

def sy_tau_call(h: M.HCall, +d: M.W) -> M.HCall:
  match h:
    case M.HCall{to, +cd, ok, +ret}:
      M.HCall{to, cd, ok, M.ite(List<&2, U32>, sy_tsel(cd), M.b_of_w(M.w_add(M.w_of_b32(ret), d)), ret)}

def sy_tau_calls(xs: List<&2, M.HCall>, +d: M.W) -> List<&2, M.HCall>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{sy_tau_call(h, d), sy_tau_calls(t, d)}

def sy_fits_call(h: M.HCall, +d: M.W) -> Bool:
  match h:
    case M.HCall{to, +cd, ok, +ret}:
      ux_imp(sy_tsel(cd), sy_fit(M.w_of_b32(ret), d))

def sy_fits_calls(xs: List<&2, M.HCall>, +d: M.W) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{h, t}:
      Bool.and(sy_fits_call(h, d), sy_fits_calls(t, d))

def sy_tau_en(en: M.HEnv, +d: M.W) -> M.HEnv:
  match en:
    case M.HEnv{e_blobs, +e_block_timestamp, e_caller, +e_calls, e_code, e_immutable_LAYER_2_CHAIN_ID, e_msg_data_length, e_msg_value, e_this}:
      M.HEnv{e_blobs, M.w_add(e_block_timestamp, d), e_caller, sy_tau_calls(e_calls, d), e_code, e_immutable_LAYER_2_CHAIN_ID, e_msg_data_length, e_msg_value, e_this}

def sy_fits_en(en: M.HEnv, +d: M.W) -> Bool:
  match en:
    case M.HEnv{e_blobs, +e_block_timestamp, e_caller, +e_calls, e_code, e_immutable_LAYER_2_CHAIN_ID, e_msg_data_length, e_msg_value, e_this}:
      Bool.and(sy_fit(e_block_timestamp, d), sy_fits_calls(e_calls, d))

# τ_d on an act (J2)
def sy_tau_x(x: M.HAct, +d: M.W) -> M.HAct:
  match x:
    case M.A_addChallenger{ar, en}:
      M.A_addChallenger{ar, sy_tau_en(en, d)}
    case M.A_batchChallengedSuccess{ar, en}:
      M.A_batchChallengedSuccess{ar, sy_tau_en(en, d)}
    case M.A_batchExist{ar, en}:
      M.A_batchExist{ar, sy_tau_en(en, d)}
    case M.A_batchInChallenge{ar, en}:
      M.A_batchInChallenge{ar, sy_tau_en(en, d)}
    case M.A_batchInsideChallengeWindow{ar, en}:
      M.A_batchInsideChallengeWindow{ar, sy_tau_en(en, d)}
    case M.A_challengeState{ar, en}:
      M.A_challengeState{ar, sy_tau_en(en, d)}
    case M.A_claimProveRemaining{ar, en}:
      M.A_claimProveRemaining{ar, sy_tau_en(en, d)}
    case M.A_claimReward{ar, en}:
      M.A_claimReward{ar, sy_tau_en(en, d)}
    case M.A_commitBatch{ar, en}:
      M.A_commitBatch{ar, sy_tau_en(en, d)}
    case M.A_commitBatchWithProof{ar, en}:
      M.A_commitBatchWithProof{ar, sy_tau_en(en, d)}
    case M.A_commitState{ar, en}:
      M.A_commitState{ar, sy_tau_en(en, d)}
    case M.A_finalizeBatch{ar, en}:
      M.A_finalizeBatch{ar, sy_tau_en(en, d)}
    case M.A_importGenesisBatch{ar, en}:
      M.A_importGenesisBatch{ar, sy_tau_en(en, d)}
    case M.A_initialize{ar, en}:
      M.A_initialize{ar, sy_tau_en(en, d)}
    case M.A_initialize2{ar, en}:
      M.A_initialize2{ar, sy_tau_en(en, d)}
    case M.A_initialize3{ar, en}:
      M.A_initialize3{ar, sy_tau_en(en, d)}
    case M.A_initialize4{ar, en}:
      M.A_initialize4{ar, sy_tau_en(en, d)}
    case M.A_isBatchFinalized{ar, en}:
      M.A_isBatchFinalized{ar, sy_tau_en(en, d)}
    case M.A_owner{ar, en}:
      M.A_owner{ar, sy_tau_en(en, d)}
    case M.A_paused{ar, en}:
      M.A_paused{ar, sy_tau_en(en, d)}
    case M.A_proveCommittedBatchState{ar, en}:
      M.A_proveCommittedBatchState{ar, sy_tau_en(en, d)}
    case M.A_proveState{ar, en}:
      M.A_proveState{ar, sy_tau_en(en, d)}
    case M.A_receive{ar, en}:
      M.A_receive{ar, sy_tau_en(en, d)}
    case M.A_removeChallenger{ar, en}:
      M.A_removeChallenger{ar, sy_tau_en(en, d)}
    case M.A_renounceOwnership{ar, en}:
      M.A_renounceOwnership{ar, sy_tau_en(en, d)}
    case M.A_revertBatch{ar, en}:
      M.A_revertBatch{ar, sy_tau_en(en, d)}
    case M.A_setPause{ar, en}:
      M.A_setPause{ar, sy_tau_en(en, d)}
    case M.A_transferOwnership{ar, en}:
      M.A_transferOwnership{ar, sy_tau_en(en, d)}
    case M.A_updateFinalizePeriodSeconds{ar, en}:
      M.A_updateFinalizePeriodSeconds{ar, sy_tau_en(en, d)}
    case M.A_updateProofWindow{ar, en}:
      M.A_updateProofWindow{ar, sy_tau_en(en, d)}
    case M.A_updateRewardPercentage{ar, en}:
      M.A_updateRewardPercentage{ar, sy_tau_en(en, d)}
    case M.A_updateRollupDelayPeriod{ar, en}:
      M.A_updateRollupDelayPeriod{ar, sy_tau_en(en, d)}
    case M.A_updateVerifier{ar, en}:
      M.A_updateVerifier{ar, sy_tau_en(en, d)}

def sy_fits_x(x: M.HAct, +d: M.W) -> Bool:
  match x:
    case M.A_addChallenger{ar, en}:
