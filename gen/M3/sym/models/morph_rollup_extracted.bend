  sy_pi_v_4_m(sy_at_0(k, M.W{151, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}, M.W{0, 0, 0, 0, 0, 0, 0, 0}), v, a, b)

def sy_pi_v_5_m(c: Bool, +v: M.W, +a: M.W, +b: M.W) -> M.W:
