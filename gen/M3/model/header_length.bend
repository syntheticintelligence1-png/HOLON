def enc_sol(+h: R_Header) -> List<&2, U32>:
  enc_sol_at(U32.to_nat(enc_sol_tag(h)), h)

# load_sol: loader Rollup._loadBatchHeader; ok_load_sol is its domain predicate
def ok_load_sol(+b: List<&2, U32>) -> Bool:
  Bool.or(Bool.and(Nat.is_gt(List.length(&2, U32, b), 0n), Bool.and(U32.is_eq(byte_at(b, 0n), 0), Nat.is_ge(List.length(&2, U32, b), 249n))), Bool.and(Nat.is_gt(List.length(&2, U32, b), 0n), Bool.and(Bool.not(U32.is_eq(byte_at(b, 0n), 0)), Bool.and(Bool.or(U32.is_eq(byte_at(b, 0n), 1), U32.is_eq(byte_at(b, 0n), 2)), Nat.is_eq(List.length(&2, U32, b), 257n)))))

def load_sol(+b: List<&2, U32>) -> Maybe<&2, List<&2, U32>>:
  sel_bytes(ok_load_sol(b), b)
