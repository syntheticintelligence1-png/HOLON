# the call (ar, en) of challengeState succeeds from s
def fx_s_disch_self_Rollup_challengeState_489_493(+ar: M.AR_challengeState, +en: M.HEnv, +s: M.GSt, +kh: List<&2, M.HKB>) -> Bool:
