def v_b_eq(xs: List<&2, U32>, ys: List<&2, U32>) -> Bool:
  match xs ys:
    case Nil{} Nil{}:
      True{}
    case Nil{} Con{h, t}:
      False{}
    case Con{h, t} Nil{}:
      False{}
    case Con{a, s} Con{b, u}:
      Bool.and(U32.is_eq(a, b), v_b_eq(s, u))

def v_n_of_w(+w: v_W) -> Nat:
  U32.to_nat(v_w_lo(w))

def v_m_ov(bs: List<&2, U32>, mem: List<&2, U32>) -> List<&2, U32>:
  match bs:
    case Nil{}:
      mem
    case Con{b, r}:
      match mem:
        case Nil{}:
          Con{b, v_m_ov(r, Nil{})}
        case Con{h, t}:
          Con{b, v_m_ov(r, t)}

def v_m_over(mem: List<&2, U32>, bs: List<&2, U32>) -> List<&2, U32>:
  v_m_ov(bs, mem)

def v_m_put(off: Nat, mem: List<&2, U32>, bs: List<&2, U32>) -> List<&2, U32>:
  match off mem:
    case 0n Nil{}:
      v_m_over(Nil{}, bs)
    case 0n Con{h, t}:
      v_m_over(Con{h, t}, bs)
    case 1n+p Nil{}:
      Con{57005, v_m_put(p, Nil{}, bs)}
    case 1n+p Con{h, t}:
      Con{h, v_m_put(p, t, bs)}

def v_m_havoc(mem: List<&2, U32>) -> List<&2, U32>:
  match mem:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{57005, v_m_havoc(t)}

def v_m_slice(mem: List<&2, U32>, +off: v_W, +n: v_W) -> List<&2, U32>:
  v_b_take(v_n_of_w(n), v_b_drop(mem, v_n_of_w(off)), 57005)

type v_KW is Data:
  v_KW{k: v_W, v: v_W}

def v_kw_get(xs: List<&2, v_KW>, +k: v_W) -> v_W:
  match xs:
    case Nil{}:
      v_w0()
    case Con{h, t}:
      match h:
        case v_KW{hk, hv}:
          v_ite(v_W, v_w_eq(hk, k), hv, v_kw_get(t, k))

def v_kw_put(xs: List<&2, v_KW>, +k: v_W, +v: v_W, +done: Bool) -> List<&2, v_KW>:
  match xs:
    case Nil{}:
      v_ite(List<&2, v_KW>, done, Nil{}, [v_KW{k, v}])
    case Con{h, t}:
      match h:
        case v_KW{+hk, hv}:
          +eq = v_w_eq(hk, k)
          Con{v_KW{hk, v_ite(v_W, Bool.and(eq, Bool.not(done)), v, hv)}, v_kw_put(t, k, v, Bool.or(done, eq))}

def v_kw_set(xs: List<&2, v_KW>, +k: v_W, +v: v_W) -> List<&2, v_KW>:
  v_kw_put(xs, k, v, False{})

type v_HSt is Data:
  v_HSt{sl: List<&2, v_KW>}

def v_sload(s: v_HSt, +k: v_W) -> v_W:
  match s:
    case v_HSt{sl}:
      v_kw_get(sl, k)

def v_sstore(s: v_HSt, +k: v_W, +v: v_W) -> v_HSt:
  match s:
    case v_HSt{sl}:
      v_HSt{v_kw_set(sl, k, v)}

type v_HKB is Data:
  v_HKB{b: List<&2, U32>, v: v_W}

def v_b_rev(xs: List<&2, U32>, acc: List<&2, U32>) -> List<&2, U32>:
  match xs:
    case Nil{}:
      acc
    case Con{h, t}:
      v_b_rev(t, Con{h, acc})

def v_h_revs(xs: List<&2, v_HKB>) -> List<&2, v_HKB>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      match h:
        case v_HKB{hb, hv}:
          Con{v_HKB{v_b_rev(hb, Nil{}), hv}, v_h_revs(t)}

def v_h_cons(c: Bool, xt: List<&2, U32>, cv: v_W, r: List<&2, v_HKB>) -> List<&2, v_HKB>:
  match c:
    case True{}:
      Con{v_HKB{xt, cv}, r}
    case False{}:
      r

def v_h_one(+b: U32, cb: List<&2, U32>, cv: v_W, r: List<&2, v_HKB>) -> List<&2, v_HKB>:
  match cb:
    case Nil{}:
      r
    case Con{x, xt}:
      v_h_cons(U32.is_eq(x, b), xt, cv, r)

def v_h_step(+b: U32, cs: List<&2, v_HKB>) -> List<&2, v_HKB>:
  match cs:
    case Nil{}:
      Nil{}
    case Con{c, rest}:
      match c:
        case v_HKB{cb, cv}:
          v_h_one(b, cb, cv, v_h_step(b, rest))

def v_h_end1(cb: List<&2, U32>, cv: v_W, r: v_W) -> v_W:
  match cb:
    case Nil{}:
      cv
    case Con{x, xt}:
      r

def v_h_ends(cs: List<&2, v_HKB>) -> v_W:
  match cs:
    case Nil{}:
      v_w0()
    case Con{c, rest}:
      match c:
        case v_HKB{cb, cv}:
          v_h_end1(cb, cv, v_h_ends(rest))

def v_h_filt(k: List<&2, U32>, cs: List<&2, v_HKB>) -> v_W:
  match k:
    case Nil{}:
      v_h_ends(cs)
    case Con{b, t}:
      v_h_filt(t, v_h_step(b, cs))

def v_h_get(xs: List<&2, v_HKB>, k: List<&2, U32>) -> v_W:
  v_h_filt(v_b_rev(k, Nil{}), v_h_revs(xs))

type v_HCall is Data:
  v_HCall{to: v_W, d: List<&2, U32>, ok: Bool, ret: List<&2, U32>}

type v_HAns is Data:
  v_HAns{f: Bool, ok: Bool, ret: List<&2, U32>}

def v_c_find(xs: List<&2, v_HCall>, +to: v_W, +bt: Bool, +d: List<&2, U32>) -> v_HAns:
  match xs:
    case Nil{}:
      v_HAns{False{}, False{}, Nil{}}
    case Con{h, t}:
      match h:
        case v_HCall{cto, cd, cok, cret}:
          v_ite(v_HAns, Bool.and(Bool.or(Bool.not(bt), v_w_eq(cto, to)), v_b_eq(cd, d)), v_HAns{True{}, cok, cret}, v_c_find(t, to, bt, d))

def v_a_ok(a: v_HAns) -> Bool:
  match a:
    case v_HAns{f, ok, ret}:
      Bool.and(f, ok)

def v_a_ret(a: v_HAns) -> List<&2, U32>:
  match a:
    case v_HAns{f, ok, ret}:
      ret

type v_HLog is Data:
  v_HLog{t: List<&2, v_W>, d: List<&2, U32>}

type v_HOut is Data:
  v_HOut{c: U32, rv: List<&2, U32>, po: v_HSt, lg: List<&2, v_HLog>, tw: List<&2, v_W>}

def v_o_code(o: v_HOut) -> U32:
  match o:
    case v_HOut{c, rv, po, lg, tw}:
      c

def v_o_post(o: v_HOut) -> v_HSt:
  match o:
    case v_HOut{c, rv, po, lg, tw}:
      po

def v_o_logs(o: v_HOut) -> List<&2, v_HLog>:
  match o:
    case v_HOut{c, rv, po, lg, tw}:
      lg

def v_w_nth(xs: List<&2, v_W>, n: Nat) -> v_W:
  match xs n:
    case Nil{} _:
      v_w0()
    case Con{h, t} 0n:
      h
    case Con{h, t} 1n+p:
      v_w_nth(t, p)

def v_w_len(xs: List<&2, v_W>) -> U32:
  match xs:
    case Nil{}:
      0
    case Con{h, t}:
      U32.inc(v_w_len(t))

type v_KB is Data:
  v_KB{k: v_W, b: List<&2, U32>}

def v_kb_get(xs: List<&2, v_KB>, +k: v_W) -> List<&2, U32>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      match h:
        case v_KB{hk, hb}:
          v_ite(List<&2, U32>, v_w_eq(hk, k), hb, v_kb_get(t, k))

def v_lg_rev(xs: List<&2, v_HLog>, +acc: List<&2, v_HLog>) -> List<&2, v_HLog>:
  match xs:
    case Nil{}:
      acc
    case Con{h, t}:
      v_lg_rev(t, Con{h, acc})

def v_hs_get(xs: List<&2, v_HKB>, +k: List<&2, U32>) -> v_W:
  v_h_get(xs, k)

def v_kt_id(+xs: List<&2, v_HKB>) -> List<&2, v_HKB>:
  xs

def v_st_after(+o: v_HOut, +st: v_HSt) -> v_HSt:
  v_ite(v_HSt, v_u_nz(v_o_code(o)), st, v_o_post(o))

def v_b_zeros(n: Nat) -> List<&2, U32>:
  match n:
    case 0n:
      Nil{}
    case 1n+p:
      Con{0, v_b_zeros(p)}

def v_abi_dyn(+bs: List<&2, U32>) -> List<&2, U32>:
  List.append(&2, U32, v_b_of_u(v_b_len(bs)), List.append(&2, U32, bs, v_b_zeros(U32.to_nat(U32.and(U32.sub(32, U32.and(v_b_len(bs), 31)), 31)))))

def v_abi_words(xs: List<&2, v_W>) -> List<&2, U32>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      List.append(&2, U32, v_b_of_w(h), v_abi_words(t))

def v_abi_wlist(+xs: List<&2, v_W>) -> List<&2, U32>:
  List.append(&2, U32, v_b_of_u(v_w_len(xs)), v_abi_words(xs))

def v_eq_bool(a: Bool, b: Bool) -> Bool:
  match a b:
    case True{} True{}:
      True{}
    case False{} False{}:
      True{}
    case True{} False{}:
      False{}
    case False{} True{}:
      False{}

def v_is_true(b: Bool) -> Type:
  match b:
    case True{}:
      Unit
    case False{}:
      Empty

def v_w_shl_64(a: v_W) -> v_W:
  match a:
    case v_W{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}:
      v_W{0, 0, a0, a1, a2, a3, a4, a5}

def v_w_shr_64(a: v_W) -> v_W:
  match a:
    case v_W{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}:
      v_W{a2, a3, a4, a5, a6, a7, 0, 0}

def v_w_shr_160(a: v_W) -> v_W:
  match a:
    case v_W{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}:
      v_W{a5, a6, a7, 0, 0, 0, 0, 0}

