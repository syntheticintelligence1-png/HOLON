def fv_w(w: M.W) -> v_W:
  match w:
    case M.W{a0, a1, a2, a3, a4, a5, a6, a7}:
      v_W{a0, a1, a2, a3, a4, a5, a6, a7}

def fv_kb(e: M.HKB) -> v_HKB:
  match e:
    case M.HKB{b, v}:
      v_HKB{b, fv_w(v)}

# the hash table as the callee's model takes it (one keccak256)
def fv_tab(xs: List<&2, M.HKB>) -> List<&2, v_HKB>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Con{fv_kb(h), fv_tab(t)}

# the callee's state at the laws' deployment
def fv_s0() -> v_HSt:
  v_HSt{[v_KW{v_W{0, 0, 0, 0, 0, 0, 0, 0}, v_W{725488790, 3714200534, 2888397955, 3775048766, 2141796443, 0, 0, 0}}, v_KW{v_W{1, 0, 0, 0, 0, 0, 0, 0}, v_W{2959701400, 62681297, 2743502602, 131344039, 2697693335, 0, 0, 0}}, v_KW{v_W{1925383500, 1174424855, 2538171007, 4056078756, 1889412192, 551097500, 2505850973, 2707146252}, v_W{0, 0, 475547403, 2644059230, 2050295964, 1976013814, 774065582, 0}}]}

# the environment of a resolution: no value, the calldata of two words, no external call
def fv_env() -> v_HEnv:
  v_HEnv{v_W{0, 0, 0, 0, 0, 0, 0, 0}, Nil{}, v_W{68, 0, 0, 0, 0, 0, 0, 0}, v_W{0, 0, 0, 0, 0, 0, 0, 0}}

# the resolution succeeds and returns a non-zero word
def fv_out(o: v_HOut) -> Bool:
  match o:
    case v_HOut{c, rv, po, lg, tw}:
      Bool.and(U32.is_eq(c, 0), v_w_nz(v_b_word(rv, 0n)))

# dom(vs, v, i): getVerifier(v, i) on the callee's model from vs (LD2)
def fv_dom(+vs: v_HSt, +v: v_W, +i: v_W, +vkh: List<&2, v_HKB>) -> Bool:
  fv_out(v_run_getVerifier(vs, v_AR_getVerifier{v, i}, fv_env(), vkh))

