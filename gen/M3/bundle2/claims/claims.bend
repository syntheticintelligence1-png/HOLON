      v_HOut{x_cd, x_rv, x_ov, v_lg_rev(x_lg, Nil{}), x_tw}

def v_run_verifyAggregateProof(+st: v_HSt, +ar: v_AR_verifyAggregateProof, +en: v_HEnv, +kh: List<&2, v_HKB>) -> v_HOut:
  v_xo_verifyAggregateProof(v_xr_verifyAggregateProof(st, ar, en, kh))

def v_chk_verifyAggregateProof(+st: v_HSt, +ar: v_AR_verifyAggregateProof, +en: v_HEnv, +kh: List<&2, v_HKB>) -> U32:
  v_o_code(v_run_verifyAggregateProof(st, ar, en, kh))

def v_post_verifyAggregateProof(+st: v_HSt, +ar: v_AR_verifyAggregateProof, +en: v_HEnv, +kh: List<&2, v_HKB>) -> v_HSt:
  v_o_post(v_run_verifyAggregateProof(st, ar, en, kh))

def v_logs_verifyAggregateProof(+st: v_HSt, +ar: v_AR_verifyAggregateProof, +en: v_HEnv, +kh: List<&2, v_HKB>) -> List<&2, v_HLog>:
  v_o_logs(v_run_verifyAggregateProof(st, ar, en, kh))

def v_step_verifyAggregateProof(+st: v_HSt, +ar: v_AR_verifyAggregateProof, +en: v_HEnv, +kh: List<&2, v_HKB>) -> v_HSt:
  v_st_after(v_run_verifyAggregateProof(st, ar, en, kh), st)

type v_HAct is Data:
  v_A_getVerifier{ar: v_AR_getVerifier, en: v_HEnv}
  v_A_initialize{ar: v_AR_initialize, en: v_HEnv}
  v_A_legacyVerifiersLength{ar: v_AR_legacyVerifiersLength, en: v_HEnv}
  v_A_owner{ar: v_AR_owner, en: v_HEnv}
  v_A_renounceOwnership{ar: v_AR_renounceOwnership, en: v_HEnv}
  v_A_transferOwnership{ar: v_AR_transferOwnership, en: v_HEnv}
  v_A_updateVerifier{ar: v_AR_updateVerifier, en: v_HEnv}
  v_A_verifyAggregateProof{ar: v_AR_verifyAggregateProof, en: v_HEnv}

def v_step(a: v_HAct, +s: v_HSt, +kh: List<&2, v_HKB>) -> v_HSt:
  match a:
    case v_A_getVerifier{ar, en}:
      v_step_getVerifier(s, ar, en, kh)
    case v_A_initialize{ar, en}:
      v_step_initialize(s, ar, en, kh)
    case v_A_legacyVerifiersLength{ar, en}:
      v_step_legacyVerifiersLength(s, ar, en, kh)
    case v_A_owner{ar, en}:
      v_step_owner(s, ar, en, kh)
    case v_A_renounceOwnership{ar, en}:
      v_step_renounceOwnership(s, ar, en, kh)
    case v_A_transferOwnership{ar, en}:
      v_step_transferOwnership(s, ar, en, kh)
    case v_A_updateVerifier{ar, en}:
      v_step_updateVerifier(s, ar, en, kh)
    case v_A_verifyAggregateProof{ar, en}:
      v_step_verifyAggregateProof(s, ar, en, kh)

def v_s0() -> v_HSt:
  v_HSt{[v_KW{v_W{0, 0, 0, 0, 0, 0, 0, 0}, v_W{725488790, 3714200534, 2888397955, 3775048766, 2141796443, 0, 0, 0}}, v_KW{v_W{1, 0, 0, 0, 0, 0, 0, 0}, v_W{2959701400, 62681297, 2743502602, 131344039, 2697693335, 0, 0, 0}}, v_KW{v_W{700002047, 604227984, 2475954915, 107905898, 2586635237, 2426371143, 88962863, 907489690}, v_W{0, 0, 475547403, 2644059230, 2050295964, 1976013814, 774065582, 0}}, v_KW{v_W{1925383500, 1174424855, 2538171007, 4056078756, 1889412192, 551097500, 2505850973, 2707146252}, v_W{0, 0, 475547403, 2644059230, 2050295964, 1976013814, 774065582, 0}}, v_KW{v_W{2691611981, 2849331908, 972818212, 3257091189, 3023478468, 2816835373, 29174803, 3282193157}, v_W{0, 0, 475547403, 2644059230, 2050295964, 1976013814, 774065582, 0}}]}

def v_run(tr: List<&2, v_HAct>, s: v_HSt, +kh: List<&2, v_HKB>) -> v_HSt:
  match tr:
    case Nil{}:
      s
    case Con{a, rest}:
      v_run(rest, v_step(a, s, kh), kh)

type v_Reach<-kh: List<&2, v_HKB>, -s: v_HSt> is Type:
  v_R0{e: {s == v_s0() : v_HSt}}
  v_RStep{a: v_HAct, p: v_HSt, r: v_Reach<kh, p>, e: {s == v_step(a, p, kh) : v_HSt}}

# ---- the claims
def fx_imp(c: Bool, b: Bool) -> Bool:
  match c:
    case True{}:
      b
    case False{}:
      True{}

def fx_ite(c: Bool, a: Bool, b: Bool) -> Bool:
  match c:
    case True{}:
      a
    case False{}:
      b

# the kernel claim (o1 and o2 and pt and c) implies d: d the consumers' equality, o1 and o2 each run's
# blobs_wf and success, pt the table and closed premises, c equal commitments (matched in that order)
def fx_k3(d: Bool, o1: Bool, o2: Bool, pt: Bool, c: Bool) -> Bool:
  match d:
    case True{}:
      True{}
    case False{}:
      match o1:
        case False{}:
          True{}
        case True{}:
          match o2:
            case False{}:
              True{}
            case True{}:
              match pt:
                case False{}:
                  True{}
                case True{}:
                  Bool.not(c)

def fx_ws_eq(a: List<&2, M.W>, b: List<&2, M.W>) -> Bool:
  match a b:
    case Nil{} Nil{}:
      True{}
    case Nil{} Con{y, ys}:
      False{}
    case Con{x, xs} Nil{}:
      False{}
    case Con{x, xs} Con{y, ys}:
      Bool.and(M.w_eq(x, y), fx_ws_eq(xs, ys))

# the top byte of a word is 0x01
def fx_top(w: M.W) -> Bool:
  match w:
    case M.W{a0, a1, a2, a3, a4, a5, a6, a7}:
      U32.is_eq(U32.and(a7, 4278190080), 16777216)

# blobs_wf on one entry: z is whether the entry is the zero word, rest the rest of the check
def fx_wfw(z: Bool, rest: Bool) -> Bool:
  match z:
    case True{}:
      False{}
    case False{}:
      rest

# blobs_wf: every entry of a blob-hash list is a nonzero word whose top byte is 0x01
def fx_wf(xs: List<&2, M.W>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{+h, t}:
      fx_wfw(M.w_eq(h, M.w0()), Bool.and(fx_top(h), fx_wf(t)))

# NZ over one hash table: no entry is the zero word
def fx_nz(xs: List<&2, M.HKB>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{h, t}:
      match h:
        case M.HKB{b, v}:
          Bool.and(M.w_nz(v), fx_nz(t))

# CF of one entry against the rest of a table: an equal value has an equal key
def fx_cf1(+b: List<&2, U32>, +v: M.W, xs: List<&2, M.HKB>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{h, t}:
      match h:
        case M.HKB{b2, v2}:
          Bool.and(fx_imp(M.w_eq(v, v2), M.b_eq(b, b2)), fx_cf1(b, v, t))

# CF over a hash table: two entries with one value have one key
def fx_cf(xs: List<&2, M.HKB>) -> Bool:
  match xs:
    case Nil{}:
      True{}
    case Con{h, +t}:
      match h:
        case M.HKB{b, v}:
          Bool.and(fx_cf1(b, v, t), fx_cf(t))

# the table premises: cf and nz of every hash table
def fx_tabs(+kh: List<&2, M.HKB>) -> Bool:
  Bool.and(fx_cf(kh), fx_nz(kh))

# equal fields: both absent, or both present with one value
def fx_feq(h1: Bool, v1: M.W, h2: Bool, v2: M.W) -> Bool:
  match h1:
    case True{}:
      match h2:
        case True{}:
          M.w_eq(v1, v2)
        case False{}:
          False{}
    case False{}:
      Bool.not(h2)

