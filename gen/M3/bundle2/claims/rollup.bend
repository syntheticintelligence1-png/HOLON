6, 888210391, 843664006, 622019630, 3319020618}, W{100, 0, 0, 0, 0, 0, 0, 0}}]}

# ---- ghost: SORT coercions (holon.rules.sort)

type Tag is Data:
  TG_bot{}
  TG_Dig_Agg{}
  TG_Dig_VH{}

def tg_eq(a: Tag, b: Tag) -> Bool:
  match a b:
    case TG_bot{} TG_bot{}:
      True{}
    case TG_bot{} TG_Dig_Agg{}:
      False{}
    case TG_bot{} TG_Dig_VH{}:
      False{}
    case TG_Dig_Agg{} TG_bot{}:
      False{}
    case TG_Dig_Agg{} TG_Dig_Agg{}:
      True{}
    case TG_Dig_Agg{} TG_Dig_VH{}:
      False{}
    case TG_Dig_VH{} TG_bot{}:
      False{}
    case TG_Dig_VH{} TG_Dig_Agg{}:
      False{}
    case TG_Dig_VH{} TG_Dig_VH{}:
      True{}

type GKT is Data:
  GKT{k: W, t: Tag}

def gk_get(xs: List<&2, GKT>, +k: W) -> Tag:
  match xs:
    case Nil{}:
      TG_bot{}
    case Con{h, t}:
      match h:
        case GKT{hk, ht}:
          ite(Tag, w_eq(hk, k), ht, gk_get(t, k))

def gk_put(xs: List<&2, GKT>, +k: W, +v: Tag, +done: Bool) -> List<&2, GKT>:
  match xs:
    case Nil{}:
      ite(List<&2, GKT>, done, Nil{}, [GKT{k, v}])
    case Con{h, t}:
      match h:
        case GKT{+hk, ht}:
          +eq = w_eq(hk, k)
          Con{GKT{hk, ite(Tag, Bool.and(eq, Bool.not(done)), v, ht)}, gk_put(t, k, v, Bool.or(done, eq))}

def gk_set(xs: List<&2, GKT>, +k: W, +v: Tag) -> List<&2, GKT>:
  gk_put(xs, k, v, False{})

# the augmented state: the real store and the generated companion of every union register (G1)
type GSt is Data:
  GSt{st: HSt, gc_batchBlobVersionedHashes: List<&2, GKT>}

def gh_get_st(e: GSt) -> HSt:
  match e:
    case GSt{st, gc_batchBlobVersionedHashes}:
      st

def gh_get_batchBlobVersionedHashes(e: GSt) -> List<&2, GKT>:
  match e:
    case GSt{st, gc_batchBlobVersionedHashes}:
      gc_batchBlobVersionedHashes

def gh_set_st(e: GSt, +v: HSt) -> GSt:
  match e:
    case GSt{_, gc_batchBlobVersionedHashes}:
      GSt{v, gc_batchBlobVersionedHashes}

def gh_set_batchBlobVersionedHashes(e: GSt, +v: List<&2, GKT>) -> GSt:
  match e:
    case GSt{st, _}:
      GSt{st, v}

def gh_s0() -> GSt:
  GSt{s0(), Nil{}}

