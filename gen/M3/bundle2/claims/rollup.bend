def wrap_T_SDur(+v: T_SDur) -> T_Dur:
  T_Dur{pay_T_SDur(v)}

def rzg_T_SDur(c: Bool, +p: W) -> Maybe<&2, T_Dur>:
  match c:
    case True{}:
      None{}
    case False{}:
      Some{T_Dur{p}}

# realize (N3): None iff the signed value is negative
def realize_T_SDur(v: T_SDur) -> Maybe<&2, T_Dur>:
  match v:
    case T_SDur{ng, p}:
      rzg_T_SDur(ng, p)

def add_Dur_Time(+a: T_Dur, +b: T_Time) -> T_Time:
  T_Time{w_add(pay_T_Dur(a), pay_T_Time(b))}

def add_Time_Dur(+a: T_Time, +b: T_Dur) -> T_Time:
  T_Time{w_add(pay_T_Time(a), pay_T_Dur(b))}

def eq_Dig_Agg_Dig_VH_Dig_Agg_Dig_VH(+a: T_Dig_Agg_Dig_VH, +b: T_Dig_Agg_Dig_VH) -> Bool:
  w_eq(pay_T_Dig_Agg_Dig_VH(a), pay_T_Dig_Agg_Dig_VH(b))

def eq_Dig_VH_Dig_VH(+a: T_Dig_VH, +b: T_Dig_VH) -> Bool:
  w_eq(pay_T_Dig_VH(a), pay_T_Dig_VH(b))

def gt_Dur_Dur(+a: T_Dur, +b: T_Dur) -> Bool:
  w_gt(pay_T_Dur(a), pay_T_Dur(b))

def gt_Time_Time(+a: T_Time, +b: T_Time) -> Bool:
  w_gt(pay_T_Time(a), pay_T_Time(b))

def le_Time_Time(+a: T_Time, +b: T_Time) -> Bool:
  w_le(pay_T_Time(a), pay_T_Time(b))

def lt_Time_Time(+a: T_Time, +b: T_Time) -> Bool:
  w_lt(pay_T_Time(a), pay_T_Time(b))

def ne_Dig_Agg_Dig_VH_Dig_Agg_Dig_VH(+a: T_Dig_Agg_Dig_VH, +b: T_Dig_Agg_Dig_VH) -> Bool:
  Bool.not(w_eq(pay_T_Dig_Agg_Dig_VH(a), pay_T_Dig_Agg_Dig_VH(b)))

def ne_Dur_Dur(+a: T_Dur, +b: T_Dur) -> Bool:
  Bool.not(w_eq(pay_T_Dur(a), pay_T_Dur(b)))

def sub_Time_Time(+a: T_Time, +b: T_Time) -> T_SDur:
  T_SDur{w_lt(pay_T_Time(a), pay_T_Time(b)), w_sub(pay_T_Time(a), pay_T_Time(b))}

