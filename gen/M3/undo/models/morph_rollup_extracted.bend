  ux_veq_isChallenger(ux_reg_isChallenger(st2, ux_key_pair_Rollup_addChallenger_removeChallenger_0(x0), kh), ux_reg_isChallenger(st, ux_key_pair_Rollup_addChallenger_removeChallenger_0(x0), kh))

