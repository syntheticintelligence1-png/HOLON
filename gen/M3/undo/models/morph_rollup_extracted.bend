    case M.A_receive{ar, en}:
      False{}
    case M.A_removeChallenger{+ar, +en}:
      ux_hpair_Rollup_removeChallenger_addChallenger_a(M.x0_removeChallenger(M.gh_get_st(s), ar, en, kh), M.xr_removeChallenger(M.gh_get_st(s), ar, en, kh), s, y, kh)
    case M.A_renounceOwnership{ar, en}:
      False{}
    case M.A_revertBatch{ar, en}:
      False{}
    case M.A_setPause{ar, en}:
      False{}
    case M.A_transferOwnership{ar, en}:
      False{}
    case M.A_updateFinalizePeriodSeconds{ar, en}:
      False{}
    case M.A_updateProofWindow{ar, en}:
      False{}
    case M.A_updateRewardPercentage{ar, en}:
      False{}
    case M.A_updateRollupDelayPeriod{ar, en}:
      False{}
    case M.A_updateVerifier{ar, en}:
      False{}

# L_undo_pair_Rollup_removeChallenger_addChallenger: with NZ, after a call x of removeChallenger and a call y of addChallenger, both succeeding and restoring every register the pair restores, t observes from s2 what it observes from s
