def kk(c0: Bool, c1: Bool, c2: Bool, c3: Bool) -> Bool:
  Bool.and(c0, Bool.and(c1, Bool.and(c2, c3)))

def kv(+c0: Bool, +c1: Bool, +c2: Bool, +c3: Bool, e0: {True{} == c0 : Bool}, e1: {True{} == c1 : Bool}, e2: {True{} == c2 : Bool}, e3: {True{} == c3 : Bool}) -> {kk(c0, c1, c2, c3) == True{} : Bool}:
