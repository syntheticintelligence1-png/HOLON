  (%e1 : {kk(True{}, _, c2, c3) == True{} : Bool}
  (%e2 : {kk(True{}, True{}, _, c3) == True{} : Bool}
  (%e3 : {kk(True{}, True{}, True{}, _) == True{} : Bool}
  {==}))))

