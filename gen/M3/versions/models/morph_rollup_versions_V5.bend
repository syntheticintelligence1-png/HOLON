  match c:
    case True{}:
      s_renounceOwnership_3(x)
    case False{}:
      xf_renounceOwnership(x, 1, Nil{})

# check _openzeppelin/contracts-upgradeable/access/OwnableUpgradeable.sol:66-68
def s_renounceOwnership_4(x: X_renounceOwnership) -> X_renounceOwnership:
  match x:
    case X_renounceOwnership{x_st, x_ov, x_ar, +x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
      k_renounceOwnership_4(w_eq(ge_e_msg_value(x_en), W{0, 0, 0, 0, 0, 0, 0, 0}), X_renounceOwnership{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw})

def x0_renounceOwnership(+st: HSt, +ar: AR_renounceOwnership, +en: HEnv, +kh: List<&2, HKB>) -> X_renounceOwnership:
  X_renounceOwnership{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_renounceOwnership(+st: HSt, +ar: AR_renounceOwnership, +en: HEnv, +kh: List<&2, HKB>) -> X_renounceOwnership:
  s_renounceOwnership_4(x0_renounceOwnership(st, ar, en, kh))

def xo_renounceOwnership(x: X_renounceOwnership) -> HOut:
  match x:
    case X_renounceOwnership{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_renounceOwnership(+st: HSt, +ar: AR_renounceOwnership, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_renounceOwnership(xr_renounceOwnership(st, ar, en, kh))

# 0 when every check of renounceOwnership holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_renounceOwnership(+st: HSt, +ar: AR_renounceOwnership, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_renounceOwnership(st, ar, en, kh))

def post_renounceOwnership(+st: HSt, +ar: AR_renounceOwnership, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_renounceOwnership(st, ar, en, kh))

def logs_renounceOwnership(+st: HSt, +ar: AR_renounceOwnership, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_renounceOwnership(st, ar, en, kh))

def step_renounceOwnership(+st: HSt, +ar: AR_renounceOwnership, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_renounceOwnership(st, ar, en, kh), st)

