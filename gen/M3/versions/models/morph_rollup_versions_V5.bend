  X_updateVerifier{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_updateVerifier(+st: HSt, +ar: AR_updateVerifier, +en: HEnv, +kh: List<&2, HKB>) -> X_updateVerifier:
  s_updateVerifier_7(x0_updateVerifier(st, ar, en, kh))

def xo_updateVerifier(x: X_updateVerifier) -> HOut:
  match x:
    case X_updateVerifier{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_updateVerifier(+st: HSt, +ar: AR_updateVerifier, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_updateVerifier(xr_updateVerifier(st, ar, en, kh))

# 0 when every check of updateVerifier holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_updateVerifier(+st: HSt, +ar: AR_updateVerifier, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_updateVerifier(st, ar, en, kh))

def post_updateVerifier(+st: HSt, +ar: AR_updateVerifier, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_updateVerifier(st, ar, en, kh))

def logs_updateVerifier(+st: HSt, +ar: AR_updateVerifier, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_updateVerifier(st, ar, en, kh))

def step_updateVerifier(+st: HSt, +ar: AR_updateVerifier, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_updateVerifier(st, ar, en, kh), st)

# an action with its arguments and its environment (A-env: free per step)
type HAct is Data:
  A_addChallenger{ar: AR_addChallenger, en: HEnv}
  A_batchChallengedSuccess{ar: AR_batchChallengedSuccess, en: HEnv}
  A_batchExist{ar: AR_batchExist, en: HEnv}
  A_batchInChallenge{ar: AR_batchInChallenge, en: HEnv}
  A_batchInsideChallengeWindow{ar: AR_batchInsideChallengeWindow, en: HEnv}
  A_challengeState{ar: AR_challengeState, en: HEnv}
  A_claimProveRemaining{ar: AR_claimProveRemaining, en: HEnv}
  A_claimReward{ar: AR_claimReward, en: HEnv}
  A_finalizeBatch{ar: AR_finalizeBatch, en: HEnv}
  A_importGenesisBatch{ar: AR_importGenesisBatch, en: HEnv}
  A_initialize{ar: AR_initialize, en: HEnv}
  A_initialize2{ar: AR_initialize2, en: HEnv}
  A_isBatchFinalized{ar: AR_isBatchFinalized, en: HEnv}
  A_owner{ar: AR_owner, en: HEnv}
  A_paused{ar: AR_paused, en: HEnv}
  A_proveState{ar: AR_proveState, en: HEnv}
  A_receive{ar: AR_receive, en: HEnv}
  A_removeChallenger{ar: AR_removeChallenger, en: HEnv}
  A_renounceOwnership{ar: AR_renounceOwnership, en: HEnv}
  A_revertBatch{ar: AR_revertBatch, en: HEnv}
  A_setPause{ar: AR_setPause, en: HEnv}
  A_transferOwnership{ar: AR_transferOwnership, en: HEnv}
  A_updateFinalizePeriodSeconds{ar: AR_updateFinalizePeriodSeconds, en: HEnv}
  A_updateProofWindow{ar: AR_updateProofWindow, en: HEnv}
  A_updateRewardPercentage{ar: AR_updateRewardPercentage, en: HEnv}
  A_updateVerifier{ar: AR_updateVerifier, en: HEnv}

def step(a: HAct, +s: HSt, +kh: List<&2, HKB>) -> HSt:
  match a:
    case A_addChallenger{ar, en}:
      step_addChallenger(s, ar, en, kh)
    case A_batchChallengedSuccess{ar, en}:
      step_batchChallengedSuccess(s, ar, en, kh)
    case A_batchExist{ar, en}:
      step_batchExist(s, ar, en, kh)
    case A_batchInChallenge{ar, en}:
      step_batchInChallenge(s, ar, en, kh)
    case A_batchInsideChallengeWindow{ar, en}:
      step_batchInsideChallengeWindow(s, ar, en, kh)
    case A_challengeState{ar, en}:
      step_challengeState(s, ar, en, kh)
    case A_claimProveRemaining{ar, en}:
      step_claimProveRemaining(s, ar, en, kh)
    case A_claimReward{ar, en}:
      step_claimReward(s, ar, en, kh)
    case A_finalizeBatch{ar, en}:
      step_finalizeBatch(s, ar, en, kh)
    case A_importGenesisBatch{ar, en}:
      step_importGenesisBatch(s, ar, en, kh)
    case A_initialize{ar, en}:
      step_initialize(s, ar, en, kh)
    case A_initialize2{ar, en}:
      step_initialize2(s, ar, en, kh)
    case A_isBatchFinalized{ar, en}:
      step_isBatchFinalized(s, ar, en, kh)
    case A_owner{ar, en}:
      step_owner(s, ar, en, kh)
    case A_paused{ar, en}:
      step_paused(s, ar, en, kh)
    case A_proveState{ar, en}:
      step_proveState(s, ar, en, kh)
    case A_receive{ar, en}:
      step_receive(s, ar, en, kh)
    case A_removeChallenger{ar, en}:
      step_removeChallenger(s, ar, en, kh)
    case A_renounceOwnership{ar, en}:
      step_renounceOwnership(s, ar, en, kh)
    case A_revertBatch{ar, en}:
      step_revertBatch(s, ar, en, kh)
    case A_setPause{ar, en}:
      step_setPause(s, ar, en, kh)
    case A_transferOwnership{ar, en}:
      step_transferOwnership(s, ar, en, kh)
    case A_updateFinalizePeriodSeconds{ar, en}:
      step_updateFinalizePeriodSeconds(s, ar, en, kh)
    case A_updateProofWindow{ar, en}:
      step_updateProofWindow(s, ar, en, kh)
    case A_updateRewardPercentage{ar, en}:
      step_updateRewardPercentage(s, ar, en, kh)
    case A_updateVerifier{ar, en}:
      step_updateVerifier(s, ar, en, kh)

# the initial state: the target's storage after the deployment of the binding (zero without one)
def s0() -> HSt:
  HSt{Nil{}}

def run(tr: List<&2, HAct>, s: HSt, +kh: List<&2, HKB>) -> HSt:
  match tr:
    case Nil{}:
      s
    case Con{a, rest}:
      run(rest, step(a, s, kh), kh)

# the reachable states: the deployment (R0) and one step of any action (RStep)
type Reach<-kh: List<&2, HKB>, -s: HSt> is Type:
  R0{e: {s == s0() : HSt}}
  RStep{a: HAct, p: HSt, r: Reach<kh, p>, e: {s == step(a, p, kh) : HSt}}
