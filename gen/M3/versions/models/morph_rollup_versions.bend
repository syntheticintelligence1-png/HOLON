# the state after step x from s (s itself when the step reverts)
def vstep(x: VStep, s: VSt, +kh: List<&2, HKB>) -> VSt:
  match x:
    case U_entry{c}:
      vu_entry(s, c, kh)
    case U_V3_V4{c}:
      vu_V3_V4(s, c, kh)
    case U_V4_V5{c}:
      vu_V4_V5(s, c, kh)
    case U_V5_V6{c}:
      vu_V5_V6(s, c, kh)
    case U_V6_V7{c}:
      vu_V6_V7(s, c, kh)
    case U_V7_V8{c}:
      vu_V7_V8(s, c, kh)
    case U_V8_V9{c}:
      vu_V8_V9(s, c, kh)
    case U_V9_V10{c}:
      vu_V9_V10(s, c, kh)
    case U_V10_V11{c}:
      vu_V10_V11(s, c, kh)
    case C_V3_addChallenger{ar, cl, en}:
      vc_V3_addChallenger(s, ar, cl, en, kh)
    case C_V3_batchChallengedSuccess{ar, cl, en}:
      vc_V3_batchChallengedSuccess(s, ar, cl, en, kh)
