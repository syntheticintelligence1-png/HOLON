def cw_V3(w: W) -> K_V3.W:
  match w:
    case W{l0, l1, l2, l3, l4, l5, l6, l7}:
      K_V3.W{l0, l1, l2, l3, l4, l5, l6, l7}

def wc_V3(w: K_V3.W) -> W:
  match w:
    case K_V3.W{l0, l1, l2, l3, l4, l5, l6, l7}:
      W{l0, l1, l2, l3, l4, l5, l6, l7}

def clW_V3(xs: List<&2, W>) -> List<&2, K_V3.W>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{x, t}:
      Con{cw_V3(x), clW_V3(t)}

def clKW_V3(xs: List<&2, KW>) -> List<&2, K_V3.KW>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      match h:
        case KW{a, b}:
          Con{K_V3.KW{cw_V3(a), cw_V3(b)}, clKW_V3(t)}

def clHKB_V3(xs: List<&2, HKB>) -> List<&2, K_V3.HKB>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      match h:
        case HKB{a, b}:
          Con{K_V3.HKB{a, cw_V3(b)}, clHKB_V3(t)}

def clHCall_V3(xs: List<&2, HCall>) -> List<&2, K_V3.HCall>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      match h:
        case HCall{a, b, c, d}:
          Con{K_V3.HCall{cw_V3(a), b, c, d}, clHCall_V3(t)}

def clKB_V3(xs: List<&2, KB>) -> List<&2, K_V3.KB>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      match h:
        case KB{a, b}:
          Con{K_V3.KB{cw_V3(a), b}, clKB_V3(t)}

def lKW_V3(xs: List<&2, K_V3.KW>) -> List<&2, KW>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      match h:
        case K_V3.KW{a, b}:
          Con{KW{wc_V3(a), wc_V3(b)}, lKW_V3(t)}

def cst_V3(s: HSt) -> K_V3.HSt:
  match s:
    case HSt{sl}:
      K_V3.HSt{clKW_V3(sl)}

def stc_V3(s: K_V3.HSt) -> HSt:
  match s:
    case K_V3.HSt{sl}:
      HSt{lKW_V3(sl)}

def ckh_V3(xs: List<&2, HKB>) -> List<&2, K_V3.HKB>:
  clHKB_V3(xs)

def env_V3(en: VEnv, +cl: W) -> K_V3.HEnv:
  match en:
    case VEnv{e_blobs, e_block_timestamp, e_calls, e_code, e_immutable_LAYER_2_CHAIN_ID, e_msg_data_length, e_msg_value, e_this}:
      K_V3.HEnv{cw_V3(e_block_timestamp), cw_V3(cl), clHCall_V3(e_calls), clKB_V3(e_code), cw_V3(e_immutable_LAYER_2_CHAIN_ID), cw_V3(e_msg_data_length), cw_V3(e_msg_value), cw_V3(e_this)}

def vfin_V3(o: K_V3.HOut, f: VSt) -> VSt:
  match o:
    case K_V3.HOut{c, rv, po, lg, tw}:
      vpick(U32.is_eq(c, 0), VSt{VV_V3{}, stc_V3(po)}, f)

def vokf_V3(o: K_V3.HOut) -> Bool:
  match o:
    case K_V3.HOut{c, rv, po, lg, tw}:
      U32.is_eq(c, 0)

