def vadmin_slot() -> W:
  W{190669059, 3601274757, 3907916152, 608068534, 4171628910, 1940788153, 1247185713, 3039897448}

# the proxy's creation: the placeholder version, every slot zero but the admin slot
def vr0() -> VSt:
  VSt{VV_placeholder{}, HSt{[KW{vadmin_slot(), W{173, 0, 0, 0, 0, 0, 0, 0}}]}}

def vuc_entry(+st: HSt, c: UC_entry, +kh: List<&2, HKB>) -> VSt:
  match c:
    case UN_entry{}:
      VSt{VV_V3{}, st}
    case UK_entry_initialize{ar, en}:
      vfin_V3(K_V3.run_initialize(cst_V3(st), ar, env_V3(en, sload(st, vadmin_slot())), ckh_V3(kh)), VSt{VV_placeholder{}, st})

def vua_entry(go: Bool, v: VV, +st: HSt, c: UC_entry, +kh: List<&2, HKB>) -> VSt:
  match go:
    case True{}:
      vuc_entry(st, c, kh)
    case False{}:
      VSt{v, st}

def vu_entry(s: VSt, c: UC_entry, +kh: List<&2, HKB>) -> VSt:
  match s:
    case VSt{+v, +st}:
      vua_entry(vis_placeholder(v), v, st, c, kh)

