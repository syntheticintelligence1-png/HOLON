    case C_V11_renounceOwnership{ar, cl, en}:
      vok_c_V11_renounceOwnership(s, ar, cl, en, kh)
    case C_V11_revertBatch{ar, cl, en}:
      vok_c_V11_revertBatch(s, ar, cl, en, kh)
    case C_V11_setPause{ar, cl, en}:
      vok_c_V11_setPause(s, ar, cl, en, kh)
    case C_V11_transferOwnership{ar, cl, en}:
      vok_c_V11_transferOwnership(s, ar, cl, en, kh)
    case C_V11_updateFinalizePeriodSeconds{ar, cl, en}:
      vok_c_V11_updateFinalizePeriodSeconds(s, ar, cl, en, kh)
    case C_V11_updateProofWindow{ar, cl, en}:
      vok_c_V11_updateProofWindow(s, ar, cl, en, kh)
    case C_V11_updateRewardPercentage{ar, cl, en}:
      vok_c_V11_updateRewardPercentage(s, ar, cl, en, kh)
    case C_V11_updateRollupDelayPeriod{ar, cl, en}:
      vok_c_V11_updateRollupDelayPeriod(s, ar, cl, en, kh)
    case C_V11_updateVerifier{ar, cl, en}:
      vok_c_V11_updateVerifier(s, ar, cl, en, kh)

def vrun(xs: List<&2, VStep>, s: VSt, +kh: List<&2, HKB>) -> VSt:
  match xs:
    case Nil{}:
      s
    case Con{x, rest}:
      vrun(rest, vstep(x, s, kh), kh)

# the reachable states of the versioned machine: the proxy's creation and one step of any kind
type VReach<-kh: List<&2, HKB>, -s: VSt> is Type:
  VR0{e: {s == vr0() : VSt}}
  VRStep{x: VStep, p: VSt, r: VReach<kh, p>, e: {s == vstep(x, p, kh) : VSt}}

# the real slot of a layout coordinate's mapping steps from slot l
def vloc(p: List<&2, VP>, l: W, +kh: List<&2, HKB>) -> W:
  match p:
    case Nil{}:
      l
    case Con{h, t}:
      match h:
        case VP{k, o}:
          vloc(t, w_add(h_get(kh, List.append(&2, U32, b_of_w(k), b_of_w(l))), o), kh)

# the word at the storage location of layout coordinate (b, o, p)
def vread(s: VSt, b: W, o: W, p: List<&2, VP>, +kh: List<&2, HKB>) -> W:
  match s:
    case VSt{v, st}:
      sload(st, vloc(p, w_add(b, o), kh))

# the cells (17, 192) and (9, 192) of a root input are equal
def pcell_committedBatches_17_9(+x: List<&2, U32>) -> Bool:
  b_eq(b_take(8n, b_drop(x, 17n), 0), b_take(8n, b_drop(x, 9n), 0))

def pic_V3_committedBatches_17_9(ok: Bool, ar: K_V3.AR_importGenesisBatch) -> Bool:
  match ok:
    case True{}:
      pcell_committedBatches_17_9(K_V3.ga_importGenesisBatch__batchHeader(ar))
    case False{}:
      True{}

