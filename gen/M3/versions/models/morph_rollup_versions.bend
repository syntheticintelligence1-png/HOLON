# init morph_rollup.versions:chain:committedBatches:17:9: a successful call of importGenesisBatch commits a header whose cell 17 equals its cell 9
def pinit_committedBatches_17_9(a: VStep, s: VSt, e: VEnv, +kh: List<&2, HKB>) -> Bool:
  match a:
    case C_V3_importGenesisBatch{+ar, +cl, en}:
      pic_V3_committedBatches_17_9(vok(C_V3_importGenesisBatch{ar, cl, e}, s, kh), ar)
    case C_V4_importGenesisBatch{+ar, +cl, en}:
      pic_V4_committedBatches_17_9(vok(C_V4_importGenesisBatch{ar, cl, e}, s, kh), ar)
    case C_V5_importGenesisBatch{+ar, +cl, en}:
      pic_V5_committedBatches_17_9(vok(C_V5_importGenesisBatch{ar, cl, e}, s, kh), ar)
    case C_V6_importGenesisBatch{+ar, +cl, en}:
      pic_V6_committedBatches_17_9(vok(C_V6_importGenesisBatch{ar, cl, e}, s, kh), ar)
    case C_V7_importGenesisBatch{+ar, +cl, en}:
      pic_V7_committedBatches_17_9(vok(C_V7_importGenesisBatch{ar, cl, e}, s, kh), ar)
    case C_V8_importGenesisBatch{+ar, +cl, en}:
      pic_V8_committedBatches_17_9(vok(C_V8_importGenesisBatch{ar, cl, e}, s, kh), ar)
    case C_V9_importGenesisBatch{+ar, +cl, en}:
      pic_V9_committedBatches_17_9(vok(C_V9_importGenesisBatch{ar, cl, e}, s, kh), ar)
    case C_V10_importGenesisBatch{+ar, +cl, en}:
      pic_V10_committedBatches_17_9(vok(C_V10_importGenesisBatch{ar, cl, e}, s, kh), ar)
    case C_V11_importGenesisBatch{+ar, +cl, en}:
      pic_V11_committedBatches_17_9(vok(C_V11_importGenesisBatch{ar, cl, e}, s, kh), ar)
    case _:
      True{}

# one step of an action of V3 (its module's step), on the layer's storage
def step_V3(a: K_V3.HAct, +s: HSt, +kh: List<&2, HKB>) -> HSt:
  stc_V3(K_V3.step(a, cst_V3(s), ckh_V3(kh)))

# a trace of actions of V3 (its module's run)
def run_V3(tr: List<&2, K_V3.HAct>, s: HSt, +kh: List<&2, HKB>) -> HSt:
  stc_V3(K_V3.run(tr, cst_V3(s), ckh_V3(kh)))

