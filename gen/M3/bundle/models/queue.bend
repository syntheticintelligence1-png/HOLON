def s_updateWhitelistChecker_4(x: X_updateWhitelistChecker) -> X_updateWhitelistChecker:
  match x:
    case X_updateWhitelistChecker{x_st, x_ov, +x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
      k_updateWhitelistChecker_4(Bool.not(w_nz(w_shr_160(ga_updateWhitelistChecker__newWhitelistChecker(x_ar)))), X_updateWhitelistChecker{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw})

# updateWhitelistChecker#contracts/contracts/l1/rollup/L1MessageQueueWithGasPriceOracle.sol:351-354#1
