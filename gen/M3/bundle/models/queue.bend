      s_updateWhitelistChecker_4(x)
    case False{}:
      xf_updateWhitelistChecker(x, 2, Nil{})

# check contracts/contracts/l1/rollup/L1MessageQueueWithGasPriceOracle.sol:351-354
def s_updateWhitelistChecker_5(x: X_updateWhitelistChecker) -> X_updateWhitelistChecker:
  match x:
    case X_updateWhitelistChecker{x_st, x_ov, x_ar, +x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
      k_updateWhitelistChecker_5(w_ge(ge_e_msg_data_length(x_en), W{36, 0, 0, 0, 0, 0, 0, 0}), X_updateWhitelistChecker{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw})

# updateWhitelistChecker#contracts/contracts/l1/rollup/L1MessageQueueWithGasPriceOracle.sol:351-354#0
def k_updateWhitelistChecker_6(c: Bool, x: X_updateWhitelistChecker) -> X_updateWhitelistChecker:
  match c:
    case True{}:
      s_updateWhitelistChecker_5(x)
    case False{}:
      xf_updateWhitelistChecker(x, 1, Nil{})

# check contracts/contracts/l1/rollup/L1MessageQueueWithGasPriceOracle.sol:351-354
def s_updateWhitelistChecker_6(x: X_updateWhitelistChecker) -> X_updateWhitelistChecker:
  match x:
    case X_updateWhitelistChecker{x_st, x_ov, x_ar, +x_en, x_kh, x_cd, x_rv, x_lg, x_tw}:
      k_updateWhitelistChecker_6(w_eq(ge_e_msg_value(x_en), W{0, 0, 0, 0, 0, 0, 0, 0}), X_updateWhitelistChecker{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw})

def x0_updateWhitelistChecker(+st: HSt, +ar: AR_updateWhitelistChecker, +en: HEnv, +kh: List<&2, HKB>) -> X_updateWhitelistChecker:
  X_updateWhitelistChecker{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_updateWhitelistChecker(+st: HSt, +ar: AR_updateWhitelistChecker, +en: HEnv, +kh: List<&2, HKB>) -> X_updateWhitelistChecker:
  s_updateWhitelistChecker_6(x0_updateWhitelistChecker(st, ar, en, kh))

def xo_updateWhitelistChecker(x: X_updateWhitelistChecker) -> HOut:
  match x:
    case X_updateWhitelistChecker{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_updateWhitelistChecker(+st: HSt, +ar: AR_updateWhitelistChecker, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_updateWhitelistChecker(xr_updateWhitelistChecker(st, ar, en, kh))

# 0 when every check of updateWhitelistChecker holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_updateWhitelistChecker(+st: HSt, +ar: AR_updateWhitelistChecker, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_updateWhitelistChecker(st, ar, en, kh))

def post_updateWhitelistChecker(+st: HSt, +ar: AR_updateWhitelistChecker, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_updateWhitelistChecker(st, ar, en, kh))

def logs_updateWhitelistChecker(+st: HSt, +ar: AR_updateWhitelistChecker, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_updateWhitelistChecker(st, ar, en, kh))

def step_updateWhitelistChecker(+st: HSt, +ar: AR_updateWhitelistChecker, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_updateWhitelistChecker(st, ar, en, kh), st)

# an action with its arguments and its environment (A-env: free per step)
type HAct is Data:
  A_calculateIntrinsicGasFee{ar: AR_calculateIntrinsicGasFee, en: HEnv}
  A_estimateCrossDomainMessageFee{ar: AR_estimateCrossDomainMessageFee, en: HEnv}
  A_getFirstUnfinalizedMessageEnqueueTime{ar: AR_getFirstUnfinalizedMessageEnqueueTime, en: HEnv}
  A_getMessageEnqueueTimestamp{ar: AR_getMessageEnqueueTimestamp, en: HEnv}
  A_initialize{ar: AR_initialize, en: HEnv}
  A_nextCrossDomainMessageIndex{ar: AR_nextCrossDomainMessageIndex, en: HEnv}
  A_owner{ar: AR_owner, en: HEnv}
  A_popCrossDomainMessage{ar: AR_popCrossDomainMessage, en: HEnv}
  A_renounceOwnership{ar: AR_renounceOwnership, en: HEnv}
  A_setL2BaseFee{ar: AR_setL2BaseFee, en: HEnv}
  A_transferOwnership{ar: AR_transferOwnership, en: HEnv}
  A_updateMaxGasLimit{ar: AR_updateMaxGasLimit, en: HEnv}
  A_updateWhitelistChecker{ar: AR_updateWhitelistChecker, en: HEnv}

def step(a: HAct, +s: HSt, +kh: List<&2, HKB>) -> HSt:
  match a:
    case A_calculateIntrinsicGasFee{ar, en}:
      step_calculateIntrinsicGasFee(s, ar, en, kh)
    case A_estimateCrossDomainMessageFee{ar, en}:
      step_estimateCrossDomainMessageFee(s, ar, en, kh)
    case A_getFirstUnfinalizedMessageEnqueueTime{ar, en}:
      step_getFirstUnfinalizedMessageEnqueueTime(s, ar, en, kh)
    case A_getMessageEnqueueTimestamp{ar, en}:
      step_getMessageEnqueueTimestamp(s, ar, en, kh)
    case A_initialize{ar, en}:
      step_initialize(s, ar, en, kh)
    case A_nextCrossDomainMessageIndex{ar, en}:
      step_nextCrossDomainMessageIndex(s, ar, en, kh)
    case A_owner{ar, en}:
      step_owner(s, ar, en, kh)
    case A_popCrossDomainMessage{ar, en}:
      step_popCrossDomainMessage(s, ar, en, kh)
    case A_renounceOwnership{ar, en}:
      step_renounceOwnership(s, ar, en, kh)
    case A_setL2BaseFee{ar, en}:
      step_setL2BaseFee(s, ar, en, kh)
    case A_transferOwnership{ar, en}:
      step_transferOwnership(s, ar, en, kh)
    case A_updateMaxGasLimit{ar, en}:
      step_updateMaxGasLimit(s, ar, en, kh)
    case A_updateWhitelistChecker{ar, en}:
      step_updateWhitelistChecker(s, ar, en, kh)

# the initial state: the target's storage after the deployment of the binding (zero without one)
def s0() -> HSt:
  HSt{[KW{W{0, 0, 0, 0, 0, 0, 0, 0}, W{1, 0, 0, 0, 0, 0, 0, 0}}, KW{W{51, 0, 0, 0, 0, 0, 0, 0}, W{725488790, 3714200534, 2888397955, 3775048766, 2141796443, 0, 0, 0}}, KW{W{104, 0, 0, 0, 0, 0, 0, 0}, W{10000000, 0, 0, 0, 0, 0, 0, 0}}, KW{W{107, 0, 0, 0, 0, 0, 0, 0}, W{3424892719, 2712917043, 4194384351, 2562408013, 1444273847, 0, 0, 0}}, KW{W{1563962300, 547605072, 3426170281, 3393069174, 1227733389, 107464744, 1000448801, 906532001}, W{2438343339, 1418373816, 2049007707, 3613579632, 61253708, 0, 0, 0}}, KW{W{190669059, 3601274757, 3907916152, 608068534, 4171628910, 1940788153, 1247185713, 3039897448}, W{173, 0, 0, 0, 0, 0, 0, 0}}]}

def run(tr: List<&2, HAct>, s: HSt, +kh: List<&2, HKB>) -> HSt:
  match tr:
    case Nil{}:
      s
    case Con{a, rest}:
      run(rest, step(a, s, kh), kh)

# the reachable states: the deployment (R0) and one step of any action (RStep)
type Reach<-kh: List<&2, HKB>, -s: HSt> is Type:
  R0{e: {s == s0() : HSt}}
  RStep{a: HAct, p: HSt, r: Reach<kh, p>, e: {s == step(a, p, kh) : HSt}}
