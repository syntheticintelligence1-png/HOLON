      k_withdraw_7(w_eq(ge_e_msg_value(x_en), W{0, 0, 0, 0, 0, 0, 0, 0}), X_withdraw{x_st, x_ov, x_ar, x_en, x_kh, x_cd, x_rv, x_lg, x_tw})

def x0_withdraw(+st: HSt, +ar: AR_withdraw, +en: HEnv, +kh: List<&2, HKB>) -> X_withdraw:
  X_withdraw{st, st, ar, en, kh, 0, Nil{}, Nil{}, Nil{}}

# the context after the action's program ran (holon.extracted_eval's order)
def xr_withdraw(+st: HSt, +ar: AR_withdraw, +en: HEnv, +kh: List<&2, HKB>) -> X_withdraw:
  s_withdraw_7(x0_withdraw(st, ar, en, kh))

def xo_withdraw(x: X_withdraw) -> HOut:
  match x:
    case X_withdraw{_, x_ov, _, _, _, x_cd, x_rv, x_lg, x_tw}:
      HOut{x_cd, x_rv, x_ov, lg_rev(x_lg, Nil{}), x_tw}

def run_withdraw(+st: HSt, +ar: AR_withdraw, +en: HEnv, +kh: List<&2, HKB>) -> HOut:
  xo_withdraw(xr_withdraw(st, ar, en, kh))

# 0 when every check of withdraw holds, k + 1 when check k (holon.machine's order) is the first to fail
def chk_withdraw(+st: HSt, +ar: AR_withdraw, +en: HEnv, +kh: List<&2, HKB>) -> U32:
  o_code(run_withdraw(st, ar, en, kh))

def post_withdraw(+st: HSt, +ar: AR_withdraw, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  o_post(run_withdraw(st, ar, en, kh))

def logs_withdraw(+st: HSt, +ar: AR_withdraw, +en: HEnv, +kh: List<&2, HKB>) -> List<&2, HLog>:
  o_logs(run_withdraw(st, ar, en, kh))

def step_withdraw(+st: HSt, +ar: AR_withdraw, +en: HEnv, +kh: List<&2, HKB>) -> HSt:
  st_after(run_withdraw(st, ar, en, kh), st)

# an action with its arguments and its environment (A-env: free per step)
type HAct is Data:
  A_addSubmitter{ar: AR_addSubmitter, en: HEnv}
  A_claimSlashRemaining{ar: AR_claimSlashRemaining, en: HEnv}
  A_claimWithdrawal{ar: AR_claimWithdrawal, en: HEnv}
  A_initialize{ar: AR_initialize, en: HEnv}
  A_isActive{ar: AR_isActive, en: HEnv}
  A_owner{ar: AR_owner, en: HEnv}
  A_removeSubmitter{ar: AR_removeSubmitter, en: HEnv}
  A_renounceOwnership{ar: AR_renounceOwnership, en: HEnv}
  A_setMinimumStake{ar: AR_setMinimumStake, en: HEnv}
  A_slash{ar: AR_slash, en: HEnv}
  A_stake{ar: AR_stake, en: HEnv}
  A_transferOwnership{ar: AR_transferOwnership, en: HEnv}
  A_updateChallengeDeposit{ar: AR_updateChallengeDeposit, en: HEnv}
  A_updateRewardPercentage{ar: AR_updateRewardPercentage, en: HEnv}
  A_withdraw{ar: AR_withdraw, en: HEnv}

def step(a: HAct, +s: HSt, +kh: List<&2, HKB>) -> HSt:
  match a:
    case A_addSubmitter{ar, en}:
      step_addSubmitter(s, ar, en, kh)
    case A_claimSlashRemaining{ar, en}:
      step_claimSlashRemaining(s, ar, en, kh)
    case A_claimWithdrawal{ar, en}:
      step_claimWithdrawal(s, ar, en, kh)
    case A_initialize{ar, en}:
      step_initialize(s, ar, en, kh)
    case A_isActive{ar, en}:
      step_isActive(s, ar, en, kh)
    case A_owner{ar, en}:
      step_owner(s, ar, en, kh)
    case A_removeSubmitter{ar, en}:
      step_removeSubmitter(s, ar, en, kh)
    case A_renounceOwnership{ar, en}:
      step_renounceOwnership(s, ar, en, kh)
    case A_setMinimumStake{ar, en}:
      step_setMinimumStake(s, ar, en, kh)
    case A_slash{ar, en}:
      step_slash(s, ar, en, kh)
    case A_stake{ar, en}:
      step_stake(s, ar, en, kh)
    case A_transferOwnership{ar, en}:
      step_transferOwnership(s, ar, en, kh)
    case A_updateChallengeDeposit{ar, en}:
      step_updateChallengeDeposit(s, ar, en, kh)
    case A_updateRewardPercentage{ar, en}:
      step_updateRewardPercentage(s, ar, en, kh)
    case A_withdraw{ar, en}:
      step_withdraw(s, ar, en, kh)

# the initial state: the target's storage after the deployment of the binding (zero without one)
def s0() -> HSt:
  HSt{[KW{W{0, 0, 0, 0, 0, 0, 0, 0}, W{1, 0, 0, 0, 0, 0, 0, 0}}, KW{W{51, 0, 0, 0, 0, 0, 0, 0}, W{725488790, 3714200534, 2888397955, 3775048766, 2141796443, 0, 0, 0}}, KW{W{101, 0, 0, 0, 0, 0, 0, 0}, W{1, 0, 0, 0, 0, 0, 0, 0}}, KW{W{151, 0, 0, 0, 0, 0, 0, 0}, W{1068857001, 3918681293, 1456729169, 363394722, 1502716639, 0, 0, 0}}, KW{W{152, 0, 0, 0, 0, 0, 0, 0}, W{2808348672, 232830643, 0, 0, 0, 0, 0, 0}}, KW{W{153, 0, 0, 0, 0, 0, 0, 0}, W{1, 0, 0, 0, 0, 0, 0, 0}}, KW{W{154, 0, 0, 0, 0, 0, 0, 0}, W{20, 0, 0, 0, 0, 0, 0, 0}}, KW{W{4262691420, 2773174323, 1693844328, 111321583, 144050432, 387103744, 3719196585, 112964662}, W{1, 0, 0, 0, 0, 0, 0, 0}}, KW{W{1563962300, 547605072, 3426170281, 3393069174, 1227733389, 107464744, 1000448801, 906532001}, W{3962702769, 107263671, 654799238, 2764125102, 3340252245, 0, 0, 0}}, KW{W{2393228258, 2880041055, 2846777565, 1057917073, 1576675443, 760542485, 2874397788, 1302587242}, W{2808348672, 232830643, 0, 0, 0, 0, 0, 0}}, KW{W{1943644614, 47275775, 878370823, 2358984609, 2473866751, 512103264, 1939064567, 1582445754}, W{2808348672, 232830643, 0, 0, 0, 0, 0, 0}}, KW{W{190669059, 3601274757, 3907916152, 608068534, 4171628910, 1940788153, 1247185713, 3039897448}, W{173, 0, 0, 0, 0, 0, 0, 0}}, KW{W{1336631855, 2026400076, 812001385, 1802044470, 2270657611, 2706432616, 413631003, 3866415071}, W{1, 0, 0, 0, 0, 0, 0, 0}}]}

def run(tr: List<&2, HAct>, s: HSt, +kh: List<&2, HKB>) -> HSt:
  match tr:
    case Nil{}:
      s
    case Con{a, rest}:
      run(rest, step(a, s, kh), kh)

# the reachable states: the deployment (R0) and one step of any action (RStep)
type Reach<-kh: List<&2, HKB>, -s: HSt> is Type:
  R0{e: {s == s0() : HSt}}
  RStep{a: HAct, p: HSt, r: Reach<kh, p>, e: {s == step(a, p, kh) : HSt}}
