def _le_le_ok(x: Cmp, y: Cmp, ex: {Cmp.is_lt(cflip(x)) == False{} : Bool}, ey: {Cmp.is_lt(cflip(y)) == False{} : Bool}) -> {cok(x, y) == True{} : Bool}:
