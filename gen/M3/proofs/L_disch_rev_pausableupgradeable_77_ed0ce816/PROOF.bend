  match c:
    case True{}:
      (%Equal.sym(M.SK, hk, k, sk_refl(hk, k, ec)) : {M.ite(M.W, Bool.and(M.sk_eq(_, kw), Bool.not(d)), v, hv) == hv : M.W}
      (%Equal.sym(Bool, M.sk_eq(k, kw), False{}, ne) : {M.ite(M.W, Bool.and(_, Bool.not(d)), v, hv) == hv : M.W}
      {==}))
    case False{}:
      ih

