def _fin_flip(x: Bool, y: Bool, r: Cmp, s: Cmp, ih: {s == cflip(r) : Cmp}) -> {Word.cmp.fin(y, x, s) == cflip(Word.cmp.fin(x, y, r)) : Cmp}:
  match x y r s:
    case True{} True{} LT{} LT{}:
      efq({Word.cmp.fin(True{}, True{}, LT{}) == cflip(Word.cmp.fin(True{}, True{}, LT{})) : Cmp}, cmp_ne_LT_GT(ih))
    case True{} True{} LT{} EQ{}:
      efq({Word.cmp.fin(True{}, True{}, EQ{}) == cflip(Word.cmp.fin(True{}, True{}, LT{})) : Cmp}, cmp_ne_EQ_GT(ih))
    case True{} True{} LT{} GT{}:
      {==}
    case True{} True{} EQ{} LT{}:
      efq({Word.cmp.fin(True{}, True{}, LT{}) == cflip(Word.cmp.fin(True{}, True{}, EQ{})) : Cmp}, cmp_ne_LT_EQ(ih))
    case True{} True{} EQ{} EQ{}:
      {==}
    case True{} True{} EQ{} GT{}:
      efq({Word.cmp.fin(True{}, True{}, GT{}) == cflip(Word.cmp.fin(True{}, True{}, EQ{})) : Cmp}, cmp_ne_GT_EQ(ih))
    case True{} True{} GT{} LT{}:
      {==}
