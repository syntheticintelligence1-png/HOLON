def _ult2_lex(c: Cmp, +l: Cmp, +lt: Bool, +eq: Bool, +lo: Bool, elt: {lt == Cmp.is_lt(c) : Bool}, eeq: {eq == Cmp.is_eq(c) : Bool}, elo: {lo == Cmp.is_lt(l) : Bool}) -> {Bool.or(lt, Bool.and(eq, lo)) == Cmp.is_lt(lex(c, l)) : Bool}:
  match c:
    case LT{}:
      %Equal.sym(Bool, lt, True{}, elt) : {Bool.or(_, Bool.and(eq, lo)) == True{} : Bool}
      {==}
    case EQ{}:
      %Equal.sym(Bool, lt, False{}, elt) : {Bool.or(_, Bool.and(eq, lo)) == Cmp.is_lt(l) : Bool}
      %Equal.sym(Bool, eq, True{}, eeq) : {Bool.or(False{}, Bool.and(_, lo)) == Cmp.is_lt(l) : Bool}
      elo
    case GT{}:
      %Equal.sym(Bool, lt, False{}, elt) : {Bool.or(_, Bool.and(eq, lo)) == False{} : Bool}
      %Equal.sym(Bool, eq, False{}, eeq) : {Bool.or(False{}, Bool.and(_, lo)) == False{} : Bool}
      {==}

