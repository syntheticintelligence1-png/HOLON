def cmp_trans(+n: Nat, a: Word(n), b: Word(n), c: Word(n), ok: {cok(Word.cmp(n, a, b), Word.cmp(n, b, c)) == True{} : Bool}) -> {Word.cmp(n, a, c) == ccomb(Word.cmp(n, a, b), Word.cmp(n, b, c)) : Cmp}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match a b c:
        case WCon{x, +at} WCon{y, +bt} WCon{z, +ct}:
          _fin_trans(x, y, z, Word.cmp(p, at, bt), Word.cmp(p, bt, ct), Word.cmp(p, at, ct), o => cmp_trans(p, at, bt, ct, o), ok)

def cmp_flip(+n: Nat, a: Word(n), b: Word(n)) -> {Word.cmp(n, b, a) == cflip(Word.cmp(n, a, b)) : Cmp}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match a b:
        case WCon{x, +at} WCon{y, +bt}:
          _fin_flip(x, y, Word.cmp(p, at, bt), Word.cmp(p, bt, at), cmp_flip(p, at, bt))

def u_trans(a: U32, b: U32, c: U32, ok: {cok(U32.cmp(a, b), U32.cmp(b, c)) == True{} : Bool}) -> {U32.cmp(a, c) == ccomb(U32.cmp(a, b), U32.cmp(b, c)) : Cmp}:
  match a b c:
    case U32{x} U32{y} U32{z}:
      cmp_trans(32n, x, y, z, ok)

def u_flip(a: U32, b: U32) -> {U32.cmp(b, a) == cflip(U32.cmp(a, b)) : Cmp}:
  match a b:
    case U32{x} U32{y}:
      cmp_flip(32n, x, y)

def lex(hi: Cmp, lo: Cmp) -> Cmp:
  match hi:
    case LT{}:
      LT{}
    case EQ{}:
      lo
    case GT{}:
      GT{}

def _lex_trans(h1: Cmp, h2: Cmp, h3: Cmp, l1: Cmp, l2: Cmp, l3: Cmp, ihh: {cok(h1, h2) == True{} : Bool} -> {h3 == ccomb(h1, h2) : Cmp}, ihl: {cok(l1, l2) == True{} : Bool} -> {l3 == ccomb(l1, l2) : Cmp}, ok: {cok(lex(h1, l1), lex(h2, l2)) == True{} : Bool}) -> {lex(h3, l3) == ccomb(lex(h1, l1), lex(h2, l2)) : Cmp}:
  match h1 h2 h3 l1 l2 l3:
    case LT{} LT{} LT{} LT{} LT{} LT{}:
      {==}
    case LT{} LT{} LT{} LT{} LT{} EQ{}:
