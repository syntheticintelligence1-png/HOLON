# ---- word order (holon.disch.order: generic, proved here, never assumed)
def cflip(a: Cmp) -> Cmp:
  match a:
    case LT{}:
      GT{}
    case EQ{}:
      EQ{}
    case GT{}:
      LT{}

def ccomb(a: Cmp, b: Cmp) -> Cmp:
  match a b:
    case LT{} LT{}:
      LT{}
    case LT{} EQ{}:
      LT{}
    case LT{} GT{}:
      EQ{}
    case EQ{} LT{}:
      LT{}
    case EQ{} EQ{}:
      EQ{}
    case EQ{} GT{}:
      GT{}
    case GT{} LT{}:
      EQ{}
    case GT{} EQ{}:
      GT{}
    case GT{} GT{}:
      GT{}

def cok(a: Cmp, b: Cmp) -> Bool:
  match a b:
    case LT{} LT{}:
      True{}
    case LT{} EQ{}:
      True{}
    case LT{} GT{}:
      False{}
    case EQ{} LT{}:
      True{}
    case EQ{} EQ{}:
      True{}
    case EQ{} GT{}:
      True{}
    case GT{} LT{}:
      False{}
    case GT{} EQ{}:
      True{}
    case GT{} GT{}:
      True{}

def is_cmp(a: Cmp, b: Cmp) -> Type:
  match a b:
    case LT{} LT{}:
      Unit
    case LT{} EQ{}:
      Empty
    case LT{} GT{}:
      Empty
    case EQ{} LT{}:
      Empty
    case EQ{} EQ{}:
      Unit
    case EQ{} GT{}:
      Empty
    case GT{} LT{}:
      Empty
    case GT{} EQ{}:
      Empty
    case GT{} GT{}:
      Unit

def cmp_ne_LT_EQ(e: {LT{} == EQ{} : Cmp}) -> Empty:
  (%Equal.sym(Cmp, LT{}, EQ{}, e) : is_cmp(_, EQ{})
  Unit{})

def cmp_ne_LT_GT(e: {LT{} == GT{} : Cmp}) -> Empty:
  (%Equal.sym(Cmp, LT{}, GT{}, e) : is_cmp(_, GT{})
  Unit{})

def cmp_ne_EQ_LT(e: {EQ{} == LT{} : Cmp}) -> Empty:
  (%Equal.sym(Cmp, EQ{}, LT{}, e) : is_cmp(_, LT{})
  Unit{})

def cmp_ne_EQ_GT(e: {EQ{} == GT{} : Cmp}) -> Empty:
  (%Equal.sym(Cmp, EQ{}, GT{}, e) : is_cmp(_, GT{})
  Unit{})

def cmp_ne_GT_LT(e: {GT{} == LT{} : Cmp}) -> Empty:
  (%Equal.sym(Cmp, GT{}, LT{}, e) : is_cmp(_, LT{})
  Unit{})

def cmp_ne_GT_EQ(e: {GT{} == EQ{} : Cmp}) -> Empty:
  (%Equal.sym(Cmp, GT{}, EQ{}, e) : is_cmp(_, EQ{})
  Unit{})

