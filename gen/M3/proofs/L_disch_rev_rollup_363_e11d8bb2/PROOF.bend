def _lt_le_ok(x: Cmp, y: Cmp, ex: {Cmp.is_lt(x) == True{} : Bool}, ey: {Cmp.is_lt(cflip(y)) == False{} : Bool}) -> {cok(x, y) == True{} : Bool}:
  match x y:
    case LT{} LT{}:
      {==}
    case LT{} EQ{}:
      {==}
    case LT{} GT{}:
      efq({cok(LT{}, GT{}) == True{} : Bool}, true_ne_false(ey))
    case EQ{} LT{}:
      efq({cok(EQ{}, LT{}) == True{} : Bool}, false_ne_true(ex))
    case EQ{} EQ{}:
      efq({cok(EQ{}, EQ{}) == True{} : Bool}, false_ne_true(ex))
    case EQ{} GT{}:
      efq({cok(EQ{}, GT{}) == True{} : Bool}, false_ne_true(ex))
    case GT{} LT{}:
      efq({cok(GT{}, LT{}) == True{} : Bool}, false_ne_true(ex))
    case GT{} EQ{}:
      efq({cok(GT{}, EQ{}) == True{} : Bool}, false_ne_true(ex))
    case GT{} GT{}:
      efq({cok(GT{}, GT{}) == True{} : Bool}, false_ne_true(ex))

def _lt_le_c(x: Cmp, y: Cmp, ex: {Cmp.is_lt(x) == True{} : Bool}, ey: {Cmp.is_lt(cflip(y)) == False{} : Bool}) -> {Cmp.is_lt(ccomb(x, y)) == True{} : Bool}:
  match x y:
    case LT{} LT{}:
      {==}
    case LT{} EQ{}:
      {==}
    case LT{} GT{}:
      efq({Cmp.is_lt(ccomb(LT{}, GT{})) == True{} : Bool}, true_ne_false(ey))
    case EQ{} LT{}:
      efq({Cmp.is_lt(ccomb(EQ{}, LT{})) == True{} : Bool}, false_ne_true(ex))
    case EQ{} EQ{}:
      efq({Cmp.is_lt(ccomb(EQ{}, EQ{})) == True{} : Bool}, false_ne_true(ex))
    case EQ{} GT{}:
      efq({Cmp.is_lt(ccomb(EQ{}, GT{})) == True{} : Bool}, false_ne_true(ex))
    case GT{} LT{}:
      efq({Cmp.is_lt(ccomb(GT{}, LT{})) == True{} : Bool}, false_ne_true(ex))
    case GT{} EQ{}:
      efq({Cmp.is_lt(ccomb(GT{}, EQ{})) == True{} : Bool}, false_ne_true(ex))
    case GT{} GT{}:
      efq({Cmp.is_lt(ccomb(GT{}, GT{})) == True{} : Bool}, false_ne_true(ex))

def _le_lt_ok(x: Cmp, y: Cmp, ex: {Cmp.is_lt(cflip(x)) == False{} : Bool}, ey: {Cmp.is_lt(y) == True{} : Bool}) -> {cok(x, y) == True{} : Bool}:
  match x y:
    case LT{} LT{}:
      {==}
    case LT{} EQ{}:
      efq({cok(LT{}, EQ{}) == True{} : Bool}, false_ne_true(ey))
    case LT{} GT{}:
      efq({cok(LT{}, GT{}) == True{} : Bool}, false_ne_true(ey))
    case EQ{} LT{}:
      {==}
    case EQ{} EQ{}:
      efq({cok(EQ{}, EQ{}) == True{} : Bool}, false_ne_true(ey))
    case EQ{} GT{}:
      efq({cok(EQ{}, GT{}) == True{} : Bool}, false_ne_true(ey))
    case GT{} LT{}:
      efq({cok(GT{}, LT{}) == True{} : Bool}, true_ne_false(ex))
    case GT{} EQ{}:
      efq({cok(GT{}, EQ{}) == True{} : Bool}, true_ne_false(ex))
    case GT{} GT{}:
      efq({cok(GT{}, GT{}) == True{} : Bool}, true_ne_false(ex))

def _le_lt_c(x: Cmp, y: Cmp, ex: {Cmp.is_lt(cflip(x)) == False{} : Bool}, ey: {Cmp.is_lt(y) == True{} : Bool}) -> {Cmp.is_lt(ccomb(x, y)) == True{} : Bool}:
  match x y:
    case LT{} LT{}:
      {==}
    case LT{} EQ{}:
      efq({Cmp.is_lt(ccomb(LT{}, EQ{})) == True{} : Bool}, false_ne_true(ey))
    case LT{} GT{}:
      efq({Cmp.is_lt(ccomb(LT{}, GT{})) == True{} : Bool}, false_ne_true(ey))
    case EQ{} LT{}:
      {==}
