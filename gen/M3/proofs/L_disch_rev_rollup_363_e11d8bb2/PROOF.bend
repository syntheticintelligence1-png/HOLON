def _lex_flip(h: Cmp, l: Cmp, hs: Cmp, ls: Cmp, ihh: {hs == cflip(h) : Cmp}, ihl: {ls == cflip(l) : Cmp}) -> {lex(hs, ls) == cflip(lex(h, l)) : Cmp}:
  match h l hs ls:
    case LT{} LT{} LT{} LT{}:
      efq({lex(LT{}, LT{}) == cflip(lex(LT{}, LT{})) : Cmp}, cmp_ne_LT_GT(ihh))
    case LT{} LT{} LT{} EQ{}:
      efq({lex(LT{}, EQ{}) == cflip(lex(LT{}, LT{})) : Cmp}, cmp_ne_LT_GT(ihh))
    case LT{} LT{} LT{} GT{}:
      efq({lex(LT{}, GT{}) == cflip(lex(LT{}, LT{})) : Cmp}, cmp_ne_LT_GT(ihh))
    case LT{} LT{} EQ{} LT{}:
      efq({lex(EQ{}, LT{}) == cflip(lex(LT{}, LT{})) : Cmp}, cmp_ne_EQ_GT(ihh))
    case LT{} LT{} EQ{} EQ{}:
      efq({lex(EQ{}, EQ{}) == cflip(lex(LT{}, LT{})) : Cmp}, cmp_ne_EQ_GT(ihh))
    case LT{} LT{} EQ{} GT{}:
      efq({lex(EQ{}, GT{}) == cflip(lex(LT{}, LT{})) : Cmp}, cmp_ne_EQ_GT(ihh))
    case LT{} LT{} GT{} LT{}:
      {==}
    case LT{} LT{} GT{} EQ{}:
      {==}
    case LT{} LT{} GT{} GT{}:
      {==}
    case LT{} EQ{} LT{} LT{}:
      efq({lex(LT{}, LT{}) == cflip(lex(LT{}, EQ{})) : Cmp}, cmp_ne_LT_GT(ihh))
    case LT{} EQ{} LT{} EQ{}:
      efq({lex(LT{}, EQ{}) == cflip(lex(LT{}, EQ{})) : Cmp}, cmp_ne_LT_GT(ihh))
    case LT{} EQ{} LT{} GT{}:
      efq({lex(LT{}, GT{}) == cflip(lex(LT{}, EQ{})) : Cmp}, cmp_ne_LT_GT(ihh))
    case LT{} EQ{} EQ{} LT{}:
      efq({lex(EQ{}, LT{}) == cflip(lex(LT{}, EQ{})) : Cmp}, cmp_ne_EQ_GT(ihh))
    case LT{} EQ{} EQ{} EQ{}:
      efq({lex(EQ{}, EQ{}) == cflip(lex(LT{}, EQ{})) : Cmp}, cmp_ne_EQ_GT(ihh))
    case LT{} EQ{} EQ{} GT{}:
      efq({lex(EQ{}, GT{}) == cflip(lex(LT{}, EQ{})) : Cmp}, cmp_ne_EQ_GT(ihh))
    case LT{} EQ{} GT{} LT{}:
      {==}
    case LT{} EQ{} GT{} EQ{}:
      {==}
    case LT{} EQ{} GT{} GT{}:
      {==}
    case LT{} GT{} LT{} LT{}:
      efq({lex(LT{}, LT{}) == cflip(lex(LT{}, GT{})) : Cmp}, cmp_ne_LT_GT(ihh))
    case LT{} GT{} LT{} EQ{}:
      efq({lex(LT{}, EQ{}) == cflip(lex(LT{}, GT{})) : Cmp}, cmp_ne_LT_GT(ihh))
    case LT{} GT{} LT{} GT{}:
      efq({lex(LT{}, GT{}) == cflip(lex(LT{}, GT{})) : Cmp}, cmp_ne_LT_GT(ihh))
    case LT{} GT{} EQ{} LT{}:
      efq({lex(EQ{}, LT{}) == cflip(lex(LT{}, GT{})) : Cmp}, cmp_ne_EQ_GT(ihh))
    case LT{} GT{} EQ{} EQ{}:
      efq({lex(EQ{}, EQ{}) == cflip(lex(LT{}, GT{})) : Cmp}, cmp_ne_EQ_GT(ihh))
    case LT{} GT{} EQ{} GT{}:
      efq({lex(EQ{}, GT{}) == cflip(lex(LT{}, GT{})) : Cmp}, cmp_ne_EQ_GT(ihh))
    case LT{} GT{} GT{} LT{}:
      {==}
    case LT{} GT{} GT{} EQ{}:
      {==}
    case LT{} GT{} GT{} GT{}:
      {==}
    case EQ{} LT{} LT{} LT{}:
      efq({lex(LT{}, LT{}) == cflip(lex(EQ{}, LT{})) : Cmp}, cmp_ne_LT_EQ(ihh))
    case EQ{} LT{} LT{} EQ{}:
      efq({lex(LT{}, EQ{}) == cflip(lex(EQ{}, LT{})) : Cmp}, cmp_ne_LT_EQ(ihh))
    case EQ{} LT{} LT{} GT{}:
      efq({lex(LT{}, GT{}) == cflip(lex(EQ{}, LT{})) : Cmp}, cmp_ne_LT_EQ(ihh))
    case EQ{} LT{} EQ{} LT{}:
      efq({lex(EQ{}, LT{}) == cflip(lex(EQ{}, LT{})) : Cmp}, cmp_ne_LT_GT(ihl))
    case EQ{} LT{} EQ{} EQ{}:
      efq({lex(EQ{}, EQ{}) == cflip(lex(EQ{}, LT{})) : Cmp}, cmp_ne_EQ_GT(ihl))
    case EQ{} LT{} EQ{} GT{}:
      {==}
    case EQ{} LT{} GT{} LT{}:
      efq({lex(GT{}, LT{}) == cflip(lex(EQ{}, LT{})) : Cmp}, cmp_ne_GT_EQ(ihh))
