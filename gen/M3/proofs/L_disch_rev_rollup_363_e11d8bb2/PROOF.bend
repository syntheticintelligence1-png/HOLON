    case LT{} LT{} LT{} EQ{} EQ{} EQ{}:
      {==}
    case LT{} LT{} LT{} EQ{} EQ{} GT{}:
      {==}
    case LT{} LT{} LT{} EQ{} GT{} LT{}:
      {==}
    case LT{} LT{} LT{} EQ{} GT{} EQ{}:
      {==}
    case LT{} LT{} LT{} EQ{} GT{} GT{}:
      {==}
    case LT{} LT{} LT{} GT{} LT{} LT{}:
      {==}
    case LT{} LT{} LT{} GT{} LT{} EQ{}:
      {==}
    case LT{} LT{} LT{} GT{} LT{} GT{}:
      {==}
    case LT{} LT{} LT{} GT{} EQ{} LT{}:
      {==}
    case LT{} LT{} LT{} GT{} EQ{} EQ{}:
      {==}
    case LT{} LT{} LT{} GT{} EQ{} GT{}:
      {==}
    case LT{} LT{} LT{} GT{} GT{} LT{}:
      {==}
    case LT{} LT{} LT{} GT{} GT{} EQ{}:
      {==}
    case LT{} LT{} LT{} GT{} GT{} GT{}:
      {==}
    case LT{} LT{} EQ{} LT{} LT{} LT{}:
      efq({lex(EQ{}, LT{}) == ccomb(lex(LT{}, LT{}), lex(LT{}, LT{})) : Cmp}, cmp_ne_EQ_LT(ihh({==})))
    case LT{} LT{} EQ{} LT{} LT{} EQ{}:
      efq({lex(EQ{}, EQ{}) == ccomb(lex(LT{}, LT{}), lex(LT{}, LT{})) : Cmp}, cmp_ne_EQ_LT(ihh({==})))
    case LT{} LT{} EQ{} LT{} LT{} GT{}:
      efq({lex(EQ{}, GT{}) == ccomb(lex(LT{}, LT{}), lex(LT{}, LT{})) : Cmp}, cmp_ne_EQ_LT(ihh({==})))
    case LT{} LT{} EQ{} LT{} EQ{} LT{}:
      efq({lex(EQ{}, LT{}) == ccomb(lex(LT{}, LT{}), lex(LT{}, EQ{})) : Cmp}, cmp_ne_EQ_LT(ihh({==})))
    case LT{} LT{} EQ{} LT{} EQ{} EQ{}:
      efq({lex(EQ{}, EQ{}) == ccomb(lex(LT{}, LT{}), lex(LT{}, EQ{})) : Cmp}, cmp_ne_EQ_LT(ihh({==})))
    case LT{} LT{} EQ{} LT{} EQ{} GT{}:
      efq({lex(EQ{}, GT{}) == ccomb(lex(LT{}, LT{}), lex(LT{}, EQ{})) : Cmp}, cmp_ne_EQ_LT(ihh({==})))
    case LT{} LT{} EQ{} LT{} GT{} LT{}:
      efq({lex(EQ{}, LT{}) == ccomb(lex(LT{}, LT{}), lex(LT{}, GT{})) : Cmp}, cmp_ne_EQ_LT(ihh({==})))
    case LT{} LT{} EQ{} LT{} GT{} EQ{}:
      efq({lex(EQ{}, EQ{}) == ccomb(lex(LT{}, LT{}), lex(LT{}, GT{})) : Cmp}, cmp_ne_EQ_LT(ihh({==})))
    case LT{} LT{} EQ{} LT{} GT{} GT{}:
      efq({lex(EQ{}, GT{}) == ccomb(lex(LT{}, LT{}), lex(LT{}, GT{})) : Cmp}, cmp_ne_EQ_LT(ihh({==})))
    case LT{} LT{} EQ{} EQ{} LT{} LT{}:
      efq({lex(EQ{}, LT{}) == ccomb(lex(LT{}, EQ{}), lex(LT{}, LT{})) : Cmp}, cmp_ne_EQ_LT(ihh({==})))
    case LT{} LT{} EQ{} EQ{} LT{} EQ{}:
