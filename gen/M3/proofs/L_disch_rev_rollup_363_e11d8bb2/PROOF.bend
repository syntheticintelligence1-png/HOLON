      efq({Word.cmp.fin(True{}, True{}, EQ{}) == cflip(Word.cmp.fin(True{}, True{}, GT{})) : Cmp}, cmp_ne_EQ_LT(ih))
    case True{} True{} GT{} GT{}:
      efq({Word.cmp.fin(True{}, True{}, GT{}) == cflip(Word.cmp.fin(True{}, True{}, GT{})) : Cmp}, cmp_ne_GT_LT(ih))
    case True{} False{} LT{} LT{}:
      efq({Word.cmp.fin(False{}, True{}, LT{}) == cflip(Word.cmp.fin(True{}, False{}, LT{})) : Cmp}, cmp_ne_LT_GT(ih))
    case True{} False{} LT{} EQ{}:
      efq({Word.cmp.fin(False{}, True{}, EQ{}) == cflip(Word.cmp.fin(True{}, False{}, LT{})) : Cmp}, cmp_ne_EQ_GT(ih))
    case True{} False{} LT{} GT{}:
      {==}
    case True{} False{} EQ{} LT{}:
      efq({Word.cmp.fin(False{}, True{}, LT{}) == cflip(Word.cmp.fin(True{}, False{}, EQ{})) : Cmp}, cmp_ne_LT_EQ(ih))
    case True{} False{} EQ{} EQ{}:
      {==}
    case True{} False{} EQ{} GT{}:
      efq({Word.cmp.fin(False{}, True{}, GT{}) == cflip(Word.cmp.fin(True{}, False{}, EQ{})) : Cmp}, cmp_ne_GT_EQ(ih))
    case True{} False{} GT{} LT{}:
      {==}
    case True{} False{} GT{} EQ{}:
      efq({Word.cmp.fin(False{}, True{}, EQ{}) == cflip(Word.cmp.fin(True{}, False{}, GT{})) : Cmp}, cmp_ne_EQ_LT(ih))
    case True{} False{} GT{} GT{}:
      efq({Word.cmp.fin(False{}, True{}, GT{}) == cflip(Word.cmp.fin(True{}, False{}, GT{})) : Cmp}, cmp_ne_GT_LT(ih))
    case False{} True{} LT{} LT{}:
      efq({Word.cmp.fin(True{}, False{}, LT{}) == cflip(Word.cmp.fin(False{}, True{}, LT{})) : Cmp}, cmp_ne_LT_GT(ih))
    case False{} True{} LT{} EQ{}:
      efq({Word.cmp.fin(True{}, False{}, EQ{}) == cflip(Word.cmp.fin(False{}, True{}, LT{})) : Cmp}, cmp_ne_EQ_GT(ih))
    case False{} True{} LT{} GT{}:
      {==}
    case False{} True{} EQ{} LT{}:
      efq({Word.cmp.fin(True{}, False{}, LT{}) == cflip(Word.cmp.fin(False{}, True{}, EQ{})) : Cmp}, cmp_ne_LT_EQ(ih))
    case False{} True{} EQ{} EQ{}:
      {==}
    case False{} True{} EQ{} GT{}:
      efq({Word.cmp.fin(True{}, False{}, GT{}) == cflip(Word.cmp.fin(False{}, True{}, EQ{})) : Cmp}, cmp_ne_GT_EQ(ih))
    case False{} True{} GT{} LT{}:
      {==}
    case False{} True{} GT{} EQ{}:
      efq({Word.cmp.fin(True{}, False{}, EQ{}) == cflip(Word.cmp.fin(False{}, True{}, GT{})) : Cmp}, cmp_ne_EQ_LT(ih))
    case False{} True{} GT{} GT{}:
      efq({Word.cmp.fin(True{}, False{}, GT{}) == cflip(Word.cmp.fin(False{}, True{}, GT{})) : Cmp}, cmp_ne_GT_LT(ih))
    case False{} False{} LT{} LT{}:
      efq({Word.cmp.fin(False{}, False{}, LT{}) == cflip(Word.cmp.fin(False{}, False{}, LT{})) : Cmp}, cmp_ne_LT_GT(ih))
    case False{} False{} LT{} EQ{}:
      efq({Word.cmp.fin(False{}, False{}, EQ{}) == cflip(Word.cmp.fin(False{}, False{}, LT{})) : Cmp}, cmp_ne_EQ_GT(ih))
