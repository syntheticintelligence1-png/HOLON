# a limb's complement value and its bound: to_nat(u) + 1 + to_nat(not u) == 2^32
def unc(u: U32) -> Nat:
  match u:
    case U32{d}:
      Word.to_nat(32n, Word.not(32n, d))

def u_bnd(+u: U32) -> {Nat.add(U32.to_nat(u), 1n+unc(u)) == Laws.c3_shn(32n, 1n) : Nat}:
  match u:
    case U32{+d}:
      Equal.trans(Nat, Nat.add(U32.to_nat(U32{d}), 1n+unc(U32{d})), Nat.add(Word.to_nat(32n, d), 1n+Word.to_nat(32n, Word.not(32n, d))), Laws.c3_shn(32n, 1n), {==}, w_bound(32n, d))


# the complement of a word, limb by limb, as a natural number
def wcn(w: M.W) -> Nat:
