  n_le_add(Laws.c3_wnat(M.w_add(a, b)), cmul(Bool.not(M.w_add_ok(a, b)), Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, 1n)))))))))))


# x + (y + z) == y + (x + z)
def n_swap3(+x: Nat, +y: Nat, +z: Nat) -> {Nat.add(x, Nat.add(y, z)) == Nat.add(y, Nat.add(x, z)) : Nat}:
