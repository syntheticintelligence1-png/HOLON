def _lt_le_ok(x: Cmp, y: Cmp, ex: {Cmp.is_lt(x) == True{} : Bool}, ey: {Cmp.is_lt(cflip(y)) == False{} : Bool}) -> {cok(x, y) == True{} : Bool}:
  match x y:
    case LT{} LT{}:
      {==}
    case LT{} EQ{}:
      {==}
    case LT{} GT{}:
      efq({cok(LT{}, GT{}) == True{} : Bool}, true_ne_false(ey))
    case EQ{} LT{}:
      efq({cok(EQ{}, LT{}) == True{} : Bool}, false_ne_true(ex))
    case EQ{} EQ{}:
      efq({cok(EQ{}, EQ{}) == True{} : Bool}, false_ne_true(ex))
    case EQ{} GT{}:
      efq({cok(EQ{}, GT{}) == True{} : Bool}, false_ne_true(ex))
    case GT{} LT{}:
      efq({cok(GT{}, LT{}) == True{} : Bool}, false_ne_true(ex))
    case GT{} EQ{}:
      efq({cok(GT{}, EQ{}) == True{} : Bool}, false_ne_true(ex))
    case GT{} GT{}:
      efq({cok(GT{}, GT{}) == True{} : Bool}, false_ne_true(ex))

def _lt_le_c(x: Cmp, y: Cmp, ex: {Cmp.is_lt(x) == True{} : Bool}, ey: {Cmp.is_lt(cflip(y)) == False{} : Bool}) -> {Cmp.is_lt(ccomb(x, y)) == True{} : Bool}:
  match x y:
    case LT{} LT{}:
      {==}
    case LT{} EQ{}:
      {==}
    case LT{} GT{}:
      efq({Cmp.is_lt(ccomb(LT{}, GT{})) == True{} : Bool}, true_ne_false(ey))
    case EQ{} LT{}:
      efq({Cmp.is_lt(ccomb(EQ{}, LT{})) == True{} : Bool}, false_ne_true(ex))
    case EQ{} EQ{}:
      efq({Cmp.is_lt(ccomb(EQ{}, EQ{})) == True{} : Bool}, false_ne_true(ex))
    case EQ{} GT{}:
      efq({Cmp.is_lt(ccomb(EQ{}, GT{})) == True{} : Bool}, false_ne_true(ex))
    case GT{} LT{}:
      efq({Cmp.is_lt(ccomb(GT{}, LT{})) == True{} : Bool}, false_ne_true(ex))
    case GT{} EQ{}:
      efq({Cmp.is_lt(ccomb(GT{}, EQ{})) == True{} : Bool}, false_ne_true(ex))
    case GT{} GT{}:
      efq({Cmp.is_lt(ccomb(GT{}, GT{})) == True{} : Bool}, false_ne_true(ex))

def _le_lt_ok(x: Cmp, y: Cmp, ex: {Cmp.is_lt(cflip(x)) == False{} : Bool}, ey: {Cmp.is_lt(y) == True{} : Bool}) -> {cok(x, y) == True{} : Bool}:
  match x y:
    case LT{} LT{}:
      {==}
    case LT{} EQ{}:
      efq({cok(LT{}, EQ{}) == True{} : Bool}, false_ne_true(ey))
    case LT{} GT{}:
      efq({cok(LT{}, GT{}) == True{} : Bool}, false_ne_true(ey))
    case EQ{} LT{}:
      {==}
    case EQ{} EQ{}:
      efq({cok(EQ{}, EQ{}) == True{} : Bool}, false_ne_true(ey))
    case EQ{} GT{}:
      efq({cok(EQ{}, GT{}) == True{} : Bool}, false_ne_true(ey))
    case GT{} LT{}:
      efq({cok(GT{}, LT{}) == True{} : Bool}, true_ne_false(ex))
    case GT{} EQ{}:
      efq({cok(GT{}, EQ{}) == True{} : Bool}, true_ne_false(ex))
    case GT{} GT{}:
      efq({cok(GT{}, GT{}) == True{} : Bool}, true_ne_false(ex))

def _le_lt_c(x: Cmp, y: Cmp, ex: {Cmp.is_lt(cflip(x)) == False{} : Bool}, ey: {Cmp.is_lt(y) == True{} : Bool}) -> {Cmp.is_lt(ccomb(x, y)) == True{} : Bool}:
  match x y:
    case LT{} LT{}:
      {==}
    case LT{} EQ{}:
      efq({Cmp.is_lt(ccomb(LT{}, EQ{})) == True{} : Bool}, false_ne_true(ey))
    case LT{} GT{}:
      efq({Cmp.is_lt(ccomb(LT{}, GT{})) == True{} : Bool}, false_ne_true(ey))
    case EQ{} LT{}:
      {==}
    case EQ{} EQ{}:
      efq({Cmp.is_lt(ccomb(EQ{}, EQ{})) == True{} : Bool}, false_ne_true(ey))
    case EQ{} GT{}:
      efq({Cmp.is_lt(ccomb(EQ{}, GT{})) == True{} : Bool}, false_ne_true(ey))
    case GT{} LT{}:
      efq({Cmp.is_lt(ccomb(GT{}, LT{})) == True{} : Bool}, true_ne_false(ex))
    case GT{} EQ{}:
      efq({Cmp.is_lt(ccomb(GT{}, EQ{})) == True{} : Bool}, true_ne_false(ex))
    case GT{} GT{}:
      efq({Cmp.is_lt(ccomb(GT{}, GT{})) == True{} : Bool}, true_ne_false(ex))

def _le_le_ok(x: Cmp, y: Cmp, ex: {Cmp.is_lt(cflip(x)) == False{} : Bool}, ey: {Cmp.is_lt(cflip(y)) == False{} : Bool}) -> {cok(x, y) == True{} : Bool}:
  match x y:
    case LT{} LT{}:
      {==}
    case LT{} EQ{}:
      {==}
    case LT{} GT{}:
      efq({cok(LT{}, GT{}) == True{} : Bool}, true_ne_false(ey))
    case EQ{} LT{}:
      {==}
    case EQ{} EQ{}:
      {==}
    case EQ{} GT{}:
      efq({cok(EQ{}, GT{}) == True{} : Bool}, true_ne_false(ey))
    case GT{} LT{}:
      efq({cok(GT{}, LT{}) == True{} : Bool}, true_ne_false(ex))
    case GT{} EQ{}:
      efq({cok(GT{}, EQ{}) == True{} : Bool}, true_ne_false(ex))
    case GT{} GT{}:
      efq({cok(GT{}, GT{}) == True{} : Bool}, true_ne_false(ex))

def _le_le_c(x: Cmp, y: Cmp, ex: {Cmp.is_lt(cflip(x)) == False{} : Bool}, ey: {Cmp.is_lt(cflip(y)) == False{} : Bool}) -> {Cmp.is_lt(cflip(ccomb(x, y))) == False{} : Bool}:
  match x y:
    case LT{} LT{}:
      {==}
    case LT{} EQ{}:
      {==}
    case LT{} GT{}:
      efq({Cmp.is_lt(cflip(ccomb(LT{}, GT{}))) == False{} : Bool}, true_ne_false(ey))
    case EQ{} LT{}:
      {==}
    case EQ{} EQ{}:
      {==}
    case EQ{} GT{}:
      efq({Cmp.is_lt(cflip(ccomb(EQ{}, GT{}))) == False{} : Bool}, true_ne_false(ey))
    case GT{} LT{}:
      efq({Cmp.is_lt(cflip(ccomb(GT{}, LT{}))) == False{} : Bool}, true_ne_false(ex))
    case GT{} EQ{}:
      efq({Cmp.is_lt(cflip(ccomb(GT{}, EQ{}))) == False{} : Bool}, true_ne_false(ex))
    case GT{} GT{}:
      efq({Cmp.is_lt(cflip(ccomb(GT{}, GT{}))) == False{} : Bool}, true_ne_false(ex))

def rw_lt(+x: Cmp, +y: Cmp, +v: Bool, e: {x == y : Cmp}, h: {Cmp.is_lt(x) == v : Bool}) -> {Cmp.is_lt(y) == v : Bool}:
  (%e : {Cmp.is_lt(_) == v : Bool}
  h)

def rw_ltf(+x: Cmp, +y: Cmp, +v: Bool, e: {x == y : Cmp}, h: {Cmp.is_lt(cflip(x)) == v : Bool}) -> {Cmp.is_lt(cflip(y)) == v : Bool}:
  (%e : {Cmp.is_lt(cflip(_)) == v : Bool}
  h)

def w_lt_le(+a: M.W, +b: M.W, +c: M.W, h1: {M.w_lt(a, b) == True{} : Bool}, h2: {M.w_lt(c, b) == False{} : Bool}) -> {M.w_lt(a, c) == True{} : Bool}:
  +ex = Equal.trans(Bool, Cmp.is_lt(wcmp(a, b)), M.w_lt(a, b), True{}, Equal.sym(Bool, M.w_lt(a, b), Cmp.is_lt(wcmp(a, b)), w_lt_cmp(a, b)), h1)
  +e2 = Equal.trans(Bool, Cmp.is_lt(wcmp(c, b)), M.w_lt(c, b), False{}, Equal.sym(Bool, M.w_lt(c, b), Cmp.is_lt(wcmp(c, b)), w_lt_cmp(c, b)), h2)
  +ey = rw_lt(wcmp(c, b), cflip(wcmp(b, c)), False{}, w_flip(b, c), e2)
  +tr = w_trans(a, b, c, _lt_le_ok(wcmp(a, b), wcmp(b, c), ex, ey))
  +r = rw_lt(ccomb(wcmp(a, b), wcmp(b, c)), wcmp(a, c), True{}, Equal.sym(Cmp, wcmp(a, c), ccomb(wcmp(a, b), wcmp(b, c)), tr), _lt_le_c(wcmp(a, b), wcmp(b, c), ex, ey))
  Equal.trans(Bool, M.w_lt(a, c), Cmp.is_lt(wcmp(a, c)), True{}, w_lt_cmp(a, c), r)

def w_le_lt(+a: M.W, +b: M.W, +c: M.W, h1: {M.w_lt(b, a) == False{} : Bool}, h2: {M.w_lt(b, c) == True{} : Bool}) -> {M.w_lt(a, c) == True{} : Bool}:
  +e1 = Equal.trans(Bool, Cmp.is_lt(wcmp(b, a)), M.w_lt(b, a), False{}, Equal.sym(Bool, M.w_lt(b, a), Cmp.is_lt(wcmp(b, a)), w_lt_cmp(b, a)), h1)
  +ex = rw_lt(wcmp(b, a), cflip(wcmp(a, b)), False{}, w_flip(a, b), e1)
  +ey = Equal.trans(Bool, Cmp.is_lt(wcmp(b, c)), M.w_lt(b, c), True{}, Equal.sym(Bool, M.w_lt(b, c), Cmp.is_lt(wcmp(b, c)), w_lt_cmp(b, c)), h2)
  +tr = w_trans(a, b, c, _le_lt_ok(wcmp(a, b), wcmp(b, c), ex, ey))
  +r = rw_lt(ccomb(wcmp(a, b), wcmp(b, c)), wcmp(a, c), True{}, Equal.sym(Cmp, wcmp(a, c), ccomb(wcmp(a, b), wcmp(b, c)), tr), _le_lt_c(wcmp(a, b), wcmp(b, c), ex, ey))
  Equal.trans(Bool, M.w_lt(a, c), Cmp.is_lt(wcmp(a, c)), True{}, w_lt_cmp(a, c), r)

def w_le_le(+a: M.W, +b: M.W, +c: M.W, h1: {M.w_lt(b, a) == False{} : Bool}, h2: {M.w_lt(c, b) == False{} : Bool}) -> {M.w_lt(c, a) == False{} : Bool}:
  +e1 = Equal.trans(Bool, Cmp.is_lt(wcmp(b, a)), M.w_lt(b, a), False{}, Equal.sym(Bool, M.w_lt(b, a), Cmp.is_lt(wcmp(b, a)), w_lt_cmp(b, a)), h1)
  +ex = rw_lt(wcmp(b, a), cflip(wcmp(a, b)), False{}, w_flip(a, b), e1)
  +e2 = Equal.trans(Bool, Cmp.is_lt(wcmp(c, b)), M.w_lt(c, b), False{}, Equal.sym(Bool, M.w_lt(c, b), Cmp.is_lt(wcmp(c, b)), w_lt_cmp(c, b)), h2)
  +ey = rw_lt(wcmp(c, b), cflip(wcmp(b, c)), False{}, w_flip(b, c), e2)
  +tr = w_trans(a, b, c, _le_le_ok(wcmp(a, b), wcmp(b, c), ex, ey))
  +r = rw_ltf(ccomb(wcmp(a, b), wcmp(b, c)), wcmp(a, c), False{}, Equal.sym(Cmp, wcmp(a, c), ccomb(wcmp(a, b), wcmp(b, c)), tr), _le_le_c(wcmp(a, b), wcmp(b, c), ex, ey))
  +r2 = rw_lt(cflip(wcmp(a, c)), wcmp(c, a), False{}, Equal.sym(Cmp, wcmp(c, a), cflip(wcmp(a, c)), w_flip(a, c)), r)
  Equal.trans(Bool, M.w_lt(c, a), Cmp.is_lt(wcmp(c, a)), False{}, w_lt_cmp(c, a), r2)

def bcmp_refl(b: Bool) -> {Word.cmp.fin(b, b, EQ{}) == EQ{} : Cmp}:
  match b:
    case True{}:
      {==}
    case False{}:
      {==}

def cmp_refl(+n: Nat, x: Word(n)) -> {Word.cmp(n, x, x) == EQ{} : Cmp}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match x:
        case WCon{+b, +xt}:
          (%Equal.sym(Cmp, Word.cmp(p, xt, xt), EQ{}, cmp_refl(p, xt)) : {Word.cmp.fin(b, b, _) == EQ{} : Cmp}
          bcmp_refl(b))

def u_eq_self(+a: U32) -> {U32.is_eq(a, a) == True{} : Bool}:
  match a:
    case U32{+x}:
      (%Equal.sym(Cmp, Word.cmp(32n, x, x), EQ{}, cmp_refl(32n, x)) : {Cmp.is_eq(_) == True{} : Bool}
      {==})

def w_eq_self(+a: M.W) -> {M.w_eq(a, a) == True{} : Bool}:
  match a:
    case M.W{+a0, +a1, +a2, +a3, +a4, +a5, +a6, +a7}:
      and_intro(U32.is_eq(a0, a0), Bool.and(U32.is_eq(a1, a1), Bool.and(U32.is_eq(a2, a2), Bool.and(U32.is_eq(a3, a3), Bool.and(U32.is_eq(a4, a4), Bool.and(U32.is_eq(a5, a5), Bool.and(U32.is_eq(a6, a6), U32.is_eq(a7, a7))))))), u_eq_self(a0), and_intro(U32.is_eq(a1, a1), Bool.and(U32.is_eq(a2, a2), Bool.and(U32.is_eq(a3, a3), Bool.and(U32.is_eq(a4, a4), Bool.and(U32.is_eq(a5, a5), Bool.and(U32.is_eq(a6, a6), U32.is_eq(a7, a7)))))), u_eq_self(a1), and_intro(U32.is_eq(a2, a2), Bool.and(U32.is_eq(a3, a3), Bool.and(U32.is_eq(a4, a4), Bool.and(U32.is_eq(a5, a5), Bool.and(U32.is_eq(a6, a6), U32.is_eq(a7, a7))))), u_eq_self(a2), and_intro(U32.is_eq(a3, a3), Bool.and(U32.is_eq(a4, a4), Bool.and(U32.is_eq(a5, a5), Bool.and(U32.is_eq(a6, a6), U32.is_eq(a7, a7)))), u_eq_self(a3), and_intro(U32.is_eq(a4, a4), Bool.and(U32.is_eq(a5, a5), Bool.and(U32.is_eq(a6, a6), U32.is_eq(a7, a7))), u_eq_self(a4), and_intro(U32.is_eq(a5, a5), Bool.and(U32.is_eq(a6, a6), U32.is_eq(a7, a7)), u_eq_self(a5), and_intro(U32.is_eq(a6, a6), U32.is_eq(a7, a7), u_eq_self(a6), u_eq_self(a7))))))))

def sp_self(+a: M.SP) -> {M.sp_eq(a, a) == True{} : Bool}:
  match a:
    case M.SP_m{+k, +o}:
      and_intro(M.w_eq(o, o), M.w_eq(k, k), w_eq_self(o), w_eq_self(k))

def sps_self(+p: List<&2, M.SP>) -> {M.sps_eq(p, p) == True{} : Bool}:
  match p:
    case Nil{}:
      {==}
    case Con{+h, +t}:
      and_intro(M.sp_eq(h, h), M.sps_eq(t, t), sp_self(h), sps_self(t))

def sk_self(+a: M.SK) -> {M.sk_eq(a, a) == True{} : Bool}:
  match a:
    case M.SK{+b, +o, +p}:
      and_intro(M.w_eq(b, b), Bool.and(M.w_eq(o, o), M.sps_eq(p, p)), w_eq_self(b), and_intro(M.w_eq(o, o), M.sps_eq(p, p), w_eq_self(o), sps_self(p)))

def kv_same_c(c: Bool, +hv: M.W, +k: M.SK, +v: M.W, +t: List<&2, M.KV>, ih: {M.kv_get(M.kv_put(t, k, v, False{}), k) == v : M.W}) -> {M.ite(M.W, c, M.ite(M.W, Bool.and(c, Bool.not(False{})), v, hv), M.kv_get(M.kv_put(t, k, v, Bool.or(False{}, c)), k)) == v : M.W}:
  match c:
    case True{}:
      {==}
    case False{}:
      ih

def kv_same(xs: List<&2, M.KV>, +k: M.SK, +v: M.W) -> {M.kv_get(M.kv_put(xs, k, v, False{}), k) == v : M.W}:
  match xs:
    case Nil{}:
      (%Equal.sym(Bool, M.sk_eq(k, k), True{}, sk_self(k)) : {M.ite(M.W, _, v, M.w0()) == v : M.W}
      {==})
    case Con{h, +t}:
      match h:
        case M.KV{+hk, +hv}:
          kv_same_c(M.sk_eq(hk, k), hv, k, v, t, kv_same(t, k, v))

def st_same(s: M.HSt, +k: M.SK, +v: M.W) -> {M.sload(M.sstore(s, k, v), k) == v : M.W}:
  match s:
    case M.HSt{sl}:
      kv_same(sl, k, v)

def w_ne_sym_c(c: Bool, +a: M.W, +b: M.W, e: {M.w_eq(a, b) == False{} : Bool}, ec: {M.w_eq(b, a) == c : Bool}) -> {c == False{} : Bool}:
  match c:
    case True{}:
      efq({True{} == False{} : Bool}, true_ne_false(Equal.trans(Bool, True{}, M.w_eq(b, b), False{}, Equal.sym(Bool, M.w_eq(b, b), True{}, w_eq_self(b)), (%Equal.sym(M.W, b, a, w_refl(b, a, ec)) : {M.w_eq(_, b) == False{} : Bool}
      e))))
    case False{}:
      {==}

def w_ne_sym(+a: M.W, +b: M.W, e: {M.w_eq(a, b) == False{} : Bool}) -> {M.w_eq(b, a) == False{} : Bool}:
  w_ne_sym_c(M.w_eq(b, a), a, b, e, {==})

def st_same_k(s: M.HSt, +kw: M.SK, +v: M.W, +k: M.SK, e: {M.sk_eq(kw, k) == True{} : Bool}) -> {M.sload(M.sstore(s, kw, v), k) == v : M.W}:
  (%sk_refl(kw, k, e) : {M.sload(M.sstore(s, kw, v), _) == v : M.W}
  st_same(s, kw, v))


def n_pred(n: Nat) -> Nat:
  match n:
    case 0n:
      0n
    case 1n+p:
      p

def n_disc(n: Nat) -> Type:
  match n:
    case 0n:
      Empty
    case 1n+p:
      Unit

def n_succ_nz(+a: Nat, e: {1n+a == 0n : Nat}) -> Empty:
  (%e : n_disc(_)
  Unit{})

def n_succ_inj(+a: Nat, +b: Nat, e: {1n+a == 1n+b : Nat}) -> {a == b : Nat}:
  Equal.cong(Nat, Nat, n_pred, 1n+a, 1n+b, e)

def n_add_z(+a: Nat) -> {Nat.add(a, 0n) == a : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, x => 1n+x, Nat.add(p, 0n), p, n_add_z(p))

def n_add_s(+a: Nat, +b: Nat) -> {Nat.add(a, 1n+b) == 1n+Nat.add(a, b) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, x => 1n+x, Nat.add(p, 1n+b), 1n+Nat.add(p, b), n_add_s(p, b))

def n_add_comm(+a: Nat, +b: Nat) -> {Nat.add(a, b) == Nat.add(b, a) : Nat}:
  match a:
    case 0n:
      Equal.sym(Nat, Nat.add(b, 0n), b, n_add_z(b))
    case 1n+p:
      Equal.trans(Nat, 1n+Nat.add(p, b), 1n+Nat.add(b, p), Nat.add(b, 1n+p),
        Equal.cong(Nat, Nat, x => 1n+x, Nat.add(p, b), Nat.add(b, p), n_add_comm(p, b)),
        Equal.sym(Nat, Nat.add(b, 1n+p), 1n+Nat.add(b, p), n_add_s(b, p)))

def n_add_assoc(+a: Nat, +b: Nat, +c: Nat) -> {Nat.add(Nat.add(a, b), c) == Nat.add(a, Nat.add(b, c)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, x => 1n+x, Nat.add(Nat.add(p, b), c), Nat.add(p, Nat.add(b, c)), n_add_assoc(p, b, c))

def n_dbl_add(+a: Nat, +b: Nat) -> {Nat.double(Nat.add(a, b)) == Nat.add(Nat.double(a), Nat.double(b)) : Nat}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      Equal.cong(Nat, Nat, x => 2n+x, Nat.double(Nat.add(p, b)), Nat.add(Nat.double(p), Nat.double(b)), n_dbl_add(p, b))

# a + c == b + c gives a == b (cancellation on the left of add: c + a == c + b)
def n_cancel_l(+c: Nat, +a: Nat, +b: Nat, e: {Nat.add(c, a) == Nat.add(c, b) : Nat}) -> {a == b : Nat}:
  match c:
    case 0n:
      e
    case 1n+p:
      n_cancel_l(p, a, b, n_succ_inj(Nat.add(p, a), Nat.add(p, b), e))

# ---- rearrangements
def n_cong_l(+a: Nat, +b: Nat, +c: Nat, e: {a == b : Nat}) -> {Nat.add(a, c) == Nat.add(b, c) : Nat}:
  Equal.cong(Nat, Nat, x => Nat.add(x, c), a, b, e)

def n_cong_r(+c: Nat, +a: Nat, +b: Nat, e: {a == b : Nat}) -> {Nat.add(c, a) == Nat.add(c, b) : Nat}:
  Equal.cong(Nat, Nat, x => Nat.add(c, x), a, b, e)

# (a + b) + (c + d) == (a + c) + (b + d)
def n_swap_mid(+a: Nat, +b: Nat, +c: Nat, +d: Nat) -> {Nat.add(Nat.add(a, b), Nat.add(c, d)) == Nat.add(Nat.add(a, c), Nat.add(b, d)) : Nat}:
  Equal.trans(Nat, Nat.add(Nat.add(a, b), Nat.add(c, d)), Nat.add(a, Nat.add(b, Nat.add(c, d))), Nat.add(Nat.add(a, c), Nat.add(b, d)),
    n_add_assoc(a, b, Nat.add(c, d)),
    Equal.trans(Nat, Nat.add(a, Nat.add(b, Nat.add(c, d))), Nat.add(a, Nat.add(c, Nat.add(b, d))), Nat.add(Nat.add(a, c), Nat.add(b, d)),
      n_cong_r(a, Nat.add(b, Nat.add(c, d)), Nat.add(c, Nat.add(b, d)),
        Equal.trans(Nat, Nat.add(b, Nat.add(c, d)), Nat.add(Nat.add(b, c), d), Nat.add(c, Nat.add(b, d)),
          Equal.sym(Nat, Nat.add(Nat.add(b, c), d), Nat.add(b, Nat.add(c, d)), n_add_assoc(b, c, d)),
          Equal.trans(Nat, Nat.add(Nat.add(b, c), d), Nat.add(Nat.add(c, b), d), Nat.add(c, Nat.add(b, d)),
            n_cong_l(Nat.add(b, c), Nat.add(c, b), d, n_add_comm(b, c)),
            n_add_assoc(c, b, d)))),
      Equal.sym(Nat, Nat.add(Nat.add(a, c), Nat.add(b, d)), Nat.add(a, Nat.add(c, Nat.add(b, d))), n_add_assoc(a, c, Nat.add(b, d)))))

# ---- shifts and bits
def shn_add(+n: Nat, +a: Nat, +b: Nat) -> {Laws.c3_shn(n, Nat.add(a, b)) == Nat.add(Laws.c3_shn(n, a), Laws.c3_shn(n, b)) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      Equal.trans(Nat, Nat.double(Laws.c3_shn(p, Nat.add(a, b))), Nat.double(Nat.add(Laws.c3_shn(p, a), Laws.c3_shn(p, b))), Nat.add(Nat.double(Laws.c3_shn(p, a)), Nat.double(Laws.c3_shn(p, b))),
        Equal.cong(Nat, Nat, Nat.double, Laws.c3_shn(p, Nat.add(a, b)), Nat.add(Laws.c3_shn(p, a), Laws.c3_shn(p, b)), shn_add(p, a, b)),
        n_dbl_add(Laws.c3_shn(p, a), Laws.c3_shn(p, b)))

def b2n(b: Bool) -> Nat:
  match b:
    case False{}:
      0n
    case True{}:
      1n

# the carry out of Bool.full_add (its second component)
def fa_carry(a: Bool, +b: Bool, +c: Bool) -> Bool:
  match a:
    case False{}:
      Bool.and(b, c)
    case True{}:
      Bool.or(b, c)

# the carry out of Word.adc(n, a, b, False{}, c)
def wcarry(n: Nat, a: Word(n), b: Word(n), c: Bool) -> Bool:
  match n:
    case 0n:
      c
    case 1n+p:
      match a b:
        case WCon{ah, at} WCon{bh, bt}:
          wcarry(p, at, bt, fa_carry(ah, bh, c))

# the full adder's step, in Nat: (s + 2 L) + 2 Cy == ((h + 2 A) + (g + 2 B)) + c, from L + Cy == (A + B) + k and s + 2 k == (h + g) + c
def n_fa_step(+sn: Nat, +kn: Nat, +hn: Nat, +gn: Nat, +cn: Nat, +l: Nat, +cy: Nat, +a: Nat, +b: Nat,
              ih: {Nat.add(l, cy) == Nat.add(Nat.add(a, b), kn) : Nat},
              fa: {Nat.add(sn, Nat.double(kn)) == Nat.add(Nat.add(hn, gn), cn) : Nat}) ->
              {Nat.add(Nat.add(sn, Nat.double(l)), Nat.double(cy)) == Nat.add(Nat.add(Nat.add(hn, Nat.double(a)), Nat.add(gn, Nat.double(b))), cn) : Nat}:
  +da = Nat.double(a)
  +db = Nat.double(b)
  +dk = Nat.double(kn)
  # left: (sn + 2l) + 2cy == sn + 2(l + cy) == sn + 2((a + b) + k) == sn + ((da + db) + dk) == (sn + dk) + (da + db)
  +l1 = Equal.trans(Nat, Nat.add(Nat.add(sn, Nat.double(l)), Nat.double(cy)), Nat.add(sn, Nat.add(Nat.double(l), Nat.double(cy))), Nat.add(sn, Nat.double(Nat.add(l, cy))),
    n_add_assoc(sn, Nat.double(l), Nat.double(cy)),
    n_cong_r(sn, Nat.add(Nat.double(l), Nat.double(cy)), Nat.double(Nat.add(l, cy)), Equal.sym(Nat, Nat.double(Nat.add(l, cy)), Nat.add(Nat.double(l), Nat.double(cy)), n_dbl_add(l, cy))))
  +l2 = n_cong_r(sn, Nat.double(Nat.add(l, cy)), Nat.add(Nat.add(da, db), dk),
    Equal.trans(Nat, Nat.double(Nat.add(l, cy)), Nat.double(Nat.add(Nat.add(a, b), kn)), Nat.add(Nat.add(da, db), dk),
      Equal.cong(Nat, Nat, Nat.double, Nat.add(l, cy), Nat.add(Nat.add(a, b), kn), ih),
      Equal.trans(Nat, Nat.double(Nat.add(Nat.add(a, b), kn)), Nat.add(Nat.double(Nat.add(a, b)), dk), Nat.add(Nat.add(da, db), dk),
        n_dbl_add(Nat.add(a, b), kn),
        n_cong_l(Nat.double(Nat.add(a, b)), Nat.add(da, db), dk, n_dbl_add(a, b)))))
  # sn + ((da + db) + dk) == sn + (dk + (da + db)) == (sn + dk) + (da + db)
  +l3 = Equal.trans(Nat, Nat.add(sn, Nat.add(Nat.add(da, db), dk)), Nat.add(sn, Nat.add(dk, Nat.add(da, db))), Nat.add(Nat.add(sn, dk), Nat.add(da, db)),
    n_cong_r(sn, Nat.add(Nat.add(da, db), dk), Nat.add(dk, Nat.add(da, db)), n_add_comm(Nat.add(da, db), dk)),
    Equal.sym(Nat, Nat.add(Nat.add(sn, dk), Nat.add(da, db)), Nat.add(sn, Nat.add(dk, Nat.add(da, db))), n_add_assoc(sn, dk, Nat.add(da, db))))
  +l4 = n_cong_l(Nat.add(sn, dk), Nat.add(Nat.add(hn, gn), cn), Nat.add(da, db), fa)
  # right: ((hn + da) + (gn + db)) + cn == ((hn + gn) + (da + db)) + cn == ((hn + gn) + cn) + (da + db)
  +r1 = n_cong_l(Nat.add(Nat.add(hn, da), Nat.add(gn, db)), Nat.add(Nat.add(hn, gn), Nat.add(da, db)), cn, n_swap_mid(hn, da, gn, db))
  +r2 = Equal.trans(Nat, Nat.add(Nat.add(Nat.add(hn, gn), Nat.add(da, db)), cn), Nat.add(Nat.add(hn, gn), Nat.add(Nat.add(da, db), cn)), Nat.add(Nat.add(Nat.add(hn, gn), cn), Nat.add(da, db)),
    n_add_assoc(Nat.add(hn, gn), Nat.add(da, db), cn),
    Equal.trans(Nat, Nat.add(Nat.add(hn, gn), Nat.add(Nat.add(da, db), cn)), Nat.add(Nat.add(hn, gn), Nat.add(cn, Nat.add(da, db))), Nat.add(Nat.add(Nat.add(hn, gn), cn), Nat.add(da, db)),
      n_cong_r(Nat.add(hn, gn), Nat.add(Nat.add(da, db), cn), Nat.add(cn, Nat.add(da, db)), n_add_comm(Nat.add(da, db), cn)),
      Equal.sym(Nat, Nat.add(Nat.add(Nat.add(hn, gn), cn), Nat.add(da, db)), Nat.add(Nat.add(hn, gn), Nat.add(cn, Nat.add(da, db))), n_add_assoc(Nat.add(hn, gn), cn, Nat.add(da, db)))))
  +lhs = Equal.trans(Nat, Nat.add(Nat.add(sn, Nat.double(l)), Nat.double(cy)), Nat.add(sn, Nat.double(Nat.add(l, cy))), Nat.add(Nat.add(Nat.add(hn, gn), cn), Nat.add(da, db)),
    l1, Equal.trans(Nat, Nat.add(sn, Nat.double(Nat.add(l, cy))), Nat.add(sn, Nat.add(Nat.add(da, db), dk)), Nat.add(Nat.add(Nat.add(hn, gn), cn), Nat.add(da, db)),
      l2, Equal.trans(Nat, Nat.add(sn, Nat.add(Nat.add(da, db), dk)), Nat.add(Nat.add(sn, dk), Nat.add(da, db)), Nat.add(Nat.add(Nat.add(hn, gn), cn), Nat.add(da, db)), l3, l4)))
  +rhs = Equal.trans(Nat, Nat.add(Nat.add(Nat.add(hn, da), Nat.add(gn, db)), cn), Nat.add(Nat.add(Nat.add(hn, gn), Nat.add(da, db)), cn), Nat.add(Nat.add(Nat.add(hn, gn), cn), Nat.add(da, db)), r1, r2)
  Equal.trans(Nat, Nat.add(Nat.add(sn, Nat.double(l)), Nat.double(cy)), Nat.add(Nat.add(Nat.add(hn, gn), cn), Nat.add(da, db)), Nat.add(Nat.add(Nat.add(hn, da), Nat.add(gn, db)), cn),
    lhs, Equal.sym(Nat, Nat.add(Nat.add(Nat.add(hn, da), Nat.add(gn, db)), cn), Nat.add(Nat.add(Nat.add(hn, gn), cn), Nat.add(da, db)), rhs))

# the adder in Nat: to_nat(adc(a, b, c)) + 2^n carry == (to_nat(a) + to_nat(b)) + c (induction on the width)
def w_adc_nat(+n: Nat, +a: Word(n), +b: Word(n), +c: Bool) ->
    {Nat.add(Word.to_nat(n, Word.adc(n, a, b, False{}, c)), Laws.c3_shn(n, b2n(wcarry(n, a, b, c)))) == Nat.add(Nat.add(Word.to_nat(n, a), Word.to_nat(n, b)), b2n(c)) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match a b c:
        case WCon{False{}, +at} WCon{False{}, +bt} False{}:
          n_fa_step(0n, 0n, 0n, 0n, 0n, Word.to_nat(p, Word.adc(p, at, bt, False{}, False{})),
            Laws.c3_shn(p, b2n(wcarry(p, at, bt, False{}))), Word.to_nat(p, at), Word.to_nat(p, bt), w_adc_nat(p, at, bt, False{}), {==})
        case WCon{False{}, +at} WCon{False{}, +bt} True{}:
          n_fa_step(1n, 0n, 0n, 0n, 1n, Word.to_nat(p, Word.adc(p, at, bt, False{}, False{})),
            Laws.c3_shn(p, b2n(wcarry(p, at, bt, False{}))), Word.to_nat(p, at), Word.to_nat(p, bt), w_adc_nat(p, at, bt, False{}), {==})
        case WCon{False{}, +at} WCon{True{}, +bt} False{}:
          n_fa_step(1n, 0n, 0n, 1n, 0n, Word.to_nat(p, Word.adc(p, at, bt, False{}, False{})),
            Laws.c3_shn(p, b2n(wcarry(p, at, bt, False{}))), Word.to_nat(p, at), Word.to_nat(p, bt), w_adc_nat(p, at, bt, False{}), {==})
        case WCon{False{}, +at} WCon{True{}, +bt} True{}:
          n_fa_step(0n, 1n, 0n, 1n, 1n, Word.to_nat(p, Word.adc(p, at, bt, False{}, True{})),
            Laws.c3_shn(p, b2n(wcarry(p, at, bt, True{}))), Word.to_nat(p, at), Word.to_nat(p, bt), w_adc_nat(p, at, bt, True{}), {==})
        case WCon{True{}, +at} WCon{False{}, +bt} False{}:
          n_fa_step(1n, 0n, 1n, 0n, 0n, Word.to_nat(p, Word.adc(p, at, bt, False{}, False{})),
            Laws.c3_shn(p, b2n(wcarry(p, at, bt, False{}))), Word.to_nat(p, at), Word.to_nat(p, bt), w_adc_nat(p, at, bt, False{}), {==})
        case WCon{True{}, +at} WCon{False{}, +bt} True{}:
          n_fa_step(0n, 1n, 1n, 0n, 1n, Word.to_nat(p, Word.adc(p, at, bt, False{}, True{})),
            Laws.c3_shn(p, b2n(wcarry(p, at, bt, True{}))), Word.to_nat(p, at), Word.to_nat(p, bt), w_adc_nat(p, at, bt, True{}), {==})
        case WCon{True{}, +at} WCon{True{}, +bt} False{}:
          n_fa_step(0n, 1n, 1n, 1n, 0n, Word.to_nat(p, Word.adc(p, at, bt, False{}, True{})),
            Laws.c3_shn(p, b2n(wcarry(p, at, bt, True{}))), Word.to_nat(p, at), Word.to_nat(p, bt), w_adc_nat(p, at, bt, True{}), {==})
        case WCon{True{}, +at} WCon{True{}, +bt} True{}:
          n_fa_step(1n, 1n, 1n, 1n, 1n, Word.to_nat(p, Word.adc(p, at, bt, False{}, True{})),
            Laws.c3_shn(p, b2n(wcarry(p, at, bt, True{}))), Word.to_nat(p, at), Word.to_nat(p, bt), w_adc_nat(p, at, bt, True{}), {==})

# ---- adding zero, and the carry-in as an increment
def w_adc_zr(+n: Nat, +x: Word(n)) -> {Word.adc(n, x, Word.zero(n), False{}, False{}) == x : Word(n)}:
  match n:
    case 0n:
      match x:
        case WNil{}:
          {==}
    case 1n+p:
      match x:
        case WCon{False{}, +xt}:
          Equal.cong(Word(p), Word(1n+p), t => WCon{False{}, t}, Word.adc(p, xt, Word.zero(p), False{}, False{}), xt, w_adc_zr(p, xt))
        case WCon{True{}, +xt}:
          Equal.cong(Word(p), Word(1n+p), t => WCon{True{}, t}, Word.adc(p, xt, Word.zero(p), False{}, False{}), xt, w_adc_zr(p, xt))

def w_adc_zl(+n: Nat, +y: Word(n)) -> {Word.adc(n, Word.zero(n), y, False{}, False{}) == y : Word(n)}:
  match n:
    case 0n:
      match y:
        case WNil{}:
          {==}
    case 1n+p:
      match y:
        case WCon{False{}, +yt}:
          Equal.cong(Word(p), Word(1n+p), t => WCon{False{}, t}, Word.adc(p, Word.zero(p), yt, False{}, False{}), yt, w_adc_zl(p, yt))
        case WCon{True{}, +yt}:
          Equal.cong(Word(p), Word(1n+p), t => WCon{True{}, t}, Word.adc(p, Word.zero(p), yt, False{}, False{}), yt, w_adc_zl(p, yt))

def w_inc_adc(+n: Nat, +x: Word(n), +y: Word(n)) -> {Word.inc(n, Word.adc(n, x, y, False{}, False{})) == Word.adc(n, x, y, False{}, True{}) : Word(n)}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match x y:
        case WCon{False{}, +xt} WCon{False{}, +yt}:
          {==}
        case WCon{False{}, +xt} WCon{True{}, +yt}:
          Equal.cong(Word(p), Word(1n+p), t => WCon{False{}, t}, Word.inc(p, Word.adc(p, xt, yt, False{}, False{})), Word.adc(p, xt, yt, False{}, True{}), w_inc_adc(p, xt, yt))
        case WCon{True{}, +xt} WCon{False{}, +yt}:
          Equal.cong(Word(p), Word(1n+p), t => WCon{False{}, t}, Word.inc(p, Word.adc(p, xt, yt, False{}, False{})), Word.adc(p, xt, yt, False{}, True{}), w_inc_adc(p, xt, yt))
        case WCon{True{}, +xt} WCon{True{}, +yt}:
          {==}

# ---- the order of words is the order of their values
def fin_ff(+t: Cmp) -> {Word.cmp.fin(False{}, False{}, t) == t : Cmp}:
  match t:
    case LT{}:
      {==}
    case EQ{}:
      {==}
    case GT{}:
      {==}

def fin_tt(+t: Cmp) -> {Word.cmp.fin(True{}, True{}, t) == t : Cmp}:
  match t:
    case LT{}:
      {==}
    case EQ{}:
      {==}
    case GT{}:
      {==}

def nc_dd(+a: Nat, +b: Nat) -> {Nat.cmp(Nat.double(a), Nat.double(b)) == Nat.cmp(a, b) : Cmp}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      nc_dd(p, q)

def nc_d1d(+a: Nat, +b: Nat) -> {Nat.cmp(Nat.double(a), 1n+Nat.double(b)) == Word.cmp.fin(False{}, True{}, Nat.cmp(a, b)) : Cmp}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      nc_d1d(p, q)

def nc_1dd(+a: Nat, +b: Nat) -> {Nat.cmp(1n+Nat.double(a), Nat.double(b)) == Word.cmp.fin(True{}, False{}, Nat.cmp(a, b)) : Cmp}:
  match a b:
    case 0n 0n:
      {==}
    case 0n 1n+q:
      {==}
    case 1n+p 0n:
      {==}
    case 1n+p 1n+q:
      nc_1dd(p, q)

def w_cmp_nat(+n: Nat, +a: Word(n), +b: Word(n)) -> {Word.cmp(n, a, b) == Nat.cmp(Word.to_nat(n, a), Word.to_nat(n, b)) : Cmp}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match a b:
        case WCon{False{}, +at} WCon{False{}, +bt}:
          Equal.trans(Cmp, Word.cmp.fin(False{}, False{}, Word.cmp(p, at, bt)), Word.cmp.fin(False{}, False{}, Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt))), Nat.cmp(Nat.double(Word.to_nat(p, at)), Nat.double(Word.to_nat(p, bt))),
            Equal.cong(Cmp, Cmp, t => Word.cmp.fin(False{}, False{}, t), Word.cmp(p, at, bt), Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt)), w_cmp_nat(p, at, bt)),
            Equal.trans(Cmp, Word.cmp.fin(False{}, False{}, Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt))), Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt)), Nat.cmp(Nat.double(Word.to_nat(p, at)), Nat.double(Word.to_nat(p, bt))),
              fin_ff(Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt))),
              Equal.sym(Cmp, Nat.cmp(Nat.double(Word.to_nat(p, at)), Nat.double(Word.to_nat(p, bt))), Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt)), nc_dd(Word.to_nat(p, at), Word.to_nat(p, bt)))))
        case WCon{True{}, +at} WCon{True{}, +bt}:
          Equal.trans(Cmp, Word.cmp.fin(True{}, True{}, Word.cmp(p, at, bt)), Word.cmp.fin(True{}, True{}, Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt))), Nat.cmp(Nat.double(Word.to_nat(p, at)), Nat.double(Word.to_nat(p, bt))),
            Equal.cong(Cmp, Cmp, t => Word.cmp.fin(True{}, True{}, t), Word.cmp(p, at, bt), Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt)), w_cmp_nat(p, at, bt)),
            Equal.trans(Cmp, Word.cmp.fin(True{}, True{}, Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt))), Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt)), Nat.cmp(Nat.double(Word.to_nat(p, at)), Nat.double(Word.to_nat(p, bt))),
              fin_tt(Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt))),
              Equal.sym(Cmp, Nat.cmp(Nat.double(Word.to_nat(p, at)), Nat.double(Word.to_nat(p, bt))), Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt)), nc_dd(Word.to_nat(p, at), Word.to_nat(p, bt)))))
        case WCon{False{}, +at} WCon{True{}, +bt}:
          Equal.trans(Cmp, Word.cmp.fin(False{}, True{}, Word.cmp(p, at, bt)), Word.cmp.fin(False{}, True{}, Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt))), Nat.cmp(Nat.double(Word.to_nat(p, at)), 1n+Nat.double(Word.to_nat(p, bt))),
            Equal.cong(Cmp, Cmp, t => Word.cmp.fin(False{}, True{}, t), Word.cmp(p, at, bt), Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt)), w_cmp_nat(p, at, bt)),
            Equal.sym(Cmp, Nat.cmp(Nat.double(Word.to_nat(p, at)), 1n+Nat.double(Word.to_nat(p, bt))), Word.cmp.fin(False{}, True{}, Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt))), nc_d1d(Word.to_nat(p, at), Word.to_nat(p, bt))))
        case WCon{True{}, +at} WCon{False{}, +bt}:
          Equal.trans(Cmp, Word.cmp.fin(True{}, False{}, Word.cmp(p, at, bt)), Word.cmp.fin(True{}, False{}, Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt))), Nat.cmp(1n+Nat.double(Word.to_nat(p, at)), Nat.double(Word.to_nat(p, bt))),
            Equal.cong(Cmp, Cmp, t => Word.cmp.fin(True{}, False{}, t), Word.cmp(p, at, bt), Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt)), w_cmp_nat(p, at, bt)),
            Equal.sym(Cmp, Nat.cmp(1n+Nat.double(Word.to_nat(p, at)), Nat.double(Word.to_nat(p, bt))), Word.cmp.fin(True{}, False{}, Nat.cmp(Word.to_nat(p, at), Word.to_nat(p, bt))), nc_1dd(Word.to_nat(p, at), Word.to_nat(p, bt))))

# ---- the bound: to_nat(w) + 1 + to_nat(not w) == 2^n
def w_bound(+n: Nat, +w: Word(n)) -> {Nat.add(Word.to_nat(n, w), 1n+Word.to_nat(n, Word.not(n, w))) == Laws.c3_shn(n, 1n) : Nat}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match w:
        case WCon{False{}, +t}:
          Equal.trans(Nat, Nat.add(Nat.double(Word.to_nat(p, t)), 2n+Nat.double(Word.to_nat(p, Word.not(p, t)))), Nat.double(Nat.add(Word.to_nat(p, t), 1n+Word.to_nat(p, Word.not(p, t)))), Nat.double(Laws.c3_shn(p, 1n)), Equal.sym(Nat, Nat.double(Nat.add(Word.to_nat(p, t), 1n+Word.to_nat(p, Word.not(p, t)))), Nat.add(Nat.double(Word.to_nat(p, t)), 2n+Nat.double(Word.to_nat(p, Word.not(p, t)))), n_dbl_add(Word.to_nat(p, t), 1n+Word.to_nat(p, Word.not(p, t)))), Equal.cong(Nat, Nat, Nat.double, Nat.add(Word.to_nat(p, t), 1n+Word.to_nat(p, Word.not(p, t))), Laws.c3_shn(p, 1n), w_bound(p, t)))
        case WCon{True{}, +t}:
          Equal.trans(Nat, 1n+Nat.add(Nat.double(Word.to_nat(p, t)), 1n+Nat.double(Word.to_nat(p, Word.not(p, t)))), 1n+(1n+Nat.add(Nat.double(Word.to_nat(p, t)), Nat.double(Word.to_nat(p, Word.not(p, t))))), Nat.double(Laws.c3_shn(p, 1n)), Equal.cong(Nat, Nat, x => 1n+x, Nat.add(Nat.double(Word.to_nat(p, t)), 1n+Nat.double(Word.to_nat(p, Word.not(p, t)))), 1n+Nat.add(Nat.double(Word.to_nat(p, t)), Nat.double(Word.to_nat(p, Word.not(p, t)))), n_add_s(Nat.double(Word.to_nat(p, t)), Nat.double(Word.to_nat(p, Word.not(p, t))))), Equal.trans(Nat, 1n+(1n+Nat.add(Nat.double(Word.to_nat(p, t)), Nat.double(Word.to_nat(p, Word.not(p, t))))), Nat.add(Nat.double(Word.to_nat(p, t)), 2n+Nat.double(Word.to_nat(p, Word.not(p, t)))), Nat.double(Laws.c3_shn(p, 1n)), Equal.sym(Nat, Nat.add(Nat.double(Word.to_nat(p, t)), 2n+Nat.double(Word.to_nat(p, Word.not(p, t)))), 1n+(1n+Nat.add(Nat.double(Word.to_nat(p, t)), Nat.double(Word.to_nat(p, Word.not(p, t))))), Equal.trans(Nat, Nat.add(Nat.double(Word.to_nat(p, t)), 2n+Nat.double(Word.to_nat(p, Word.not(p, t)))), 1n+Nat.add(Nat.double(Word.to_nat(p, t)), 1n+Nat.double(Word.to_nat(p, Word.not(p, t)))), 1n+(1n+Nat.add(Nat.double(Word.to_nat(p, t)), Nat.double(Word.to_nat(p, Word.not(p, t))))), n_add_s(Nat.double(Word.to_nat(p, t)), 1n+Nat.double(Word.to_nat(p, Word.not(p, t)))), Equal.cong(Nat, Nat, x => 1n+x, Nat.add(Nat.double(Word.to_nat(p, t)), 1n+Nat.double(Word.to_nat(p, Word.not(p, t)))), 1n+Nat.add(Nat.double(Word.to_nat(p, t)), Nat.double(Word.to_nat(p, Word.not(p, t)))), n_add_s(Nat.double(Word.to_nat(p, t)), Nat.double(Word.to_nat(p, Word.not(p, t))))))), Equal.trans(Nat, Nat.add(Nat.double(Word.to_nat(p, t)), 2n+Nat.double(Word.to_nat(p, Word.not(p, t)))), Nat.double(Nat.add(Word.to_nat(p, t), 1n+Word.to_nat(p, Word.not(p, t)))), Nat.double(Laws.c3_shn(p, 1n)), Equal.sym(Nat, Nat.double(Nat.add(Word.to_nat(p, t), 1n+Word.to_nat(p, Word.not(p, t)))), Nat.add(Nat.double(Word.to_nat(p, t)), 2n+Nat.double(Word.to_nat(p, Word.not(p, t)))), n_dbl_add(Word.to_nat(p, t), 1n+Word.to_nat(p, Word.not(p, t)))), Equal.cong(Nat, Nat, Nat.double, Nat.add(Word.to_nat(p, t), 1n+Word.to_nat(p, Word.not(p, t))), Laws.c3_shn(p, 1n), w_bound(p, t)))))


# a + 0 == a and 0 + b == b on U32
def u_add_z(+a: U32) -> {U32.add(a, 0) == a : U32}:
  match a:
    case U32{+x}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.adc(32n, x, Word.zero(32n), False{}, False{}), x, w_adc_zr(32n, x))

def u_z_add(+b: U32) -> {U32.add(0, b) == b : U32}:
  match b:
    case U32{+y}:
      Equal.cong(Word(32n), U32, w => U32{w}, Word.adc(32n, Word.zero(32n), y, False{}, False{}), y, w_adc_zl(32n, y))

def u_add_eq_a(c: Bool, +a: U32, +b: U32, e: {U32.is_eq(a, 0) == c : Bool}) -> {M.ite(U32, c, b, U32.add(a, b)) == U32.add(a, b) : U32}:
  match c:
    case True{}:
      (%Equal.sym(U32, a, 0, u_refl(a, 0, e)) : {b == U32.add(_, b) : U32}
      Equal.sym(U32, U32.add(0, b), b, u_z_add(b)))
    case False{}:
      {==}

def u_add_eq_b(c: Bool, +a: U32, +b: U32, e: {U32.is_eq(b, 0) == c : Bool}) -> {M.ite(U32, c, a, M.ite(U32, U32.is_eq(a, 0), b, U32.add(a, b))) == U32.add(a, b) : U32}:
  match c:
    case True{}:
      (%Equal.sym(U32, b, 0, u_refl(b, 0, e)) : {a == U32.add(a, _) : U32}
      Equal.sym(U32, U32.add(a, 0), a, u_add_z(a)))
    case False{}:
      u_add_eq_a(U32.is_eq(a, 0), a, b, {==})

def u_add_eq(+a: U32, +b: U32) -> {M.u_add(a, b) == U32.add(a, b) : U32}:
  u_add_eq_b(U32.is_eq(b, 0), a, b, {==})


def n_cmp_refl(+a: Nat) -> {Nat.cmp(a, a) == EQ{} : Cmp}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      n_cmp_refl(p)

# a < a + 1 + d
def n_lt_add(+a: Nat, +d: Nat) -> {Cmp.is_lt(Nat.cmp(a, Nat.add(a, 1n+d))) == True{} : Bool}:
  match a:
    case 0n:
      {==}
    case 1n+p:
      n_lt_add(p, d)

# not (a + d < a)
def n_nlt_add(+a: Nat, +d: Nat) -> {Cmp.is_lt(Nat.cmp(Nat.add(a, d), a)) == False{} : Bool}:
  match a:
    case 0n:
      match d:
