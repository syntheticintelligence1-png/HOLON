  n_lt_add(a, 0n)

def lt_up(a: Nat, b: Nat, h: {Nat.is_lt(a, b) == True{} : Bool}) -> {Nat.is_lt(a, Nat.add(b, 1n)) == True{} : Bool}:
  match a b:
    case 0n 0n:
