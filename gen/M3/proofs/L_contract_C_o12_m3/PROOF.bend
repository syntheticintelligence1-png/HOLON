# the wrap bound: N(a + b) <= N(a) + N(b)
def w_wrap(+a: M.W, +b: M.W) -> {Nat.is_le(Laws.c3_wnat(M.w_add(a, b)), Nat.add(Laws.c3_wnat(a), Laws.c3_wnat(b))) == True{} : Bool}:
