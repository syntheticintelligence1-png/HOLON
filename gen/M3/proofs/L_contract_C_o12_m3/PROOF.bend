def lt_irr(+a: Nat) -> {Nat.is_lt(a, a) == False{} : Bool}:
  (%Equal.sym(Cmp, Nat.cmp(a, a), EQ{}, n_cmp_refl(a)) : {Cmp.is_lt(_) == False{} : Bool}
