# a sum with a carry of pw that stays below pw has no carry
def nw_c(c: Bool, +s: Nat, +x: Nat, +d: Nat, +pw: Nat, eb: {Nat.add(s, cmul(c, pw)) == x : Nat}, e: {Nat.add(x, 1n+d) == pw : Nat}) -> {s == x : Nat}:
  match c:
    case False{}:
      Equal.trans(Nat, s, Nat.add(s, 0n), x, Equal.sym(Nat, Nat.add(s, 0n), s, n_add_z(s)), eb)
    case True{}:
      efq({s == x : Nat}, n_succ_nz(Nat.add(s, d), Equal.trans(Nat, 1n+Nat.add(s, d), Nat.add(s, 1n+d), 0n, Equal.sym(Nat, Nat.add(s, 1n+d), 1n+Nat.add(s, d), n_add_s(s, d)), n_cancel_l(x, Nat.add(s, 1n+d), 0n, Equal.trans(Nat, Nat.add(x, Nat.add(s, 1n+d)), Nat.add(s, Nat.add(x, 1n+d)), Nat.add(x, 0n), n_swap3(x, s, 1n+d), Equal.trans(Nat, Nat.add(s, Nat.add(x, 1n+d)), x, Nat.add(x, 0n), Equal.trans(Nat, Nat.add(s, Nat.add(x, 1n+d)), Nat.add(s, pw), x, n_cong_r(s, Nat.add(x, 1n+d), pw, e), eb), Equal.sym(Nat, Nat.add(x, 0n), x, n_add_z(x))))))))

# no wrap: N(a) + N(b) + 1 + d == 2^256 gives N(a + b) == N(a) + N(b)
def nw(+a: M.W, +b: M.W, +d: Nat, e: {Nat.add(Nat.add(Laws.c3_wnat(a), Laws.c3_wnat(b)), 1n+d) == Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, 1n)))))))) : Nat}) -> {Laws.c3_wnat(M.w_add(a, b)) == Nat.add(Laws.c3_wnat(a), Laws.c3_wnat(b)) : Nat}:
  nw_c(Bool.not(M.w_add_ok(a, b)), Laws.c3_wnat(M.w_add(a, b)), Nat.add(Laws.c3_wnat(a), Laws.c3_wnat(b)), d, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, 1n)))))))), w_bridge(a, b), e)

def ok_c(c: Bool, +s: Nat, +x: Nat, +pw: Nat, eb: {Nat.add(s, cmul(Bool.not(c), pw)) == x : Nat}, ec: {c == True{} : Bool}) -> {s == x : Nat}:
  match c:
    case True{}:
      Equal.trans(Nat, s, Nat.add(s, 0n), x, Equal.sym(Nat, Nat.add(s, 0n), s, n_add_z(s)), eb)
    case False{}:
      efq({s == x : Nat}, false_ne_true(ec))

# a checked sum: w_add_ok(a, b) gives N(a + b) == N(a) + N(b)
def okn(+a: M.W, +b: M.W, ok: {M.w_add_ok(a, b) == True{} : Bool}) -> {Laws.c3_wnat(M.w_add(a, b)) == Nat.add(Laws.c3_wnat(a), Laws.c3_wnat(b)) : Nat}:
  ok_c(M.w_add_ok(a, b), Laws.c3_wnat(M.w_add(a, b)), Nat.add(Laws.c3_wnat(a), Laws.c3_wnat(b)), Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, Laws.c3_shn(32n, 1n)))))))), w_bridge(a, b), ok)


