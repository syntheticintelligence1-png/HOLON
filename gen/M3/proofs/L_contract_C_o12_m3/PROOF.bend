    case M.W{l0, l1, l2, l3, l4, l5, l6, l7}:
      Nat.add(unc(l0), Laws.c3_shn(32n, Nat.add(unc(l1), Laws.c3_shn(32n, Nat.add(unc(l2), Laws.c3_shn(32n, Nat.add(unc(l3), Laws.c3_shn(32n, Nat.add(unc(l4), Laws.c3_shn(32n, Nat.add(unc(l5), Laws.c3_shn(32n, Nat.add(unc(l6), Laws.c3_shn(32n, unc(l7)))))))))))))))

