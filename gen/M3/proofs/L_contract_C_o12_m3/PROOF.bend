        case M.KV{+hk, +hv}:
          kv_fr_c(M.sk_eq(hk, k), hk, hv, kw, v, d, k, M.kv_get(M.kv_put(t, kw, v, Bool.or(d, M.sk_eq(hk, kw))), k), M.kv_get(t, k), {==}, ne2, kv_frame(t, kw, v, Bool.or(d, M.sk_eq(hk, kw)), k, ne1, ne2))

