open Dec_sendMessage

def decide_sendMessage (who : Nat) : Dec_sendMessage :=
  D_sendMessage_Ok

def exec_sendMessage (d : Dec_sendMessage) (t : Nat) (lfi : Nat) (inch : Bool) (bc : Nat) (rri : Nat) (paused : Bool) (W : Nat) (F : Nat) (D : Nat) (qlen : Nat) (qpend : Nat) (enq : (List Nat)) (active : (List Nat)) (chals : (List Nat)) (fsr : (List Nat)) (chs : (List HCh)) (win : (List HEntry)) (s_csr : (List Nat)) (s_bd : (List HBD)) (s_bvh : (List Nat)) (s_tag : (List Nat)) (log : (List HObs)) (who : Nat) : HSt :=
  (match d with | (D_sendMessage_Rev code) => (HSt.mk t lfi inch bc rri paused W F D qlen qpend enq active chals fsr chs win s_csr s_bd s_bvh s_tag ((O_Rev code) :: log)) | D_sendMessage_Ok => (HSt.mk t lfi inch bc rri paused W F D (Nat_add qlen 1) qpend (b_list_append enq [t]) active chals fsr chs win s_csr s_bd s_bvh s_tag (O_Ok :: log)))

def step_sendMessage (s : HSt) (who : Nat) : HSt :=
  (match s with | (HSt.mk t lfi inch bc rri paused W F D qlen qpend enq active chals fsr chs win s_csr s_bd s_bvh s_tag log) => (exec_sendMessage (decide_sendMessage who) t lfi inch bc rri paused W F D qlen qpend enq active chals fsr chs win s_csr s_bd s_bvh s_tag log who))

inductive Dec_wait : Type where
  | D_wait_Rev : Nat → Dec_wait
  | D_wait_Ok : Dec_wait
open Dec_wait

def decide_wait (dt : Nat) : Dec_wait :=
  D_wait_Ok

def exec_wait (d : Dec_wait) (t : Nat) (lfi : Nat) (inch : Bool) (bc : Nat) (rri : Nat) (paused : Bool) (W : Nat) (F : Nat) (D : Nat) (qlen : Nat) (qpend : Nat) (enq : (List Nat)) (active : (List Nat)) (chals : (List Nat)) (fsr : (List Nat)) (chs : (List HCh)) (win : (List HEntry)) (s_csr : (List Nat)) (s_bd : (List HBD)) (s_bvh : (List Nat)) (s_tag : (List Nat)) (log : (List HObs)) (dt : Nat) : HSt :=
  (match d with | (D_wait_Rev code) => (HSt.mk t lfi inch bc rri paused W F D qlen qpend enq active chals fsr chs win s_csr s_bd s_bvh s_tag ((O_Rev code) :: log)) | D_wait_Ok => (HSt.mk (Nat_add t dt) lfi inch bc rri paused W F D qlen qpend enq active chals fsr chs win s_csr s_bd s_bvh s_tag (O_Ok :: log)))

def step_wait (s : HSt) (dt : Nat) : HSt :=
  (match s with | (HSt.mk t lfi inch bc rri paused W F D qlen qpend enq active chals fsr chs win s_csr s_bd s_bvh s_tag log) => (exec_wait (decide_wait dt) t lfi inch bc rri paused W F D qlen qpend enq active chals fsr chs win s_csr s_bd s_bvh s_tag log dt))

def step (a : HAct) (s : HSt) : HSt :=
  (match a with | (A_commitBatch who ver parent n lbn prev post blobs) => (step_commitBatch s who ver parent n lbn prev post blobs) | (A_commitState who ver parent n lbn prev post blobs) => (step_commitState s who ver parent n lbn prev post blobs) | (A_commitBatchWithProof who ver parent n lbn prev post blobs proof) => (step_commitBatchWithProof s who ver parent n lbn prev post blobs proof) | (A_revertBatch who idx count) => (step_revertBatch s who idx count) | (A_challengeState who idx value) => (step_challengeState s who idx value) | (A_proveState who idx proof) => (step_proveState s who idx proof) | (A_finalizeBatch who idx) => (step_finalizeBatch s who idx) | (A_setPause who status) => (step_setPause s who status) | (A_sendMessage who) => (step_sendMessage s who) | (A_wait dt) => (step_wait s dt))

def run (tr : (List HAct)) (s : HSt) : HSt :=
  (match tr with | [] => s | (a :: rest) => (run rest (step a s)))

def clear_log (s : HSt) : HSt :=
  (match s with | (HSt.mk t lfi inch bc rri paused W F D qlen qpend enq active chals fsr chs win s_csr s_bd s_bvh s_tag log) => (HSt.mk t lfi inch bc rri paused W F D qlen qpend enq active chals fsr chs win s_csr s_bd s_bvh s_tag []))

def log_of (s : HSt) : (List HObs) :=
  (match s with | (HSt.mk t lfi inch bc rri paused W F D qlen qpend enq active chals fsr chs win s_csr s_bd s_bvh s_tag log) => log)

def obs (tr : (List HAct)) (s : HSt) : (List HObs) :=
  (log_of (run tr (clear_log s)))

def all_ok (l : (List HObs)) : Bool :=
  (match l with | [] => true | (o :: t) => (match o with | O_Ok => (all_ok t) | (O_Rev c) => false))

def runs_ok (tr : (List HAct)) (s : HSt) : Bool :=
  (all_ok (obs tr s))

def cost (tr : (List HAct)) : Nat :=
  (match tr with | [] => 0 | (a :: rest) => (match a with | (A_commitBatch _ _ _ _ _ _ _ _) => (Nat_add 0 (cost rest)) | (A_commitState _ _ _ _ _ _ _ _) => (Nat_add 0 (cost rest)) | (A_commitBatchWithProof _ _ _ _ _ _ _ _ _) => (Nat_add 1000 (cost rest)) | (A_revertBatch _ _ _) => (Nat_add 0 (cost rest)) | (A_challengeState _ _ _) => (Nat_add 0 (cost rest)) | (A_proveState _ _ _) => (Nat_add 0 (cost rest)) | (A_finalizeBatch _ _) => (Nat_add 0 (cost rest)) | (A_setPause _ _) => (Nat_add 0 (cost rest)) | (A_sendMessage _) => (Nat_add 1 (cost rest)) | (A_wait _) => (Nat_add 0 (cost rest))))

def elapsed (tr : (List HAct)) : Nat :=
  (match tr with | [] => 0 | (a :: rest) => (match a with | (A_commitBatch _ _ _ _ _ _ _ _) => (Nat_add 0 (elapsed rest)) | (A_commitState _ _ _ _ _ _ _ _) => (Nat_add 0 (elapsed rest)) | (A_commitBatchWithProof _ _ _ _ _ _ _ _ _) => (Nat_add 0 (elapsed rest)) | (A_revertBatch _ _ _) => (Nat_add 0 (elapsed rest)) | (A_challengeState _ _ _) => (Nat_add 0 (elapsed rest)) | (A_proveState _ _ _) => (Nat_add 0 (elapsed rest)) | (A_finalizeBatch _ _) => (Nat_add 0 (elapsed rest)) | (A_setPause _ _) => (Nat_add 0 (elapsed rest)) | (A_sendMessage _) => (Nat_add 0 (elapsed rest)) | (A_wait dt) => (Nat_add dt (elapsed rest))))

def lci_of (s : HSt) : Nat :=
  (match s with | (HSt.mk t lfi inch bc rri paused W F D qlen qpend enq active chals fsr chs win s_csr s_bd s_bvh s_tag log) => (d_lci lfi win))

