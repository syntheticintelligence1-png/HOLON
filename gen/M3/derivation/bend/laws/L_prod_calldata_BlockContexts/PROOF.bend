# HypB's instance: one blob that is the payload; the blob layer answers its bytes
def cb_w(q: List<&2, Nat>) -> List<&2, C.GV>:
  [C.VY{P.u32s(q)}]

def pl_w(bl: List<&2, C.GV>) -> C.PlAns:
  match bl:
    case Con{b, t}:
      match b:
        case C.VY{bs}:
          C.PlOk{False{}, bs}
        case _:
          C.PlOk{False{}, Nil{}}
    case Nil{}:
      C.PlOk{False{}, Nil{}}

