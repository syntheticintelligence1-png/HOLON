# HypT's instance: a codec of opaque tokens
def tbl() -> List<&2, Nat>:
  [1n, 248n, 203n, 130n, 207n, 85n, 130n, 1n, 51n, 133n, 2n, 3n, 107n, 228n, 186n, 131n, 6n, 104n, 163n, 148n, 242n, 79n, 80n, 134n, 45n, 57n, 53n, 56n, 120n, 84n, 90n, 227n, 55n, 176n, 57n, 17n, 213n, 168n, 96n, 128n, 136n, 2n, 253n, 173n, 203n, 65n, 58n, 251n, 225n, 159n, 230n, 193n, 129n, 115n, 147n, 95n, 11n, 64n, 0n, 182n, 253n, 65n, 70n, 11n, 166n, 122n, 156n, 147n, 46n, 10n, 174n, 66n, 218n, 148n, 150n, 246n, 130n, 215n, 103n, 150n, 32n, 248n, 56n, 247n, 148n, 77n, 237n, 217n, 228n, 62n, 186n, 155n, 100n, 25n, 95n, 192n, 77n, 181n, 88n, 203n, 161n, 43n, 68n, 233n, 84n, 225n, 160n, 224n, 38n, 205n, 26n, 82n, 114n, 151n, 191n, 128n, 52n, 36n, 189n, 198n, 218n, 151n, 40n, 179n, 242n, 203n, 218n, 209n, 188n, 245n, 154n, 15n, 167n, 22n, 52n, 192n, 25n, 210n, 136n, 128n, 160n, 219n, 245n, 165n, 93n, 92n, 206n, 133n, 134n, 179n, 55n, 76n, 99n, 184n, 192n, 127n, 85n, 81n, 54n, 115n, 226n, 121n, 127n, 77n, 203n, 23n, 165n, 254n, 17n, 88n, 221n, 12n, 105n, 160n, 245n, 170n, 237n, 196n, 164n, 119n, 201n, 29n, 169n, 132n, 250n, 108n, 203n, 155n, 48n, 132n, 198n, 227n, 45n, 65n, 66n, 47n, 141n, 0n, 191n, 63n, 36n, 130n, 158n, 205n, 11n, 77n]

def enc1(n: Nat, +rest: List<&2, Nat>) -> List<&2, Nat>:
  match n:
    case 0n:
      List.append(&2, Nat, tbl(), rest)
    case 1n+k:
      Con{256n, Con{k, rest}}

def et_w(u: List<&2, Nat>) -> List<&2, Nat>:
  match u:
    case Nil{}:
      Nil{}
    case Con{n, t}:
      enc1(n, et_w(t))

type PS is Data:
  PB{acc: List<&2, List<&2, U32>>}
  PT{acc: List<&2, List<&2, U32>>}
  PM{rem: List<&2, Nat>, acc: List<&2, List<&2, U32>>}
  PE{}

def rev_app(xs: List<&2, List<&2, U32>>, ys: List<&2, List<&2, U32>>) -> List<&2, List<&2, U32>>:
  match xs:
    case Nil{}:
      ys
    case Con{a, t}:
      rev_app(t, Con{a, ys})

def fin(st: PS) -> C.DtAns:
  match st:
    case PB{acc}:
      C.DtOk{False{}, rev_app(acc, Nil{})}
    case _:
      C.DtErr{C.VNil{}}

def tb_rest(rem: List<&2, Nat>, acc: List<&2, List<&2, U32>>) -> PS:
  match rem:
    case Nil{}:
      PB{Con{P.tok(0n), acc}}
    case Con{r, rs}:
      PM{Con{r, rs}, acc}

def tb_next(c: Bool, rem: List<&2, Nat>, acc: List<&2, List<&2, U32>>) -> PS:
  match c:
    case True{}:
      tb_rest(rem, acc)
    case False{}:
      PE{}

def start(t: List<&2, Nat>, +b: Nat, acc: List<&2, List<&2, U32>>) -> PS:
  match t:
    case Nil{}:
      PE{}
    case Con{r, rs}:
      tb_next(Nat.is_eq(b, r), rs, acc)

def nb(c: Bool, +b: Nat, acc: List<&2, List<&2, U32>>) -> PS:
  match c:
    case True{}:
      PT{acc}
    case False{}:
      start(tbl(), b, acc)

def nxt(st: PS, +b: Nat) -> PS:
  match st:
    case PB{acc}:
      nb(Nat.is_eq(b, 256n), b, acc)
    case PT{acc}:
      PB{Con{P.tok(1n+b), acc}}
    case PM{rem, acc}:
      start(rem, b, acc)
    case PE{}:
      PE{}

def pr(bs: List<&2, Nat>, st: PS) -> C.DtAns:
  match bs:
    case Nil{}:
      fin(st)
    case Con{b, t}:
      pr(t, nxt(st, b))

def dt_w(bs: List<&2, Nat>) -> C.DtAns:
  pr(bs, PB{Nil{}})

# ---------------------------------------------------------------- the hypotheses' instances
def hypb_w(q: List<&2, Nat>) -> {pl_w(cb_w(q)) == P.ok_payload(q) : C.PlAns}:
  {==}

# HypT's instance: by induction on u, the parser's accumulator generalised
def hypt_go(u: List<&2, Nat>, acc: List<&2, List<&2, U32>>) -> {pr(et_w(u), PB{acc}) == C.DtOk{False{}, rev_app(acc, P.toks(u))} : C.DtAns}:
  match u:
    case Nil{}:
      {==}
    case Con{n, t}:
      match n:
        case 0n:
          hypt_go(t, Con{P.tok(0n), acc})
        case 1n+k:
          hypt_go(t, Con{P.tok(1n+k), acc})

def hypt_w(u: List<&2, Nat>) -> {dt_w(et_w(u)) == P.ok_txs(u) : C.DtAns}:
  hypt_go(u, Nil{})

# ---------------------------------------------------------------- generic lemmas (variables: nothing runs)
def sel(b: Bool, A: Type) -> Type:
  match b:
    case True{}:
      A
    case False{}:
      Unit

def efq(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : sel(_, A)
  Unit{}

# the end of a run, under a variable fuel F
def tr_end(F: Nat, x: C.Res) -> {x == C.m_run(F, C.MEnd{x}) : C.Res}:
  match F:
    case 0n:
      {==}
    case 1n+p:
      {==}

# a step of the machine from a running or a returning state, at the witness's closures, under a variable fuel F
def tg_0(F: Nat, fr: C.Frame, st: List<&2, C.Frame>, h: List<&2, C.GV>, s2: C.MT, x: C.Res, es: {s2 == C.m_step(C.MGo{fr, st, h, C.pl_spent, P.dt_cap}) : C.MT}, ih: {x == C.m_run(F, s2) : C.Res}) -> {x == C.m_run(1n+F, C.MGo{fr, st, h, C.pl_spent, P.dt_cap}) : C.Res}:
  %es : {x == C.m_run(F, _) : C.Res}
  ih

