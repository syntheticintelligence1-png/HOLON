def l_rb_m1(c: List<&2, C.GV>, b: C.GV, F: Nat) -> {C.m_run(F, C.MGo{C.Fr11{C.F11K0{}, C.rset([False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}], C.rset([False{}, False{}, False{}, False{}, False{}, False{}, False{}, False{}, True{}], C.RE{}, b), C.VP{4n, Nil{}})}, Nil{}, List.append(&2, C.GV, C.globals_cells(), c), pl_w, P.dt_m(dt_w)}) == P.run_bc(P.BC{c, b}, F, pl_w, P.dt_m(dt_w)) : C.Res}:
  {==}

def run_m1() -> {res_m1() == P.rm(w_x(), w_p(), cb_w, pl_w, P.dt_m(dt_w), None{}, P.fuel0()) : C.Res}:
  %l_rm_1(w_x(), w_p(), None{}, P.fuel0()) : {res_m1() == _ : C.Res}
  %bo_m1() : {res_m1() == P.run_bc(_, P.fuel0(), pl_w, P.dt_m(dt_w)) : C.Res}
  %l_rb_m1(cells_m1(), batch_m1(), P.fuel0()) : {res_m1() == _ : C.Res}
  %g0_m1() : {res_m1() == C.m_run(P.fuel0(), _) : C.Res}
  fu_m1(P.fuel0(), {==})

# ---------------------------------------------------------------- the bridges: a consumer term at the law's closures is the term at the witness's (over variables)
def BR_0(cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, -x: M.HAct, -p: List<&2, Nat>) -> Type:
  {P.txs_data(x, p, cb_w, pl_w, None{}, P.fuel0()) == P.txs_data(x, p, cb, pl, None{}, P.fuel0()) : List<&2, Nat>}

def br_0(-x: M.HAct, -p: List<&2, Nat>) -> BR_0(cb_w, pl_w, x, p):
  {==}

def BR_1(cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, dt: List<&2, Nat> -> C.DtAns, -x: M.HAct, -p: List<&2, Nat>) -> Type:
  {P.derive_ok(x, p, cb_w, pl_w, dt_w, None{}, P.fuel0()) == P.derive_ok(x, p, cb, pl, dt, None{}, P.fuel0()) : Bool}

def br_1(-x: M.HAct, -p: List<&2, Nat>) -> BR_1(cb_w, pl_w, dt_w, x, p):
  {==}

def BR_2(cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, dt: List<&2, Nat> -> C.DtAns, -x: M.HAct, -p: List<&2, Nat>) -> Type:
  {P.derived_lastBlockNumber(x, p, cb_w, pl_w, dt_w, None{}, P.fuel0()) == P.derived_lastBlockNumber(x, p, cb, pl, dt, None{}, P.fuel0()) : Nat}

def br_2(-x: M.HAct, -p: List<&2, Nat>) -> BR_2(cb_w, pl_w, dt_w, x, p):
  {==}

# ---------------------------------------------------------------- the premises and the claim
def pf_h0() -> {P.is_commitBatch(w_x()) == True{} : Bool}:
  {==}

def pf_h1() -> {P.last_ok(M.gh_s0(), w_x(), w_kh()) == True{} : Bool}:
  {==}

def W_h2(cb: List<&2, Nat> -> List<&2, C.GV>, vh: C.GV -> M.W) -> Type:
  P.blobs_match(w_x(), w_p(), cb, vh)

def pf_h2() -> W_h2(cb_w, vh_w):
  ({==}, Unit{})

def W_h5(cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, et: List<&2, Nat> -> List<&2, Nat>) -> Type:
  {P.txs_data(w_x(), w_p(), cb, pl, None{}, P.fuel0()) == et(w_ts()) : List<&2, Nat>}

def pf_h5() -> W_h5(cb_w, pl_w, et_w):
  %br_0(w_x(), w_p()) : {_ == et_w(w_ts()) : List<&2, Nat>}
  %l_txs_data_0(w_x(), w_p(), None{}, P.fuel0()) : {_ == et_w(w_ts()) : List<&2, Nat>}
  %run_c0() : {P.cap_of(_) == et_w(w_ts()) : List<&2, Nat>}
  {==}

def W_h6(cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, dt: List<&2, Nat> -> C.DtAns) -> Type:
  {P.derive_ok(w_x(), w_p(), cb, pl, dt, None{}, P.fuel0()) == True{} : Bool}

def pf_h6() -> W_h6(cb_w, pl_w, dt_w):
  %br_1(w_x(), w_p()) : {_ == True{} : Bool}
  %l_derive_ok_0(w_x(), w_p(), None{}, P.fuel0()) : {_ == True{} : Bool}
  %run_m1() : {P.res_ok(_) == True{} : Bool}
  {==}

def pf_h7() -> {P.committed_ok_LastBlockNumber(M.gh_s0(), w_x(), w_kh()) == True{} : Bool}:
  {==}

def W_v_l(cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, dt: List<&2, Nat> -> C.DtAns) -> Type:
  {3n == P.derived_lastBlockNumber(w_x(), w_p(), cb, pl, dt, None{}, P.fuel0()) : Nat}

def v_l() -> W_v_l(cb_w, pl_w, dt_w):
  %br_2(w_x(), w_p()) : {3n == _ : Nat}
  %l_derived_lastBlockNumber_0(w_x(), w_p(), None{}, P.fuel0()) : {3n == _ : Nat}
  %run_m1() : {3n == P.gv_nat(P.fld(P.recv_of(_), 8n)) : Nat}
  {==}

def v_r() -> {P.committed_LastBlockNumber(M.gh_s0(), w_x(), w_kh()) == 2n : Nat}:
  {==}

def W_claim(cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, dt: List<&2, Nat> -> C.DtAns) -> Type:
  {P.derived_lastBlockNumber(w_x(), w_p(), cb, pl, dt, None{}, P.fuel0()) == P.committed_LastBlockNumber(M.gh_s0(), w_x(), w_kh()) : Nat}

def lt(e: W_claim(cb_w, pl_w, dt_w)) -> {3n == 2n : Nat}:
  %v_r() : {3n == _ : Nat}
  %e : {3n == _ : Nat}
  v_l()

def neg(e: W_claim(cb_w, pl_w, dt_w)) -> Empty:
  %lt(e) : P.is_true(Nat.is_eq(_, 3n))
  Unit{}

def Laws.cl_l_prod_cycle_lastblocknumber():
  (w_kh(), (M.gh_s0(), (M.R0{{==}}, (w_x(), (w_p(), (w_ts(), (cb_w, (pl_w, (vh_w, (et_w, (dt_w, (pf_h0(), (pf_h1(), (pf_h2(), (hypb_w, (hypt_w, (pf_h5(), (pf_h6(), (pf_h7(), neg)))))))))))))))))))
