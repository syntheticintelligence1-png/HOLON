      Con{deep5(h, v), deeps5(h, t)}

def deep6(+h: List<&2, C.GV>, +v: C.GV) -> C.GV:
  match v:
    case C.VS{c, q, o, n, k}:
      C.VR{deeps5(h, C.g_elems(h, v))}
    case C.VP{c, q}:
      deep5(h, C.hload(h, v))
    case C.VR{fs}:
      C.VR{deeps5(h, fs)}
    case _:
      v

def deeps6(+h: List<&2, C.GV>, vs: List<&2, C.GV>) -> List<&2, C.GV>:
  match vs:
    case Nil{}:
      Nil{}
    case Con{v, t}:
      Con{deep6(h, v), deeps6(h, t)}

def deep7(+h: List<&2, C.GV>, +v: C.GV) -> C.GV:
  match v:
    case C.VS{c, q, o, n, k}:
      C.VR{deeps6(h, C.g_elems(h, v))}
    case C.VP{c, q}:
      deep6(h, C.hload(h, v))
    case C.VR{fs}:
      C.VR{deeps6(h, fs)}
    case _:
      v

def deeps7(+h: List<&2, C.GV>, vs: List<&2, C.GV>) -> List<&2, C.GV>:
  match vs:
    case Nil{}:
      Nil{}
    case Con{v, t}:
      Con{deep7(h, v), deeps7(h, t)}

def deep8(+h: List<&2, C.GV>, +v: C.GV) -> C.GV:
  match v:
    case C.VS{c, q, o, n, k}:
      C.VR{deeps7(h, C.g_elems(h, v))}
    case C.VP{c, q}:
      deep7(h, C.hload(h, v))
    case C.VR{fs}:
      C.VR{deeps7(h, fs)}
    case _:
      v

def deep_r(+r: C.Res) -> C.GV:
  deep8(heap_of(r), recv_of(r))

# the consumer's terms (I88's vocabulary)
def derive_ok(x: M.HAct, p: List<&2, Nat>, cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, dt: List<&2, Nat> -> C.DtAns, ctx: Maybe<&2, List<&2, Nat>>, fuel: Nat) -> Bool:
  res_ok(rm(x, p, cb, pl, dt_m(dt), ctx, fuel))

def txs_data(x: M.HAct, p: List<&2, Nat>, cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, ctx: Maybe<&2, List<&2, Nat>>, fuel: Nat) -> List<&2, Nat>:
  cap_of(rm(x, p, cb, pl, dt_cap, ctx, fuel))

def derived_lastBlockNumber(x: M.HAct, p: List<&2, Nat>, cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, dt: List<&2, Nat> -> C.DtAns, ctx: Maybe<&2, List<&2, Nat>>, fuel: Nat) -> Nat:
  gv_nat(fld(recv_of(rm(x, p, cb, pl, dt_m(dt), ctx, fuel)), 8n))

def derived_sum_l1MsgNum(x: M.HAct, p: List<&2, Nat>, cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, dt: List<&2, Nat> -> C.DtAns, ctx: Maybe<&2, List<&2, Nat>>, fuel: Nat) -> Nat:
  sum_of(blocks_r(rm(x, p, cb, pl, dt_m(dt), ctx, fuel)), 5n)

def derived_blocks(x: M.HAct, p: List<&2, Nat>, cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, dt: List<&2, Nat> -> C.DtAns, ctx: Maybe<&2, List<&2, Nat>>, fuel: Nat) -> List<&2, Nat>:
  nums(blocks_r(rm(x, p, cb, pl, dt_m(dt), ctx, fuel)), 0n)

def derived_batch(x: M.HAct, p: List<&2, Nat>, cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, dt: List<&2, Nat> -> C.DtAns, ctx: Maybe<&2, List<&2, Nat>>, fuel: Nat) -> C.GV:
  deep_r(rm(x, p, cb, pl, dt_m(dt), ctx, fuel))

# trailing calls each closure twice (the decoder's answer, the run): it takes two copies of each
def trailing(+x: M.HAct, +p: List<&2, Nat>, cb: List<&2, Nat> -> List<&2, C.GV>, cb2: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, pl2: List<&2, C.GV> -> C.PlAns, dt: List<&2, Nat> -> C.DtAns, dt2: List<&2, Nat> -> C.DtAns, +ctx: Maybe<&2, List<&2, Nat>>, +fuel: Nat) -> Nat:
  Nat.sub(ans_len(dt(txs_data(x, p, cb, pl, ctx, fuel))), dq_sum(blocks_r(rm(x, p, cb2, pl2, dt_m(dt2), ctx, fuel))))

# circ applied to the step's statement: the committed header and the blobs cb(p)
def circuit_accepts(circ: Stmt -> Bool, +s: M.GSt, +x: M.HAct, p: List<&2, Nat>, cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, dt: List<&2, Nat> -> C.DtAns, +kh: List<&2, M.HKB>) -> Bool:
  circ(Stmt{committed_header(s, x, kh), cb(p)})

# ---------------------------------------------------------------- the hypotheses (I88's frozen statements, as types)
# HypB (HypB)
def HypB(cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns) -> Type:
  @q:List<&2, Nat> -> {pl(cb(q)) == ok_payload(q) : C.PlAns}

# HypC_binds_trailing (HypC)
def HypC_binds_trailing(circ: Stmt -> Bool, cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, vh: C.GV -> M.W, et: List<&2, Nat> -> List<&2, Nat>, dt: List<&2, Nat> -> C.DtAns) -> Type:
  @kh:List<&2, M.HKB> -> @s:M.GSt -> @r_s:M.Reach<kh, s> -> @x:M.HAct -> @p:List<&2, Nat> -> @ts:List<&2, Nat> -> {is_commitBatch(x) == True{} : Bool} -> {last_ok(s, x, kh) == True{} : Bool} -> blobs_match(x, p, cb, vh) -> {txs_data(x, p, cb, pl, None{}, fuel0()) == et(ts) : List<&2, Nat>} -> {derive_ok(x, p, cb, pl, dt, None{}, fuel0()) == True{} : Bool} -> {circuit_accepts(circ, s, x, p, cb, pl, dt, kh) == True{} : Bool} -> {trailing(x, p, cb, cb, pl, pl, dt, dt, None{}, fuel0()) == 0n : Nat}

# HypC_ignores_trailing (HypC)
def HypC_ignores_trailing(circ: Stmt -> Bool, cb: List<&2, Nat> -> List<&2, C.GV>, pl: List<&2, C.GV> -> C.PlAns, vh: C.GV -> M.W, et: List<&2, Nat> -> List<&2, Nat>, dt: List<&2, Nat> -> C.DtAns) -> Type:
  @kh:List<&2, M.HKB> -> @s:M.GSt -> @r_s:M.Reach<kh, s> -> @x:M.HAct -> @p:List<&2, Nat> -> @ts:List<&2, Nat> -> @p2:List<&2, Nat> -> @ts2:List<&2, Nat> -> {is_commitBatch(x) == True{} : Bool} -> {last_ok(s, x, kh) == True{} : Bool} -> blobs_match(x, p, cb, vh) -> {txs_data(x, p, cb, pl, None{}, fuel0()) == et(ts) : List<&2, Nat>} -> {derive_ok(x, p, cb, pl, dt, None{}, fuel0()) == True{} : Bool} -> {is_commitBatch(x) == True{} : Bool} -> {last_ok(s, x, kh) == True{} : Bool} -> blobs_match(x, p2, cb, vh) -> {txs_data(x, p2, cb, pl, None{}, fuel0()) == et(ts2) : List<&2, Nat>} -> {derive_ok(x, p2, cb, pl, dt, None{}, fuel0()) == True{} : Bool} -> {derived_batch(x, p, cb, pl, dt, None{}, fuel0()) == derived_batch(x, p2, cb, pl, dt, None{}, fuel0()) : C.GV} -> {circuit_accepts(circ, s, x, p, cb, pl, dt, kh) == circuit_accepts(circ, s, x, p2, cb, pl, dt, kh) : Bool}

# HypT (HypT)
def HypT(et: List<&2, Nat> -> List<&2, Nat>, dt: List<&2, Nat> -> C.DtAns) -> Type:
  @u:List<&2, Nat> -> {dt(et(u)) == ok_txs(u) : C.DtAns}
