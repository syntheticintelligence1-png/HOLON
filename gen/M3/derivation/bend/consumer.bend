      +n = arr_len(vget(p, hget(h, c)))
      ix_k(neg, fits(i, n), h, c, p, 0, i, n, ti, tn)
    case VNil{}:
      ix_k(neg, False{}, h, 0n, Nil{}, 0, i, 0, ti, tn)
    case _:
      EPan{h, nil_panic()}

# IndexAddr: x a slice or a pointer to an array; sg: the index's type is signed; ti, tn: type ids of the texts
