  iaddr_k(x, Bool.and(sg, i_neg(i)), h, i, ti, tn)

# ---------------------------------------------------------------- slicing (Go 1.24's checks and texts)
type SB is Data:
  SB{c: Nat, p: List<&2, Nat>, o: U32, n: U32, k: U32, nil: Bool, cap_word: Bool}

def sb_of(+h: List<&2, GV>, +x: GV) -> SB:
  match x:
