      SB{c, p, 0, n, n, False{}, False{}}
    case VStr{bs}:
      SB{0n, Nil{}, 0, blen(bs), blen(bs), False{}, False{}}
    case _:
      SB{0n, Nil{}, 0, 0, 0, True{}, True{}}

def sl_mk(+x: GV, +b: SB, +i: U32, +j: U32, +k: U32) -> GV:
