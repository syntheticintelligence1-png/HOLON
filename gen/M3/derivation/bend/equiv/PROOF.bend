def w_eq_complete(a: M.W, b: M.W) -> {a == b : M.W} -> {M.w_eq(a, b) == True{} : Bool}:
  +e =>
    %e : {M.w_eq(a, _) == True{} : Bool}
    Equal.sym(Bool, True{}, M.w_eq(a, a), w_refl(a))

# ---------------------------------------------------------------- the two lists
# I88's Bool gives the proposition
def bm_to(hs: List<&2, M.W>, vh: C.GV -> M.W, bl: List<&2, C.GV>, gs: List<&2, M.W>, im: P.imgs(vh, bl, gs), +e: {P.bm_bool(hs, gs) == True{} : Bool}) -> P.bm_rel(hs, vh, bl):
  match hs bl gs:
    case Nil{} Nil{} Nil{}:
      Unit{}
    case Nil{} Nil{} Con{g, u}:
      Empty.absurd(Unit, im)
    case Nil{} Con{b, t} Nil{}:
      Empty.absurd({M.w0() == vh(b) : M.W} & P.bm_rel(Nil{}, vh, t), im)
    case Nil{} Con{+b, +t} Con{+g, +u}:
      match im:
        case (gi, ir):
          (Equal.trans(M.W, M.w0(), g, vh(b), w_eq_sound(M.w0(), g, and_l(M.w_eq(M.w0(), g), P.bm_bool(Nil{}, u), e)), gi), bm_to(Nil{}, vh, t, u, ir, and_r(M.w_eq(M.w0(), g), P.bm_bool(Nil{}, u), e)))
    case Con{+h, +r} Nil{} Nil{}:
      (w_eq_sound(h, M.w0(), and_l(M.w_eq(h, M.w0()), P.bm_bool(r, Nil{}), e)), bm_to(r, vh, Nil{}, Nil{}, im, and_r(M.w_eq(h, M.w0()), P.bm_bool(r, Nil{}), e)))
    case Con{h, r} Nil{} Con{g, u}:
      Empty.absurd({h == M.w0() : M.W} & P.bm_rel(r, vh, Nil{}), im)
    case Con{h, r} Con{b, t} Nil{}:
      Empty.absurd({h == vh(b) : M.W} & P.bm_rel(r, vh, t), im)
    case Con{+h, +r} Con{+b, +t} Con{+g, +u}:
      match im:
        case (gi, ir):
          (Equal.trans(M.W, h, g, vh(b), w_eq_sound(h, g, and_l(M.w_eq(h, g), P.bm_bool(r, u), e)), gi), bm_to(r, vh, t, u, ir, and_r(M.w_eq(h, g), P.bm_bool(r, u), e)))

# the proposition gives I88's Bool
def bm_from(hs: List<&2, M.W>, vh: C.GV -> M.W, bl: List<&2, C.GV>, gs: List<&2, M.W>, im: P.imgs(vh, bl, gs), q: P.bm_rel(hs, vh, bl)) -> {P.bm_bool(hs, gs) == True{} : Bool}:
  match hs bl gs:
    case Nil{} Nil{} Nil{}:
      {==}
    case Nil{} Nil{} Con{g, u}:
      Empty.absurd({P.bm_bool(Nil{}, Con{g, u}) == True{} : Bool}, im)
    case Nil{} Con{b, t} Nil{}:
      Empty.absurd({True{} == True{} : Bool}, im)
    case Nil{} Con{+b, +t} Con{+g, +u}:
      match im:
        case (gi, ir):
          match q:
            case (q0, qr):
              and_i(M.w_eq(M.w0(), g), P.bm_bool(Nil{}, u), w_eq_complete(M.w0(), g, Equal.trans(M.W, M.w0(), vh(b), g, q0, Equal.sym(M.W, g, vh(b), gi))), bm_from(Nil{}, vh, t, u, ir, qr))
    case Con{+h, +r} Nil{} Nil{}:
      match q:
        case (q0, qr):
          and_i(M.w_eq(h, M.w0()), P.bm_bool(r, Nil{}), w_eq_complete(h, M.w0(), q0), bm_from(r, vh, Nil{}, Nil{}, im, qr))
    case Con{h, r} Nil{} Con{g, u}:
      Empty.absurd({P.bm_bool(Con{h, r}, Con{g, u}) == True{} : Bool}, im)
    case Con{h, r} Con{b, t} Nil{}:
      Empty.absurd({P.bm_bool(Con{h, r}, Nil{}) == True{} : Bool}, im)
    case Con{+h, +r} Con{+b, +t} Con{+g, +u}:
      match im:
        case (gi, ir):
          match q:
            case (q0, qr):
              and_i(M.w_eq(h, g), P.bm_bool(r, u), w_eq_complete(h, g, Equal.trans(M.W, h, vh(b), g, q0, Equal.sym(M.W, g, vh(b), gi))), bm_from(r, vh, t, u, ir, qr))

# the image list is unique
def imgs_unique(vh: C.GV -> M.W, bl: List<&2, C.GV>, g1: List<&2, M.W>, g2: List<&2, M.W>, i1: P.imgs(vh, bl, g1), i2: P.imgs(vh, bl, g2)) -> {g1 == g2 : List<&2, M.W>}:
  match bl g1 g2:
    case Nil{} Nil{} Nil{}:
      {==}
    case Nil{} Con{a, s} g2:
      Empty.absurd({Con{a, s} == g2 : List<&2, M.W>}, i1)
    case Nil{} Nil{} Con{a, s}:
      Empty.absurd({Nil{} == Con{a, s} : List<&2, M.W>}, i2)
    case Con{b, t} Nil{} g2:
      Empty.absurd({Nil{} == g2 : List<&2, M.W>}, i1)
    case Con{b, t} Con{a, s} Nil{}:
      Empty.absurd({Con{a, s} == Nil{} : List<&2, M.W>}, i2)
    case Con{+b, +t} Con{+a, +s} Con{+c, +w}:
      match i1:
        case (e1, r1):
          match i2:
            case (e2, r2):
              %Equal.trans(M.W, a, vh(b), c, e1, Equal.sym(M.W, c, vh(b), e2)) : {Con{a, s} == Con{_, w} : List<&2, M.W>}
              %imgs_unique(vh, t, s, w, r1, r2) : {Con{a, s} == Con{a, _} : List<&2, M.W>}
              {==}

# ---------------------------------------------------------------- the laws
def Laws.blobs_match_of_bool(x, p, cb, vh, gs, im, e):
  bm_to(P.blobhashes(x), vh, cb(p), gs, im, it_eq(P.blobs_match_b(x, gs), e))

def Laws.bool_of_blobs_match(x, p, cb, vh, gs, im, r):
  eq_it(P.blobs_match_b(x, gs), bm_from(P.blobhashes(x), vh, cb(p), gs, im, r))

def Laws.imgs_unique(vh, bl, g1, g2, i1, i2):
  imgs_unique(vh, bl, g1, g2, i1, i2)
