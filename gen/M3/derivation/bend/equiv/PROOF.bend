# ---------------------------------------------------------------- Bool, Cmp
def sel(b: Bool, A: Type) -> Type:
  match b:
    case True{}:
      A
    case False{}:
      Unit

def efq(-A: Type, e: {False{} == True{} : Bool}) -> A:
  %e : sel(_, A)
  Unit{}

def csel(c: Cmp, A: Type) -> Type:
  match c:
    case EQ{}:
      A
    case LT{}:
      Unit
    case GT{}:
      Unit

def efq_lt(-A: Type, e: {LT{} == EQ{} : Cmp}) -> A:
  %e : csel(_, A)
  Unit{}

def efq_gt(-A: Type, e: {GT{} == EQ{} : Cmp}) -> A:
  %e : csel(_, A)
  Unit{}

def and_l(a: Bool, b: Bool) -> {Bool.and(a, b) == True{} : Bool} -> {a == True{} : Bool}:
  match a:
    case True{}:
      e => {==}
    case False{}:
      e => efq({False{} == True{} : Bool}, e)

def and_r(a: Bool, b: Bool) -> {Bool.and(a, b) == True{} : Bool} -> {b == True{} : Bool}:
  match a:
    case True{}:
      e => e
    case False{}:
      e => efq({b == True{} : Bool}, e)

def and_i(a: Bool, b: Bool) -> {a == True{} : Bool} -> {b == True{} : Bool} -> {Bool.and(a, b) == True{} : Bool}:
  match a:
    case True{}:
      ea => eb => eb
    case False{}:
      ea => eb => efq({Bool.and(False{}, b) == True{} : Bool}, ea)

def it_eq(b: Bool) -> P.is_true(b) -> {b == True{} : Bool}:
  match b:
    case True{}:
      u => {==}
    case False{}:
      u => Empty.absurd({False{} == True{} : Bool}, u)

def eq_it(b: Bool) -> {b == True{} : Bool} -> P.is_true(b):
  match b:
    case True{}:
      e => Unit{}
    case False{}:
      e => efq(Empty, e)

# ---------------------------------------------------------------- Bool.cmp, Word.cmp and U32.is_eq decide equality
def bc_eq(a: Bool, b: Bool) -> {Bool.cmp(a, b) == EQ{} : Cmp} -> {a == b : Bool}:
  match a b:
    case True{} True{}:
      e => {==}
    case False{} False{}:
      e => {==}
    case True{} False{}:
      e => efq_gt({True{} == False{} : Bool}, e)
    case False{} True{}:
      e => efq_lt({False{} == True{} : Bool}, e)

def wc_eq_k(p: Nat, ah: Bool, at: Word(p), bh: Bool, bt: Word(p), c: Cmp) -> {Word.cmp(p, at, bt) == c : Cmp} -> {Word.cmp.fin(ah, bh, c) == EQ{} : Cmp} -> ({Word.cmp(p, at, bt) == EQ{} : Cmp} -> {at == bt : Word(p)}) -> {WCon{ah, at} == WCon{bh, bt} : Word(1n+p)}:
  match c:
    case LT{}:
      ec => e => ih => efq_lt({WCon{ah, at} == WCon{bh, bt} : Word(1n+p)}, e)
    case GT{}:
      ec => e => ih => efq_gt({WCon{ah, at} == WCon{bh, bt} : Word(1n+p)}, e)
    case EQ{}:
      ec => e => ih =>
        %bc_eq(ah, bh, e) : {WCon{ah, at} == WCon{_, bt} : Word(1n+p)}
        %ih(ec) : {WCon{ah, at} == WCon{ah, _} : Word(1n+p)}
        {==}

def wc_eq(n: Nat, a: Word(n), b: Word(n)) -> {Word.cmp(n, a, b) == EQ{} : Cmp} -> {a == b : Word(n)}:
  match n:
    case 0n:
      match a b:
        case WNil{} WNil{}:
          e => {==}
    case 1n+(+p):
      match a b:
        case WCon{+ah, +at} WCon{+bh, +bt}:
          e => wc_eq_k(p, ah, at, bh, bt, Word.cmp(p, at, bt), {==}, e, q => wc_eq(p, at, bt, q))

def wc_refl(n: Nat, a: Word(n)) -> {EQ{} == Word.cmp(n, a, a) : Cmp}:
  match n:
    case 0n:
      {==}
    case 1n+p:
      match a:
        case WCon{h, t}:
          match h:
            case True{}:
              %wc_refl(p, t) : {EQ{} == Word.cmp.fin(True{}, True{}, _) : Cmp}
              {==}
            case False{}:
              %wc_refl(p, t) : {EQ{} == Word.cmp.fin(False{}, False{}, _) : Cmp}
              {==}

def ceq(c: Cmp) -> {Cmp.is_eq(c) == True{} : Bool} -> {c == EQ{} : Cmp}:
  match c:
    case EQ{}:
      e => {==}
    case LT{}:
      e => efq({LT{} == EQ{} : Cmp}, e)
    case GT{}:
      e => efq({GT{} == EQ{} : Cmp}, e)

def u_eq(a: U32, b: U32) -> {U32.is_eq(a, b) == True{} : Bool} -> {a == b : U32}:
  match a b:
    case U32{+x} U32{+y}:
      e =>
        %wc_eq(32n, x, y, ceq(Word.cmp(32n, x, y), e)) : {U32{x} == U32{_} : U32}
        {==}

def u_refl(a: U32) -> {True{} == U32.is_eq(a, a) : Bool}:
  match a:
    case U32{+x}:
      %wc_refl(32n, x) : {True{} == Cmp.is_eq(_) : Bool}
      {==}

