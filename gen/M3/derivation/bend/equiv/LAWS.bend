# the rendered premise gives I88's Bool, on that image list
law bool_of_blobs_match:
  for +x: M.HAct
  for p: List<&2, Nat>
  for cb: List<&2, Nat> -> List<&2, C.GV>
  for vh: C.GV -> M.W
  for +gs: List<&2, M.W>
