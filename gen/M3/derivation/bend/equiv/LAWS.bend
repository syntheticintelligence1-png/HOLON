  for r: P.blobs_match(x, p, cb, vh)
  P.is_true(P.blobs_match_b(x, gs))

# the image list of vh over the blobs is unique
law imgs_unique:
  for vh: C.GV -> M.W
  for bl: List<&2, C.GV>
  for g1: List<&2, M.W>
  for g2: List<&2, M.W>
  for i1: P.imgs(vh, bl, g1)
  for i2: P.imgs(vh, bl, g2)
  {g1 == g2 : List<&2, M.W>}
