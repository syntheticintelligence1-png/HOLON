def ni_step_gen(s1: M.HSt, s2: M.HSt, e: {Laws.proj_V_s_csr(s1) == Laws.proj_V_s_csr(s2) : Laws.V_s_csr}, +a: M.HAct) -> {Laws.proj_V_s_csr(M.step(a, s1)) == Laws.proj_V_s_csr(M.step(a, s2)) : Laws.V_s_csr}:
  match s1 s2:
    case M.HSt{t_a, lfi_a, inch_a, bc_a, rri_a, paused_a, W_a, F_a, D_a, qlen_a, qpend_a, enq_a, active_a, chals_a, fsr_a, chs_a, win_a, s_csr_a, s_bd_a, s_bvh_a, s_tag_a, log_a} M.HSt{t_b, lfi_b, inch_b, bc_b, rri_b, paused_b, W_b, F_b, D_b, qlen_b, qpend_b, enq_b, active_b, chals_b, fsr_b, chs_b, win_b, s_csr_b, s_bd_b, s_bvh_b, s_tag_b, log_b}:
      %e : {Laws.proj_V_s_csr(M.step(a, M.HSt{t_a, lfi_a, inch_a, bc_a, rri_a, paused_a, W_a, F_a, D_a, qlen_a, qpend_a, enq_a, active_a, chals_a, fsr_a, chs_a, win_a, s_csr_a, s_bd_a, s_bvh_a, s_tag_a, log_a})) == Laws.proj_V_s_csr(M.step(a, ni_rebuild(_, s_csr_b))) : Laws.V_s_csr}
      ni_step(t_a, lfi_a, inch_a, bc_a, rri_a, paused_a, W_a, F_a, D_a, qlen_a, qpend_a, enq_a, active_a, chals_a, fsr_a, chs_a, win_a, s_bd_a, s_bvh_a, s_tag_a, log_a, s_csr_a, s_csr_b, a)

def Laws.l_undo_csr(tr, s1, s2, h0):
  match tr:
    case Nil{}:
      h0
    case Con{+a, rest}:
      Laws.l_undo_csr(rest, M.step(a, s1), M.step(a, s2), ni_step_gen(s1, s2, h0, a))
