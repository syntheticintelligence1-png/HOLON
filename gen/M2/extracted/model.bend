type HEnv is Data:
  HEnv{e_msg_value: Nat, e_msg_data_length: Nat, e_caller: Nat, e_block_timestamp: Nat, blobs: List<&2, Nat>, c0: List<&2, HKL>, c1: List<&2, HKL>, c2: List<&2, HKL>, c3: List<&2, HKL>, c4: List<&2, HKL>, kec: List<&2, HKB>, sha: List<&2, HKB>, unk: List<&2, HKV>}

# env c0: the answers of ISubmitter.challengeDeposit (argument list -> [ok, results..])
# env c1: the answers of ISubmitter.isActive (argument list -> [ok, results..])
# env c2: the answers of IL1MessageQueue.getFirstUnfinalizedMessageEnqueueTime (argument list -> [ok, results..])
# env c3: the answers of IRollupVerifier.verifyAggregateProof (argument list -> [ok, results..])
# env c4: the answers of ISubmitter.slash (argument list -> [ok, results..])
def ge_e_msg_value(e: HEnv) -> Nat:
  match e:
    case HEnv{+e_msg_value, e_msg_data_length, e_caller, e_block_timestamp, blobs, c0, c1, c2, c3, c4, kec, sha, unk}:
      e_msg_value

def ge_e_msg_data_length(e: HEnv) -> Nat:
  match e:
    case HEnv{e_msg_value, +e_msg_data_length, e_caller, e_block_timestamp, blobs, c0, c1, c2, c3, c4, kec, sha, unk}:
      e_msg_data_length

def ge_e_caller(e: HEnv) -> Nat:
  match e:
    case HEnv{e_msg_value, e_msg_data_length, +e_caller, e_block_timestamp, blobs, c0, c1, c2, c3, c4, kec, sha, unk}:
      e_caller

def ge_e_block_timestamp(e: HEnv) -> Nat:
  match e:
    case HEnv{e_msg_value, e_msg_data_length, e_caller, +e_block_timestamp, blobs, c0, c1, c2, c3, c4, kec, sha, unk}:
      e_block_timestamp

def ge_blobs(e: HEnv) -> List<&2, Nat>:
  match e:
    case HEnv{e_msg_value, e_msg_data_length, e_caller, e_block_timestamp, +blobs, c0, c1, c2, c3, c4, kec, sha, unk}:
      blobs

def ge_c0(e: HEnv) -> List<&2, HKL>:
  match e:
    case HEnv{e_msg_value, e_msg_data_length, e_caller, e_block_timestamp, blobs, +c0, c1, c2, c3, c4, kec, sha, unk}:
      c0

def ge_c1(e: HEnv) -> List<&2, HKL>:
  match e:
    case HEnv{e_msg_value, e_msg_data_length, e_caller, e_block_timestamp, blobs, c0, +c1, c2, c3, c4, kec, sha, unk}:
      c1

def ge_c2(e: HEnv) -> List<&2, HKL>:
  match e:
    case HEnv{e_msg_value, e_msg_data_length, e_caller, e_block_timestamp, blobs, c0, c1, +c2, c3, c4, kec, sha, unk}:
      c2

