def cost(tr: List<&2, HAct>) -> Nat:
  match tr:
    case Nil{}:
      0n
    case Con{a, rest}:
      match a:
        case A_commitBatch{_, _, _, _, _, _, _, _}:
          Nat.add(0n, cost(rest))
        case A_commitState{_, _, _, _, _, _, _, _}:
          Nat.add(0n, cost(rest))
        case A_commitBatchWithProof{_, _, _, _, _, _, _, _, _}:
          Nat.add(1000n, cost(rest))
        case A_revertBatch{_, _, _}:
          Nat.add(0n, cost(rest))
        case A_challengeState{_, _, _}:
          Nat.add(0n, cost(rest))
        case A_proveState{_, _, _}:
          Nat.add(0n, cost(rest))
        case A_finalizeBatch{_, _}:
          Nat.add(0n, cost(rest))
        case A_setPause{_, _}:
          Nat.add(0n, cost(rest))
        case A_sendMessage{_}:
          Nat.add(1n, cost(rest))
        case A_wait{_}:
          Nat.add(0n, cost(rest))

def elapsed(tr: List<&2, HAct>) -> Nat:
  match tr:
    case Nil{}:
      0n
    case Con{a, rest}:
      match a:
        case A_commitBatch{_, _, _, _, _, _, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_commitState{_, _, _, _, _, _, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_commitBatchWithProof{_, _, _, _, _, _, _, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_revertBatch{_, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_challengeState{_, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_proveState{_, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_finalizeBatch{_, _}:
          Nat.add(0n, elapsed(rest))
        case A_setPause{_, _}:
          Nat.add(0n, elapsed(rest))
        case A_sendMessage{_}:
          Nat.add(0n, elapsed(rest))
        case A_wait{dt}:
          Nat.add(dt, elapsed(rest))

# the blob sidecar a commit transaction delivers to L2 derivation (the consumer of FACT)
def blobs_of(a: HAct) -> List<&2, Nat>:
  match a:
    case A_commitBatch{_, _, _, _, _, _, _, blobs}:
      blobs
    case A_commitState{_, _, _, _, _, _, _, blobs}:
      blobs
    case A_commitBatchWithProof{_, _, _, _, _, _, _, blobs, _}:
      blobs
    case A_revertBatch{_, _, _}:
      Nil{}
    case A_challengeState{_, _, _}:
      Nil{}
    case A_proveState{_, _, _}:
      Nil{}
    case A_finalizeBatch{_, _}:
      Nil{}
    case A_setPause{_, _}:
      Nil{}
    case A_sendMessage{_}:
      Nil{}
    case A_wait{_}:
      Nil{}

# actions of a permissionless principal class (no permission guard on the caller; holon.diagram.principals): the class X of DISCH
def perm(a: HAct) -> Bool:
  match a:
    case A_commitBatch{_, _, _, _, _, _, _, _}:
      False{}
    case A_commitState{_, _, _, _, _, _, _, _}:
      False{}
    case A_commitBatchWithProof{_, _, _, _, _, _, _, _, _}:
      True{}
    case A_revertBatch{_, _, _}:
      False{}
    case A_challengeState{_, _, _}:
      False{}
    case A_proveState{_, _, _}:
      False{}
    case A_finalizeBatch{_, _}:
      True{}
    case A_setPause{_, _}:
      False{}
    case A_sendMessage{_}:
      True{}
    case A_wait{_}:
      True{}

# principal class active_submitter (active submitter): permission predicate mem(who,active)
def perm_active_submitter(a: HAct, who_: Nat) -> Bool:
  match a:
    case A_commitBatch{who, _, _, _, _, _, _, _}:
      Nat.is_eq(who, who_)
    case A_commitState{who, _, _, _, _, _, _, _}:
      Nat.is_eq(who, who_)
    case A_commitBatchWithProof{_, _, _, _, _, _, _, _, _}:
      False{}
    case A_revertBatch{_, _, _}:
      False{}
    case A_challengeState{_, _, _}:
      False{}
    case A_proveState{who, _, _}:
      Nat.is_eq(who, who_)
    case A_finalizeBatch{_, _}:
      False{}
    case A_setPause{_, _}:
      False{}
    case A_sendMessage{_}:
      False{}
    case A_wait{_}:
      False{}

# principal class anyone (anyone, anyone (through the messenger; fee abstracted as one message cost)): permission predicate none
def perm_anyone(a: HAct, who_: Nat) -> Bool:
  match a:
    case A_commitBatch{_, _, _, _, _, _, _, _}:
      False{}
    case A_commitState{_, _, _, _, _, _, _, _}:
      False{}
    case A_commitBatchWithProof{who, _, _, _, _, _, _, _, _}:
      Nat.is_eq(who, who_)
    case A_revertBatch{_, _, _}:
      False{}
    case A_challengeState{_, _, _}:
      False{}
    case A_proveState{_, _, _}:
      False{}
    case A_finalizeBatch{who, _}:
      Nat.is_eq(who, who_)
    case A_setPause{_, _}:
      False{}
    case A_sendMessage{who}:
      Nat.is_eq(who, who_)
    case A_wait{_}:
      False{}

# principal class challenger (challenger): permission predicate mem(who,chals)
def perm_challenger(a: HAct, who_: Nat) -> Bool:
  match a:
    case A_commitBatch{_, _, _, _, _, _, _, _}:
      False{}
    case A_commitState{_, _, _, _, _, _, _, _}:
      False{}
    case A_commitBatchWithProof{_, _, _, _, _, _, _, _, _}:
      False{}
    case A_revertBatch{_, _, _}:
      False{}
    case A_challengeState{who, _, _}:
      Nat.is_eq(who, who_)
    case A_proveState{_, _, _}:
      False{}
    case A_finalizeBatch{_, _}:
      False{}
    case A_setPause{_, _}:
      False{}
    case A_sendMessage{_}:
      False{}
    case A_wait{_}:
      False{}

# principal class environment (environment): permission predicate none
def perm_environment(a: HAct, who_: Nat) -> Bool:
  match a:
    case A_commitBatch{_, _, _, _, _, _, _, _}:
      False{}
    case A_commitState{_, _, _, _, _, _, _, _}:
      False{}
    case A_commitBatchWithProof{_, _, _, _, _, _, _, _, _}:
      False{}
    case A_revertBatch{_, _, _}:
      False{}
    case A_challengeState{_, _, _}:
      False{}
    case A_proveState{_, _, _}:
