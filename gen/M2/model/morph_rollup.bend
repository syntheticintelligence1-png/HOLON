# principal class owner (owner): permission predicate who==OWNER
def perm_owner(a: HAct, who_: Nat) -> Bool:
  match a:
    case A_commitBatch{_, _, _, _, _, _, _, _}:
      False{}
    case A_commitState{_, _, _, _, _, _, _, _}:
      False{}
    case A_commitBatchWithProof{_, _, _, _, _, _, _, _, _}:
      False{}
    case A_revertBatch{who, _, _}:
      Nat.is_eq(who, who_)
    case A_challengeState{_, _, _}:
      False{}
    case A_proveState{_, _, _}:
      False{}
    case A_finalizeBatch{_, _}:
      False{}
    case A_setPause{who, _}:
      Nat.is_eq(who, who_)
    case A_sendMessage{_}:
      False{}
    case A_wait{_}:
      False{}

# LCI of a state
def lci_of(s: HSt) -> Nat:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      d_lci(lfi, win)

# 
def csr_last(s: HSt) -> Nat:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      g_Entry_csr(last_d(HEntry, win, empty_entry()))

# DISCH guard kappa: an open challenge whose proof window has passed (the realize site at :363 underflows)
def kappa(s: HSt) -> Bool:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      Bool.and(inch, Nat.is_lt(Nat.add(W, g_Ch_s(nth_d(HCh, chs, bc, empty_ch()))), t))

# Prop 6.19 ghost-tag exactness: every committed header's blob field has the sort its version implies (v2 <=> aggregate)
def tags_ok(s: HSt) -> Bool:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      b_tags_exact(win)

# header of the newest batch (committedBatches[LCI] = keccak256 of it, under CF)
def new_hdr(s: HSt) -> List<&2, Nat>:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      b_hdr_of(last_d(HEntry, win, empty_entry()))

# migration: state as written by Rollup before reinitializer(2): committedStateRoots did not exist (all zero)
def mig_legacy(s: HSt) -> HSt:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      HSt{t, lfi, inch, bc, rri, paused, W, F, D, qlen, qpend, enq, active, chals, fsr, chs, b_zero_csr(win), b_zeros_like(s_csr), s_bd, s_bvh, s_tag, log}

# migration: initialize2(_prevStateRoot): writes committedStateRoots[LCI] only if it is zero
def mig_eta2(s: HSt, +root: Nat) -> HSt:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      HSt{t, lfi, inch, bc, rri, paused, W, F, D, qlen, qpend, enq, active, chals, fsr, chs, ite(List<&2, HEntry>, Nat.is_eq(g_Entry_csr(last_d(HEntry, win, empty_entry())), 0n), b_set_last_csr(win, root), win), s_csr, s_bd, s_bvh, s_tag, log}

# initial state: after initialize(...) and importGenesisBatch at t = 10 (Rollup.sol:226-252)
def s0() -> HSt:
