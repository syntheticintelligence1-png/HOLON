def decide_wait(+dt: Nat) -> Dec_wait:
  D_wait_Ok{}

def exec_wait(d: Dec_wait, +t: Nat, +lfi: Nat, +inch: Bool, +bc: Nat, +rri: Nat, +paused: Bool, +W: Nat, +F: Nat, +D: Nat, +qlen: Nat, +qpend: Nat, +enq: List<&2, Nat>, +active: List<&2, Nat>, +chals: List<&2, Nat>, +fsr: List<&2, Nat>, +chs: List<&2, HCh>, +win: List<&2, HEntry>, +s_csr: List<&2, Nat>, +s_bd: List<&2, HBD>, +s_bvh: List<&2, Nat>, +s_tag: List<&2, Nat>, +log: List<&2, HObs>, +dt: Nat) -> HSt:
  match d:
    case D_wait_Rev{code}:
      HSt{t, lfi, inch, bc, rri, paused, W, F, D, qlen, qpend, enq, active, chals, fsr, chs, win, s_csr, s_bd, s_bvh, s_tag, Con{O_Rev{code}, log}}
    case D_wait_Ok{}:
      HSt{Nat.add(t, dt), lfi, inch, bc, rri, paused, W, F, D, qlen, qpend, enq, active, chals, fsr, chs, win, s_csr, s_bd, s_bvh, s_tag, Con{O_Ok{}, log}}

def step_wait(s: HSt, +dt: Nat) -> HSt:
  match s:
    case HSt{+t, +lfi, +inch, +bc, +rri, +paused, +W, +F, +D, +qlen, +qpend, +enq, +active, +chals, +fsr, +chs, +win, +s_csr, +s_bd, +s_bvh, +s_tag, +log}:
      exec_wait(decide_wait(dt), t, lfi, inch, bc, rri, paused, W, F, D, qlen, qpend, enq, active, chals, fsr, chs, win, s_csr, s_bd, s_bvh, s_tag, log, dt)

def step(a: HAct, s: HSt, +agg: List<&2, HO_agg>) -> HSt:
  match a:
    case A_commitBatch{+who, +ver, +parent, +n, +lbn, +prev, +post, +blobs}:
      step_commitBatch(s, who, ver, parent, n, lbn, prev, post, blobs, agg)
    case A_commitState{+who, +ver, +parent, +n, +lbn, +prev, +post, +blobs}:
      step_commitState(s, who, ver, parent, n, lbn, prev, post, blobs)
    case A_commitBatchWithProof{+who, +ver, +parent, +n, +lbn, +prev, +post, +blobs, +proof}:
      step_commitBatchWithProof(s, who, ver, parent, n, lbn, prev, post, blobs, proof, agg)
    case A_revertBatch{+who, +idx, +count}:
      step_revertBatch(s, who, idx, count)
    case A_challengeState{+who, +idx, +value}:
      step_challengeState(s, who, idx, value)
    case A_proveState{+who, +idx, +proof}:
      step_proveState(s, who, idx, proof)
    case A_finalizeBatch{+who, +idx}:
      step_finalizeBatch(s, who, idx)
    case A_setPause{+who, +status}:
      step_setPause(s, who, status)
    case A_sendMessage{+who}:
      step_sendMessage(s, who)
    case A_wait{+dt}:
      step_wait(s, dt)

def run(tr: List<&2, HAct>, s: HSt, +agg: List<&2, HO_agg>) -> HSt:
  match tr:
    case Nil{}:
      s
    case Con{a, rest}:
      run(rest, step(a, s, agg), agg)

def clear_log(s: HSt) -> HSt:
  match s:
    case HSt{t, lfi, inch, bc, rri, paused, W, F, D, qlen, qpend, enq, active, chals, fsr, chs, win, s_csr, s_bd, s_bvh, s_tag, log}:
      HSt{t, lfi, inch, bc, rri, paused, W, F, D, qlen, qpend, enq, active, chals, fsr, chs, win, s_csr, s_bd, s_bvh, s_tag, Nil{}}

def log_of(s: HSt) -> List<&2, HObs>:
  match s:
    case HSt{t, lfi, inch, bc, rri, paused, W, F, D, qlen, qpend, enq, active, chals, fsr, chs, win, s_csr, s_bd, s_bvh, s_tag, log}:
      log

# observations of tr from s: the log tr produces (newest first)
def obs(tr: List<&2, HAct>, s: HSt, +agg: List<&2, HO_agg>) -> List<&2, HObs>:
  log_of(run(tr, clear_log(s), agg))

def ok_head(l: List<&2, HObs>) -> Bool:
  match l:
    case Nil{}:
      False{}
    case Con{o, t}:
      match o:
        case O_Ok{}:
          True{}
        case O_Rev{c}:
          False{}

# the last action applied to s succeeded
def last_ok(s: HSt) -> Bool:
  ok_head(log_of(s))

def all_ok(l: List<&2, HObs>) -> Bool:
  match l:
    case Nil{}:
      True{}
    case Con{o, t}:
      match o:
        case O_Ok{}:
          all_ok(t)
        case O_Rev{c}:
          False{}

# every action of tr succeeds from s
def runs_ok(tr: List<&2, HAct>, s: HSt, +agg: List<&2, HO_agg>) -> Bool:
  all_ok(obs(tr, s, agg))

def no_code(l: List<&2, HObs>, +k: Nat) -> Bool:
  match l:
    case Nil{}:
      True{}
    case Con{o, t}:
      match o:
        case O_Ok{}:
          no_code(t, k)
        case O_Rev{c}:
          Bool.and(Bool.not(Nat.is_eq(c, k)), no_code(t, k))

def eq_obs(a: HObs, b: HObs) -> Bool:
  match a b:
    case O_Ok{} O_Ok{}:
      True{}
    case O_Rev{x} O_Rev{y}:
      Nat.is_eq(x, y)
    case O_Ok{} O_Rev{y}:
      False{}
    case O_Rev{x} O_Ok{}:
      False{}

def eq_obs_list(xs: List<&2, HObs>, ys: List<&2, HObs>) -> Bool:
  match xs ys:
    case Nil{} Nil{}:
      True{}
    case Nil{} Con{h, t}:
      False{}
    case Con{h, t} Nil{}:
      False{}
    case Con{x, xt} Con{y, yt}:
      Bool.and(eq_obs(x, y), eq_obs_list(xt, yt))

