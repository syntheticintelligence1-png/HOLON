def tb_run(tr: List<&2, M.HAct>, +s: M.HSt, +gs: Nat, inv: tb_I(s, gs)) -> tb_I(M.run(tr, s), Nat.add(gs, Laws.gh_32a98a102eb5(tr, s))):
  match tr:
    case Nil{}:
      %Equal.sym(Nat, Nat.add(gs, 0n), gs, tb_add_zero(gs)) : tb_I(s, _)
      inv
    case Con{+b___, +rest}:
      %tb_add_assoc(gs, Laws.gh1_32a98a102eb5(b___, s), Laws.gh_32a98a102eb5(rest, M.step(b___, s))) : tb_I(M.run(rest, M.step(b___, s)), _)
      tb_run(rest, M.step(b___, s), Nat.add(gs, Laws.gh1_32a98a102eb5(b___, s)), tb_step(b___, s, gs, inv))

def tb_out(-sf: M.HSt, -gs: Nat, +k: Nat, inv: tb_I(sf, gs)) -> ({Laws.ex_5e9f2157bb8e(sf, gs, k) == True{} : Bool}) & (({Laws.ex_eca2df51acde(sf, gs) == True{} : Bool}) & ({Laws.ex_79696e7a79ff(sf) == True{} : Bool})):
  (f0, (h1, h2)) = inv
  (f0(k), (h1, h2))

def Laws.l_contract_c_o12(p, k):
  tb_out(M.run(p, M.s0()), Laws.gh_32a98a102eb5(p, M.s0()), k, tb_run(p, M.s0(), 0n, tb_base()))
