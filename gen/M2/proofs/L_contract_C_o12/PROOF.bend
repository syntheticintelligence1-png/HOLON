def tb_c23(inch: Bool, +W: Nat, +bc: Nat, +chs: List<&2, M.HCh>, +dt: Nat, +gs: Nat, +t: Nat, +h1: {Bool.or(Bool.not(inch), Nat.is_le(W, gs)) == True{} : Bool}, +h2: {Bool.or(Bool.not(inch), Nat.is_le(M.g_Ch_s(M.nth_d(M.HCh, chs, bc, M.empty_ch())), t)) == True{} : Bool}) -> {Bool.or(Bool.not(inch), Nat.is_le(M.g_Ch_s(M.nth_d(M.HCh, chs, bc, M.empty_ch())), Nat.add(t, dt))) == True{} : Bool}:
