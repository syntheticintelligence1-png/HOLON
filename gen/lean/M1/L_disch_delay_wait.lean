def step (a : HAct) (s : HSt) : HSt :=
  match a with
  | .A_commitBatch who ver parent n lbn prev post blobs => step_commitBatch s who ver parent n lbn prev post blobs
  | .A_commitState who ver parent n lbn prev post blobs => step_commitState s who ver parent n lbn prev post blobs
  | .A_commitBatchWithProof who ver parent n lbn prev post blobs proof => step_commitBatchWithProof s who ver parent n lbn prev post blobs proof
  | .A_revertBatch who idx count => step_revertBatch s who idx count
  | .A_challengeState who idx value => step_challengeState s who idx value
  | .A_proveState who idx proof => step_proveState s who idx proof
  | .A_finalizeBatch who idx => step_finalizeBatch s who idx
  | .A_setPause who status => step_setPause s who status
  | .A_sendMessage who => step_sendMessage s who
  | .A_wait dt => step_wait s dt

def run : List HAct -> HSt -> HSt
  | [], s => s
  | a :: rest, s => run rest (step a s)

def clear_log (s : HSt) : HSt := { s with log := [] }

def log_of (s : HSt) : List HObs := s.log

def obs (tr : List HAct) (s : HSt) : List HObs := log_of (run tr (clear_log s))

def ok_head : List HObs -> Bool
  | [] => false
  | .O_Ok :: _ => true
  | .O_Rev _ :: _ => false

def last_ok (s : HSt) : Bool := ok_head s.log

def all_ok : List HObs -> Bool
  | [] => true
  | .O_Ok :: t => all_ok t
  | .O_Rev _ :: _ => false

def runs_ok (tr : List HAct) (s : HSt) : Bool := all_ok (obs tr s)

def no_code : List HObs -> Nat -> Bool
  | [], _ => true
  | .O_Ok :: t, k => no_code t k
  | .O_Rev c :: t, k => Bool.not (isEq c k) && no_code t k

def eq_obs : HObs -> HObs -> Bool
  | .O_Ok, .O_Ok => true
  | .O_Rev x, .O_Rev y => isEq x y
  | _, _ => false

def eq_obs_list : List HObs -> List HObs -> Bool
  | [], [] => true
  | x :: xt, y :: yt => eq_obs x y && eq_obs_list xt yt
  | _, _ => false

