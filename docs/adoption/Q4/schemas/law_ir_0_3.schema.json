{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "HOLON law IR (holon-ir/0.3): typed state-machine laws with function binders, CF/hyp premises and scope",
 "description": "Extends holon-ir/0.2 (I7): rule_catalog_version (hashed), Fn<A,B>, Bytes(n), List<Nat> and record-ref binder types (a record type of the law's facts, checked against them by holon.ir.check_binder_types: G3 and holon run), Reach, the application term {app: f, args}, premises {cf: {fn, set: [terms]}} (a finite set; global injectivity is rejected by holon.ir.check_premises, G3), {hyp: {name}} and {neq: [a, b]}, statement.scope (bounded{H} bounds every Trace binder to H actions; at_state{ref} is Unsupported until a generator resolves the state), structured maps_to, and the negation links of an existential law and its frozen negation subform (negation, negation_of: holon.ir.negation_law). The 0.3 statement hash covers the statement and the content hashes (refs) of the definitions it depends on, transitively (holon.gen.refs), not the facts bundle. I15 adds, additively, the SORT-site term {site: ID, on: A, from: S} (holon.sorts.sites): the Bool 'every evaluation of the subtraction site ID while action A runs from state S has minuend >= subtrahend', rendered site_ok[ID](A, S); its statement ref site:ID hashes the site's spec (basis and hit points) computed from the facts and the SORT-site sidecar (holon.gen.refs). I24 adds, additively, the codec terms {call, args}, {field, of}, {bytes}, {some} (with {var} and {bool}) of laws over a holon-facts/0.1 document or a linked codec document (holon.diagram.linked), and the expr term {expr: E, from: S [, action: A, on: T] [, bind: {name: term}]} over a holon-facts/0.2 document; their refs are holon.gen.refs's (codec terms: fn:, type:, carrier:; expr: the closure of what E names). I27 adds, additively, the UNDO term {undo: ID, on: [terms]} (holon.rules.undo; rendered undo_ok[ID](args); its statement ref undo:ID) and the binder types Word and Val[<family>] (a storage family of the law's transitions document). I26 adds, additively, the FACT term {fact: ID, on: [terms]} (holon.rules.fact; rendered fact_ok[ID](args); its statement ref fact:ID).",
 "type": "object",
 "required": [
  "ir_version",
  "law_id",
  "milestone",
  "rule",
  "rule_catalog_version",
  "facts",
  "statement"
 ],
 "additionalProperties": false,
 "properties": {
  "ir_version": {
   "type": "string",
   "const": "holon-ir/0.3"
  },
  "law_id": {
   "type": "string",
   "pattern": "^L[0-9]?_[A-Za-z0-9_]+$"
  },
  "milestone": {
   "type": "string",
   "pattern": "^[MT][0-9]+$"
  },
  "rule": {
   "enum": [
    "PAR",
    "UNDO",
    "NAT",
    "SYM",
    "FACT",
    "SORT",
    "DISCH",
    "OWN",
    "INTENT"
   ]
  },
  "subform": {
   "type": "string"
  },
  "facts": {
   "type": "string",
   "pattern": "\\.json$"
  },
  "facts_sha256": {
   "type": "string",
   "pattern": "^([0-9a-f]{64})?$"
  },
  "statement": {
   "$ref": "#/$defs/statement"
  },
  "notes": {
   "type": "string"
  },
  "maps_to": {
   "oneOf": [
    {
     "type": "string"
    },
    {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "id"
      ],
      "properties": {
       "id": {
        "type": "string"
       },
       "role": {
        "type": "string"
       }
      }
     }
    }
   ]
  },
  "evidence": {
   "type": "array",
   "items": {
    "enum": [
     "E1",
     "E2",
     "E3",
     "E4",
     "E5",
     "E6"
    ]
   }
  },
  "predicted": {
   "enum": [
    "PROVED",
    "REFUTED",
    "UNKNOWN"
   ]
  },
  "rule_catalog_version": {
   "type": "string",
   "pattern": "^holon-rules/[0-9]+\\.[0-9]+$"
  },
  "negation": {
   "type": "string",
   "pattern": "^L[0-9]?_[A-Za-z0-9_]+$",
   "description": "an existential law: the id of its frozen negation subform (a law of the same milestone whose negation_of names this law)"
  },
  "negation_of": {
   "type": "string",
   "pattern": "^L[0-9]?_[A-Za-z0-9_]+$",
   "description": "a generated negation subform (holon.ir.negation_law): the id of the existential law it negates"
  }
 },
 "$defs": {
  "ident": {
   "type": "string",
   "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
  },
  "statement": {
   "type": "object",
   "required": [
    "binders",
    "claim"
   ],
   "additionalProperties": false,
   "properties": {
    "binders": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/binder"
     }
    },
    "assume": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/premise"
     }
    },
    "claim": {
     "$ref": "#/$defs/claim"
    },
    "scope": {
     "oneOf": [
      {
       "type": "object",
       "required": [
        "kind"
       ],
       "additionalProperties": false,
       "properties": {
        "kind": {
         "const": "unbounded"
        }
       }
      },
      {
       "type": "object",
       "required": [
        "kind",
        "H"
       ],
       "additionalProperties": false,
       "properties": {
        "kind": {
         "const": "bounded"
        },
        "H": {
         "type": "integer"
        }
       }
      },
      {
       "type": "object",
       "required": [
        "kind",
        "ref"
       ],
       "additionalProperties": false,
       "properties": {
        "kind": {
         "const": "at_state"
        },
        "ref": {
         "type": "string"
        }
       }
      }
     ]
    }
   }
  },
  "binder": {
   "type": "object",
   "required": [
    "q",
    "name",
    "type"
   ],
   "additionalProperties": false,
   "properties": {
    "q": {
     "enum": [
      "forall",
      "exists"
     ]
    },
    "name": {
     "$ref": "#/$defs/ident"
    },
    "type": {
     "oneOf": [
      {
       "enum": [
        "State",
        "Trace",
        "Act",
        "Nat",
        "Bool",
        "Reach",
        "List<Nat>"
       ]
      },
      {
       "type": "string",
       "pattern": "^(Fn<[A-Za-z0-9<>,()]+>|Bytes\\([0-9]+\\))$"
      },
      {
       "type": "string",
       "pattern": "^(?!(State|Trace|Act|Nat|Bool|Reach|Word)$)[A-Z][A-Za-z0-9_]*$",
       "description": "a record ref: a record type the law's facts declare (holon.ir.check_binder_types)"
      },
      {
       "type": "string",
       "pattern": "^(Word|Val\\[[A-Za-z_][A-Za-z0-9_]*\\])$",
       "description": "I27: a 256-bit word (Word) and the value type of a storage family of the law's document (Val[<family>]), the binders k and v of an UNDO residue law (holon.ir.check_binder_types)"
      }
     ]
    }
   }
  },
  "claim": {
   "oneOf": [
    {
     "$ref": "#/$defs/prop"
    },
    {
     "$ref": "#/$defs/conj"
    }
   ]
  },
  "conj": {
   "type": "object",
   "required": [
    "all"
   ],
   "additionalProperties": false,
   "properties": {
    "all": {
     "type": "array",
     "minItems": 1,
     "items": {
      "$ref": "#/$defs/prop"
     }
    }
   }
  },
  "prop": {
   "oneOf": [
    {
     "type": "object",
     "required": [
      "eq"
     ],
     "additionalProperties": false,
     "properties": {
      "eq": {
       "type": "array",
       "minItems": 2,
       "maxItems": 2,
       "items": {
        "$ref": "#/$defs/term"
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "neq"
     ],
     "additionalProperties": false,
     "properties": {
      "neq": {
       "type": "array",
       "minItems": 2,
       "maxItems": 2,
       "items": {
        "$ref": "#/$defs/term"
       }
      }
     }
    }
   ]
  },
  "term": {
   "oneOf": [
    {
     "$ref": "#/$defs/t_var"
    },
    {
     "$ref": "#/$defs/t_nat"
    },
    {
     "$ref": "#/$defs/t_bool"
    },
    {
     "$ref": "#/$defs/t_nats"
    },
    {
     "$ref": "#/$defs/t_s0"
    },
    {
     "$ref": "#/$defs/t_run"
    },
    {
     "$ref": "#/$defs/t_step"
    },
    {
     "$ref": "#/$defs/t_obs"
    },
    {
     "$ref": "#/$defs/t_trace"
    },
    {
     "$ref": "#/$defs/t_cat"
    },
    {
     "$ref": "#/$defs/t_act"
    },
    {
     "$ref": "#/$defs/t_proj"
    },
    {
     "$ref": "#/$defs/t_obsv"
    },
    {
     "$ref": "#/$defs/t_mig"
    },
    {
     "$ref": "#/$defs/t_fn"
    },
    {
     "$ref": "#/$defs/t_plus"
    },
    {
     "$ref": "#/$defs/t_app"
    },
    {
     "$ref": "#/$defs/t_site"
    },
    {
     "$ref": "#/$defs/t_width_site"
    },
    {
     "$ref": "#/$defs/t_call"
    },
    {
     "$ref": "#/$defs/t_field"
    },
    {
     "$ref": "#/$defs/t_bytes"
    },
    {
     "$ref": "#/$defs/t_some"
    },
    {
     "$ref": "#/$defs/t_expr"
    },
    {
     "$ref": "#/$defs/t_coerce"
    },
    {
     "$ref": "#/$defs/t_disch"
    },
    {
     "$ref": "#/$defs/t_undo"
    },
    {
     "$ref": "#/$defs/t_fact"
    },
    {
     "$ref": "#/$defs/t_ghost"
    },
    {
     "$ref": "#/$defs/t_init"
    },
    {
     "$ref": "#/$defs/t_bundle"
    }
   ]
  },
  "t_var": {
   "type": "object",
   "required": [
    "var"
   ],
   "additionalProperties": false,
   "properties": {
    "var": {
     "$ref": "#/$defs/ident"
    }
   }
  },
  "t_nat": {
   "type": "object",
   "required": [
    "nat"
   ],
   "additionalProperties": false,
   "properties": {
    "nat": {
     "type": "integer"
    }
   }
  },
  "t_bool": {
   "type": "object",
   "required": [
    "bool"
   ],
   "additionalProperties": false,
   "properties": {
    "bool": {
     "type": "boolean"
    }
   }
  },
  "t_nats": {
   "type": "object",
   "required": [
    "nats"
   ],
   "additionalProperties": false,
   "properties": {
    "nats": {
     "type": "array",
     "items": {
      "type": "integer"
     }
    }
   }
  },
  "t_s0": {
   "type": "object",
   "required": [
    "s0"
   ],
   "additionalProperties": false,
   "properties": {
    "s0": {
     "type": "object",
     "additionalProperties": false
    }
   }
  },
  "t_run": {
   "type": "object",
   "required": [
    "run",
    "from"
   ],
   "additionalProperties": false,
   "properties": {
    "run": {
     "$ref": "#/$defs/term"
    },
    "from": {
     "$ref": "#/$defs/term"
    }
   }
  },
  "t_step": {
   "type": "object",
   "required": [
    "step",
    "from"
   ],
   "additionalProperties": false,
   "properties": {
    "step": {
     "$ref": "#/$defs/term"
    },
    "from": {
     "$ref": "#/$defs/term"
    }
   }
  },
  "t_obs": {
   "type": "object",
   "required": [
    "obs",
    "from"
   ],
   "additionalProperties": false,
   "properties": {
    "obs": {
     "$ref": "#/$defs/term"
    },
    "from": {
     "$ref": "#/$defs/term"
    }
   }
  },
  "t_trace": {
   "type": "object",
   "required": [
    "trace"
   ],
   "additionalProperties": false,
   "properties": {
    "trace": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/term"
     }
    }
   }
  },
  "t_cat": {
   "type": "object",
   "required": [
    "cat"
   ],
   "additionalProperties": false,
   "properties": {
    "cat": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "$ref": "#/$defs/term"
     }
    }
   }
  },
  "t_act": {
   "type": "object",
   "required": [
    "act",
    "args"
   ],
   "additionalProperties": false,
   "properties": {
    "act": {
     "$ref": "#/$defs/ident"
    },
    "args": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/term"
     }
    }
   }
  },
  "t_proj": {
   "type": "object",
   "required": [
    "proj",
    "of"
   ],
   "additionalProperties": false,
   "properties": {
    "proj": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/ident"
     }
    },
    "of": {
     "$ref": "#/$defs/term"
    }
   }
  },
  "t_obsv": {
   "type": "object",
   "required": [
    "obsv",
    "of"
   ],
   "additionalProperties": false,
   "properties": {
    "obsv": {
     "$ref": "#/$defs/ident"
    },
    "of": {
     "$ref": "#/$defs/term"
    }
   }
  },
  "t_mig": {
   "type": "object",
   "required": [
    "mig",
    "of"
   ],
   "additionalProperties": false,
   "properties": {
    "mig": {
     "$ref": "#/$defs/ident"
    },
    "of": {
     "$ref": "#/$defs/term"
    },
    "args": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/term"
     }
    }
   }
  },
  "t_fn": {
   "type": "object",
   "required": [
    "fn",
    "args"
   ],
   "additionalProperties": false,
   "properties": {
    "fn": {
     "$ref": "#/$defs/ident"
    },
    "args": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/term"
     }
    }
   }
  },
  "t_plus": {
   "type": "object",
   "required": [
    "plus"
   ],
   "additionalProperties": false,
   "properties": {
    "plus": {
     "type": "array",
     "minItems": 2,
     "maxItems": 2,
     "items": {
      "$ref": "#/$defs/term"
     }
    }
   }
  },
  "premise": {
   "oneOf": [
    {
     "$ref": "#/$defs/prop"
    },
    {
     "type": "object",
     "required": [
      "cf"
     ],
     "additionalProperties": false,
     "properties": {
      "cf": {
       "type": "object",
       "required": [
        "fn",
        "set"
       ],
       "additionalProperties": false,
       "properties": {
        "fn": {
         "$ref": "#/$defs/ident"
        },
        "set": {
         "oneOf": [
          {
           "type": "array",
           "items": {
            "$ref": "#/$defs/term"
           }
          },
          {
           "const": "*"
          }
         ]
        }
       }
      }
     }
    },
    {
     "type": "object",
     "required": [
      "hyp"
     ],
     "additionalProperties": false,
     "properties": {
      "hyp": {
       "type": "object",
       "required": [
        "name"
       ],
       "properties": {
        "name": {
         "type": "string"
        }
       }
      }
     }
    }
   ]
  },
  "t_app": {
   "type": "object",
   "required": [
    "app",
    "args"
   ],
   "additionalProperties": false,
   "properties": {
    "app": {
     "$ref": "#/$defs/ident"
    },
    "args": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/term"
     }
    }
   }
  },
  "t_site": {
   "type": "object",
   "required": [
    "site",
    "on",
    "from"
   ],
   "additionalProperties": false,
   "description": "a SORT-site term (I15): the I13 site id <model>:<span>:<x8>, the action, the state",
   "properties": {
    "site": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_]+:[^ ]+:[0-9a-f]{8}$"
    },
    "on": {
     "$ref": "#/$defs/term"
    },
    "from": {
     "$ref": "#/$defs/term"
    }
   }
  },
  "t_width_site": {
   "type": "object",
   "required": [
    "width_site",
    "on",
    "from"
   ],
   "additionalProperties": false,
   "description": "a SORT-width term (I20, holon.sorts.width): the width site id width:<span>:<record or ->.<field>, the action, the state",
   "properties": {
    "width_site": {
     "type": "string",
     "pattern": "^width:[^ ]+:[^ ]+$"
    },
    "on": {
     "$ref": "#/$defs/term"
    },
    "from": {
     "$ref": "#/$defs/term"
    }
   }
  },
  "t_call": {
   "type": "object",
   "required": [
    "call",
    "args"
   ],
   "additionalProperties": false,
   "description": "I24, codec terms (holon-ir/0.1 terms over a holon-facts/0.1 document or a linked codec document): a call of a facts function or component function",
   "properties": {
    "call": {
     "$ref": "#/$defs/ident"
    },
    "args": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/term"
     }
    }
   }
  },
  "t_field": {
   "type": "object",
   "required": [
    "field",
    "of"
   ],
   "additionalProperties": false,
   "description": "I24, codec terms: a record field of a term (a Go record field is its path joined by '.')",
   "properties": {
    "field": {
     "type": "string",
     "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "of": {
     "$ref": "#/$defs/term"
    }
   }
  },
  "t_bytes": {
   "type": "object",
   "required": [
    "bytes"
   ],
   "additionalProperties": false,
   "description": "I24, codec terms: a byte string, lower-case hex",
   "properties": {
    "bytes": {
     "type": "string",
     "pattern": "^0x([0-9a-f]{2})*$"
    }
   }
  },
  "t_some": {
   "type": "object",
   "required": [
    "some"
   ],
   "additionalProperties": false,
   "description": "I24, codec terms: an option's value",
   "properties": {
    "some": {
     "$ref": "#/$defs/term"
    }
   }
  },
  "t_expr": {
   "type": "object",
   "required": [
    "expr",
    "from"
   ],
   "additionalProperties": false,
   "description": "I24, holon-facts/0.2: the value of facts expression E in state S, the inputs of action A taken from the action T (when T is an A; the default value of E's type otherwise), the names in bind bound to those IR terms (they shadow inputs)",
   "properties": {
    "expr": {},
    "from": {
     "$ref": "#/$defs/term"
    },
    "action": {
     "$ref": "#/$defs/ident"
    },
    "on": {
     "$ref": "#/$defs/term"
    },
    "bind": {
     "type": "object",
     "additionalProperties": {
      "$ref": "#/$defs/term"
     }
    }
   }
  },
  "t_coerce": {
   "type": "object",
   "required": [
    "coerce",
    "on",
    "from"
   ],
   "additionalProperties": false,
   "description": "a SORT coercion term (I30, holon.rules.sort): the coercion id <model>:<realize|as_member|reinterpret>:<span>:<x8>, the action, the state; every hit of the coercion while the action runs from the state is Some",
   "properties": {
    "coerce": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_.]+:(realize|as_member|reinterpret):[^ ]+:[0-9a-f]{8}$"
    },
    "on": {
     "$ref": "#/$defs/term"
    },
    "from": {
     "$ref": "#/$defs/term"
    }
   }
  },
  "t_disch": {
   "type": "object",
   "required": [
    "disch",
    "on",
    "from",
    "at",
    "env"
   ],
   "additionalProperties": false,
   "description": "a DISCH term (I31, holon.rules.disch): the id <model>:<blocking|revert|external|external_none>:<tag>:<class|all>, the action, the reachable state, the time the blocked condition holds at and the step's environment; disch_ok[ID](A, S, T, E) is the sub-form's claim over the typed model",
   "properties": {
    "disch": {
     "type": "string",
     "pattern": "^[A-Za-z0-9_.]+:(blocking|revert|external|external_none):[a-z0-9_]+_[0-9a-f]{8}:[A-Za-z0-9_]+$"
    },
    "on": {
     "$ref": "#/$defs/term"
    },
    "from": {
     "$ref": "#/$defs/term"
    },
    "at": {
     "$ref": "#/$defs/term"
    },
    "env": {
     "$ref": "#/$defs/term"
    }
   }
  },
  "t_undo": {
   "type": "object",
   "required": [
    "undo",
    "on"
   ],
   "additionalProperties": false,
