      HSt{t, own, min_stake, dep, rew, srem, reg, stake, wdr, wbi, Con{O_Rev{code}, log}}
    case D_claimWithdrawal_Ok{}:
      HSt{t, own, min_stake, dep, rew, srem, reg, b_set_nat(stake, who, 0n), b_remove(who, wdr), b_set_nat(wbi, who, 0n), Con{O_Ok{}, log}}

def step_claimWithdrawal(s: HSt, +who: Nat, +rc: Nat) -> HSt:
  match s:
    case HSt{+t, +own, +min_stake, +dep, +rew, +srem, +reg, +stake, +wdr, +wbi, +log}:
      exec_claimWithdrawal(decide_claimWithdrawal(stake, wdr, wbi, who, rc), t, own, min_stake, dep, rew, srem, reg, stake, wdr, wbi, log, who, rc)

type Dec_slash is Data:
  D_slash_Rev{code: Nat}
  D_slash_Ok{vamount: Nat}

# contracts/l1/rollup/Submitter.sol:156
def dec_slash_2(c: Bool, +vamount: Nat) -> Dec_slash:
  match c:
    case False{}:
      D_slash_Rev{14n}
    case True{}:
      D_slash_Ok{vamount}

# contracts/l1/rollup/Submitter.sol:35
def dec_slash_0(c: Bool, +stake: List<&2, Nat>, +sub: Nat, +reward: Nat) -> Dec_slash:
  match c:
    case False{}:
      D_slash_Rev{13n}
    case True{}:
      +vamount = b_nth(stake, sub)
      dec_slash_2(Nat.is_le(reward, vamount), vamount)

def decide_slash(+stake: List<&2, Nat>, +who: Nat, +sub: Nat, +reward: Nat) -> Dec_slash:
  dec_slash_0(Nat.is_eq(who, 6n), stake, sub, reward)

def exec_slash(d: Dec_slash, +t: Nat, +own: Nat, +min_stake: Nat, +dep: Nat, +rew: Nat, +srem: Nat, +reg: List<&2, Nat>, +stake: List<&2, Nat>, +wdr: List<&2, Nat>, +wbi: List<&2, Nat>, +log: List<&2, HObs>, +who: Nat, +sub: Nat, +reward: Nat) -> HSt:
  match d:
    case D_slash_Rev{code}:
      HSt{t, own, min_stake, dep, rew, srem, reg, stake, wdr, wbi, Con{O_Rev{code}, log}}
    case D_slash_Ok{+vamount}:
      HSt{t, own, min_stake, dep, rew, Nat.add(srem, Nat.sub(vamount, reward)), b_remove(sub, reg), b_set_nat(stake, sub, 0n), b_remove(sub, wdr), b_set_nat(wbi, sub, 0n), Con{O_Ok{}, log}}

def step_slash(s: HSt, +who: Nat, +sub: Nat, +reward: Nat) -> HSt:
  match s:
    case HSt{+t, +own, +min_stake, +dep, +rew, +srem, +reg, +stake, +wdr, +wbi, +log}:
      exec_slash(decide_slash(stake, who, sub, reward), t, own, min_stake, dep, rew, srem, reg, stake, wdr, wbi, log, who, sub, reward)

type Dec_claimSlashRemaining is Data:
  D_claimSlashRemaining_Rev{code: Nat}
  D_claimSlashRemaining_Ok{}

# contracts/l1/rollup/Submitter.sol:164
def dec_claimSlashRemaining_1(c: Bool) -> Dec_claimSlashRemaining:
  match c:
    case False{}:
      D_claimSlashRemaining_Rev{15n}
    case True{}:
      D_claimSlashRemaining_Ok{}

# contracts/l1/rollup/Submitter.sol:162
def dec_claimSlashRemaining_0(c: Bool, +srem: Nat) -> Dec_claimSlashRemaining:
  match c:
    case False{}:
      D_claimSlashRemaining_Rev{10n}
    case True{}:
      dec_claimSlashRemaining_1(Nat.is_gt(srem, 0n))

def decide_claimSlashRemaining(+srem: Nat, +who: Nat, +rc: Nat) -> Dec_claimSlashRemaining:
  dec_claimSlashRemaining_0(Bool.not(Nat.is_eq(rc, 0n)), srem)

def exec_claimSlashRemaining(d: Dec_claimSlashRemaining, +t: Nat, +own: Nat, +min_stake: Nat, +dep: Nat, +rew: Nat, +srem: Nat, +reg: List<&2, Nat>, +stake: List<&2, Nat>, +wdr: List<&2, Nat>, +wbi: List<&2, Nat>, +log: List<&2, HObs>, +who: Nat, +rc: Nat) -> HSt:
  match d:
    case D_claimSlashRemaining_Rev{code}:
      HSt{t, own, min_stake, dep, rew, srem, reg, stake, wdr, wbi, Con{O_Rev{code}, log}}
    case D_claimSlashRemaining_Ok{}:
      HSt{t, own, min_stake, dep, rew, 0n, reg, stake, wdr, wbi, Con{O_Ok{}, log}}

def step_claimSlashRemaining(s: HSt, +who: Nat, +rc: Nat) -> HSt:
  match s:
    case HSt{+t, +own, +min_stake, +dep, +rew, +srem, +reg, +stake, +wdr, +wbi, +log}:
      exec_claimSlashRemaining(decide_claimSlashRemaining(srem, who, rc), t, own, min_stake, dep, rew, srem, reg, stake, wdr, wbi, log, who, rc)

def step(a: HAct, s: HSt) -> HSt:
  match a:
    case A_initialize{+who, +owner_, +rollup_, +mins_, +dep_, +rew_}:
      step_initialize(s, who, owner_, rollup_, mins_, dep_, rew_)
    case A_addSubmitter{+who, +sub}:
      step_addSubmitter(s, who, sub)
    case A_removeSubmitter{+who, +sub}:
      step_removeSubmitter(s, who, sub)
    case A_setMinimumStake{+who, +val}:
      step_setMinimumStake(s, who, val)
    case A_updateChallengeDeposit{+who, +val}:
      step_updateChallengeDeposit(s, who, val)
    case A_updateRewardPercentage{+who, +val}:
      step_updateRewardPercentage(s, who, val)
    case A_stake{+who, +sub, +value}:
      step_stake(s, who, sub, value)
    case A_withdraw{+who}:
      step_withdraw(s, who)
    case A_claimWithdrawal{+who, +rc}:
      step_claimWithdrawal(s, who, rc)
    case A_slash{+who, +sub, +reward}:
      step_slash(s, who, sub, reward)
    case A_claimSlashRemaining{+who, +rc}:
      step_claimSlashRemaining(s, who, rc)

def run(tr: List<&2, HAct>, s: HSt) -> HSt:
  match tr:
    case Nil{}:
      s
    case Con{a, rest}:
      run(rest, step(a, s))

def clear_log(s: HSt) -> HSt:
  match s:
    case HSt{t, own, min_stake, dep, rew, srem, reg, stake, wdr, wbi, log}:
      HSt{t, own, min_stake, dep, rew, srem, reg, stake, wdr, wbi, Nil{}}

def log_of(s: HSt) -> List<&2, HObs>:
  match s:
    case HSt{t, own, min_stake, dep, rew, srem, reg, stake, wdr, wbi, log}:
      log

# observations of tr from s: the log tr produces (newest first)
def obs(tr: List<&2, HAct>, s: HSt) -> List<&2, HObs>:
  log_of(run(tr, clear_log(s)))

def ok_head(l: List<&2, HObs>) -> Bool:
  match l:
    case Nil{}:
      False{}
    case Con{o, t}:
      match o:
        case O_Ok{}:
          True{}
        case O_Rev{c}:
          False{}

# the last action applied to s succeeded
def last_ok(s: HSt) -> Bool:
  ok_head(log_of(s))

def all_ok(l: List<&2, HObs>) -> Bool:
  match l:
    case Nil{}:
      True{}
    case Con{o, t}:
      match o:
        case O_Ok{}:
          all_ok(t)
        case O_Rev{c}:
          False{}

# every action of tr succeeds from s
def runs_ok(tr: List<&2, HAct>, s: HSt) -> Bool:
  all_ok(obs(tr, s))

def no_code(l: List<&2, HObs>, +k: Nat) -> Bool:
  match l:
    case Nil{}:
      True{}
    case Con{o, t}:
      match o:
        case O_Ok{}:
          no_code(t, k)
        case O_Rev{c}:
          Bool.and(Bool.not(Nat.is_eq(c, k)), no_code(t, k))

def eq_obs(a: HObs, b: HObs) -> Bool:
  match a b:
    case O_Ok{} O_Ok{}:
      True{}
    case O_Rev{x} O_Rev{y}:
      Nat.is_eq(x, y)
    case O_Ok{} O_Rev{y}:
      False{}
    case O_Rev{x} O_Ok{}:
      False{}

def eq_obs_list(xs: List<&2, HObs>, ys: List<&2, HObs>) -> Bool:
  match xs ys:
    case Nil{} Nil{}:
      True{}
    case Nil{} Con{h, t}:
      False{}
    case Con{h, t} Nil{}:
      False{}
    case Con{x, xt} Con{y, yt}:
      Bool.and(eq_obs(x, y), eq_obs_list(xt, yt))

