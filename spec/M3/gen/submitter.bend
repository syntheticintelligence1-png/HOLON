def cost(tr: List<&2, HAct>) -> Nat:
  match tr:
    case Nil{}:
      0n
    case Con{a, rest}:
      match a:
        case A_initialize{_, _, _, _, _, _}:
          Nat.add(0n, cost(rest))
        case A_addSubmitter{_, _}:
          Nat.add(0n, cost(rest))
        case A_removeSubmitter{_, _}:
          Nat.add(0n, cost(rest))
        case A_setMinimumStake{_, _}:
          Nat.add(0n, cost(rest))
        case A_updateChallengeDeposit{_, _}:
          Nat.add(0n, cost(rest))
        case A_updateRewardPercentage{_, _}:
          Nat.add(0n, cost(rest))
        case A_stake{_, _, _}:
          Nat.add(0n, cost(rest))
        case A_withdraw{_}:
          Nat.add(0n, cost(rest))
        case A_claimWithdrawal{_, _}:
          Nat.add(0n, cost(rest))
        case A_slash{_, _, _}:
          Nat.add(0n, cost(rest))
        case A_claimSlashRemaining{_, _}:
          Nat.add(0n, cost(rest))

def elapsed(tr: List<&2, HAct>) -> Nat:
  match tr:
    case Nil{}:
      0n
    case Con{a, rest}:
      match a:
        case A_initialize{_, _, _, _, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_addSubmitter{_, _}:
          Nat.add(0n, elapsed(rest))
        case A_removeSubmitter{_, _}:
          Nat.add(0n, elapsed(rest))
        case A_setMinimumStake{_, _}:
          Nat.add(0n, elapsed(rest))
        case A_updateChallengeDeposit{_, _}:
          Nat.add(0n, elapsed(rest))
        case A_updateRewardPercentage{_, _}:
          Nat.add(0n, elapsed(rest))
        case A_stake{_, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_withdraw{_}:
          Nat.add(0n, elapsed(rest))
        case A_claimWithdrawal{_, _}:
          Nat.add(0n, elapsed(rest))
        case A_slash{_, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_claimSlashRemaining{_, _}:
          Nat.add(0n, elapsed(rest))

# actions any principal may take (no role modifier): the permissionless class X of DISCH
def perm(a: HAct) -> Bool:
  match a:
    case A_initialize{_, _, _, _, _, _}:
      True{}
    case A_addSubmitter{_, _}:
      False{}
    case A_removeSubmitter{_, _}:
      False{}
    case A_setMinimumStake{_, _}:
      False{}
    case A_updateChallengeDeposit{_, _}:
      False{}
    case A_updateRewardPercentage{_, _}:
      False{}
    case A_stake{_, _, _}:
      True{}
    case A_withdraw{_}:
      True{}
    case A_claimWithdrawal{_, _}:
      True{}
    case A_slash{_, _, _}:
      False{}
    case A_claimSlashRemaining{_, _}:
      False{}

# initial state: 
def s0() -> HSt:
  HSt{0n, 1n, 1n, 1n, 10n, 0n, [2n, 3n], [5n, 7n], Nil{}, Nil{}, Nil{}}
