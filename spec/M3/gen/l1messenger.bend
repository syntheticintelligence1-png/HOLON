          False{}

# the last action applied to s succeeded
def last_ok(s: HSt) -> Bool:
  ok_head(log_of(s))

def all_ok(l: List<&2, HObs>) -> Bool:
  match l:
    case Nil{}:
      True{}
    case Con{o, t}:
      match o:
        case O_Ok{}:
          all_ok(t)
        case O_Rev{c}:
          False{}

# every action of tr succeeds from s
def runs_ok(tr: List<&2, HAct>, s: HSt) -> Bool:
  all_ok(obs(tr, s))

def no_code(l: List<&2, HObs>, +k: Nat) -> Bool:
  match l:
    case Nil{}:
      True{}
    case Con{o, t}:
      match o:
        case O_Ok{}:
          no_code(t, k)
        case O_Rev{c}:
          Bool.and(Bool.not(Nat.is_eq(c, k)), no_code(t, k))

def eq_obs(a: HObs, b: HObs) -> Bool:
  match a b:
    case O_Ok{} O_Ok{}:
      True{}
    case O_Rev{x} O_Rev{y}:
      Nat.is_eq(x, y)
    case O_Ok{} O_Rev{y}:
      False{}
    case O_Rev{x} O_Ok{}:
      False{}

def eq_obs_list(xs: List<&2, HObs>, ys: List<&2, HObs>) -> Bool:
  match xs ys:
    case Nil{} Nil{}:
      True{}
    case Nil{} Con{h, t}:
      False{}
    case Con{h, t} Nil{}:
      False{}
    case Con{x, xt} Con{y, yt}:
      Bool.and(eq_obs(x, y), eq_obs_list(xt, yt))

def is_replayMessage(a: HAct) -> Bool:
  match a:
    case A_replayMessage{_, _, _, _, _, _, _}:
      True{}
    case A_updateMaxReplayTimes{_, _}:
      False{}
    case A_sendMessage{_, _, _, _, _, _, _, _}:
      False{}
    case A_sendMessage2{_, _, _, _, _, _, _, _, _}:
      False{}
    case A_setWhitelist{_, _, _}:
      False{}
    case A_wait{_}:
      False{}

def is_updateMaxReplayTimes(a: HAct) -> Bool:
  match a:
    case A_replayMessage{_, _, _, _, _, _, _}:
      False{}
    case A_updateMaxReplayTimes{_, _}:
      True{}
    case A_sendMessage{_, _, _, _, _, _, _, _}:
      False{}
    case A_sendMessage2{_, _, _, _, _, _, _, _, _}:
      False{}
    case A_setWhitelist{_, _, _}:
      False{}
    case A_wait{_}:
      False{}

def is_sendMessage(a: HAct) -> Bool:
  match a:
    case A_replayMessage{_, _, _, _, _, _, _}:
      False{}
    case A_updateMaxReplayTimes{_, _}:
      False{}
    case A_sendMessage{_, _, _, _, _, _, _, _}:
      True{}
    case A_sendMessage2{_, _, _, _, _, _, _, _, _}:
      False{}
    case A_setWhitelist{_, _, _}:
      False{}
    case A_wait{_}:
      False{}

def is_sendMessage2(a: HAct) -> Bool:
  match a:
    case A_replayMessage{_, _, _, _, _, _, _}:
      False{}
    case A_updateMaxReplayTimes{_, _}:
      False{}
    case A_sendMessage{_, _, _, _, _, _, _, _}:
      False{}
    case A_sendMessage2{_, _, _, _, _, _, _, _, _}:
      True{}
    case A_setWhitelist{_, _, _}:
      False{}
    case A_wait{_}:
      False{}

def is_setWhitelist(a: HAct) -> Bool:
  match a:
    case A_replayMessage{_, _, _, _, _, _, _}:
      False{}
    case A_updateMaxReplayTimes{_, _}:
      False{}
    case A_sendMessage{_, _, _, _, _, _, _, _}:
      False{}
    case A_sendMessage2{_, _, _, _, _, _, _, _, _}:
      False{}
    case A_setWhitelist{_, _, _}:
      True{}
    case A_wait{_}:
      False{}

def is_wait(a: HAct) -> Bool:
  match a:
    case A_replayMessage{_, _, _, _, _, _, _}:
      False{}
    case A_updateMaxReplayTimes{_, _}:
      False{}
    case A_sendMessage{_, _, _, _, _, _, _, _}:
      False{}
    case A_sendMessage2{_, _, _, _, _, _, _, _, _}:
      False{}
    case A_setWhitelist{_, _, _}:
      False{}
    case A_wait{_}:
      True{}

def cost(tr: List<&2, HAct>) -> Nat:
  match tr:
    case Nil{}:
      0n
    case Con{a, rest}:
      match a:
        case A_replayMessage{_, _, _, _, _, _, _}:
          Nat.add(0n, cost(rest))
        case A_updateMaxReplayTimes{_, _}:
          Nat.add(0n, cost(rest))
        case A_sendMessage{_, _, _, _, _, _, _, _}:
          Nat.add(0n, cost(rest))
        case A_sendMessage2{_, _, _, _, _, _, _, _, _}:
          Nat.add(0n, cost(rest))
        case A_setWhitelist{_, _, _}:
          Nat.add(0n, cost(rest))
        case A_wait{_}:
          Nat.add(0n, cost(rest))

def elapsed(tr: List<&2, HAct>) -> Nat:
  match tr:
    case Nil{}:
      0n
    case Con{a, rest}:
      match a:
        case A_replayMessage{_, _, _, _, _, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_updateMaxReplayTimes{_, _}:
          Nat.add(0n, elapsed(rest))
        case A_sendMessage{_, _, _, _, _, _, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_sendMessage2{_, _, _, _, _, _, _, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_setWhitelist{_, _, _}:
          Nat.add(0n, elapsed(rest))
        case A_wait{_}:
          Nat.add(0n, elapsed(rest))

# actions any principal may take (no role modifier): the permissionless class X of DISCH
def perm(a: HAct) -> Bool:
  match a:
    case A_replayMessage{_, _, _, _, _, _, _}:
      True{}
    case A_updateMaxReplayTimes{_, _}:
      False{}
    case A_sendMessage{_, _, _, _, _, _, _, _}:
      True{}
    case A_sendMessage2{_, _, _, _, _, _, _, _, _}:
      True{}
    case A_setWhitelist{_, _, _}:
      True{}
    case A_wait{_}:
      True{}

# replayStates[xh].times
def times_of(s: HSt, +xh: Nat) -> Nat:
  match s:
    case HSt{+t, +own, +maxr, +mrt, +pri, +mst, +wl, +bf, +dr, +fq, +paused, +log}:
      g_RS_tm(nth_d(HRS, mrt, xh, empty_RS()))

# maxReplayTimes
def maxr_of(s: HSt) -> Nat:
  match s:
    case HSt{+t, +own, +maxr, +mrt, +pri, +mst, +wl, +bf, +dr, +fq, +paused, +log}:
      maxr

# messageSendTimestamp[xh]
def sent_at(s: HSt, +xh: Nat) -> Nat:
  match s:
    case HSt{+t, +own, +maxr, +mrt, +pri, +mst, +wl, +bf, +dr, +fq, +paused, +log}:
      b_nth(mst, xh)

# initial state: 
def s0() -> HSt:
  HSt{0n, 1n, 3n, Nil{}, Nil{}, Nil{}, Nil{}, 0n, Nil{}, 0n, False{}, Nil{}}
