{
  "assumptions": [
    {
      "id": "A-dirty",
      "text": "Memory at the free pointer is not zeroed: every region a walk allocates (mload(0x40)) starts with unknown cells (memory_init dirty), so a byte that no op writes is unknown, never zero."
    },
    {
      "id": "A-env",
      "text": "Environment terms (storage, block, msg and tx members, blobhash, results of external calls, memory reads, and values computed from them) are free: a revert whose failing condition mentions one belongs to the transition, not to the edge (rule J1), and conditions on them are projected away."
    },
    {
      "id": "A-implicit",
      "text": "Implicit reverts (checked arithmetic, array bounds, ABI decoding) are not part of an edge's partiality: only explicit require, revert and branch conditions on inputs are."
    },
    {
      "fields": [
        "batchIndex",
        "totalL1MessagePopped"
      ],
      "id": "A-width:Header",
      "record": "Header",
      "text": "Fields of Header whose value type is wider than their stored width: the bytes keep only the low part of the value, so they determine it only when it fits the width."
    }
