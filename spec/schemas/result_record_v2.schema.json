{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOLON result record v2 (additive to the frozen schemas/result_record.schema.json)",
  "description": "One field per whitepaper §8.6 item: status, statement_hash (law hash), model_sha256 (model hash), premises, scope_v2, kernels, independence_class, refinement_refs, replay (witness replay status), coverage. A field a later iteration fills holds the constant 'pending:I<n>'; that iteration replaces the constant here and asserts the removal in its own test (non_vacuity: filled by I3; refinement_refs: filled by I16).",
  "type": "object",
  "required": ["law_id", "statement_hash", "facts_sha256", "status", "premises", "replay", "record_version", "model_sha256",
               "compiled_sha256", "generator_sha256", "cone", "ledger_match", "model_assumptions", "scope_v2", "kernels", "independence_class",
               "refinement_refs", "coverage", "non_vacuity", "witness_provenance", "filter_bin",
               "evidence_levels", "evidence_triage", "evidence_override"],
  "properties": {
    "law_id": {"type": "string", "pattern": "^L[0-9]?_[A-Za-z0-9_]+$"},
    "statement_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "facts_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["PROVED", "REFUTED", "UNKNOWN"]},
    "premises": {"type": "array", "items": {"type": "string"}},
    "replay": {"type": "object", "required": ["status"],
               "properties": {"status": {"enum": ["not_run", "passed", "failed", "not_applicable"]}}},
    "record_version": {"const": "holon-record/0.2"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "compiled_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 of the compiled model (.mjs) the refuter executed"},
    "generator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "sha256 over the generator entry modules and every holon module they import"},
    "cone": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
    "ledger_match": {"const": "exact", "description": "committed records match their ledger bundle by facts sha256; 'derived' (a run over facts derived from a registered file, e.g. planted mutations) never validates"},
    "model_assumptions": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"}},
    "ledger_assumptions": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"},
                           "description": "M2+ records only (audit M2/1 F-M2-12): the ledger entries meeting the cone that the model does not replace by an oracle parameter (abstractions, stand-ins still inside the model); model_assumptions holds the hypothesis premises (§8.5)"},
    "scope_v2": {
      "type": "object",
      "required": ["kind", "horizon", "at_state"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["bounded", "unbounded"]},
        "horizon": {"type": ["string", "null"]},
        "at_state": {"enum": ["s0", "any", null]}
      }
    },
    "statement_scope": {
      "type": "object",
      "required": ["kind"],
      "properties": {"kind": {"enum": ["unbounded", "bounded", "at_state"]}},
      "description": "holon-ir/0.3 records (audit F-M2-01): the statement's IR scope, verbatim; scope and scope_v2 follow it, never the status"
    },
    "kernels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "role", "result"],
        "properties": {
          "name": {"enum": ["bend2", "bendtt", "lean4"]},
          "version": {"type": "string"},
          "role": {"enum": ["primary", "second", "second-independent"]},
          "result": {"enum": ["checked", "failed", "not_run"]},
          "shares_frontend_with": {"type": "string"},
          "note": {"type": "string"},
          "source": {"type": "string", "description": "lean4 (I9): the Lean file that carries the verdict, repo-relative"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$",
                            "description": "lean4 (I9): sha256 of the Lean text emitted for this law, facts, status and witness; checked only if gen/<m>/lean/report.json checked exactly this text"},
          "theorem": {"type": "string", "description": "lean4 (I9): the theorem carrying the verdict (the law, or its counter-law)"},
          "axioms": {"type": "array", "items": {"enum": ["propext", "Quot.sound"]},
                     "description": "lean4 (I9): `#print axioms` of the checked theorems; only propext and Quot.sound are allowed"}
        }
      }
    },
    "independence_class": {"enum": ["none", "I1", "I1-shared", "I2"]},
    "refinement_refs": {"type": "array",
                        "description": "I16: the refinement records of the edges the cone uses (holon.records.refinement_refs): per-edge records under results/M2/refinement/ and trace-corpus per_action entries of replay/<m>/report.json. 'pending:I16' is no longer accepted.",
                        "items": {"type": "string",
                                  "pattern": "^(results/M2/refinement/[A-Za-z0-9_]+\\.json|replay/M[0-9]+/report\\.json#/refinement/per_action/[A-Za-z0-9_]+)$"}},
    "coverage": {"const": "pending:I19"},
    "non_vacuity": {
      "type": "object",
      "required": ["status", "law", "witness", "reachable", "degenerate", "parent_statement_hash", "bound"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["inhabited", "counter_witness", "no_premises", "unknown"]},
        "law": {"type": ["string", "null"]},
        "witness": {"type": ["object", "null"]},
        "reachable": {"type": ["boolean", "null"]},
        "degenerate": {"type": ["boolean", "null"]},
        "parent_statement_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "bound": {"type": ["string", "null"]}
      }
    },
    "witness_provenance": {"type": ["object", "null"],
                           "additionalProperties": {"enum": ["public_schedule", "internal_harness", "emulated_storage", "library_api"]}},
    "filter_bin": {"enum": ["finding", "model_defect", "pending", null]},
    "evidence_levels": {"type": ["array", "null"], "items": {"enum": ["E1", "E2", "E3", "E4", "E5", "E6"]},
                        "description": "I14: holon.diagram.evidence.law_evidence(law, gen/M2/evidence.json)['levels'] (sorted, distinct) when the evidence set covers the law's facts; null otherwise"},
    "evidence_triage": {"enum": ["finding", "intent_question", "none"],
                        "description": "I14: evidence_triage(status, max level): none unless REFUTED, then intent_question iff the strongest level is E6, else finding. The frozen v1 triage is unchanged"},
    "site": {"type": "string", "pattern": "^[^:]+:.+:[0-9a-f]{8}$",
             "description": "I15: a SORT-site law's I13 site id (DERIVATION.json basis.site_id)"},
    "witnesses": {"type": "object",
                  "description": "I15: a SORT-site law's refutation per entry point: {} when PROVED, else one entry per entry point (DERIVATION.json entry_points)",
                  "additionalProperties": {"type": "object",
                                           "required": ["status", "witness", "laws", "proof", "checker", "verdict", "stage", "bound", "replay"],
                                           "properties": {"status": {"enum": ["REFUTED", "UNKNOWN"]},
                                                          "witness": {"type": ["object", "null"]},
                                                          "laws": {"type": ["string", "null"]},
                                                          "proof": {"type": ["string", "null"]},
                                                          "checker": {"type": ["object", "null"]},
                                                          "verdict": {"enum": ["checked", "failed", "not_run"]},
                                                          "stage": {"enum": ["S2", "S3", null]},
                                                          "bound": {"type": "string", "minLength": 1},
                                                          "replay": {"type": "object", "required": ["status", "detail", "panic_site"],
                                                                     "properties": {"status": {"enum": ["not_run", "passed", "failed", "not_applicable"]},
                                                                                    "panic_site": {"type": ["string", "null"]}}}}}},
    "evidence_override": {"type": ["object", "null"], "required": ["evidence_triage", "why"], "additionalProperties": false,
                          "description": "I14: null, or exactly config/evidence_overrides.json[<M>][<law_id>] (a human's recorded judgment)",
                          "properties": {"evidence_triage": {"enum": ["finding", "intent_question"]},
                                         "why": {"type": "string", "pattern": "\\S"}}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "REFUTED"}}},
     "then": {"properties": {"witness_provenance": {"type": "object"}, "filter_bin": {"enum": ["finding", "model_defect", "pending"]}}}},
    {"if": {"properties": {"status": {"enum": ["PROVED", "UNKNOWN"]}}},
     "then": {"properties": {"witness_provenance": {"type": "null"}, "filter_bin": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "UNKNOWN"}}},
     "then": {"properties": {"independence_class": {"const": "none"}}}},
    {"if": {"properties": {"status": {"enum": ["PROVED", "REFUTED"]}}},
     "then": {"properties": {"independence_class": {"enum": ["I1", "I1-shared", "I2"]}}}},
    {"$comment": "0.1/0.2 records (no statement_scope): scope_v2 is the search's, bounded exactly when UNKNOWN (M0/M1, pinned)",
     "if": {"properties": {"status": {"const": "UNKNOWN"}, "statement_scope": {"type": "null"}}},
     "then": {"properties": {"scope_v2": {"properties": {"kind": {"const": "bounded"}}}}}},
    {"if": {"properties": {"status": {"enum": ["PROVED", "REFUTED"]}, "statement_scope": {"type": "null"}}},
     "then": {"properties": {"scope_v2": {"properties": {"kind": {"const": "unbounded"}}}}}},
    {"$comment": "0.3 records: scope comes from statement.scope, never from the status (whitepaper 8.6; audit F-M2-01)",
     "if": {"required": ["statement_scope"], "properties": {"statement_scope": {"required": ["kind"], "properties": {"kind": {"const": "unbounded"}}}}},
     "then": {"properties": {"scope": {"const": "unbounded"}, "scope_v2": {"properties": {"kind": {"const": "unbounded"}}}}}},
    {"if": {"required": ["statement_scope"], "properties": {"statement_scope": {"required": ["kind"], "properties": {"kind": {"enum": ["bounded", "at_state"]}}}}},
     "then": {"properties": {"scope": {"const": "bounded"}, "scope_v2": {"properties": {"kind": {"const": "bounded"}}}}}}
  ]
}
