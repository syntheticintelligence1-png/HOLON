{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOLON audit round (audit/rounds/<M>/round<n>.json): I5's minimal format, extended by I87 with optional fields only (round_version, dry_run, packet; per attack auditor_type and run), so every earlier round stays valid",
  "type": "object",
  "required": [
    "round",
    "milestone",
    "target_commit",
    "auditor",
    "attacks",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "round": {
      "type": "integer"
    },
    "milestone": {
      "type": "string",
      "pattern": "^M[0-9]+$"
    },
    "target_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "auditor": {
      "type": "object",
      "required": [
        "session",
        "family",
        "counts_toward_convergence"
      ],
      "additionalProperties": false,
      "properties": {
        "session": {
          "type": "string"
        },
        "family": {
          "enum": [
            "same",
            "different"
          ]
        },
        "counts_toward_convergence": {
          "type": "boolean"
        }
      }
    },
    "attacks": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "tried",
          "result",
          "findings"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^A[0-9]+$"
          },
          "category": {
            "enum": [
              "statement_fidelity",
              "gate_evasion",
              "model_vs_code",
              "vacuity",
              "determinism",
              "mutation_adequacy",
              "bindings_ledger"
            ]
          },
          "tried": {
            "type": "string"
          },
          "result": {
            "enum": [
              "finding",
              "no_finding"
            ]
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^F-M[0-9]+-[0-9]{2}$"
            }
          },
          "auditor_type": {
            "enum": [
              "A1",
              "A2",
              "A3",
              "A4"
            ]
          },
          "run": {
            "type": "boolean"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^F-M[0-9]+-[0-9]{2}$"
      }
    },
    "round_version": {
      "const": "holon-audit-round/0.2"
    },
    "dry_run": {
      "type": "boolean"
    },
    "packet": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
