{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HOLON A2 driver record (audit/rounds/<M>/round<n>/a2.json, holon-audit-a2/0.1; holon/audit/hostile_input.py): an external auditor's hostile inputs, run on the compiled model and on the real code, and compared",
  "type": "object",
  "required": [
    "milestone",
    "round",
    "target_commit",
    "spec",
    "summary",
    "attack",
    "a2_version",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "milestone": {
      "type": "string",
      "pattern": "^M[0-9]+$"
    },
    "round": {
      "type": "integer"
    },
    "target_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "spec": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "body"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "body": {
          "type": "object"
        }
      }
    },
    "attack": {
      "type": "object",
      "required": [
        "id",
        "category",
        "tried",
        "result",
        "findings"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A[0-9]+$"
        },
        "category": {
          "enum": [
            "statement_fidelity",
            "gate_evasion",
            "model_vs_code",
            "vacuity",
            "determinism",
            "mutation_adequacy",
            "bindings_ledger"
          ]
        },
        "tried": {
          "type": "string"
        },
        "result": {
          "enum": [
            "finding",
            "no_finding"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F-M[0-9]+-[0-9]{2}$"
          }
        },
        "auditor_type": {
          "enum": [
            "A1",
            "A2",
            "A3",
            "A4"
          ]
        },
        "run": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "a2_version": {
      "const": "holon-audit-a2/0.1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "entry",
          "verdict"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "entry": {
            "type": "object",
            "required": [
              "kind",
              "document"
            ]
          },
          "verdict": {
            "enum": [
              "agree",
              "disagree",
              "unsupported"
            ]
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "agree",
        "disagree",
        "unsupported"
      ],
      "additionalProperties": false,
      "properties": {
        "agree": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disagree": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
