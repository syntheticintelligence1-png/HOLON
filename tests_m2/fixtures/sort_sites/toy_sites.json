{
  "facts_version": "holon-facts/0.2",
  "target": {"repo": "holon/toy-sites", "commit": "0000000000000000000000000000000000000000",
             "scope": "a toy machine for the I15 SORT-site rules: a realization check, guard and path coercions, definition sites, an invariant site, a coherence obstruction. Not a real target; never replayed."},
  "extraction": {"method": "hand-written fixture (I15 prereg)", "date": "2026-10-12"},
  "abstractions": ["Registers are Nat; the challenge flag is a Bool."],
  "params": {"OWNER": 1},
  "types": {},
  "state": [["t", "Nat", "block.timestamp (environment)"],
            ["lfi", "Nat", "last finalized index"],
            ["len", "Nat", "window length"],
            ["start", "Nat", "challenge start time"],
            ["inch", "Bool", "in challenge"],
            ["W", "Nat", "proof window"],
            ["D", "Nat", "delay period"],
            ["qpend", "Nat", "pendingQueueIndex"],
            ["qtot", "Nat", "total messages popped by commits"],
            ["enq", "List<Nat>", "message enqueue times"],
            ["last", "Nat", "index before the last finalized one"],
            ["log", "List<Obs>", "observations (newest first)"]],
  "ghost_state": [],
  "initial": {"doc": "one batch in the window, no challenge", "t": 10, "lfi": 0, "len": 1, "start": 0, "inch": false,
              "W": 10, "D": 20, "qpend": 0, "qtot": 0, "enq": [], "last": 0, "log": []},
  "principals": {"1": "owner", "2": "anyone"},
  "reasons": {"1": "not owner", "2": "can only revert unfinalized", "3": "panic:0x11", "4": "bad index",
              "5": "panic:0x11", "6": "l1msg delay"},
  "defs": {
    "lci": {"params": [["lfi", "Nat"], ["len", "Nat"]], "type": "Nat", "body": ["-", ["+", "lfi", "len"], 1],
            "doc": "last index in the window"},
    "after": {"params": [["lfi", "Nat"], ["len", "Nat"], ["idx", "Nat"]], "type": "Nat",
              "body": ["?", ["<=", "idx", ["call", "lci", "lfi", "len"]], 0, ["-", "idx", ["call", "lci", "lfi", "len"]]],
              "doc": "how far idx lies past the window"},
    "first": {"params": [["qpend", "Nat"], ["enq", "List<Nat>"], ["t", "Nat"]], "type": "Nat",
              "body": ["?", ["<", "qpend", ["call", "len", "enq"]], ["call", "nth", "enq", "qpend"], "t"],
              "src": "Toy.sol:70-75", "doc": "enqueue time of the first pending message, else now"}
  },
  "actions": [
    {"name": "revertTo", "src": "Toy.sol:10-20", "principal": "owner", "inputs": [["who", "Nat"], ["idx", "Nat"]],
     "guards": [{"require": ["==", "who", "OWNER"], "reason": 1, "src": "Toy.sol:11"},
                {"require": [">", "idx", "lfi"], "reason": 2, "src": "Toy.sol:12"},
                {"let": "p", "expr": ["-", "idx", "lfi"]}],
     "effects": {"len": "p"}},
    {"name": "commit", "src": "Toy.sol:30-40", "principal": "anyone", "inputs": [["n", "Nat"], ["pos", "Nat"]],
     "guards": [{"let": "ef", "expr": ["call", "first", "qpend", "enq", "t"], "src": "Toy.sol:31"},
                {"require": ["||", ["!", ["<", ["+", "ef", "D"], "t"]], [">", "n", 0]], "reason": 6, "src": "Toy.sol:32"},
                {"require": ["||", ["!", "inch"], ["<=", "t", ["+", "W", "start"]]], "reason": 3, "src": "Toy.sol:34"},
                {"let": "prt", "expr": ["?", "inch", ["-", ["+", "W", "start"], "t"], 0], "src": "Toy.sol:33-35"},
                {"let": "a", "expr": ["call", "after", "lfi", "len", "pos"], "src": "Toy.sol:36"}],
     "effects": {"len": ["+", "len", 1], "qtot": ["+", "qtot", "n"]},
     "effects_src": "Toy.sol:38-39"},
    {"name": "finalize", "src": "Toy.sol:50-60", "principal": "anyone", "inputs": [["idx", "Nat"]],
     "guards": [{"require": ["<=", "idx", ["call", "lci", "lfi", "len"]], "reason": 4, "src": "Toy.sol:51"},
                {"require": [">=", "idx", 1], "reason": 5, "src": "Toy.sol:52"},
                {"require": ["<=", ["-", "idx", 1], "lfi"], "reason": 4, "src": "Toy.sol:52-53"},
                {"require": ["==", ["+", "lfi", 1], "idx"], "reason": 4, "src": "Toy.sol:54"}],
     "effects": {"lfi": "idx", "len": ["-", "len", 1], "qpend": "qtot", "last": ["-", "idx", 1]},
     "effects_src": "Toy.sol:56-58"},
    {"name": "challenge", "src": "Toy.sol:62", "principal": "anyone", "inputs": [], "guards": [],
     "effects": {"inch": true, "start": "t"}},
    {"name": "send", "src": "Toy.sol:64", "principal": "anyone", "inputs": [], "guards": [],
     "effects": {"enq": ["call", "snoc", "enq", "t"]}},
    {"name": "wait", "src": "environment: time progress", "principal": "environment", "inputs": [["dt", "Nat"]],
     "guards": [], "effects": {"t": ["+", "t", "dt"]}}
  ],
  "migrations": {},
  "observers": {},
  "policy": "generic",
  "search": {"domains": {"revertTo": {"who": [1], "idx": [1, 2]}, "commit": {"n": [0, 1], "pos": [0, 2]},
                         "finalize": {"idx": [1, 2]}, "wait": {"dt": [1, 11]}},
             "prefixDepth": 3, "maxPrefixes": 400},
  "coverage": {"modelled": ["revertTo", "commit", "finalize", "challenge", "send", "wait"], "debt": []}
}
