{
  "facts_version": "holon-facts/0.2",
  "target": {"repo": "holon/toy-evidence", "commit": "0000000000000000000000000000000000000000",
             "scope": "I14 evidence fixture: a small machine where E2, E3, E4, E5 and E6 are planted present and absent, plus E2 pairs left unresolved by a kindless library builtin (smear)"},
  "extraction": {"method": "hand-written fixture", "date": "2026-10-12"},
  "abstractions": ["Registers are Nat."],
  "params": {"K": 5},
  "types": {},
  "state": [["t", "Nat", "block.timestamp (environment)"],
            ["dl", "Nat", "deadline"],
            ["store", "Nat", "digest written by putValue"],
            ["seen", "Nat", "digest copied by peekValue"],
            ["u", "Nat", "left tag"],
            ["v", "Nat", "right tag"],
            ["m1", "Nat", "a machine word"],
            ["m2", "Nat", "another machine word"],
            ["on", "Bool", "a flag"],
            ["off", "Bool", "another flag"],
            ["buf", "List<Nat>", "a buffer"],
            ["log", "List<Obs>", "observations"]],
  "ghost_state": [],
  "initial": {"doc": "all registers zero", "t": 0, "dl": 0, "store": 0, "seen": 0, "u": 0, "v": 0, "m1": 0, "m2": 0,
              "on": false, "off": false, "buf": [], "log": []},
  "principals": {},
  "reasons": {"1": "late", "2": "bad digest", "3": "stale copy", "4": "tags differ", "5": "wrong key", "6": "flags differ",
              "7": "words out of order", "8": "empty slot", "9": "expired", "10": "copy ahead of store"},
  "defs": {"digest": {"params": [["x", "Nat"]], "type": "Nat", "body": ["+", "x", "K"], "src": "toy/T.sol:5"}},
  "actions": [
    {"name": "putValue", "src": "toy/T.sol:10-12", "principal": "anyone", "inputs": [["val", "Nat"]],
     "guards": [{"let": "h", "expr": ["call", "digest", "val"], "src": "toy/T.sol:10"},
                {"require": ["<=", "t", "dl"], "reason": 1, "src": "toy/T.sol:11"}],
     "effects": {"store": "h", "buf": ["call", "snoc", "buf", "val"]}},
    {"name": "checkValue", "src": "toy/T.sol:20-22", "principal": "anyone", "inputs": [["val", "Nat"]],
     "guards": [{"require": ["==", ["call", "digest", "val"], "store"], "reason": 2, "src": "toy/T.sol:20"}],
     "effects": {"seen": "store"}},
    {"name": "peekValue", "src": "toy/T.sol:30-32", "principal": "anyone", "inputs": [],
     "guards": [{"require": ["==", ["call", "digest", "store"], "seen"], "reason": 3, "src": "toy/T.sol:30"}],
     "effects": {"seen": "store"}},
    {"name": "sync", "src": "toy/T.sol:40-45", "principal": "anyone", "inputs": [["x", "Nat"]],
     "guards": [{"require": ["==", "u", "v"], "reason": 4, "src": "toy/T.sol:40"},
                {"require": ["==", "x", "K"], "reason": 5, "src": "toy/T.sol:41"},
                {"require": ["==", "on", "off"], "reason": 6, "src": "toy/T.sol:42"},
                {"require": ["<=", "m1", "m2"], "reason": 7, "src": "toy/T.sol:43"}],
     "effects": {"u": "x"}},
    {"name": "smudge", "src": "toy/T.sol:50-52", "principal": "anyone", "inputs": [["k", "Nat"]],
     "guards": [],
     "effects": {"buf": ["call", "smear", "buf", "k"]}},
    {"name": "readBuf", "src": "toy/T.sol:60-62", "principal": "anyone", "inputs": [["i", "Nat"]],
     "guards": [{"require": [">", ["call", "nth", "buf", "i"], 0], "reason": 8, "src": "toy/T.sol:60"}],
     "effects": {"v": ["call", "nth", "buf", "i"]}},
    {"name": "zap", "src": "toy/T.sol:70-73", "principal": "anyone", "inputs": [],
     "guards": [{"require": ["<", "t", "dl"], "reason": 9, "src": "toy/T.sol:70"},
                {"require": ["<=", "seen", "store"], "reason": 10, "src": "toy/T.sol:71"}],
     "effects": {"on": true}},
    {"name": "tick", "src": "environment: time progress", "principal": "environment", "inputs": [["dt", "Nat"]],
     "guards": [], "effects": {"t": ["+", "t", "dt"]}}
  ],
  "migrations": {},
  "observers": {"late": {"params": [["s", "State"]], "type": "Bool", "body": ["<", "dl", "t"], "doc": "the deadline has passed"},
                "smeared": {"params": [["s", "State"]], "type": "List<Nat>", "body": ["call", "smear", "buf", 0], "doc": "the buffer as smear sees it"}},
  "disch": {"doc": "delay is time waited", "delay": {"action": "tick", "input": "dt"}},
  "coverage": {"modelled": ["putValue", "checkValue", "peekValue", "sync", "smudge", "readBuf", "zap", "tick"], "debt": []}
